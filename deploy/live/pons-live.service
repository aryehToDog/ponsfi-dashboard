[Unit]
Description=STONK official live UTC revenue receiver
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/pons-live/revenue.py
EnvironmentFile=/etc/pons-live.env
User=www-data
Group=www-data
StateDirectory=pons-live
Restart=always
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pons-live

[Install]
WantedBy=multi-user.target
