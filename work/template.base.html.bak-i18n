<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pons / StonkFun 收入与回购监控面板</title>
<link rel="icon" href="data:,">
<style>
:root{
  --bg:#0a0c11; --panel:#11141c; --panel2:#161a24; --line:#212736; --line2:#2c3446;
  --txt:#e8ebf2; --mut:#828b9e; --mut2:#5d6679;
  --up:#2ee6a8; --down:#ff5c72; --warn:#ffb020;
  --pons:#8b7cff; --stonk:#2ee6a8;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--txt);
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro SC","PingFang SC","Segoe UI",Roboto,sans-serif;
  font-size:13px;line-height:1.5;-webkit-font-smoothing:antialiased}
.mono{font-family:ui-monospace,SFMono-Regular,"SF Mono",Menlo,monospace;font-variant-numeric:tabular-nums}
.wrap{max-width:1420px;margin:0 auto;padding:18px 20px 60px}
header{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:16px}
h1{font-size:16px;margin:0;font-weight:600;letter-spacing:.2px}
h1 span{color:var(--mut);font-weight:400;font-size:12px;margin-left:8px}
.hdr-right{display:flex;align-items:center;gap:10px}
.badge{font-size:11px;padding:3px 9px;border-radius:20px;border:1px solid var(--line2);color:var(--mut);white-space:nowrap}
.badge.live{color:var(--up);border-color:#1c5443;background:#0d2b22}
.badge.off{color:var(--warn);border-color:#5c451a;background:#2b210d}
button{background:var(--panel2);color:var(--txt);border:1px solid var(--line2);border-radius:7px;
  padding:6px 13px;font-size:12px;cursor:pointer;font-family:inherit;transition:.15s}
button:hover{background:#1e2431;border-color:#3a445c}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:900px){.grid2{grid-template-columns:1fr}}
.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:15px 16px}
.proj-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:12px}
.proj-name{display:flex;align-items:center;gap:9px;font-size:15px;font-weight:600}
.dot{width:9px;height:9px;border-radius:50%;flex:0 0 auto;box-shadow:0 0 10px currentColor}
.tick{font-size:11px;color:var(--mut);background:var(--panel2);border:1px solid var(--line2);padding:2px 7px;border-radius:5px}
.price{text-align:right}
.price .p{font-size:19px;font-weight:600}
.price .m{font-size:11px;color:var(--mut)}
.pill{display:inline-block;font-size:11px;padding:2px 7px;border-radius:5px;margin-top:3px}
.pill.up{background:#0d2b22;color:var(--up)}
.pill.down{background:#2b0d13;color:var(--down)}
.kv{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:9px;overflow:hidden;margin-bottom:12px}
.kv .qi{display:inline-block;width:11px;height:11px;line-height:11px;text-align:center;border-radius:50%;background:var(--line2);color:var(--mut);font-size:8.5px;cursor:help;vertical-align:1px}
.kv>div{background:var(--panel2);padding:9px 10px}
.kv .k{font-size:10.5px;color:var(--mut);margin-bottom:3px;letter-spacing:.2px}
.kv .v{font-size:14px;font-weight:600}
.kv .v small{font-size:10.5px;color:var(--mut);font-weight:400}
.status{border-radius:9px;padding:9px 11px;font-size:12px;display:flex;align-items:center;gap:9px;border:1px solid}
.status.good{background:#0d2b22;border-color:#1c5443;color:#7ff0c6}
.status.warn{background:#2b210d;border-color:#5c451a;color:#ffd68a}
.status.bad{background:#2b0d13;border-color:#5c1a24;color:#ff9aa8}
.status .lbl{font-weight:600}
.sec-title{font-size:12px;color:var(--mut);margin:22px 0 10px;letter-spacing:.4px;text-transform:uppercase;font-weight:600}
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
.tab{padding:5px 12px;border-radius:7px;border:1px solid var(--line2);background:var(--panel);color:var(--mut);cursor:pointer;font-size:12px}
.tab.on{background:#1d2330;color:var(--txt);border-color:#3a445c}
.chartbox{position:relative;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px 14px 8px}
.legend{display:flex;gap:16px;margin-bottom:6px;font-size:11.5px;color:var(--mut);flex-wrap:wrap}
.legend i{display:inline-block;width:11px;height:3px;border-radius:2px;margin-right:6px;vertical-align:middle}
svg{display:block;width:100%;height:auto;overflow:visible}
.tip{position:absolute;pointer-events:none;background:#0d1017ee;border:1px solid var(--line2);border-radius:8px;
  padding:7px 10px;font-size:11.5px;display:none;z-index:9;backdrop-filter:blur(6px);min-width:150px}
.tip .d{color:var(--mut);margin-bottom:4px;font-size:10.5px}
.tip .r{display:flex;justify-content:space-between;gap:14px}
table{width:100%;border-collapse:collapse;font-size:12px}
th,td{text-align:right;padding:7px 9px;border-bottom:1px solid var(--line)}
th{color:var(--mut);font-weight:500;font-size:11px;position:sticky;top:0;background:var(--panel);cursor:pointer;user-select:none}
th:first-child,td:first-child{text-align:left}
tbody tr:hover{background:#161a24}
.rules{display:flex;flex-direction:column;gap:16px}
.rule-legend{display:flex;gap:20px;flex-wrap:wrap;font-size:11.5px;color:var(--mut);margin:0 0 12px;line-height:1.6}
.rule-legend .lg{display:flex;align-items:center;gap:7px}
.tag{font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:5px;white-space:nowrap;flex:0 0 auto;letter-spacing:.5px}
.tag.ok{background:#0d2b22;color:var(--up);border:1px solid #1c5443}
.tag.warn{background:#2b210d;color:var(--warn);border:1px solid #5c451a}
.tag.bad{background:#2b0d13;color:var(--down);border:1px solid #5c1a24}
/* 对比表：同一规则左右并排 */
.cmp-head{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:6px}
.cmp-head .col{display:flex;align-items:center;gap:8px;background:var(--panel2);border:1px solid var(--line);border-radius:9px;padding:8px 13px;font-size:13px;font-weight:600}
.cmp-head .col .cnt{margin-left:auto;font-size:11px;font-weight:400;color:var(--mut)}
.cmp-row{display:flex;flex-direction:column;gap:7px}
.cmp-label{display:flex;align-items:center;gap:9px;flex-wrap:wrap;padding:0 2px}
.cmp-label b{font-size:12px;font-weight:600;color:var(--txt)}
.cmp-label .hint{font-size:11px;color:var(--mut2)}
.cmp-label .verdict{margin-left:auto;font-size:11px;padding:2px 9px;border-radius:5px;background:var(--panel2);border:1px solid var(--line2);color:var(--mut)}
.cmp-label .verdict.win{color:#7ff0c6;border-color:#1c5443}
.cmp-pair{display:grid;grid-template-columns:1fr 1fr;gap:10px;align-items:stretch}
@media(max-width:900px){.cmp-head,.cmp-pair{grid-template-columns:1fr}}
.cmp-pair>.rule{display:flex;flex-direction:column}
.cmp-pair>.rule .act{margin-top:auto}
.rule{background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--line2);border-radius:10px;padding:11px 13px}
.rule.ok{border-left-color:#1c5443}
.rule.warn{border-left-color:var(--warn)}
.rule.bad{border-left-color:var(--down)}
.rule.sum{border-left-color:#3a445c}
.rule .rtop{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:5px}
.rule .pname{font-size:11.5px;font-weight:600;display:none}
@media(max-width:900px){.rule .pname{display:inline}}
.rule .s{color:var(--mut);font-size:11.5px;line-height:1.55}
.rule .act{margin-top:7px;font-size:11.5px;padding:5px 9px;border-radius:6px;background:var(--panel2);border:1px solid var(--line);color:var(--mut)}
.rule .act.ok{color:#7ff0c6;border-color:#1c5443}
.rule .act.warn{color:#ffd68a;border-color:#5c451a}
.rule .act.bad{color:#ff9aa8;border-color:#5c1a24}
.rule.sum .act{color:var(--txt);border-color:#3a445c}
.gitem .g-ok{color:var(--up)}
.gitem .g-warn{color:var(--warn)}
.gitem .g-bad{color:var(--down)}
.guide{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:900px){.guide{grid-template-columns:1fr}}
.gitem{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:15px 17px}
.gitem h3{margin:0 0 5px;font-size:13px;font-weight:600}
.gitem .f{font-size:10.5px;color:var(--mut2);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;margin-bottom:9px;word-break:break-all}
.gitem .lead{font-size:12px;color:var(--mut);line-height:1.75;margin:0 0 10px}
.gitem .ex{background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:10px 12px;font-size:11.5px;line-height:1.95;margin-bottom:10px;word-break:break-word}
.gitem .ex b{color:var(--txt)}
.gitem .ex .cap{color:var(--mut2);font-size:10.5px;letter-spacing:.3px;margin-bottom:4px}
.gitem ul{margin:0;padding-left:0;list-style:none;font-size:11.5px;line-height:1.9;color:var(--mut)}
.gitem ul li{display:flex;gap:9px}
.gitem ul li .band{flex:0 0 auto;min-width:66px;font-family:ui-monospace,monospace;color:var(--txt)}
.gitem .note{margin-top:9px;font-size:11px;color:var(--mut2);line-height:1.75;border-top:1px dashed var(--line2);padding-top:8px}
.foot{color:var(--mut2);font-size:11px;margin-top:26px;line-height:1.7}
.warnline{stroke-dasharray:4 4}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>Pons · StonkFun 收入与回购监控面板<span id="gen"></span></h1>
    <div class="hdr-right">
      <span class="badge" id="src">加载中…</span>
      <button onclick="loadLive()">刷新数据</button>
    </div>
  </header>

  <div class="grid2" id="cards"></div>

  <div class="sec-title">规则引擎 · 加仓与止损信号</div>
  <div class="rule-legend">
    <span class="lg"><span class="tag ok">正常</span>条件满足，按原计划持有</span>
    <span class="lg"><span class="tag warn">警戒</span>接近阈值，暂停加仓、盯紧</span>
    <span class="lg"><span class="tag bad">危险</span>规则已触发，看每条下面的「建议」</span>
  </div>
  <div class="rules" id="rules"></div>

  <div class="sec-title">趋势图</div>
  <div class="tabs" id="tabs"></div>
  <div class="chartbox">
    <div class="legend" id="legend"></div>
    <svg id="chart" viewBox="0 0 1200 340" preserveAspectRatio="none"></svg>
    <div class="tip" id="tip"></div>
  </div>

  <div class="sec-title">日度明细（最近 20 天）</div>
  <div class="card" style="padding:0;overflow:auto;max-height:430px">
    <table id="tbl"><thead></thead><tbody></tbody></table>
  </div>

  <div class="sec-title">指标说明 · 每个数字怎么读</div>
  <div class="guide" id="guide"></div>

  <div class="foot" id="foot"></div>
</div>

<script>
const BUNDLE = /*__DATA__*/;

const PROJECTS = [
  { id:'pons', seriesKey:'pons', name:'Pons', ticker:'PONS', chain:'Robinhood Chain',
    color:'#8b7cff', supply:682770000, maxSupply:1000000000, burned:317230421,
    mcapFallback:365777975, burnEvent:'80% 协议费用 TWAP 回购销毁（官方注明尚未 immutable）',
    danger:100000, warn:150000, baseline:220000 },
  { id:'stonkfun', seriesKey:'stonkfun', name:'StonkFun', ticker:'STONK', chain:'Solana',
    color:'#2ee6a8', supply:814583323, maxSupply:1000000000, burned:185416677,
    mcapFallback:207358628, burnEvent:'约 60% 平台收入公开市场回购销毁 + 生态飞轮',
    danger:200000, warn:280000, baseline:34400 }
];

const CG_IDS = {pons:'pons', stonkfun:'stonk-3'};
let DATA = JSON.parse(JSON.stringify(BUNDLE));
let MODE = 'rev7';

/* ---------- utils ---------- */
const fmtU = v => {
  if (v === null || v === undefined || isNaN(v)) return '—';
  const a = Math.abs(v);
  if (a >= 1e9) return '$' + (v/1e9).toFixed(2) + 'B';
  if (a >= 1e6) return '$' + (v/1e6).toFixed(2) + 'M';
  if (a >= 1e3) return '$' + (v/1e3).toFixed(1) + 'K';
  return '$' + v.toFixed(0);
};
const fmtN = (v,d=2) => (v===null||isNaN(v))?'—':v.toLocaleString('en-US',{minimumFractionDigits:d,maximumFractionDigits:d});
const dayKey = ts => new Date(ts*1000).toISOString().slice(0,10);
const toMap = arr => { const m={}; (arr||[]).forEach(([ts,v])=>{ const k=dayKey(ts); m[k]=(m[k]||0)+v; }); return m; };
const sortedKeys = m => Object.keys(m).sort();
const smaAt = (vals,i,n) => { if (i<n-1) return null; let s=0; for(let j=i-n+1;j<=i;j++) s+=vals[j]; return s/n; };

/* ---------- build unified daily table ---------- */
function build(){
  const rev = {}, hold = {}, fee = {}, price = {};
  PROJECTS.forEach(p=>{
    rev[p.id]  = toMap(DATA.series[p.seriesKey+'.dailyRevenue']);
    hold[p.id] = toMap(DATA.series[p.seriesKey+'.dailyHoldersRevenue']);
    fee[p.id]  = toMap(DATA.series[p.seriesKey+'.dailyFees']);
    price[p.id]= toMap(DATA.priceSeries[p.id]);
  });
  const all = new Set();
  Object.values(rev).forEach(m=>Object.keys(m).forEach(k=>all.add(k)));
  Object.values(price).forEach(m=>Object.keys(m).forEach(k=>all.add(k)));
  const days = [...all].sort();
  const rows = days.map(d=>{
    const r = { date:d };
    PROJECTS.forEach(p=>{
      r[p.id+'_rev']   = rev[p.id][d]  ?? null;
      r[p.id+'_hold']  = hold[p.id][d] ?? null;
      r[p.id+'_fee']   = fee[p.id][d]  ?? null;
      r[p.id+'_price'] = price[p.id][d] ?? null;
    });
    return r;
  });
  return rows;
}

/* ---------- stats ---------- */
function stats(rows, p){
  const rev = rows.map(r=>r[p.id+'_rev']).map(v=>v??0);
  const hold= rows.map(r=>r[p.id+'_hold']).map(v=>v??0);
  const idxValid = rows.map((r,i)=>r[p.id+'_rev']!==null?i:-1).filter(i=>i>=0);
  const last = idxValid[idxValid.length-1];
  const sum = (a,b)=>{ let s=0,n=0; for(let i=Math.max(0,a);i<=b;i++){ if(rows[i][p.id+'_rev']!==null){s+=rev[i];n++;} } return {s,n}; };
  const w7  = sum(last-6, last), w7p = sum(last-13, last-7), w30 = sum(last-29, last);
  const avg7 = w7.n? w7.s/w7.n : 0, avg7p = w7p.n? w7p.s/w7p.n : 0, avg30 = w30.n? w30.s/w30.n : 0;
  const hold7 = sum(last-6,last);
  let holdSum7=0; for(let i=Math.max(0,last-6);i<=last;i++) holdSum7 += hold[i]||0;
  const peak = Math.max(...idxValid.map(i=>rev[i]));
  const peakDay = rows[idxValid[idxValid.findIndex(i=>rev[i]===peak)]].date;
  const mcap = DATA.meta[p.id]?.mcap || p.mcapFallback;
  const priceNow = DATA.price?.[p.id] ?? rows[last][p.id+'_price'];
  const priceArr = rows.map(r=>r[p.id+'_price']).filter(v=>v!==null);
  const ath = priceArr.length? Math.max(...priceArr) : null;
  const retrace = avg7p? (avg7-avg7p)/avg7p : 0;
  // trend over last 14 valid days via linear regression on log
  const win = idxValid.slice(-14).map(i=>({x:i, y:Math.log(Math.max(rev[i],1))}));
  let slope=0;
  if(win.length>3){
    const n=win.length, mx=win.reduce((a,b)=>a+b.x,0)/n, my=win.reduce((a,b)=>a+b.y,0)/n;
    let num=0,den=0; win.forEach(w=>{num+=(w.x-mx)*(w.y-my);den+=(w.x-mx)**2;});
    slope = num/den;
  }
  // 流动性与回购力度（成交额来自 CoinGecko）
  const mk = (DATA.market || {})[p.id] || {};
  const vol24 = mk.vol24h || null;
  const turnover  = (vol24 && mcap) ? vol24/mcap : null;
  const burnForce = (vol24 && vol24>0) ? holdSum7/(vol24*7) : null;
  const burnYield = mcap>0 ? holdSum7/mcap*52 : null;
  return {last, avg7, avg7p, avg30, holdSum7, peak, peakDay, lastRev:rev[last],
    psv: priceNow, mcap, ps7: avg7>0? mcap/(avg7*365):null, ps30: avg30>0? mcap/(avg30*365):null,
    retrace, slope, ath, priceArr, burnPct: p.burned/p.maxSupply, rows,
    vol24, volChange: (mk.change24h ?? null), turnover, burnForce, burnYield};
}

/* ---------- render cards ---------- */
function renderCards(){
  const rows = build();
  const el = document.getElementById('cards');
  el.innerHTML = PROJECTS.map(p=>{
    const s = stats(rows,p);
    const d = (s.avg7-s.avg7p)/(s.avg7p||1);
    const status = s.avg7 < p.danger ? ['bad','收入已跌破止损线，退出观察']
                 : s.avg7 < p.warn   ? ['warn','收入低于警戒线，暂停加仓']
                 : (d<-0.25)         ? ['warn','收入环比骤降，只观察不动手']
                 : (d>0.05)          ? ['good','收入企稳回升，可考虑分批加仓']
                 : ['good','收入横盘企稳，持有观察'];
    const pct = v => v===null||isNaN(v)? '—' : (v>=0?'+':'')+(v*100).toFixed(1)+'%';
    const dd = s.ath? (s.psv-s.ath)/s.ath : null;
    return `<div class="card">
      <div class="proj-head">
        <div>
          <div class="proj-name"><span class="dot" style="background:${p.color};color:${p.color}"></span>${p.name}<span class="tick">${p.ticker}</span></div>
          <div style="color:var(--mut);font-size:11.5px;margin-top:3px">${p.chain} · 已销毁 ${(s.burnPct*100).toFixed(1)}% (${fmtN(p.burned/1e6,1)}M ${p.ticker})</div>
        </div>
        <div class="price">
          <div class="p mono">$${fmtN(s.psv,4)}</div>
          <div class="m">市值 ${fmtU(s.mcap)}</div>
          <div class="pill ${dd>=0?'up':'down'}">距 ATH ${pct(dd)}</div>
        </div>
      </div>
      <div class="kv">
        <div><div class="k">7 日均收入</div><div class="v">${fmtU(s.avg7)}<small> /天</small></div></div>
        <div><div class="k">环比上 7 日</div><div class="v" style="color:${d>=0?'var(--up)':'var(--down)'}">${pct(d)}</div></div>
        <div><div class="k">最新单日收入</div><div class="v">${fmtU(s.lastRev)}</div></div>
        <div><div class="k">单日收入峰值</div><div class="v">${fmtU(s.peak)}</div></div>
        <div title="市值 ÷ 一年收入，越小越便宜"><div class="k">P/S 年化 (7日) <span class="qi">?</span></div><div class="v">${s.ps7?fmtN(s.ps7,2)+'x':'—'}</div></div>
        <div title="用 30 日均收入算的 P/S，比 7 日平滑"><div class="k">P/S 年化 (30日) <span class="qi">?</span></div><div class="v">${s.ps30?fmtN(s.ps30,2)+'x':'—'}</div></div>
        <div><div class="k">距收入峰值</div><div class="v" style="color:var(--down)">${s.peak?((s.lastRev-s.peak)/s.peak*100).toFixed(0)+'%':'—'}</div></div>
        <div title="7 日回购 × 52 ÷ 市值：一年能买掉市值的百分之几"><div class="k">回购年化收益率 <span class="qi">?</span></div><div class="v">${s.burnYield!==null?fmtN(s.burnYield*100,0)+'%':'—'}</div></div>
        <div><div class="k">最近 7 日回购</div><div class="v">${fmtU(s.holdSum7)}</div></div>
        <div title="最近 7 日回购 ÷ 最近 7 日成交额：≥5% 才算有效买盘"><div class="k">回购力度 <span class="qi">?</span></div><div class="v" style="color:${s.burnForce===null?'inherit':s.burnForce>=0.05?'var(--up)':s.burnForce>=0.02?'var(--warn)':'var(--down)'}">${s.burnForce===null?'—':(s.burnForce*100).toFixed(2)+'%'}</div></div>
        <div title="24 小时成交额"><div class="k">24h 成交额</div><div class="v">${fmtU(s.vol24)}</div></div>
        <div title="24h 成交额 ÷ 市值：一天有百分之几的筹码换手"><div class="k">日换手率 <span class="qi">?</span></div><div class="v">${s.turnover!==null?(s.turnover*100).toFixed(1)+'%':'—'}</div></div>
      </div>
      <div class="status ${status[0]}"><span class="lbl">${status[0]==='bad'?'● 危险':status[0]==='warn'?'● 警戒':'● 正常'}</span><span>${status[1]}</span></div>
    </div>`;
  }).join('');
}

/* ---------- rules（同一规则左右对比） ---------- */
const LV_TXT = {ok:'正常', warn:'警戒', bad:'危险'};
const DIMS = [
  {key:'floor', short:'止损', label:'收入是否跌破止损线', hint:'7 日均低于离场线＝该走'},
  {key:'mom',   short:'环比', label:'收入环比是否骤降',   hint:'连续下跌是最早的坏消息'},
  {key:'burn',  short:'回购', label:'回购是否持续',       hint:'回购停＝最重要的离场信号'},
  {key:'burnpower', short:'力度', label:'回购能不能托住价格', hint:'回购 ÷ 成交额，＜2% 基本可忽略'},
  {key:'ps',    short:'估值', label:'估值贵不贵（P/S）',  hint:'越低越便宜'}
];
const V_LABEL = {floor:'缓冲更厚', mom:'更抗跌', burn:'更积极', burnpower:'回购占比更高', ps:'更便宜'};

function ruleItems(rows, p){
  const s = stats(rows,p);
  const d = (s.avg7-s.avg7p)/(s.avg7p||1);
  const ps = s.ps7;
  const it = {};
  let lvl, act;

  if(s.avg7 < p.danger){ lvl='bad'; act='已跌破离场线：建议分批减仓或清仓，不要补仓'; }
  else if(s.avg7 < p.warn){ lvl='warn'; act='低于警戒线：暂停加仓，每天盯住这条线'; }
  else { lvl='ok'; act=`高出警戒线 ${fmtN((s.avg7-p.warn)/p.warn*100,0)}%，可继续持有`; }
  it.floor = {level:lvl, act, score:(s.avg7-p.danger)/p.danger,
    s:`7 日均 ${fmtU(s.avg7)}/天　·　离场线 ${fmtU(p.danger)}　·　警戒线 ${fmtU(p.warn)}`};

  if(d < -0.25){ lvl='bad'; act='环比骤降超 25%：暂停一切加仓，等连续 3 天回升再考虑'; }
  else if(d < -0.15){ lvl='warn'; act='环比走弱：只观察、不加仓'; }
  else if(d > 0.05){ lvl='ok'; act='环比回升：可考虑分批加仓'; }
  else { lvl='ok'; act='环比平稳：维持现有仓位'; }
  it.mom = {level:lvl, act, score:d,
    s:`本周 vs 上周 ${(d*100).toFixed(1)}%　·　触发线 −25%`};

  const burnRatio = s.avg7>0? s.holdSum7/(s.avg7*7) : 0;
  if(s.holdSum7 <= 0){ lvl='bad'; act='回购已停止：先减仓，等回购恢复再谈加仓'; }
  else { lvl='ok'; act=`回购在持续，7 日回购≈同期收入的 ${(burnRatio*100).toFixed(0)}%`; }
  it.burn = {level:lvl, act, score:burnRatio,
    s:`最近 7 日回购 ${fmtU(s.holdSum7)}　·　${p.burnEvent}`};

  const bf = s.burnForce;
  if(bf===null||!isFinite(bf)){ lvl='warn'; act='缺少成交额数据，无法判断回购的影响力'; }
  else if(bf >= 0.05){ lvl='ok';   act=`回购占成交额 ${(bf*100).toFixed(1)}%：买盘足够重，能真正托住价格`; }
  else if(bf >= 0.02){ lvl='warn'; act=`回购占成交额 ${(bf*100).toFixed(1)}%：能减缓下跌，但改变不了方向`; }
  else {               lvl='bad';  act=`回购只占成交额 ${(bf*100).toFixed(2)}%：杯水车薪，别指望回购托底`; }
  it.burnpower = {level:lvl, act, score:(bf===null||!isFinite(bf))? null : bf,
    s:`最近 7 日回购 ${fmtU(s.holdSum7)} ÷ 7 日成交额 ${fmtU(s.vol24? s.vol24*7 : null)}　·　≥5% 才算有效买盘`};

  if(ps===null||!isFinite(ps)){ lvl='warn'; act='没有收入数据，暂时无法估值'; }
  else if(ps < 1.5){ lvl='ok'; act=`${fmtN(ps,2)}x 便宜：安全垫厚，可分批加仓`; }
  else if(ps <= 4){ lvl='ok'; act=`${fmtN(ps,2)}x 合理：持有观察，不追高`; }
  else { lvl='warn'; act=`${fmtN(ps,2)}x 偏贵：不追高，等回调或收入涨上来`; }
  it.ps = {level:lvl, act, score:(ps===null||!isFinite(ps))? null : -ps,
    s:`P/S 年化(7日) ${ps===null||!isFinite(ps)?'—':fmtN(ps,2)+'x'}　·　&lt;1.5x 便宜 · &gt;4x 偏贵　·　参照 pump.fun 4.45x`};

  return {s, d, it, ok:Object.values(it).filter(x=>x.level==='ok').length};
}

function renderRules(){
  const rows = build();
  const A = PROJECTS[0], B = PROJECTS[1];
  const ra = ruleItems(rows, A), rb = ruleItems(rows, B);

  const verdict = {};
  DIMS.forEach(dim=>{
    const x = ra.it[dim.key].score, y = rb.it[dim.key].score;
    if(x===null||y===null||!isFinite(x)||!isFinite(y)){ verdict[dim.key]={text:'数据不足', tie:true}; return; }
    const rel = Math.abs(x-y)/(Math.abs(x)+Math.abs(y)||1);
    if(rel < 0.10){ verdict[dim.key]={text:'两家基本打平', tie:true}; return; }
    const w = x>y ? A : B;
    verdict[dim.key] = {text:`${w.ticker} ${V_LABEL[dim.key]}`, tie:false};
  });

  const card = (p, item) =>
    `<div class="rule ${item.level}">
       <div class="rtop"><span class="tag ${item.level}">${LV_TXT[item.level]}</span><span class="pname" style="color:${p.color}">● ${p.name}</span></div>
       <div class="s">${item.s}</div>
       <div class="act ${item.level}">建议：${item.act}</div>
     </div>`;

  const head = `<div class="cmp-head">
      <div class="col"><span class="dot" style="background:${A.color};color:${A.color}"></span>${A.name}<span class="tick">${A.ticker}</span><span class="cnt">${ra.ok}/${Object.keys(ra.it).length} 条正常</span></div>
      <div class="col"><span class="dot" style="background:${B.color};color:${B.color}"></span>${B.name}<span class="tick">${B.ticker}</span><span class="cnt">${rb.ok}/${Object.keys(rb.it).length} 条正常</span></div>
    </div>`;

  const body = DIMS.map((dim,i)=>{
    const v = verdict[dim.key];
    return `<div class="cmp-row">
      <div class="cmp-label"><b>${i+1}. ${dim.label}</b><span class="hint">${dim.hint}</span>
        <span class="verdict${v.tie?'':' win'}">对比：${v.text}</span></div>
      <div class="cmp-pair">${card(A, ra.it[dim.key])}${card(B, rb.it[dim.key])}</div>
    </div>`;
  }).join('');

  const summary = DIMS.map(d=>`${d.short} ${verdict[d.key].text}`).join('　·　');
  const cheaper = (ra.s.ps7 && rb.s.ps7) ? (ra.s.ps7 < rb.s.ps7 ? A : B) : null;
  const action = cheaper
    ? `资金优先级：${cheaper.ticker}（P/S 更低、安全垫更厚）；另一方等环比止跌、估值回落再考虑加仓。`
    : '数据不足，暂不给资金优先级建议。';

  document.getElementById('rules').innerHTML = head + body +
    `<div class="cmp-row">
      <div class="cmp-label"><b>综合结论</b></div>
      <div class="rule sum"><div class="s">${summary}</div><div class="act">${action}</div></div>
    </div>`;
}

/* ---------- chart ---------- */
const TABS = [
  {id:'rev',  label:'日收入'},
  {id:'rev7', label:'7 日均线收入'},
  {id:'cum',  label:'累计回购销毁'},
  {id:'price',label:'价格对比（归一）'}
];
function renderTabs(){
  document.getElementById('tabs').innerHTML = TABS.map(t=>
    `<div class="tab ${t.id===MODE?'on':''}" onclick="MODE='${t.id}';renderTabs();renderChart()">${t.label}</div>`).join('');
}
function renderChart(){
  const rows = build();
  const N = MODE==='price'? 90 : 60;
  const sub = rows.slice(-N);
  const svg = document.getElementById('chart');
  const W=1200,H=340, P={l:64,r:16,t:14,b:30};
  const iw = W-P.l-P.r, ih = H-P.t-P.b;
  let series=[], thresholds=[], yfmt = fmtU;

  if(MODE==='price'){
    let base = {};
    PROJECTS.forEach(p=>{
      const first = sub.find(r=>r[p.id+'_price']!==null);
      base[p.id] = first? first[p.id+'_price'] : null;
    });
    series = PROJECTS.map(p=>({name:p.name,color:p.color,
      pts: sub.map((r,i)=>({i, v: r[p.id+'_price']!==null&&base[p.id]? r[p.id+'_price']/base[p.id]*100 : null}))}));
    yfmt = v => fmtN(v,0);
    thresholds=[{v:100,label:'基准 100',color:'#4b5468'}];
  } else if(MODE==='cum'){
    let cum = {}; PROJECTS.forEach(p=>cum[p.id]=0);
    const allRows = rows;
    const start = allRows.length - sub.length;
    series = PROJECTS.map(p=>{
      let c=0; const pts=[];
      allRows.forEach((r,gi)=>{ if(gi>=start) pts.push({i:gi-start, v:(c+= (r[p.id+'_hold']||0))}); });
      // rebase to cumulative from the start of window for readability
      const first = pts.length? pts[0].v : 0;
      return {name:p.name+' 累计回购（窗口内）', color:p.color, pts: pts.map(x=>({i:x.i, v:x.v-first}))};
    });
  } else {
    series = PROJECTS.map(p=>{
      const vals = sub.map(r=>r[p.id+'_rev']);
      const filled = vals.map((v,i)=> v===null? null : (MODE==='rev7'? smaAt(vals.map(x=>x??0), i, 7) : v));
      return {name:p.name, color:p.color, pts: filled.map((v,i)=>({i, v}))};
    });
    PROJECTS.forEach(p=>thresholds.push({v:p.danger,label:p.ticker+' 止损线',color:p.color+'88'}));
  }

  const allV = series.flatMap(s=>s.pts.map(p=>p.v)).filter(v=>v!==null&&isFinite(v));
  let max = Math.max(...allV), min = MODE==='price'? Math.min(...allV) : 0;
  if(MODE!=='price'){ max = Math.max(max, ...thresholds.map(t=>t.v||0)); }
  const pad = (max-min)*0.08 || 1;
  max += pad; min = MODE==='price'? min-pad*1.5 : 0;
  const X = i => P.l + (sub.length<=1?0:(i/(sub.length-1))*iw);
  const Y = v => P.t + ih - ((v-min)/(max-min))*ih;

  let g='';
  // grid
  const TICKS=5;
  for(let k=0;k<=TICKS;k++){
    const v = min + (max-min)*k/TICKS, y = Y(v);
    g += `<line x1="${P.l}" x2="${W-P.r}" y1="${y}" y2="${y}" stroke="#1a1f2b"/>`;
    g += `<text x="${P.l-9}" y="${y+4}" fill="#5d6679" font-size="11" text-anchor="end" font-family="ui-monospace,monospace">${yfmt(v)}</text>`;
  }
  // x labels
  const step = Math.max(1, Math.round(sub.length/7));
  sub.forEach((r,i)=>{ if(i%step===0||i===sub.length-1){
    g += `<text x="${X(i)}" y="${H-9}" fill="#5d6679" font-size="10.5" text-anchor="middle">${r.date.slice(5)}</text>`;
  }});
  // thresholds
  thresholds.forEach(t=>{
    if(t.v===undefined||t.v===null) return;
    const y=Y(t.v);
    g += `<line x1="${P.l}" x2="${W-P.r}" y1="${y}" y2="${y}" stroke="${t.color}" class="warnline"/>`;
    g += `<text x="${W-P.r-4}" y="${y-5}" fill="${t.color}" font-size="10.5" text-anchor="end">${t.label}</text>`;
  });
  // series
  series.forEach(s=>{
    let d='', started=false;
    s.pts.forEach(pt=>{
      if(pt.v===null||!isFinite(pt.v)){ started=false; return; }
      d += (started?' L':'M') + X(pt.i).toFixed(1) + ' ' + Y(pt.v).toFixed(1);
      started=true;
    });
    g += `<path d="${d}" fill="none" stroke="${s.color}" stroke-width="2" stroke-linejoin="round"/>`;
    const lastPt = [...s.pts].reverse().find(p=>p.v!==null&&isFinite(p.v));
    if(lastPt){ g += `<circle cx="${X(lastPt.i)}" cy="${Y(lastPt.v)}" r="3.5" fill="${s.color}"/>`; }
  });
  svg.innerHTML = g;
  document.getElementById('legend').innerHTML = series.map(s=>
    `<span><i style="background:${s.color}"></i>${s.name}</span>`).join('') +
    (MODE==='price'?'<span style="color:var(--mut2)">起点=100</span>':'');

  // tooltip
  const tip = document.getElementById('tip');
  svg.onmousemove = e => {
    const r = svg.getBoundingClientRect();
    const relX = (e.clientX - r.left)/r.width*W;
    const i = Math.round((relX-P.l)/iw*(sub.length-1));
    if(i<0||i>=sub.length){ tip.style.display='none'; return; }
    const row = sub[i];
    let html = `<div class="d">${row.date}</div>`;
    series.forEach(s=>{
      const pt = s.pts.find(p=>p.i===i);
      if(pt && pt.v!==null && isFinite(pt.v))
        html += `<div class="r"><span style="color:${s.color}">${s.name.split(' 累计')[0]}</span><b>${MODE==='price'?fmtN(pt.v,1):fmtU(pt.v)}</b></div>`;
    });
    tip.innerHTML = html;
    tip.style.display='block';
    const px = X(i)/W*r.width;
    tip.style.left = Math.min(px+14, r.width-190)+'px';
    tip.style.top = (e.clientY - r.top - 20)+'px';
  };
  svg.onmouseleave = ()=> tip.style.display='none';
}

/* ---------- table ---------- */
function renderTable(){
  const all  = build();
  const rows = all.slice(-20).reverse();                 /* 最新一天在最上面 */
  const mx = {};
  ['pons_rev','pons_hold','stonkfun_rev','stonkfun_hold'].forEach(k=>{
    mx[k] = Math.max(1, ...rows.map(r=>+r[k]||0));
  });
  const w = (k,v)=> (!v||!isFinite(v)) ? 0 : Math.max(2, Math.round(v/mx[k]*100));
  const gc = p => p.id==='pons' ? 'pons' : 'stonk';
  const st = {}; PROJECTS.forEach(p=>{ st[p.id]=stats(all,p); });
  const priceTd = v => `<td class="mono v-px">${v?'$'+fmtN(v,4):'—'}</td>`;
  const dlt = (cur,prev)=>{                              /* 比前一天涨跌 */
    if(!cur||!prev) return '';
    const d=(cur-prev)/prev;
    if(!isFinite(d)||Math.abs(d)<0.005) return '<span class="dlt flat">–</span>';
    return '<span class="dlt '+(d>0?'up':'dn')+'">'+(d>0?'▲':'▼')+Math.abs(d*100).toFixed(0)+'%</span>';
  };
  const cell = (cl,k,v,extra)=> `<td class="mono ${cl}"><span class="bar" style="--w:${w(k,v)}%"></span><span class="v">${fmtU(v)}</span>${extra||''}</td>`;

  document.getElementById('tbl').querySelector('thead').innerHTML =
    `<tr class="grp"><th class="c-date" rowspan="2">日期</th>`+
    `<th class="g-pons" colspan="3">PONS <span style="opacity:.45;font-weight:500;letter-spacing:0">· Robinhood</span></th>`+
    `<th class="g-stonk" colspan="3">STONK <span style="opacity:.45;font-weight:500;letter-spacing:0">· Solana</span></th></tr>`+
    `<tr class="sub"><th class="g-pons">日收入</th><th class="g-pons">回购销毁</th><th class="g-pons">币价</th>`+
    `<th class="g-stonk">日收入</th><th class="g-stonk">回购销毁</th><th class="g-stonk">币价</th></tr>`;

  const sum = `<tr class="sum"><td class="mono c-date">近 7 日均</td>`+
    PROJECTS.map(p=>{
      const s=st[p.id], g='g-'+gc(p);
      return cell(g+' v-rev', p.id+'_rev',  s.avg7) +
             cell(g+' v-bb',  p.id+'_hold', s.holdSum7/7) +
             priceTd(s.psv);
    }).join('') + `</tr>`;

  const body = rows.map((r,i)=>{
    const prev = rows[i+1] || {};
    return `<tr><td class="mono c-date">${r.date}</td>`+
      cell('g-pons v-rev','pons_rev',r.pons_rev, dlt(r.pons_rev, prev.pons_rev))+
      cell('g-pons v-bb','pons_hold',r.pons_hold)+
      priceTd(r.pons_price)+
      cell('g-stonk v-rev','stonkfun_rev',r.stonkfun_rev, dlt(r.stonkfun_rev, prev.stonkfun_rev))+
      cell('g-stonk v-bb','stonkfun_hold',r.stonkfun_hold)+
      priceTd(r.stonkfun_price)+`</tr>`;
  }).join('');

  document.getElementById('tbl').querySelector('tbody').innerHTML = sum + body;
}

/* ---------- 指标说明 ---------- */
function renderGuide(){
  const rows = build();
  const A = PROJECTS[0], B = PROJECTS[1];
  const sa = stats(rows,A), sb = stats(rows,B);
  const psx = v => (v===null||v===undefined||!isFinite(v))?'—':fmtN(v,2)+'x';
  const pcy = v => (v===null||!isFinite(v))?'—':(v*100).toFixed(2)+'%';
  const wk  = s => s.vol24? s.vol24*7 : null;

  const cheaper = (sa.ps7 && sb.ps7) ? (sa.ps7<sb.ps7 ? A : B) : null;
  const dearer  = cheaper ? (cheaper.id===A.id ? B : A) : null;
  const sc = cheaper? stats(rows,cheaper) : null, sd = dearer? stats(rows,dearer) : null;
  const gap = (sc&&sd&&sc.ps7&&sd.ps7)? sd.ps7/sc.ps7 : null;

  const divLine = (p, st) => {
    if(!st.ps7 || !st.ps30) return '';
    const div = st.ps7/st.ps30;
    let cls='g-ok', txt;
    if(div > 1.5){ cls='g-bad'; txt='收入正在快速下滑 —— 最近 7 天的收入只有过去一个月平均的 '+fmtN(100/div,0)+'%'; }
    else if(div > 1.15){ cls='g-warn'; txt='收入比月均低，正在走弱'; }
    else if(div < 0.85){ txt='收入比月均高 '+(1/div).toFixed(1)+' 倍，正在加速'; }
    else { txt='收入和月均基本持平，节奏稳定'; }
    return `<div>${p.name}：7日 <b>${psx(st.ps7)}</b> vs 30日 <b>${psx(st.ps30)}</b>　→　相差 ${div.toFixed(2)} 倍<br><span class="${cls}">↳ ${txt}</span></div>`;
  };

  const item = (title, formula, lead, ex, bands, note) =>
    `<div class="gitem">
       <h3>${title}</h3>
       <div class="f">${formula}</div>
       <div class="lead">${lead}</div>
       ${ex?`<div class="ex">${ex}</div>`:''}
       ${bands?`<ul>${bands.map(b=>`<li><span class="band ${b[1]}">${b[0]}</span><span>${b[2]}</span></li>`).join('')}</ul>`:''}
       ${note?`<div class="note">${note}</div>`:''}
     </div>`;

  const ex1 = `<div class="cap">算给你看（${A.name}）</div>
    市值 ${fmtU(sa.mcap)}　÷　(7 日均收入 ${fmtU(sa.avg7)}/天 × 365 天 ＝ ${fmtU(sa.avg7*365)})
    <br>＝ <b>${psx(sa.ps7)}</b>
    <br>→ 假设收入不变，你花 ${fmtN(sa.ps7,2)} 元买它 1 年的收入，要 <b>${fmtN(sa.ps7,1)} 年</b>才回本
    <div style="margin-top:7px;padding-top:7px;border-top:1px dashed var(--line2)">对照 ${B.name}：${fmtU(sb.mcap)} ÷ ${fmtU(sb.avg7*365)} ＝ <b>${psx(sb.ps7)}</b>${gap?`　→　${cheaper.ticker} 便宜 <b>${gap.toFixed(1)} 倍</b>`:''}</div>`;

  const ex3 = `${A.name}：最近 7 日回购 ${fmtU(sa.holdSum7)} ÷ 7 日成交额 ${fmtU(wk(sa))} ＝ <b>${pcy(sa.burnForce)}</b>
    <br>${B.name}：最近 7 日回购 ${fmtU(sb.holdSum7)} ÷ 7 日成交额 ${fmtU(wk(sb))} ＝ <b>${pcy(sb.burnForce)}</b>
    <br><span style="color:var(--mut2)">↑ 两个都在 2% 以下 —— 这就是"回购了但涨不动"的直接原因</span>`;

  const ex4 = `当前：${A.name} 换手 <b>${sa.turnover!==null?(sa.turnover*100).toFixed(1)+'%':'—'}/天</b> · 回购年化 <b>${sa.burnYield!==null?fmtN(sa.burnYield*100,0)+'%':'—'}</b>
    <br>　　　${B.name} 换手 <b>${sb.turnover!==null?(sb.turnover*100).toFixed(1)+'%':'—'}/天</b> · 回购年化 <b>${sb.burnYield!==null?fmtN(sb.burnYield*100,0)+'%':'—'}</b>
    <br><span style="color:var(--mut2)">每天 1 成以上的筹码在换手 → 短线资金主导，回购对价格的影响被稀释</span>`;

  const momA = (sa.avg7-sa.avg7p)/(sa.avg7p||1), momB = (sb.avg7-sb.avg7p)/(sb.avg7p||1);
  const momTxt = (p,v) => `${p.name} <b>${(v*100).toFixed(1)}%</b>`;
  const ex5 = `${momTxt(A,momA)}　·　${momTxt(B,momB)}
    <br><span style="color:var(--mut2)">两家都在 −35% 附近 → 已越过 −25% 触发线，按规则＝暂停加仓</span>`;

  document.getElementById('guide').innerHTML =
    item('P/S 年化 —— 你花多少钱，买它一年的收入',
         'P/S ＝ 市值 ÷ (日均收入 × 365 天)',
         '数字越小越便宜，可以理解成"按现在的赚钱速度要几年回本"。它把"公司贵不贵"和"币价高低"分开看——币价低不代表便宜，要看它每年能赚多少。',
         ex1,
         [['&lt; 1.5x','g-ok','便宜 —— 安全垫厚，可分批加仓'],
          ['1.5x – 4x','','合理 —— 持有观察，不追高'],
          ['&gt; 4x','g-warn','偏贵 —— 需要收入增长来消化估值']],
         '注意：P/S 只反映"现在"，不反映"未来"。收入正在下滑时，看起来很便宜的 P/S 可能只是假象（分母迟早会变小）。')

  + item('为什么 P/S 要同时看 7 日和 30 日',
         '7 日 ＝ 最新速度　·　30 日 ＝ 近一个月平均',
         '7 日灵敏、能最早发现拐点；30 日平滑、不会被单日噪声骗。两个数字差得越大，说明收入变化越剧烈 —— 这正是判断"拐点"的关键。',
         divLine(A,sa) + '<div style="margin-top:7px;padding-top:7px;border-top:1px dashed var(--line2)">' + divLine(B,sb) + '</div>',
         null,
         '记法：7 日 P/S 明显高于 30 日 P/S ＝ 收入在掉；反过来 ＝ 收入在涨。')

  + item('回购力度 —— 回购到底有没有用',
         '回购力度 ＝ 最近 7 日回购 ÷ 最近 7 日成交额',
         '不要看"回购了多少钱"，要看它占市场成交量的比例。买盘再大，如果同期有几十倍的筹码在换手，也改变不了价格方向。这是判断回购能否托底唯一有效的口径。',
         ex3,
         [['≥ 5%','g-ok','回购足够重，能真正托住价格'],
          ['2% – 5%','g-warn','能减缓下跌，但改变不了方向'],
          ['&lt; 2%','g-bad','杯水车薪，别指望回购托底']],
         '典型对照：为什么有的币回购了还在跌？回购占成交量太低，只是给卖盘提供流动性而已。')

  + item('换手率 & 回购年化收益率',
         '换手率 ＝ 24h 成交额 ÷ 市值　·　回购年化 ＝ 7 日回购 × 52 ÷ 市值',
         '换手率告诉你筹码有多"活跃"：越高说明短线资金越多、波动越大，回购的影响也越小。回购年化告诉你：如果回购速度不变，一年能买掉市值的百分之几。',
         ex4,
         [['换手 &lt; 3%','g-ok','筹码稳定，回购效果好'],
          ['换手 3% – 8%','g-warn','偏活跃，回购效果一般'],
          ['换手 &gt; 8%','g-bad','高频换手，回购效果被稀释']],
         '重要：回购年化收益率高 ≠ 一定涨。它建立在"收入不跌"的假设上；收入一旦下滑，这个数字会跟着一起缩水。')

  + item('收入环比 —— 最灵敏的预警',
         '收入环比 ＝ 最近 7 日均收入 vs 前 7 日均收入',
         '这是所有指标里最早报警的一个。因为回购是"收入"的下游：收入 ↓ → 回购金额 ↓ → 买盘 ↓ → 价格失去支撑。盯收入，比盯回购更提前。',
         ex5,
         [['&gt; −15%','g-ok','收入平稳，维持仓位'],
          ['−15% ~ −25%','g-warn','走弱，只观察不加仓'],
          ['&lt; −25%','g-bad','骤降，暂停一切加仓']],
         null);
}

/* ---------- live ---------- */
async function fetchJSON(u){ const r=await fetch(u,{cache:'no-store'}); if(!r.ok) throw new Error(r.status); return r.json(); }
async function loadLive(){
  document.getElementById('src').textContent='拉取中…';
  document.getElementById('src').className='badge';
  let ok = true;
  try{
    const reqs=[];
    ['pons','stonkfun'].forEach(s=>['dailyRevenue','dailyHoldersRevenue','dailyFees'].forEach(dt=>
      reqs.push(fetchJSON(`https://api.llama.fi/summary/fees/${s}?dataType=${dt}`).then(j=>({k:`${s}.${dt}`, j})))));
    reqs.push(fetchJSON('https://api.llama.fi/protocol/pons').then(j=>({k:'meta.pons',j})));
    reqs.push(fetchJSON('https://api.llama.fi/protocol/stonkfun').then(j=>({k:'meta.stonkfun',j})));
    const res = await Promise.all(reqs);
    res.forEach(({k,j})=>{
      if(k.startsWith('meta.')){ DATA.meta[k.slice(5)] = {name:j.name, mcap:j.mcap, symbol:j.symbol}; }
      else { DATA.series[k] = (j.totalDataChart||[]).map(([ts,v])=>[ts, v]); }
    });
    DATA.generated = new Date().toISOString();
  }catch(e){
    ok = false;
  }
  // 成交额（CoinGecko）——单独 try，失败就沿用快照，不影响其他数据
  try{
    const j = await fetchJSON('https://api.coingecko.com/api/v3/simple/price?ids=' + Object.values(CG_IDS).join(',')
      + '&vs_currencies=usd&include_24hr_vol=true&include_market_cap=true&include_24hr_change=true');
    const mk = DATA.market || (DATA.market = {});
    Object.entries(CG_IDS).forEach(([name,cid])=>{
      const x = j[cid] || {};
      if(x.usd_24h_vol) mk[name] = {vol24h:x.usd_24h_vol, mcap:x.usd_market_cap||0, price:x.usd, change24h:x.usd_24h_change||0};
    });
  }catch(e){}
  setSrc(ok);
  renderAll();
}
function setSrc(ok){
  const b=document.getElementById('src');
  b.textContent = ok? '● 实时数据' : '● 内置快照（联网失败）';
  b.className = 'badge ' + (ok?'live':'off');
}
function renderAll(){ renderCards(); renderRules(); renderTabs(); renderChart(); renderTable(); renderGuide();
  const g = DATA.generated || BUNDLE.generated;
  document.getElementById('gen').textContent = '数据时间 ' + new Date(g).toLocaleString('zh-CN');
  document.getElementById('foot').innerHTML =
    `数据源：收入/回购＝DefiLlama（fees/revenue/holders-revenue API）；成交额/市值＝CoinGecko。Pons 收入=协议留存收入（创作者与 Uniswap 分成已扣除）；StonkFun 收入=其自留交易费（费用=收入）。`+
    `P/S 年化 = 市值 ÷ (日均收入 × 365)，越低越便宜。参照系：pump.fun 30 日收入 $4,528 万、市值 $24.6 亿 → 4.45x。<br>`+
    `规则阈值：Pons 日收入 7 日均 &lt; $10 万＝离场，&lt; $15 万＝暂停加仓；StonkFun &lt; $20 万＝离场，&lt; $28 万＝暂停加仓。`+
    `本面板仅为研究工具，不构成投资建议。`;
}
renderAll();
loadLive();
</script>
</body>
</html>
