</div>

<script>
const BUNDLE = /*__DATA__*/;

const PROJECTS = [
  { id:'pons', seriesKey:'pons', name:'Pons', ticker:'PONS', chain:'Robinhood Chain',
    color:'var(--pons)', colorDim:'var(--pons-dim)', supply:682770000, maxSupply:1000000000, burned:317230421,
    mcapFallback:365777975, burnEvent:'80% 协议费用 TWAP 回购销毁（官方注明尚未 immutable）',
    danger:100000, warn:150000, baseline:220000 },
  { id:'stonkfun', seriesKey:'stonkfun', name:'StonkFun', ticker:'STONK', chain:'Solana',
    color:'var(--stonk)', colorDim:'var(--stonk-dim)', supply:814583323, maxSupply:1000000000, burned:185416677,
    mcapFallback:207358628, burnEvent:'约 60% 平台收入公开市场回购销毁 + 生态飞轮',
    danger:200000, warn:280000, baseline:34400 }
];

const CG_IDS = {pons:'pons', stonkfun:'stonk-3'};
let DATA = JSON.parse(JSON.stringify(BUNDLE));
let MODE = 'rev7';

/* ---------- utils ---------- */
const fmtU = v => {
  if (v === null || v === undefined || isNaN(v)) return '—';
  const a = Math.abs(v);
  if (a >= 1e9) return '$' + (v/1e9).toFixed(2) + 'B';
  if (a >= 1e6) return '$' + (v/1e6).toFixed(2) + 'M';
  if (a >= 1e3) return '$' + (v/1e3).toFixed(1) + 'K';
  return '$' + v.toFixed(0);
};
const fmtN = (v,d=2) => (v===null||isNaN(v))?'—':v.toLocaleString('en-US',{minimumFractionDigits:d,maximumFractionDigits:d});
const dayKey = ts => new Date(ts*1000).toISOString().slice(0,10);
const toMap = arr => { const m={}; (arr||[]).forEach(([ts,v])=>{ const k=dayKey(ts); m[k]=(m[k]||0)+v; }); return m; };
const sortedKeys = m => Object.keys(m).sort();
const smaAt = (vals,i,n) => { if (i<n-1) return null; let s=0; for(let j=i-n+1;j<=i;j++) s+=vals[j]; return s/n; };

/* ---------- build unified daily table ---------- */
function build(){
  const rev = {}, hold = {}, fee = {}, price = {};
  PROJECTS.forEach(p=>{
    rev[p.id]  = toMap(DATA.series[p.seriesKey+'.dailyRevenue']);
    hold[p.id] = toMap(DATA.series[p.seriesKey+'.dailyHoldersRevenue']);
    fee[p.id]  = toMap(DATA.series[p.seriesKey+'.dailyFees']);
    price[p.id]= toMap(DATA.priceSeries[p.id]);
  });
  const all = new Set();
  Object.values(rev).forEach(m=>Object.keys(m).forEach(k=>all.add(k)));
  Object.values(price).forEach(m=>Object.keys(m).forEach(k=>all.add(k)));
  const days = [...all].sort();
  const rows = days.map(d=>{
    const r = { date:d };
    PROJECTS.forEach(p=>{
      r[p.id+'_rev']   = rev[p.id][d]  ?? null;
      r[p.id+'_hold']  = hold[p.id][d] ?? null;
      r[p.id+'_fee']   = fee[p.id][d]  ?? null;
      r[p.id+'_price'] = price[p.id][d] ?? null;
    });
    return r;
  });
  return rows;
}

/* ---------- stats ---------- */
function stats(rows, p){
  const rev = rows.map(r=>r[p.id+'_rev']).map(v=>v??0);
  const hold= rows.map(r=>r[p.id+'_hold']).map(v=>v??0);
  const idxValid = rows.map((r,i)=>r[p.id+'_rev']!==null?i:-1).filter(i=>i>=0);
  const last = idxValid[idxValid.length-1];
  const sum = (a,b)=>{ let s=0,n=0; for(let i=Math.max(0,a);i<=b;i++){ if(rows[i][p.id+'_rev']!==null){s+=rev[i];n++;} } return {s,n}; };
  const w7  = sum(last-6, last), w7p = sum(last-13, last-7), w30 = sum(last-29, last);
  const avg7 = w7.n? w7.s/w7.n : 0, avg7p = w7p.n? w7p.s/w7p.n : 0, avg30 = w30.n? w30.s/w30.n : 0;
  const hold7 = sum(last-6,last);
  let holdSum7=0; for(let i=Math.max(0,last-6);i<=last;i++) holdSum7 += hold[i]||0;
  const peak = Math.max(...idxValid.map(i=>rev[i]));
  const peakDay = rows[idxValid[idxValid.findIndex(i=>rev[i]===peak)]].date;
  const mcap = DATA.meta[p.id]?.mcap || p.mcapFallback;
  const priceNow = DATA.price?.[p.id] ?? rows[last][p.id+'_price'];
  const priceArr = rows.map(r=>r[p.id+'_price']).filter(v=>v!==null);
  const ath = priceArr.length? Math.max(...priceArr) : null;
  const retrace = avg7p? (avg7-avg7p)/avg7p : 0;
  // trend over last 14 valid days via linear regression on log
  const win = idxValid.slice(-14).map(i=>({x:i, y:Math.log(Math.max(rev[i],1))}));
  let slope=0;
  if(win.length>3){
    const n=win.length, mx=win.reduce((a,b)=>a+b.x,0)/n, my=win.reduce((a,b)=>a+b.y,0)/n;
    let num=0,den=0; win.forEach(w=>{num+=(w.x-mx)*(w.y-my);den+=(w.x-mx)**2;});
    slope = num/den;
  }
  // 流动性与回购力度（成交额来自 CoinGecko）
  const mk = (DATA.market || {})[p.id] || {};
  const vol24 = mk.vol24h || null;
  const turnover  = (vol24 && mcap) ? vol24/mcap : null;
  const burnForce = (vol24 && vol24>0) ? holdSum7/(vol24*7) : null;
  const burnYield = mcap>0 ? holdSum7/mcap*52 : null;
  return {last, avg7, avg7p, avg30, holdSum7, peak, peakDay, lastRev:rev[last],
    psv: priceNow, mcap, ps7: avg7>0? mcap/(avg7*365):null, ps30: avg30>0? mcap/(avg30*365):null,
    retrace, slope, ath, priceArr, burnPct: p.burned/p.maxSupply, rows,
    vol24, volChange: (mk.change24h ?? null), turnover, burnForce, burnYield};
}

/* ---------- render cards ---------- */
function renderCards(){
  const rows = build();
  const el = document.getElementById('cards');
  el.innerHTML = PROJECTS.map(p=>{
    const s = stats(rows,p);
    const d = (s.avg7-s.avg7p)/(s.avg7p||1);
    const status = s.avg7 < p.danger ? ['bad','收入已跌破止损线，退出观察']
                 : s.avg7 < p.warn   ? ['warn','收入低于警戒线，暂停加仓']
                 : (d<-0.25)         ? ['warn','收入环比骤降，只观察不动手']
                 : (d>0.05)          ? ['good','收入企稳回升，可考虑分批加仓']
                 : ['good','收入横盘企稳，持有观察'];
    const pct = v => v===null||isNaN(v)? '—' : (v>=0?'+':'')+(v*100).toFixed(1)+'%';
    const dd = s.ath? (s.psv-s.ath)/s.ath : null;
    return `<div class="card">
      <div class="proj-head">
        <div>
          <div class="proj-name"><span class="dot" style="background:${p.color};color:${p.color}"></span>${p.name}<span class="tick">${p.ticker}</span></div>
          <div style="color:var(--mut);font-size:11.5px;margin-top:3px">${p.chain} · 已销毁 ${(s.burnPct*100).toFixed(1)}% (${fmtN(p.burned/1e6,1)}M ${p.ticker})</div>
        </div>
        <div class="price">
          <div class="p mono">$${fmtN(s.psv,4)}</div>
          <div class="m">市值 ${fmtU(s.mcap)}</div>
          <div class="pill ${dd>=0?'up':'down'}">距 ATH ${pct(dd)}</div>
        </div>
      </div>
      <div class="kv">
        <div><div class="k">7 日均收入</div><div class="v">${fmtU(s.avg7)}<small> /天</small></div></div>
        <div><div class="k">环比上 7 日</div><div class="v" style="color:${d>=0?'var(--up)':'var(--down)'}">${pct(d)}</div></div>
        <div><div class="k">最新单日收入</div><div class="v">${fmtU(s.lastRev)}</div></div>
        <div><div class="k">单日收入峰值</div><div class="v">${fmtU(s.peak)}</div></div>
        <div title="市值 ÷ 一年收入，越小越便宜"><div class="k">P/S 年化 (7日) <span class="qi">?</span></div><div class="v">${s.ps7?fmtN(s.ps7,2)+'x':'—'}</div></div>
        <div title="用 30 日均收入算的 P/S，比 7 日平滑"><div class="k">P/S 年化 (30日) <span class="qi">?</span></div><div class="v">${s.ps30?fmtN(s.ps30,2)+'x':'—'}</div></div>
        <div><div class="k">距收入峰值</div><div class="v" style="color:var(--down)">${s.peak?((s.lastRev-s.peak)/s.peak*100).toFixed(0)+'%':'—'}</div></div>
        <div title="7 日回购 × 52 ÷ 市值：一年能买掉市值的百分之几"><div class="k">回购年化收益率 <span class="qi">?</span></div><div class="v">${s.burnYield!==null?fmtN(s.burnYield*100,0)+'%':'—'}</div></div>
        <div><div class="k">最近 7 日回购</div><div class="v">${fmtU(s.holdSum7)}</div></div>
        <div title="最近 7 日回购 ÷ 最近 7 日成交额：≥5% 才算有效买盘"><div class="k">回购力度 <span class="qi">?</span></div><div class="v" style="color:${s.burnForce===null?'inherit':s.burnForce>=0.05?'var(--up)':s.burnForce>=0.02?'var(--warn)':'var(--down)'}">${s.burnForce===null?'—':(s.burnForce*100).toFixed(2)+'%'}</div></div>
        <div title="24 小时成交额"><div class="k">24h 成交额</div><div class="v">${fmtU(s.vol24)}</div></div>
        <div title="24h 成交额 ÷ 市值：一天有百分之几的筹码换手"><div class="k">日换手率 <span class="qi">?</span></div><div class="v">${s.turnover!==null?(s.turnover*100).toFixed(1)+'%':'—'}</div></div>
      </div>
      <div class="status ${status[0]}"><span class="lbl">${status[0]==='bad'?'● 危险':status[0]==='warn'?'● 警戒':'● 正常'}</span><span>${status[1]}</span></div>
    </div>`;
  }).join('');
}

/* ---------- rules（同一规则左右对比） ---------- */
const LV_TXT = {ok:'正常', warn:'警戒', bad:'危险'};
const DIMS = [
  {key:'floor', short:'止损', label:'收入是否跌破止损线', hint:'7 日均低于离场线＝该走'},
  {key:'mom',   short:'环比', label:'收入环比是否骤降',   hint:'连续下跌是最早的坏消息'},
  {key:'burn',  short:'回购', label:'回购是否持续',       hint:'回购停＝最重要的离场信号'},
  {key:'burnpower', short:'力度', label:'回购能不能托住价格', hint:'回购 ÷ 成交额，＜2% 基本可忽略'},
  {key:'ps',    short:'估值', label:'估值贵不贵（P/S）',  hint:'越低越便宜'}
];
const V_LABEL = {floor:'缓冲更厚', mom:'更抗跌', burn:'更积极', burnpower:'回购占比更高', ps:'更便宜'};

function ruleItems(rows, p){
  const s = stats(rows,p);
  const d = (s.avg7-s.avg7p)/(s.avg7p||1);
  const ps = s.ps7;
  const it = {};
  let lvl, act;

  if(s.avg7 < p.danger){ lvl='bad'; act='已跌破离场线：建议分批减仓或清仓，不要补仓'; }
  else if(s.avg7 < p.warn){ lvl='warn'; act='低于警戒线：暂停加仓，每天盯住这条线'; }
  else { lvl='ok'; act=`高出警戒线 ${fmtN((s.avg7-p.warn)/p.warn*100,0)}%，可继续持有`; }
  it.floor = {level:lvl, act, score:(s.avg7-p.danger)/p.danger,
    s:`7 日均 ${fmtU(s.avg7)}/天　·　离场线 ${fmtU(p.danger)}　·　警戒线 ${fmtU(p.warn)}`};

  if(d < -0.25){ lvl='bad'; act='环比骤降超 25%：暂停一切加仓，等连续 3 天回升再考虑'; }
  else if(d < -0.15){ lvl='warn'; act='环比走弱：只观察、不加仓'; }
  else if(d > 0.05){ lvl='ok'; act='环比回升：可考虑分批加仓'; }
  else { lvl='ok'; act='环比平稳：维持现有仓位'; }
  it.mom = {level:lvl, act, score:d,
    s:`本周 vs 上周 ${(d*100).toFixed(1)}%　·　触发线 −25%`};

  const burnRatio = s.avg7>0? s.holdSum7/(s.avg7*7) : 0;
  if(s.holdSum7 <= 0){ lvl='bad'; act='回购已停止：先减仓，等回购恢复再谈加仓'; }
  else { lvl='ok'; act=`回购在持续，7 日回购≈同期收入的 ${(burnRatio*100).toFixed(0)}%`; }
  it.burn = {level:lvl, act, score:burnRatio,
    s:`最近 7 日回购 ${fmtU(s.holdSum7)}　·　${p.burnEvent}`};

  const bf = s.burnForce;
  if(bf===null||!isFinite(bf)){ lvl='warn'; act='缺少成交额数据，无法判断回购的影响力'; }
  else if(bf >= 0.05){ lvl='ok';   act=`回购占成交额 ${(bf*100).toFixed(1)}%：买盘足够重，能真正托住价格`; }
  else if(bf >= 0.02){ lvl='warn'; act=`回购占成交额 ${(bf*100).toFixed(1)}%：能减缓下跌，但改变不了方向`; }
  else {               lvl='bad';  act=`回购只占成交额 ${(bf*100).toFixed(2)}%：杯水车薪，别指望回购托底`; }
  it.burnpower = {level:lvl, act, score:(bf===null||!isFinite(bf))? null : bf,
    s:`最近 7 日回购 ${fmtU(s.holdSum7)} ÷ 7 日成交额 ${fmtU(s.vol24? s.vol24*7 : null)}　·　≥5% 才算有效买盘`};

  if(ps===null||!isFinite(ps)){ lvl='warn'; act='没有收入数据，暂时无法估值'; }
  else if(ps < 1.5){ lvl='ok'; act=`${fmtN(ps,2)}x 便宜：安全垫厚，可分批加仓`; }
  else if(ps <= 4){ lvl='ok'; act=`${fmtN(ps,2)}x 合理：持有观察，不追高`; }
  else { lvl='warn'; act=`${fmtN(ps,2)}x 偏贵：不追高，等回调或收入涨上来`; }
  it.ps = {level:lvl, act, score:(ps===null||!isFinite(ps))? null : -ps,
    s:`P/S 年化(7日) ${ps===null||!isFinite(ps)?'—':fmtN(ps,2)+'x'}　·　&lt;1.5x 便宜 · &gt;4x 偏贵　·　参照 pump.fun 4.45x`};

  return {s, d, it, ok:Object.values(it).filter(x=>x.level==='ok').length};
}

function renderRules(){
  const rows = build();
  const A = PROJECTS[0], B = PROJECTS[1];
  const ra = ruleItems(rows, A), rb = ruleItems(rows, B);

  const verdict = {};
  DIMS.forEach(dim=>{
    const x = ra.it[dim.key].score, y = rb.it[dim.key].score;
    if(x===null||y===null||!isFinite(x)||!isFinite(y)){ verdict[dim.key]={text:'数据不足', tie:true}; return; }
    const rel = Math.abs(x-y)/(Math.abs(x)+Math.abs(y)||1);
    if(rel < 0.10){ verdict[dim.key]={text:'两家基本打平', tie:true}; return; }
    const w = x>y ? A : B;
    verdict[dim.key] = {text:`${w.ticker} ${V_LABEL[dim.key]}`, tie:false};
  });

  const card = (p, item) =>
    `<div class="rule ${item.level}">
       <div class="rtop"><span class="tag ${item.level}">${LV_TXT[item.level]}</span><span class="pname" style="color:${p.color}">● ${p.name}</span></div>
       <div class="s">${item.s}</div>
       <div class="act ${item.level}">建议：${item.act}</div>
     </div>`;

  const head = `<div class="cmp-head">
      <div class="col"><span class="dot" style="background:${A.color};color:${A.color}"></span>${A.name}<span class="tick">${A.ticker}</span><span class="cnt">${ra.ok}/${Object.keys(ra.it).length} 条正常</span></div>
      <div class="col"><span class="dot" style="background:${B.color};color:${B.color}"></span>${B.name}<span class="tick">${B.ticker}</span><span class="cnt">${rb.ok}/${Object.keys(rb.it).length} 条正常</span></div>
    </div>`;

  const body = DIMS.map((dim,i)=>{
    const v = verdict[dim.key];
    return `<div class="cmp-row">
      <div class="cmp-label"><b>${i+1}. ${dim.label}</b><span class="hint">${dim.hint}</span>
        <span class="verdict${v.tie?'':' win'}">对比：${v.text}</span></div>
      <div class="cmp-pair">${card(A, ra.it[dim.key])}${card(B, rb.it[dim.key])}</div>
    </div>`;
  }).join('');

  const summary = DIMS.map(d=>`${d.short} ${verdict[d.key].text}`).join('　·　');
  const cheaper = (ra.s.ps7 && rb.s.ps7) ? (ra.s.ps7 < rb.s.ps7 ? A : B) : null;
  const action = cheaper
    ? `资金优先级：${cheaper.ticker}（P/S 更低、安全垫更厚）；另一方等环比止跌、估值回落再考虑加仓。`
    : '数据不足，暂不给资金优先级建议。';

  document.getElementById('rules').innerHTML = head + body +
    `<div class="cmp-row">
      <div class="cmp-label"><b>综合结论</b></div>
      <div class="rule sum"><div class="s">${summary}</div><div class="act">${action}</div></div>
    </div>`;
}

/* ---------- chart ---------- */
const TABS = [
  {id:'rev',  label:'日收入'},
  {id:'rev7', label:'7 日均线收入'},
  {id:'cum',  label:'累计回购销毁'},
  {id:'price',label:'价格对比（归一）'}
];
function renderTabs(){
  document.getElementById('tabs').innerHTML = TABS.map(t=>
    `<div class="tab ${t.id===MODE?'on':''}" onclick="MODE='${t.id}';renderTabs();renderChart()">${t.label}</div>`).join('');
}
function renderChart(){
  const rows = build();
  const N = MODE==='price'? 90 : 60;
  const sub = rows.slice(-N);
  const svg = document.getElementById('chart');
  const W=1200,H=340, P={l:64,r:16,t:14,b:30};
  const iw = W-P.l-P.r, ih = H-P.t-P.b;
  let series=[], thresholds=[], yfmt = fmtU;

  if(MODE==='price'){
    let base = {};
    PROJECTS.forEach(p=>{
      const first = sub.find(r=>r[p.id+'_price']!==null);
      base[p.id] = first? first[p.id+'_price'] : null;
    });
    series = PROJECTS.map(p=>({name:p.name,color:p.color,
      pts: sub.map((r,i)=>({i, v: r[p.id+'_price']!==null&&base[p.id]? r[p.id+'_price']/base[p.id]*100 : null}))}));
    yfmt = v => fmtN(v,0);
    thresholds=[{v:100,label:'基准 100',color:'var(--mut2)'}];
  } else if(MODE==='cum'){
    let cum = {}; PROJECTS.forEach(p=>cum[p.id]=0);
    const allRows = rows;
    const start = allRows.length - sub.length;
    series = PROJECTS.map(p=>{
      let c=0; const pts=[];
      allRows.forEach((r,gi)=>{ if(gi>=start) pts.push({i:gi-start, v:(c+= (r[p.id+'_hold']||0))}); });
      // rebase to cumulative from the start of window for readability
      const first = pts.length? pts[0].v : 0;
      return {name:p.name+' 累计回购（窗口内）', color:p.color, pts: pts.map(x=>({i:x.i, v:x.v-first}))};
    });
  } else {
    series = PROJECTS.map(p=>{
      const vals = sub.map(r=>r[p.id+'_rev']);
      const filled = vals.map((v,i)=> v===null? null : (MODE==='rev7'? smaAt(vals.map(x=>x??0), i, 7) : v));
      return {name:p.name, color:p.color, pts: filled.map((v,i)=>({i, v}))};
    });
    PROJECTS.forEach(p=>thresholds.push({v:p.danger,label:p.ticker+' 止损线',color:p.colorDim}));
  }

  const allV = series.flatMap(s=>s.pts.map(p=>p.v)).filter(v=>v!==null&&isFinite(v));
  let max = Math.max(...allV), min = MODE==='price'? Math.min(...allV) : 0;
  if(MODE!=='price'){ max = Math.max(max, ...thresholds.map(t=>t.v||0)); }
  const pad = (max-min)*0.08 || 1;
  max += pad; min = MODE==='price'? min-pad*1.5 : 0;
  const X = i => P.l + (sub.length<=1?0:(i/(sub.length-1))*iw);
  const Y = v => P.t + ih - ((v-min)/(max-min))*ih;

  let g='';
  // grid
  const TICKS=5;
  for(let k=0;k<=TICKS;k++){
    const v = min + (max-min)*k/TICKS, y = Y(v);
    g += `<line x1="${P.l}" x2="${W-P.r}" y1="${y}" y2="${y}" style="stroke:var(--grid)"/>`;
    g += `<text x="${P.l-9}" y="${y+4}" style="fill:var(--mut2)" font-size="11" text-anchor="end" font-family="ui-monospace,monospace">${yfmt(v)}</text>`;
  }
  // x labels
  const step = Math.max(1, Math.round(sub.length/7));
  sub.forEach((r,i)=>{ if(i%step===0||i===sub.length-1){
    g += `<text x="${X(i)}" y="${H-9}" style="fill:var(--mut2)" font-size="10.5" text-anchor="middle">${r.date.slice(5)}</text>`;
  }});
  // thresholds
  thresholds.forEach(t=>{
    if(t.v===undefined||t.v===null) return;
    const y=Y(t.v);
    g += `<line x1="${P.l}" x2="${W-P.r}" y1="${y}" y2="${y}" style="stroke:${t.color}" class="warnline"/>`;
    g += `<text x="${W-P.r-4}" y="${y-5}" style="fill:${t.color}" font-size="10.5" text-anchor="end">${t.label}</text>`;
  });
  // series
  series.forEach(s=>{
    let d='', started=false;
    s.pts.forEach(pt=>{
      if(pt.v===null||!isFinite(pt.v)){ started=false; return; }
      d += (started?' L':'M') + X(pt.i).toFixed(1) + ' ' + Y(pt.v).toFixed(1);
      started=true;
    });
    g += `<path d="${d}" fill="none" style="stroke:${s.color}" stroke-width="2" stroke-linejoin="round"/>`;
    const lastPt = [...s.pts].reverse().find(p=>p.v!==null&&isFinite(p.v));
    if(lastPt){ g += `<circle cx="${X(lastPt.i)}" cy="${Y(lastPt.v)}" r="3.5" style="fill:${s.color}"/>`; }
  });
  svg.innerHTML = g;
  document.getElementById('legend').innerHTML = series.map(s=>
    `<span><i style="background:${s.color}"></i>${s.name}</span>`).join('') +
    (MODE==='price'?'<span style="color:var(--mut2)">起点=100</span>':'');

  // tooltip
  const tip = document.getElementById('tip');
  svg.onmousemove = e => {
    const r = svg.getBoundingClientRect();
    const relX = (e.clientX - r.left)/r.width*W;
    const i = Math.round((relX-P.l)/iw*(sub.length-1));
    if(i<0||i>=sub.length){ tip.style.display='none'; return; }
    const row = sub[i];
    let html = `<div class="d">${row.date}</div>`;
    series.forEach(s=>{
      const pt = s.pts.find(p=>p.i===i);
      if(pt && pt.v!==null && isFinite(pt.v))
        html += `<div class="r"><span style="color:${s.color}">${s.name.split(' 累计')[0]}</span><b>${MODE==='price'?fmtN(pt.v,1):fmtU(pt.v)}</b></div>`;
    });
    tip.innerHTML = html;
    tip.style.display='block';
    const px = X(i)/W*r.width;
    tip.style.left = Math.min(px+14, r.width-190)+'px';
    tip.style.top = (e.clientY - r.top - 20)+'px';
  };
  svg.onmouseleave = ()=> tip.style.display='none';
}

