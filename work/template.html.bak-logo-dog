  hourSub:'每小时一格：交易量 / 收入 / 销毁，看得出现在是热还是冷。',
  hourTabVol:'交易量', hourTabRev:'收入', hourTabBurn:'销毁',
  hourH1:'最近 1 小时', hourH6:'最近 6 小时', hourH24:'最近 24 小时', hourH72:'最近 72 小时',
  hourLive:'● 实时刷新', hourLiveOff:'● 页面快照（实时刷新失败）',
  hourNow:'当前小时', hourPick:'选中', hourOngoing:'进行中',
  hourNoData:'还没攒到',
  hourSpan:'断档回填 · 估算',
  hourSpanNote:'其中 {n} 小时是官方累计值断档后按均值回填的（斜纹柱，估算值），其余为逐小时实测。',
  hourEst:'推算', hourChain:'链上', hourOfficial:'官方', hourEach:'每小时一根柱：左 PONS · 右 StonkFun',
  hourNoteVol:'<b>交易量</b>：PONS/WETH、STONK/SOL 两个主流池的每小时成交额（GeckoTerminal 小时线）。成交量放大说明短线资金在进场，缩下去说明热度在退——这是判断"有没有人在玩"的最快指标。',
  hourNoteRev:'<b>收入</b>：Pons 这一列是<b>链上推算</b>——每小时回购花掉的钱 ÷ 80%（Pons 公开口径：80% 收入用于回购）；StonkFun 是<b>官方接口真值</b>——直接读 stonkfun.xyz 官方累计收入，逐小时做差，不再靠猜。<b>注意</b>：官方累计值是按批结算的，个别小时的柱子会忽高忽低，看 6h / 24h 合计更稳。',
  hourNoteBurn:'<b>销毁</b>：Pons 按小时统计打进死地址的 PONS，<b>链上可对账</b>（约每 15 分钟一笔）；StonkFun 用<b>官方累计销毁量</b>逐小时做差，和平台自己页面同一个数据源。',
  /* —— 市场占有率（v3.14）：DefiLlama DEX 同源口径 —— */
  secShare:'市场占有率 · 24 小时成交量份额',
  shareLive:'● 每小时更新',
  shareSub:u=>'口径：DefiLlama · DEX 成交量（分子＝平台，分母＝所在链全部 DEX）'+(u?' · 抓取 '+u:''),
  shOfChain:'占全链 DEX 成交量',
  shChainVol:'全链总量',
  shRank:'链上排名',
  sh7d:'近 7 日',
  sh14d:'近 14 天占比',
  shPumpMark:'pump.fun 全链占比',
  shVsT:'对阵 Solana 龙头 pump.fun',
  shVsSub:'同一把尺子：DefiLlama 24h 成交量',
  shVsLine:(r,ps,mult)=>'StonkFun 成交量 = pump.fun 的 <b>'+r+'</b>；pump.fun 一家占全链 <b>'+ps+'</b>，是我们的 <b>'+mult+'</b>。',
  shareNoteH:'这块数字怎么读',
  shareNote:'<b>占比</b> ＝ 本品 24h 成交量 ÷ 所在链全部 DEX 成交量（DefiLlama 口径，每小时更新）。链越大分母越大，占比天然越小 —— <b>看趋势（近 14 天）和跟龙头的差距，比看绝对值有用</b>。口径提醒：本模块是「协议」口径（平台所有交易对加总），与上方小时监控的「单一池子」口径不同，两个数字不要互相加减。',
  /* —— 销毁里程碑（v3.15）：参考 stonk.fyi 的 milestone 卡 —— */
  secMilestone:'销毁里程碑 · 离下一个整数关口还有多久',
  msLive:'● 每小时更新',
  msSub:(f,r)=> f? f+' 的销毁速度约是另一家的 '+r+' 倍（口径：每天烧掉总量的百分之几）' : '两家的销毁数据都在持续累积',
  msStamp:'快照 ',
  msBurned:'已销毁',
  msBurnQty:'已销毁数量',
  msSupplyTxt:'总量 10 亿',
