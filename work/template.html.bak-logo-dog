<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>/* 主题：先于渲染应用，避免闪屏 */
(function(){try{var t=localStorage.getItem("pons-theme")||"auto";
if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t);}catch(e){}})();
</script>
<title>Pons / StonkFun 收入与回购监控面板</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,">
<link rel="icon" type="image/png" sizes="32x32" href="data:image/png;base64,">
<link rel="apple-touch-icon" sizes="180x180" href="data:image/png;base64,">
<meta name="theme-color" content="#0a0c11">
<style>
/* ============================================================================
   内嵌字体 v3.12 · Inter 可变字体（拉丁子集 · 100~900 全字重 · 原始 48KB）
   来源：@fontsource-variable/inter — SIL Open Font License 1.1，免费商用。
   为什么内嵌：本站是「单文件应用」，而 nginx 对整站 no-cache —— 外链字体会变成
   每次打开都重新下载；内嵌后零额外请求、零白屏，且三端字形完全一致。
   中文为什么不走这里：Inter 不含中日韩字形，浏览器会自动回退到后面的系统中文栈
   （苹方 / 鸿蒙 Sans / MiSans / 思源黑 / 雅黑 UI）—— 这是中英混排的标准做法。
   回退方法：删掉这段 @font-face，并把 --font-ui 开头的 "Inter", 去掉即可。
   ============================================================================ */
@font-face{font-family:"Inter";font-style:normal;font-weight:100 900;font-display:swap;
  src:url(data:font/woff2;base64,) format("woff2")}
:root{
  color-scheme:dark;
  --bg:#0a0c11; --glow:rgba(139,124,255,.15); --glow2:rgba(46,230,168,.06);
  --panel:#11141c; --panel2:#161a24; --panel3:#1c2230;
  --line:#212736; --line2:#2c3446; --grid:#1a1f2b;
  --txt:#e9ecf3; --mut:#858ea1; --mut2:#737d90;
  --up:#2ee6a8; --down:#ff5c72; --warn:#ffb020;
  --pons:#8b7cff; --stonk:#2ee6a8;
  --pons-dim:rgba(139,124,255,.55); --stonk-dim:rgba(46,230,168,.55);
  --accent:#8b7cff;
  --ok-bg:#0d2b22; --ok-line:#1c5443; --ok-txt:#7ff0c6;
  --wn-bg:#2b210d; --wn-line:#5c451a; --wn-txt:#ffd68a;
  --bd-bg:#2b0d13; --bd-line:#5c1a24; --bd-txt:#ff9aa8;
  --tip-bg:rgba(13,16,23,.94);
  --card-shadow:inset 0 1px 0 rgba(255,255,255,.055),0 1px 2px rgba(0,0,0,.45),0 18px 40px -32px rgba(0,0,0,.95);
  --card-sheen:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,0) 78px);
  --stick-shadow:0 20px 46px -30px rgba(0,0,0,.95),inset 0 1px 0 rgba(255,255,255,.05);
  --author-glow:linear-gradient(115deg,rgba(139,124,255,.17),rgba(46,230,168,.09) 58%,transparent);
  --cta-bg:#fff; --cta-fg:#0a0c11;
  --cta-shadow:0 6px 20px rgba(0,0,0,.45);
}
/* 浅色 · 手动切换 */
:root[data-theme="light"]{
  color-scheme:light;
  --bg:#f5f7fb; --glow:rgba(98,73,232,.10); --glow2:rgba(13,155,115,.055);
  --panel:#ffffff; --panel2:#f7f9fd; --panel3:#eef2f9;
  --line:#e6eaf2; --line2:#d3dae7; --grid:#e9edf5;
  --txt:#0f1420; --mut:#5d6779; --mut2:#666f7f;
  --up:#0d9b73; --down:#dc2f4e; --warn:#b97a00;
  --pons:#6249e8; --stonk:#0d9b73;
  --pons-dim:rgba(98,73,232,.45); --stonk-dim:rgba(13,155,115,.45);
  --accent:#6249e8;
  --ok-bg:#e9f8f2; --ok-line:#b9e6d5; --ok-txt:#0a7357;
  --wn-bg:#fdf4e4; --wn-line:#f0dcb4; --wn-txt:#8f5e00;
  --bd-bg:#fdeef1; --bd-line:#f6ccd5; --bd-txt:#b01e39;
  --tip-bg:rgba(255,255,255,.97);
  --card-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 1px 2px rgba(16,24,40,.05),0 14px 30px -22px rgba(16,24,40,.25);
  --card-sheen:none;
  --stick-shadow:0 18px 38px -28px rgba(16,24,40,.6),inset 0 1px 0 rgba(255,255,255,.9);
  --author-glow:linear-gradient(115deg,rgba(98,73,232,.10),rgba(13,155,115,.07) 58%,transparent);
  --cta-bg:#0f1420; --cta-fg:#ffffff;
  --cta-shadow:0 6px 18px rgba(16,24,40,.25);
}
/* 浅色 · 跟随系统（未手动指定时生效） */
@media (prefers-color-scheme:light){
:root:not([data-theme="dark"]):not([data-theme="light"]){
  color-scheme:light;
  --bg:#f5f7fb; --glow:rgba(98,73,232,.10); --glow2:rgba(13,155,115,.055);
  --panel:#ffffff; --panel2:#f7f9fd; --panel3:#eef2f9;
  --line:#e6eaf2; --line2:#d3dae7; --grid:#e9edf5;
  --txt:#0f1420; --mut:#5d6779; --mut2:#666f7f;
  --up:#0d9b73; --down:#dc2f4e; --warn:#b97a00;
  --pons:#6249e8; --stonk:#0d9b73;
  --pons-dim:rgba(98,73,232,.45); --stonk-dim:rgba(13,155,115,.45);
  --accent:#6249e8;
  --ok-bg:#e9f8f2; --ok-line:#b9e6d5; --ok-txt:#0a7357;
  --wn-bg:#fdf4e4; --wn-line:#f0dcb4; --wn-txt:#8f5e00;
  --bd-bg:#fdeef1; --bd-line:#f6ccd5; --bd-txt:#b01e39;
  --tip-bg:rgba(255,255,255,.97);
  --card-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 1px 2px rgba(16,24,40,.05),0 14px 30px -22px rgba(16,24,40,.25);
  --card-sheen:none;
  --stick-shadow:0 18px 38px -28px rgba(16,24,40,.6),inset 0 1px 0 rgba(255,255,255,.9);
  --author-glow:linear-gradient(115deg,rgba(98,73,232,.10),rgba(13,155,115,.07) 58%,transparent);
  --cta-bg:#0f1420; --cta-fg:#ffffff;
  --cta-shadow:0 6px 18px rgba(16,24,40,.25);
}
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--txt);
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro SC","PingFang SC","Segoe UI",Roboto,sans-serif;
  font-size:var(--fs-12);line-height:1.55;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;
  font-variant-numeric:tabular-nums;transition:background .25s ease,color .25s ease}
body::before{content:"";position:fixed;left:0;right:0;top:0;height:360px;pointer-events:none;z-index:0;
  background:radial-gradient(780px 360px at 50% -110px,var(--glow),transparent 72%)}
.wrap{position:relative;z-index:1;max-width:1400px;margin:0 auto;padding:18px 20px 64px}
.mono{font-family:var(--font-mono)}

/* ---------- 页头 ---------- */
header{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:var(--sp-card)}
h1{font-size:var(--fs-16);margin:0;font-weight:600;letter-spacing:-.1px}
h1 span{color:var(--mut);font-weight:400;font-size:var(--fs-11);margin-left:9px;letter-spacing:0}
.hdr-right{display:flex;align-items:center;gap:8px}
.badge{font-size:var(--fs-11);padding:4px 11px;border-radius:var(--r-pill);border:1px solid var(--line2);
  color:var(--mut);white-space:nowrap;background:var(--panel)}
.badge.live{color:var(--ok-txt);border-color:var(--ok-line);background:var(--ok-bg)}
.badge.off{color:var(--wn-txt);border-color:var(--wn-line);background:var(--wn-bg)}
button{background:var(--panel2);color:var(--txt);border:1px solid var(--line2);border-radius:var(--r-md);
  padding:6px 12px;font-size:var(--fs-12);cursor:pointer;font-family:inherit;font-variant-numeric:inherit;
  transition:background .15s,border-color .15s,transform .08s}
button:hover{background:var(--panel3)}
button:active{transform:translateY(1px)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

/* ---------- 安全说明条（原「只读数据面板…」一行）----------
   之前这一行没有任何样式：贴着页头、又和下方卡片贴成 0 间距。v3.8 起做成一条
   克制的信任提示条：绿色细边 = 安全语义，只在左缘点一笔，不抢主体卡片。 */
.safe-line{position:relative;display:flex;align-items:center;gap:9px;flex-wrap:wrap;
  margin:0 0 var(--sp-card);padding:10px 15px 10px 18px;border-radius:var(--r-md);
  font-size:var(--fs-11);line-height:1.75;color:var(--mut);letter-spacing:.1px;
  background:linear-gradient(90deg,color-mix(in srgb,var(--up) 10%,transparent),transparent 62%),var(--panel);
  border:1px solid var(--line)}
.safe-line::before{content:"";position:absolute;left:0;top:9px;bottom:9px;width:3px;
  border-radius:0 var(--r-xs) var(--r-xs) 0;background:var(--up);opacity:.62}
.safe-line .sf-ic{flex:0 0 auto;font-size:var(--fs-12);line-height:1}
.safe-line b{color:var(--txt);font-weight:700}
.safe-line .sf-sep{color:var(--line2)}

/* ---------- 栅格与卡片 ---------- */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-card)}
.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r-lg);padding:15px 16px;
  box-shadow:var(--card-shadow)}
.card,.rule,.gitem,.chartbox,.cmp-head .col{transition:background .25s ease,border-color .25s ease}

.proj-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:var(--sp-block)}
.proj-name{display:flex;align-items:center;flex-wrap:wrap;gap:9px;row-gap:6px;font-size:var(--fs-14);font-weight:600;letter-spacing:-.1px}
/* 小圆点 = 实时状态灯（v3.7）：呼吸微缩放 + 双层雷达扩散圈，颜色跟随代币主色 currentColor */
.dot{width:9px;height:9px;border-radius:50%;flex:0 0 auto;position:relative;display:inline-block;
  box-shadow:0 0 10px currentColor;animation:dotBreath 2.8s ease-in-out infinite;will-change:transform}
.dot::before,.dot::after{content:"";position:absolute;inset:0;border-radius:50%;background:currentColor;
  pointer-events:none;will-change:transform,opacity}
.dot::before{animation:dotPing 2.8s cubic-bezier(.25,.55,.35,1) infinite}
.dot::after{animation:dotPing 2.8s cubic-bezier(.25,.55,.35,1) infinite;animation-delay:1.4s}
@keyframes dotBreath{0%,100%{transform:scale(1)}50%{transform:scale(1.18)}}
@keyframes dotPing{0%{transform:scale(1);opacity:.5}70%{opacity:.12}100%{transform:scale(2.7);opacity:0}}
@media (prefers-reduced-motion:reduce){.dot,.dot::before,.dot::after{animation:none}}
.tick{font-size:var(--fs-11);color:var(--mut);background:var(--panel2);border:1px solid var(--line2);
  padding:2px 7px;border-radius:var(--r-sm)}
.price{text-align:right}
.price .p{font-size:20px;font-weight:600;letter-spacing:-.5px}
.price .m{font-size:var(--fs-11);color:var(--mut)}
.pill{display:inline-block;font-size:var(--fs-11);padding:2px 8px;border-radius:var(--r-sm);margin-top:4px;font-weight:600}
.pill.up{background:var(--ok-bg);color:var(--up)}
.pill.down{background:var(--bd-bg);color:var(--down)}
/* 卡片副标题（链名 · 销毁）：桌面一行；窄屏拆成两行，括号整块不拆开（2026-10-06） */
.pmeta{color:var(--mut);font-size:var(--fs-11);margin-top:3px;line-height:1.6}
.pmeta .pch::after{content:" · "}
.pmeta .pbn{white-space:nowrap}
@media(max-width:680px){
  .pmeta .pch{display:block}
  .pmeta .pch::after{content:""}
  .pmeta .pbn{display:block}
}

/* ---------- 指标格 ---------- */
.kv{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);
  border:1px solid var(--line);border-radius:var(--r-md);overflow:hidden;margin-bottom:var(--sp-block)}
.kv>div{background:var(--panel2);padding:9px 11px}
.kv .k{font-size:var(--fs-10);color:var(--mut);margin-bottom:4px;letter-spacing:.2px}
.kv .v{font-size:var(--fs-14);font-weight:600;letter-spacing:-.2px}
.kv .v small{font-size:var(--fs-10);color:var(--mut);font-weight:400;letter-spacing:0}
.kv .qi{display:inline-block;width:11px;height:11px;line-height:11px;text-align:center;border-radius:50%;
  background:var(--panel3);border:1px solid var(--line2);color:var(--mut);font-size:var(--fs-10);
  cursor:pointer;vertical-align:1px;font-weight:700;text-decoration:none;
  transition:color .18s ease,background .18s ease,border-color .18s ease}
.kv .qi:hover,.kv .qi:focus-visible{color:var(--accent);
  border-color:color-mix(in srgb,var(--accent) 45%,var(--line2));
  background:color-mix(in srgb,var(--accent) 14%,var(--panel3));outline:none}

/* ---------- 状态条 ---------- */
.status{border-radius:var(--r-md);padding:9px 12px;font-size:var(--fs-12);display:flex;align-items:center;gap:9px;border:1px solid}
.status.good{background:var(--ok-bg);border-color:var(--ok-line);color:var(--ok-txt)}
.status.warn{background:var(--wn-bg);border-color:var(--wn-line);color:var(--wn-txt)}
.status.bad{background:var(--bd-bg);border-color:var(--bd-line);color:var(--bd-txt)}
.status .lbl{font-weight:600}

/* ---------- 段落标题（右侧引一条细线） ---------- */
.sec-title{display:flex;align-items:center;gap:11px;font-size:var(--fs-11);color:var(--mut);
  margin:var(--sp-sec) 0 var(--sp-block);letter-spacing:.6px;font-weight:600;text-transform:uppercase}
.sec-title::after{content:"";flex:1;height:1px;background:var(--line)}

/* ---------- 指标说明：标题行即折叠开关（v3.7） ---------- */
.guide-head{cursor:pointer;user-select:none;transition:color .18s ease}
.guide-head:hover{color:var(--txt)}
.guide-head .gt-hint{font-size:var(--fs-10);letter-spacing:.3px;color:var(--mut2);background:var(--panel2);
  border:1px solid var(--line2);padding:1px 8px;border-radius:var(--r-pill);font-weight:500;
  text-transform:none;white-space:nowrap}
.guide-head .gt-chev{width:7px;height:7px;flex:0 0 auto;border-right:1.6px solid currentColor;
  border-bottom:1.6px solid currentColor;transform:rotate(45deg);margin-top:-3px;
  transition:transform .3s cubic-bezier(.25,.55,.35,1)}
.guide-head.open .gt-chev{transform:rotate(-135deg);margin-top:3px}
.guide-wrap{max-height:0;overflow:hidden;transition:max-height .62s cubic-bezier(.4,0,.2,1)}
/* 内容块配合高度做「淡入 + 轻微上移」；收起时先淡出，避免被裁切的生硬感 */
.guide-wrap .glegend,.guide-wrap .guide,.guide-wrap .srcbox{opacity:0;transform:translateY(-7px);
  transition:opacity .26s ease,transform .26s ease}
.guide-wrap.open .glegend,.guide-wrap.open .guide,.guide-wrap.open .srcbox{opacity:1;transform:none;
  transition:opacity .5s ease .1s,transform .5s cubic-bezier(.2,.6,.3,1) .08s}
@media (prefers-reduced-motion:reduce){.guide-wrap,.guide-wrap .glegend,.guide-wrap .guide,.guide-wrap .srcbox{transition:none}}

/* ---------- 标签页 ---------- */
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:var(--sp-block)}
.tab{padding:6px 14px;border-radius:var(--r-md);border:1px solid var(--line);background:var(--panel);
  color:var(--mut);cursor:pointer;font-size:var(--fs-12);font-weight:600;transition:.16s}
.tab:hover{color:var(--txt);border-color:var(--line2)}
.tab.on{background:var(--accent);color:#fff;border-color:transparent;font-weight:800;
  box-shadow:0 8px 22px -12px var(--accent),0 0 0 3px color-mix(in srgb,var(--accent) 20%,transparent)}
.tab.on::before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;
  background:#fff;margin-right:7px;vertical-align:1px}

/* ---------- 图表 ---------- */
.chartbox{position:relative;background:var(--panel);border:1px solid var(--line);border-radius:var(--r-lg);
  padding:14px 14px 8px;box-shadow:var(--card-shadow)}
/* 趋势图坐标文字：和小时图同源问题 —— SVG 被整体缩放到手机宽度后，里面的 10.5~12.5px
   字只剩 3~4px（2026-10-07 一并修）。搬进这层原生 HTML：字号真实、任何缩放都清晰；
   用 aspect-ratio + 负 margin 精确盖在 SVG 上，百分比定位随图表自适应。 */
.chart-marks{position:relative;z-index:2;width:100%;aspect-ratio:1200/340;margin-top:-28.3333%;
  pointer-events:none}
.chart-marks i{position:absolute;font-style:normal;font-size:var(--fs-10);font-family:var(--font-mono);
  color:var(--mut2);white-space:nowrap;line-height:1;font-variant-numeric:tabular-nums}
.chart-marks i.y{left:0;width:4.5833%;text-align:right;transform:translateY(-50%)}
.chart-marks i.xl{bottom:2.6%;transform:translateX(-50%)}
.chart-marks i.xl.l{transform:none}
.chart-marks i.xl.r{transform:translateX(-100%)}
.chart-marks i.th{right:9%;transform:translateY(calc(-100% - 3px))}
.chart-marks i.pill{transform:translateY(-50%);font-weight:800;font-size:var(--fs-11);
  padding:3px 9px;border-radius:var(--r-pill);border:1px solid;letter-spacing:.2px;
  background:color-mix(in srgb,currentColor 14%,transparent)}
@media(max-width:680px){
  .chart-marks i.y{left:3px;width:auto;text-align:left}
  .chart-marks i.y[data-alt],.chart-marks i.xl[data-alt],.chart-marks i.xl[data-close]{display:none}
  .chart-marks i.th{left:44px;right:auto;text-align:left}
  .chart-marks i.pill{font-size:11.5px;padding:2px 8px}
}
.legend{display:flex;gap:16px;margin-bottom:6px;font-size:var(--fs-11);color:var(--mut);flex-wrap:wrap}
.legend i{display:inline-block;width:11px;height:3px;border-radius:var(--r-xs);margin-right:6px;vertical-align:middle}
svg{display:block;width:100%;height:auto;overflow:visible}
.tip{position:absolute;pointer-events:none;background:var(--tip-bg);border:1px solid var(--line2);
  border-radius:var(--r-md);padding:7px 10px;font-size:var(--fs-11);display:none;z-index:9;
  -webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);min-width:150px;
  box-shadow:0 10px 30px -12px rgba(0,0,0,.5)}
.tip .d{color:var(--mut);margin-bottom:4px;font-size:var(--fs-10)}
.tip .r{display:flex;justify-content:space-between;gap:14px}
.tip .r em.bf{font-style:normal;font-size:var(--fs-10);color:var(--mut2);font-weight:600;
  border:1px dashed var(--line2);border-radius:var(--r-xs);padding:0 5px;margin-left:6px;align-self:center}

/* ---------- 表格（日度明细）---------- */
#tbl{width:100%;min-width:720px;border-collapse:separate;border-spacing:0;font-size:var(--fs-13)}
/* v3.11.1：表内单元格统一走 UI 字体 —— 表里带中文（「近 7 日均」「待更新」），
   挂 .mono 会让中文回退到另一个字体，同一列出现两种字形。数字列靠 tabular-nums 对齐。 */
#tbl td{font-family:var(--font-ui)}
#tbl th,#tbl td{text-align:right;padding:9px 14px;border-bottom:1px solid var(--line);
  font-variant-numeric:tabular-nums;white-space:nowrap}
#tbl th{color:var(--mut);font-weight:600;font-size:var(--fs-11);letter-spacing:.4px;user-select:none;
  position:sticky;background:var(--panel);z-index:2}
#tbl thead tr.grp th{top:0;font-size:var(--fs-13);font-weight:700;letter-spacing:.5px;padding-top:11px;padding-bottom:8px}
#tbl thead tr.sub th{top:37px;font-size:var(--fs-11);letter-spacing:.3px;color:var(--mut2);
  padding-top:6px;padding-bottom:6px;border-bottom:1px solid var(--line2);background:var(--panel)}
#tbl th:first-child,#tbl td:first-child{text-align:left}
#tbl td.c-date{color:var(--mut);font-weight:600;font-size:var(--fs-12);letter-spacing:.2px}
#tbl td{color:var(--txt);position:relative}
/* 项目分组：底色 + 左侧色条，一眼区分 PONS / STONK */
#tbl th.g-pons,#tbl td.g-pons{background-color:color-mix(in srgb,var(--pons) 6%,transparent)}
#tbl th.g-stonk,#tbl td.g-stonk{background-color:color-mix(in srgb,var(--stonk) 7%,transparent)}
#tbl tbody tr:nth-child(even) td.g-pons{background-color:color-mix(in srgb,var(--pons) 11%,transparent)}
#tbl tbody tr:nth-child(even) td.g-stonk{background-color:color-mix(in srgb,var(--stonk) 12%,transparent)}
/* 表头必须不透明，否则数据行会从表头下面透出来 */
#tbl thead th.c-date{background:var(--panel)}
#tbl thead th.g-pons{background:linear-gradient(color-mix(in srgb,var(--pons) 10%,transparent),color-mix(in srgb,var(--pons) 10%,transparent)),var(--panel)}
#tbl thead th.g-stonk{background:linear-gradient(color-mix(in srgb,var(--stonk) 11%,transparent),color-mix(in srgb,var(--stonk) 11%,transparent)),var(--panel)}
#tbl thead tr.grp th.g-pons{color:var(--pons);box-shadow:inset 0 -2px 0 var(--pons-dim)}
#tbl thead tr.grp th.g-stonk{color:var(--stonk);box-shadow:inset 0 -2px 0 var(--stonk-dim)}
#tbl tbody tr:hover td{background-image:linear-gradient(color-mix(in srgb,var(--txt) 7%,transparent),color-mix(in srgb,var(--txt) 7%,transparent))}
/* 组间分隔线 */
#tbl th:nth-child(4),#tbl td:nth-child(4){border-right:2px solid var(--line2)}
#tbl th:nth-child(5),#tbl td:nth-child(5){border-left:0}
/* 数值配色 */
#tbl td.v-rev{font-weight:700;font-size:var(--fs-14)}
#tbl td.g-pons.v-rev{color:var(--pons)}
#tbl td.g-stonk.v-rev{color:var(--stonk)}
#tbl td.g-pons.v-bb{color:color-mix(in srgb,var(--pons) 55%,var(--txt))}
#tbl td.g-stonk.v-bb{color:color-mix(in srgb,var(--stonk) 55%,var(--txt))}
#tbl td.v-px{color:var(--mut)}
/* 单元格内的迷你条形：从左侧起，长度＝占当期最大值 */
#tbl td .bar{position:absolute;left:0;top:0;bottom:0;width:var(--w,0%);pointer-events:none;
  border-right:1px solid color-mix(in srgb,currentColor 30%,transparent)}
#tbl td.g-pons .bar{background:linear-gradient(90deg,color-mix(in srgb,var(--pons) 24%,transparent),color-mix(in srgb,var(--pons) 6%,transparent))}
#tbl td.g-stonk .bar{background:linear-gradient(90deg,color-mix(in srgb,var(--stonk) 22%,transparent),color-mix(in srgb,var(--stonk) 5%,transparent))}
#tbl td .v{position:relative;z-index:1}
/* 环比小标 */
#tbl .dlt{position:relative;z-index:1;margin-left:7px;font-size:var(--fs-11);font-weight:700;letter-spacing:.2px}
#tbl .dlt.up{color:var(--up)} #tbl .dlt.dn{color:var(--down)} #tbl .dlt.flat{color:var(--mut2);font-weight:600}
/* 置顶汇总行：近 7 日均 */
#tbl tbody tr.sum td{border-top:1px solid var(--line2);border-bottom:1px solid var(--line2);font-weight:700}
#tbl tbody tr.sum td.c-date{color:var(--txt);font-weight:700}
#tbl tbody tr.sum td.v-rev,#tbl tbody tr.sum td.v-bb{font-size:var(--fs-14)}

/* ---------- 规则引擎 ---------- */
.rules{display:flex;flex-direction:column;gap:16px}
.rule-legend{display:flex;gap:20px;flex-wrap:wrap;font-size:var(--fs-11);color:var(--mut);margin:0 0 var(--sp-block);line-height:1.6}
.rule-legend .lg{display:flex;align-items:center;gap:7px}
.tag{font-size:var(--fs-10);font-weight:700;padding:2px 9px;border-radius:var(--r-sm);white-space:nowrap;flex:0 0 auto;letter-spacing:.5px}
.tag.ok{background:var(--ok-bg);color:var(--ok-txt);border:1px solid var(--ok-line)}
.tag.warn{background:var(--wn-bg);color:var(--wn-txt);border:1px solid var(--wn-line)}
.tag.bad{background:var(--bd-bg);color:var(--bd-txt);border:1px solid var(--bd-line);
  font-weight:800;box-shadow:0 0 0 3px rgba(255,92,114,.14)}
.cmp-head{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:6px}
.cmp-head .col{display:flex;align-items:center;gap:8px;background:var(--panel2);border:1px solid var(--line);
  border-radius:var(--r-md);padding:8px 13px;font-size:var(--fs-13);font-weight:600}
.cmp-head .col .cnt{margin-left:auto;font-size:var(--fs-11);font-weight:400;color:var(--mut)}
.cmp-row{display:flex;flex-direction:column;gap:7px}
.cmp-label{display:flex;align-items:center;gap:9px;flex-wrap:wrap;padding:0 2px}
.cmp-label b{font-size:var(--fs-12);font-weight:600;color:var(--txt)}
.cmp-label .hint{font-size:var(--fs-11);color:var(--mut2)}
.cmp-label .verdict{margin-left:auto;font-size:var(--fs-11);padding:2px 10px;border-radius:var(--r-sm);
  background:var(--panel2);border:1px solid var(--line2);color:var(--mut)}
.cmp-label .verdict.win{color:var(--ok-txt);border-color:var(--ok-line)}
.cmp-pair{display:grid;grid-template-columns:1fr 1fr;gap:10px;align-items:stretch}
.cmp-pair>.rule{display:flex;flex-direction:column}
.cmp-pair>.rule .act{margin-top:auto}
.rule{background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--line2);
  border-radius:var(--r-md);padding:11px 13px;box-shadow:var(--card-shadow)}
.rule.ok{border-left-color:var(--up)}
.rule.warn{border-left-color:var(--warn)}
/* 危险/已触发：整张卡片变红 + 呼吸高亮，第一眼就能看到 */
/* v3.13.3 性能：原来呼吸的是 box-shadow，每帧都要把整张卡片重画一遍。
   现在把光圈挪到一层只改 opacity 的伪元素上，视觉几乎一样，动画全交给合成器。 */
@keyframes badpulse{0%,100%{opacity:0}50%{opacity:1}}
.rule.bad{border-left-color:var(--down);border-left-width:4px;border-color:var(--bd-line);position:relative;
  background:color-mix(in srgb,var(--bd-bg) 42%,var(--panel))}
.rule.bad::after{content:"";position:absolute;inset:-1px;border-radius:inherit;pointer-events:none;
  box-shadow:inset 0 0 0 1px var(--bd-line),0 0 0 5px color-mix(in srgb,var(--down) 13%,transparent);
  opacity:0;animation:badpulse 2.6s ease-in-out infinite;will-change:opacity}
.rule.bad .badflag{display:inline-flex;align-items:center;gap:5px;margin-bottom:7px;padding:3px 9px;
  font-size:var(--fs-10);font-weight:800;letter-spacing:.4px;border-radius:var(--r-sm);
  color:var(--bd-txt);background:var(--bd-bg);border:1px solid var(--bd-line)}
.rule.bad .s{color:var(--txt);font-weight:600}
@media (prefers-reduced-motion:reduce){.rule.bad::after{animation:none;opacity:1}}
/* 顶部异常横幅：把所有「已触发」的项一次列清楚 */
.alertbar{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin:0 0 12px;padding:10px 13px;
  border-radius:var(--r-md);font-size:var(--fs-12);line-height:1.7;font-weight:600;
  background:color-mix(in srgb,var(--bd-bg) 78%,var(--panel));border:1px solid var(--bd-line);color:var(--bd-txt)}
.alertbar .ah{margin-left:auto;font-weight:500;color:var(--mut)}
.rule.sum{border-left-color:var(--line2)}
.rule .rtop{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:6px}
.rule .pname{font-size:var(--fs-11);font-weight:600;display:none}
.rule .s{color:var(--mut);font-size:var(--fs-11);line-height:1.6}
.rule .act{margin-top:8px;font-size:var(--fs-11);padding:6px 10px;border-radius:var(--r-sm);
  background:var(--panel2);border:1px solid var(--line);color:var(--mut)}
.rule .act.ok{color:var(--ok-txt);border-color:var(--ok-line)}
.rule .act.warn{color:var(--wn-txt);border-color:var(--wn-line)}
.rule .act.bad{color:var(--bd-txt);border-color:var(--bd-line);background:var(--bd-bg);font-weight:700}
.rule.sum .act{color:var(--txt);border-color:var(--line2)}

/* ---------- 指标说明 ---------- */
.guide{display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-card)}
.gitem{background:var(--panel);border:1px solid var(--line);border-radius:var(--r-lg);padding:15px 17px;
  box-shadow:var(--card-shadow);scroll-margin-top:78px}
/* 从「?」跳过来时：外框高亮 + 呼吸脉冲约 4 秒，让人一眼锁定是哪一条（v3.7.4 增强） */
.gitem:target,.gitem.gflash{border-color:color-mix(in srgb,var(--accent) 78%,var(--line));
  box-shadow:0 0 0 2px color-mix(in srgb,var(--accent) 55%,transparent),var(--card-shadow);
  animation:gflashPulse 1.4s ease-in-out 3}
@keyframes gflashPulse{
  0%,100%{box-shadow:0 0 0 2px color-mix(in srgb,var(--accent) 55%,transparent),var(--card-shadow)}
  50%{box-shadow:0 0 0 9px color-mix(in srgb,var(--accent) 20%,transparent),var(--card-shadow)}}
@media (prefers-reduced-motion:reduce){.gitem:target,.gitem.gflash{animation:none}}
.gitem h3{margin:0 0 5px;font-size:var(--fs-13);font-weight:600;letter-spacing:-.1px}
.gitem .f{font-size:var(--fs-10);color:var(--mut2);font-family:var(--font-mono);
  margin-bottom:10px;word-break:break-all}
.gitem .lead{font-size:var(--fs-12);color:var(--mut);line-height:1.8;margin:0 0 var(--sp-block)}
.gitem .ex{background:var(--panel2);border:1px solid var(--line);border-radius:var(--r-md);padding:10px 12px;
  font-size:var(--fs-11);line-height:2;margin-bottom:var(--sp-block);word-break:break-word}
.gitem .ex b{color:var(--txt)}
.gitem .ex .cap{color:var(--mut2);font-size:var(--fs-10);letter-spacing:.3px;margin-bottom:4px}
.gitem ul{margin:0;padding-left:0;list-style:none;font-size:var(--fs-11);line-height:1.95;color:var(--mut)}
.gitem ul li{display:flex;gap:9px}
.gitem ul li .band{flex:0 0 auto;min-width:66px;font-family:var(--font-mono);color:var(--txt)}
.gitem .note{margin-top:10px;font-size:var(--fs-11);color:var(--mut2);line-height:1.8;
  border-top:1px dashed var(--line2);padding-top:9px}
.gitem .g-ok{color:var(--up)} .gitem .g-warn{color:var(--warn)} .gitem .g-bad{color:var(--down)}

/* ---------- 页脚 ---------- */
.foot{color:var(--mut2);font-size:var(--fs-11);margin-top:var(--sp-sec);line-height:1.85;max-width:1080px}
.foot a{color:var(--accent);text-decoration:none;font-weight:600;border-bottom:1px solid var(--pons-dim)}
.foot a:hover{border-bottom-color:var(--accent)}
/* 页脚作者卡：头像 + 名字/说明 + 关注按钮，一行排干净；窄屏自动换行（2026-10-06 重排） */
.foot-card{display:flex;align-items:stretch;gap:8px;flex-wrap:wrap;margin-top:12px}
.foot .foot-author{display:inline-flex;align-items:center;gap:11px;margin-top:0;padding:9px 13px;flex:1 1 300px;min-width:0;
  border:1px solid var(--line2);border-radius:var(--r-lg);background:var(--panel)}
.foot .foot-author img{width:30px;height:30px;border-radius:50%;object-fit:cover;flex:0 0 auto}
.foot .fa-txt{display:flex;flex-direction:column;min-width:0;line-height:1.55}
.foot .fa-txt b{font-size:var(--fs-12);color:var(--txt);font-weight:700}
.foot .fa-txt b a{color:var(--txt);border-bottom:0}
.foot .fa-txt i{font-style:normal;font-size:var(--fs-10);color:var(--mut2)}
.foot .fa-follow{margin-left:auto;flex:0 0 auto;align-self:center;display:inline-flex;align-items:center;justify-content:center;
  padding:6px 13px;border-radius:var(--r-pill);text-decoration:none;font-weight:700;font-size:var(--fs-11);
  color:var(--accent);background:color-mix(in srgb,var(--accent) 10%,var(--panel));
  border:1px solid color-mix(in srgb,var(--accent) 40%,var(--line2))}
.foot .fa-follow:hover{background:color-mix(in srgb,var(--accent) 17%,var(--panel))}
.dash-ver{display:inline-flex;align-items:center;gap:7px;margin-top:7px;
  font-size:var(--fs-10);letter-spacing:.5px;color:var(--mut2);font-family:var(--font-mono);
  border:1px solid var(--line);border-radius:var(--r-pill);padding:3px 11px;background:var(--panel)}
.dash-ver::before{content:"";width:5px;height:5px;border-radius:50%;background:var(--up);opacity:.75;
  box-shadow:0 0 0 3px color-mix(in srgb,var(--up) 14%,transparent)}
/* 页脚底行：版本号 + 浏览量（一行排开，窄屏自动换行） */
.foot-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:7px}
.foot-meta .dash-ver{margin-top:0}
.pv{display:inline-flex;align-items:center;gap:6px;font-size:var(--fs-10);letter-spacing:.4px;
  color:var(--mut);border:1px solid var(--line);border-radius:var(--r-pill);padding:3px 11px;background:var(--panel);
  font-family:var(--font-mono)}
.pv b{font-weight:800;color:var(--txt);letter-spacing:0}
.pv .pv-ic{font-size:var(--fs-12);line-height:1;opacity:.85}
.pv .pv-k{color:var(--mut2)}
.pv i{font-style:normal;color:var(--line2);margin:0 1px}
.warnline{stroke-dasharray:4 4}

/* ---------- 作者名片 ---------- */
.author{position:relative;z-index:60;display:flex;align-items:center;gap:14px;flex-wrap:wrap;
  background:var(--author-glow),var(--panel);
  -webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
  border:1px solid var(--line2);border-radius:var(--r-lg);padding:12px 15px;margin-bottom:16px;
  overflow:hidden;box-shadow:var(--card-shadow),var(--stick-shadow)}
.topbar{position:fixed;top:0;left:0;right:0;height:60px;z-index:110;pointer-events:none;opacity:0;
  display:flex;align-items:center;
  background:color-mix(in srgb,var(--bg) 74%,transparent);
  -webkit-backdrop-filter:blur(16px) saturate(150%);backdrop-filter:blur(16px) saturate(150%);
  border-bottom:1px solid var(--line)}
.topbar .tb-t{padding-left:152px;font-size:var(--fs-12);font-weight:600;color:var(--mut);letter-spacing:.2px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;opacity:0;transition:opacity .4s ease}
.topbar.on .tb-t{opacity:1}
.author-mini{position:fixed;top:0;left:0;z-index:120;display:flex;align-items:center;gap:0;
  padding:4px;border-radius:var(--r-pill);text-decoration:none;
  opacity:0;pointer-events:none;transform-origin:top left;backface-visibility:hidden;
  will-change:transform,opacity}
.author-mini.settled{pointer-events:auto}
.author-mini .mini-bg{position:absolute;inset:0;border-radius:inherit;z-index:-1;opacity:0;
  background:var(--author-glow),var(--panel);border:1px solid var(--line2);
  -webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
  box-shadow:0 12px 32px -14px rgba(0,0,0,.6);transition:opacity .3s ease}
.author-mini.settled .mini-bg{opacity:1}
.author-mini img{width:40px;height:40px;border-radius:50%;object-fit:cover;display:block;flex:0 0 auto;
  border:2px solid var(--pons-dim);box-shadow:0 6px 18px -8px rgba(0,0,0,.6)}
.author-mini .mini-tip{max-width:0;margin-left:0;overflow:hidden;white-space:nowrap;
  font-size:var(--fs-12);font-weight:600;color:var(--mut);letter-spacing:.2px;
  transition:max-width .35s cubic-bezier(.22,1,.36,1),margin-left .35s cubic-bezier(.22,1,.36,1)}
.author-mini.settled:hover .mini-tip{max-width:150px;margin-left:9px}
.author-me{display:flex;align-items:center;gap:12px;text-decoration:none;color:inherit;min-width:0}
.author-av{width:54px;height:54px;border-radius:50%;object-fit:cover;flex:0 0 auto;background:var(--panel2);
  border:2px solid var(--pons-dim);box-shadow:0 6px 18px -8px rgba(0,0,0,.6)}
.author-name{font-size:var(--fs-16);font-weight:600;display:flex;align-items:center;gap:5px;line-height:1.25;letter-spacing:-.1px}
.author-name .vfy{width:15px;height:15px;flex:0 0 auto}
.author-handle{font-size:var(--fs-11);color:var(--mut);margin-top:2px}
.author-bio{font-size:var(--fs-11);color:var(--mut2);margin-top:3px;white-space:nowrap;overflow:hidden;
  text-overflow:ellipsis;max-width:min(44vw,430px)}
.author-cta{margin-left:auto;display:inline-flex;align-items:center;gap:7px;
  background:var(--cta-bg);color:var(--cta-fg);font-weight:700;font-size:var(--fs-13);text-decoration:none;
  padding:10px 17px;border-radius:var(--r-pill);white-space:nowrap;transition:.16s;box-shadow:var(--cta-shadow)}
.author-cta:hover{transform:translateY(-1px)}
.author-cta svg{width:14px;height:14px;fill:var(--cta-fg);flex:0 0 auto}

/* ---------- 作者名片 · 横幅歌词（跟着右下角行情 BGM 走） ---------- */
.lyric{flex:1 1 180px;min-width:0;display:flex;justify-content:center;align-items:center;
  opacity:0;transition:opacity .6s ease;pointer-events:none}
.lyric.hidden{display:none}   /* 没歌词可显示时整块收掉，不留空话 */
.lyric.on{opacity:1}
.ly-in{width:100%;max-width:620px;display:flex;flex-direction:column;gap:6px}
.ly-window{position:relative;height:54px;overflow:hidden;
  -webkit-mask-image:linear-gradient(180deg,transparent 0,#000 27%,#000 73%,transparent 100%);
  mask-image:linear-gradient(180deg,transparent 0,#000 27%,#000 73%,transparent 100%)}
.lyric.note .ly-window{-webkit-mask-image:none;mask-image:none}
.ly-track{will-change:transform;transition:transform .6s cubic-bezier(.22,1,.36,1)}
.ly-line{height:18px;line-height:18px;font-size:var(--fs-12);font-weight:500;color:var(--mut2);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:center;letter-spacing:.2px;
  opacity:.55;transition:color .4s ease,opacity .4s ease}
.ly-line.past{opacity:.3}
.ly-line.on{color:var(--txt);font-weight:700;opacity:1;
  text-shadow:0 0 16px color-mix(in srgb,var(--pons) 55%,transparent)}
.ly-note{font-style:normal;margin-right:6px;color:var(--pons);opacity:.95}
.lyric.note .ly-line.on{color:var(--mut);font-weight:500;opacity:.85;text-shadow:none}
.lyric.note .ly-note{animation:lyPulse 2.4s ease-in-out infinite}
@keyframes lyPulse{0%,100%{opacity:.4}50%{opacity:1}}
.ly-bar{height:2px;border-radius:var(--r-xs);background:var(--line);overflow:hidden;
  opacity:0;transition:opacity .4s ease}
.lyric.on .ly-bar{opacity:1}
.lyric.note .ly-bar{opacity:0}
.ly-bar i{display:block;height:100%;width:0;border-radius:var(--r-xs);
  background:linear-gradient(90deg,var(--pons),var(--stonk));transition:width .3s linear}
@media(max-width:900px){.lyric{flex:1 1 100%}.ly-in{max-width:none}}

/* ---------- 刷新反馈 + 手机端点击 ---------- */
@keyframes pxflash{
  0%{transform:scale(1)}
  30%{transform:scale(1.075);color:var(--up)}
  100%{transform:scale(1)}
}
.price .p.flash{animation:pxflash 1.4s cubic-bezier(.22,1,.36,1)}
header button{transition:opacity .2s ease,transform .15s ease}
header button.busy{opacity:.55}
header button.busy .ic{animation:icspin .9s linear infinite}
@keyframes icspin{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){header button.busy .ic{animation:none}}
header button:disabled{cursor:default}
a.author-cta,a.author-me,a.author-mini,.foot a,header button,.tab{touch-action:manipulation;
  -webkit-tap-highlight-color:transparent}
.author-cta{position:relative;z-index:3}
.author-me{position:relative;z-index:3}
@media(hover:none){
  .author-cta:hover{transform:none}
  .tab:hover{color:inherit}
}

/* ---------- 数据源滞后提示（DefiLlama 有时晚 1-2 天出数）---------- */
.lagtag{display:inline-flex;align-items:center;margin-left:8px;padding:2px 7px;border-radius:var(--r-pill);
  font-size:var(--fs-10);font-weight:700;letter-spacing:.2px;white-space:nowrap;
  color:var(--warn);background:color-mix(in srgb,var(--warn) 12%,transparent);
  border:1px solid color-mix(in srgb,var(--warn) 30%,transparent);vertical-align:middle}
/* 日度表补充值（链上 / 官方）：数值 + 一个小标签，hover 说明覆盖了多久、口径是什么 */
.sup-tag{margin-left:6px;padding:1px 6px;border-radius:var(--r-pill);font-size:var(--fs-10);font-weight:700;font-style:normal;
  color:var(--accent);background:color-mix(in srgb,var(--accent) 12%,transparent);
  border:1px solid color-mix(in srgb,var(--accent) 30%,transparent);vertical-align:middle}
.bb-chainrk{font-style:normal;font-size:var(--fs-10);font-weight:800;letter-spacing:.2px;color:var(--accent);
  background:color-mix(in srgb,var(--accent) 12%,transparent);border:1px solid color-mix(in srgb,var(--accent) 30%,transparent);
  border-radius:var(--r-pill);padding:1px 7px;cursor:help;white-space:nowrap}
/* 卡片上的「实时 24 小时」小胶囊：哪里写了数据晚了几天，旁边就补一个更快的源，
   让用户第一眼看到的是最新数字，而不是只有一个"晚了"的告警（2026-10-05 加） */
.livechip{display:inline-flex;align-items:center;gap:5px;margin-left:8px;padding:2px 8px;border-radius:var(--r-pill);
  font-size:var(--fs-10);font-weight:700;letter-spacing:.2px;white-space:nowrap;cursor:pointer;vertical-align:middle;
  color:var(--up);background:color-mix(in srgb,var(--up) 12%,transparent);
  border:1px solid color-mix(in srgb,var(--up) 30%,transparent);transition:background .15s}
.livechip:hover{background:color-mix(in srgb,var(--up) 22%,transparent)}
.livechip i{width:5px;height:5px;border-radius:50%;background:var(--up);display:inline-block;
  animation:dotBreath 2.8s ease-in-out infinite}
@media (prefers-reduced-motion: reduce){.livechip i{animation:none}}
#tbl td.pend{color:var(--mut2)}
#tbl td.pend .pend-v{font-size:var(--fs-11);font-weight:700;color:var(--mut2);letter-spacing:.3px}
#tbl .win{display:block;margin-top:1px;font-size:var(--fs-10);font-weight:600;color:var(--mut2);letter-spacing:.2px}


/* ==========================================================================
   v3.21 页面导航（#secNav）· 图标 + 文字常显
   —— v3.20 只有小图标，用户反馈「不知道图标什么意思」→ 改为图标+文字常显，不再靠悬停。
   ≥1024px：左侧一条固定宽度的导航列（122px），点击即平滑滚到对应板块：
      · 1024~1689：内容整体右移、左对齐到导航列右侧（导航列绝不压卡片）；
      · ≥1690：两侧留白够宽，导航列贴到内容左侧的留白里，不再占内容宽度。
   <1024px：标题下方横滑胶囊条；滑动时出现、停手约 1.5 秒后自动收起。
   ========================================================================== */
:root{--nav-w:122px;--nav-gap:13px}
#secNav{position:fixed;left:max(9px,calc(50vw - 700px - var(--nav-w) - var(--nav-gap)));top:50%;
  transform:translateY(-50%);z-index:100;width:var(--nav-w);
  display:flex;flex-direction:column;gap:2px;padding:7px 6px;border-radius:16px;
  background:color-mix(in srgb,var(--panel) 84%,transparent);
  border:1px solid var(--line);box-shadow:var(--stick-shadow);
  -webkit-backdrop-filter:blur(16px) saturate(140%);backdrop-filter:blur(16px) saturate(140%);
  opacity:.92;transition:opacity .22s ease}
#secNav:hover,#secNav:focus-within{opacity:1}
.nav-h{padding:3px 9px 6px;font-size:9.5px;font-weight:800;letter-spacing:1.5px;color:var(--mut2);
  text-transform:uppercase;user-select:none}
#secNav button{touch-action:manipulation;-webkit-tap-highlight-color:transparent}
.nav-i{position:relative;display:flex;align-items:center;gap:8px;width:100%;
  padding:6px 9px;border:0;border-radius:9px;background:transparent;color:var(--mut);cursor:pointer;text-align:left;
  font-family:var(--font-ui);font-size:var(--fs-11);font-weight:600;letter-spacing:.2px;
  transition:color .16s ease,background .16s ease,box-shadow .16s ease}
.nav-i .nav-dot{display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.nav-i .nav-dot .ic{width:14px;height:14px}
.nav-i .nav-t{flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.nav-i:hover{color:var(--txt);background:color-mix(in srgb,var(--accent) 10%,transparent);box-shadow:none}
.nav-i.on{color:var(--accent);background:color-mix(in srgb,var(--accent) 14%,transparent);
  box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--accent) 32%,transparent)}
.nav-i:focus-visible{outline:2px solid color-mix(in srgb,var(--accent) 60%,transparent);outline-offset:2px}
/* 1024~1689：内容左对齐到导航列右侧（不再居中），导航列绝不压卡片 */
@media(min-width:1024px) and (max-width:1689px){
  .wrap{margin-left:calc(9px + var(--nav-w) + var(--nav-gap));margin-right:auto;
        max-width:calc(100vw - 9px - var(--nav-w) - var(--nav-gap) - 20px)}
}
/* 锚点落位：顶部固定栏 60px，再留 20px 呼吸（手机端在下面单独加高） */
#st-hourly,#st-rules,#st-burn,#st-share,#st-rank,#st-chart,#st-table,#st-src,#st-guide{scroll-margin-top:80px}
/* 点导航跳过去时：目标标题轻微闪一下（告诉眼睛「就是这里」），1.5 秒后自己淡掉 */
.sec-title.nflash{animation:nflash 1.5s ease-out 1}
@keyframes nflash{0%,16%{color:var(--accent)}100%{color:var(--mut)}}
@media (prefers-reduced-motion:reduce){#secNav,.nav-i,.nav-i .nav-t{transition:none}.sec-title.nflash{animation:none}}

/* <1024：导轨变「标题下面一条横滑胶囊」；滑动时出现，停手后自动收起 */
@media(max-width:1023px){
  #secNav{position:sticky;left:auto;top:6px;transform:none;z-index:106;
    width:auto;flex-direction:row;align-items:center;gap:6px;padding:4px 2px;margin:4px 0 12px;border-radius:0;
    border:0;background:none;box-shadow:none;-webkit-backdrop-filter:none;backdrop-filter:none;opacity:1;
    overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch;
    scrollbar-width:none;transition:top .28s ease,opacity .26s ease,transform .26s ease}
  #secNav::-webkit-scrollbar{display:none}
  .nav-h{display:none}
  body.tb-on #secNav{top:66px}          /* 顶部固定栏出现时，横条跟着下移 */
  /* 吸顶后补一条柔和底色 + 毛玻璃：胶囊之间的缝隙不再透出下面的正文，观感安静很多 */
  body.nav-stick #secNav{background:linear-gradient(180deg,color-mix(in srgb,var(--bg) 94%,transparent),
    color-mix(in srgb,var(--bg) 74%,transparent));-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
  /* 手机端顶部一共两条：固定栏 60px + 吸顶横条约 40px，锚点落位要再往下让一点 */
  #st-hourly,#st-rules,#st-burn,#st-share,#st-rank,#st-chart,#st-table,#st-src,#st-guide{scroll-margin-top:114px}
  .nav-i{flex:0 0 auto;width:auto;gap:6px;padding:7px 12px;border-radius:999px;
    border:1px solid var(--line);color:var(--mut);background:color-mix(in srgb,var(--panel) 90%,transparent);
    -webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);box-shadow:var(--card-shadow)}
  .nav-i .nav-dot .ic{width:13px;height:13px}
  .nav-i .nav-t{flex:0 0 auto;overflow:visible}
  .nav-i:hover{background:color-mix(in srgb,var(--panel) 90%,transparent);box-shadow:var(--card-shadow)}
  .nav-i.on,.nav-i.on:hover{color:var(--accent);background:color-mix(in srgb,var(--accent) 15%,var(--panel));
    border-color:color-mix(in srgb,var(--accent) 40%,transparent);box-shadow:var(--card-shadow)}
  /* 停手后自动收起：只在「吸顶」状态收（还挂在文档流里时收起会留一条空白） */
  #secNav.nav-hide{opacity:0;transform:translateY(-18px);pointer-events:none}
}
/* ---------- 响应式 ---------- */
@media(max-width:900px){
  .grid2,.guide,.cmp-head,.cmp-pair{grid-template-columns:1fr}
  .rule .pname{display:inline}
}
@media(max-width:680px){
.proj-head>div:first-child{min-width:0;flex:1 1 auto}
.proj-name .lagtag,.proj-name .livechip{margin-left:0}
  body{font-size:var(--fs-12)}
  .wrap{padding:14px 14px 52px}
  /* 手机端安全条会折成 2~3 行：收紧内边距，别把主卡挤下去 */
  .safe-line{padding:8px 12px 8px 15px;gap:7px;line-height:1.6}
  .safe-line .sf-sep{display:none}
  .kv{grid-template-columns:repeat(2,1fr)}
  .kv .v{font-size:var(--fs-13)}
  .price .p{font-size:18px}
  .author{padding:11px 12px;gap:10px;top:6px}
  .author-av{width:46px;height:46px}
  .author-name{font-size:var(--fs-14)}
  .author-bio{display:none}
  .author-acts{margin-left:0;width:100%}
  .author-acts>*{flex:1 1 0;justify-content:center;padding:10px 14px}
  .sec-title{margin:22px 0 var(--sp-block)}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}

/* ============================================================
   排版系统 v2 —— 统一字体 / 字号 / 字重（解决「字体不一致、有的太小」）
   所有组件统一走 --fs-* 一套字号，数字统一用 tabular-nums 对齐
   ============================================================ */
:root{
  /* UI / 正文 / 数值：系统栈（不下载字体，中文站最优解）
     Mac=SF Pro+苹方 · Win11=Segoe UI Variable+雅黑UI · 安卓=Roboto+思源/小米/鸿蒙
     拉丁字排在前、中文字排在后：浏览器按「谁有字形谁上」逐字回退，两边都不将就 */
  --font-ui:"Inter",system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI Variable Text","SF Pro Text",
    "Segoe UI",Roboto,"PingFang SC","HarmonyOS Sans SC","MiSans","Noto Sans SC","Source Han Sans SC",
    "Hiragino Sans GB","Microsoft YaHei UI","Microsoft YaHei","WenQuanYi Micro Hei",sans-serif;
  /* 数值：跟着 UI 字体走 + 表格数字（tabular-nums 由 body 统一开启）——
     日度大表一直就是这么渲染的，现在卡片/排行/销毁跟它统一。
     等宽只留给「机器码」：地址、哈希、公式、图表刻度 */
  --font-num:var(--font-ui);
  /* 机器码专用等宽：有现代等宽的先用，没有就退回系统等宽 */
  --font-mono:"JetBrains Mono","Geist Mono","IBM Plex Mono","Cascadia Mono","SF Mono",
    ui-monospace,SFMono-Regular,Menlo,Consolas,"Roboto Mono",monospace;
  --fs-11:11.5px; --fs-12:12.5px; --fs-13:13.5px; --fs-14:15px; --fs-16:16.5px; --fs-20:21px;
  /* 间距标尺 v3.8（4px 基准）—— 全站统一走这套，避免各处 9/10/11/13/18 乱跳 */
  --sp-sec:28px;    /* 大段落之间：上个模块 → 下个模块标题 */
  --sp-card:16px;   /* 卡片 / 栅格之间、页头下方 */
  --sp-block:12px;  /* 段落标题 → 内容、控件 → 内容 */
  --sp-tight:10px;  /* 段落内紧邻元素（副标题、小控件、表头） */
  --sp-in:9px;      /* 卡片内部小间距（键值、脚注） */
}

/* ============================================================
   设计标尺 v3.11 —— 一把尺子量到底
   ① 圆角只有四档 + 胶囊：--r-xs 5 / --r-sm 8 / --r-md 12 / --r-lg 18 / --r-pill
      卡片=lg · 控件(按钮/标签页/内块)=md · 小件(标签/徽标)=sm · 色条/迷你块=xs
   ② 字号只有七档：--fs-10(10.5) 11 12 13 14 16 20 —— 最小的字从 8.5px 提到 10.5px
   ③ 景深三级：--sh-1 静置 / --sh-2 浮起 / --sh-3 弹层（暗色浅色各自调）
   ============================================================ */
:root{
  --r-xs:5px; --r-sm:8px; --r-md:12px; --r-lg:18px; --r-pill:999px;
  --fs-10:10.5px;
  --sh-1:0 1px 2px rgba(0,0,0,.22);
  --sh-2:0 12px 30px -20px rgba(0,0,0,.6);
  --sh-3:0 26px 64px -30px rgba(0,0,0,.8);
}
body{font-family:var(--font-ui);font-size:var(--fs-13);line-height:1.62;
  font-variant-numeric:tabular-nums lining-nums;font-feature-settings:"tnum" 1,"lnum" 1;
  font-kerning:normal;font-optical-sizing:auto;text-rendering:optimizeLegibility}
h1{font-size:var(--fs-16);font-weight:700;letter-spacing:-.15px}
h1 span{font-size:var(--fs-11);font-weight:500}
.badge,.tbtn,header button{font-size:var(--fs-12)}
.proj-name{font-size:var(--fs-16);font-weight:700}
.tick{font-size:var(--fs-11)}
.price .p{font-size:var(--fs-20);font-weight:700}
.price .m,.pill{font-size:var(--fs-11)}
.kv .k{font-size:var(--fs-11);font-weight:500;letter-spacing:.15px}
.kv .v{font-size:var(--fs-14);font-weight:700}
.kv .v small{font-size:var(--fs-11);font-weight:500}
.status{font-size:var(--fs-12)}
.status .lbl{font-weight:700}
.sec-title{font-size:var(--fs-12);letter-spacing:.9px}
.tab,.legend,.rule-legend{font-size:var(--fs-12)}
.tag{font-size:var(--fs-11);letter-spacing:.4px}
.cmp-head .col{font-size:var(--fs-13)}
.cmp-head .col .cnt{font-size:var(--fs-11)}
.cmp-label b{font-size:var(--fs-13);font-weight:700}
.cmp-label .hint,.cmp-label .verdict{font-size:var(--fs-11)}
.rule .pname{font-size:var(--fs-12)}
.rule .s{font-size:var(--fs-12);line-height:1.7;color:var(--mut)}
.rule .act{font-size:var(--fs-12);line-height:1.65}
#tbl{font-size:var(--fs-13)}
#tbl td.c-date{font-size:var(--fs-12)}
#tbl th{font-size:var(--fs-11)}
.gitem h3{font-size:var(--fs-14);font-weight:700}
.gitem .f{font-size:var(--fs-11)}
.gitem .lead{font-size:var(--fs-12);line-height:1.85}
.gitem .ex{font-size:var(--fs-12);line-height:1.95}
.gitem ul{font-size:var(--fs-12)}
.gitem .note{font-size:var(--fs-11)}
.foot,.foot .foot-author{font-size:var(--fs-11);line-height:1.9}

/* 关键信息高亮（加底色 + 加粗，让重点一眼看见） */
.hl{font-weight:700;color:var(--txt);
  background:linear-gradient(transparent 58%,color-mix(in srgb,var(--accent) 32%,transparent) 0);
  padding:0 2px;border-radius:var(--r-xs)}
.hl-up{color:var(--up);font-weight:700}
.hl-dn{color:var(--down);font-weight:700}
.hl-warn{color:var(--warn);font-weight:700}
/* 关键数字高亮：颜色自动跟着这张卡的等级走（危险=红 / 警戒=黄 / 正常=绿） */
.hi{font-weight:800;font-family:var(--font-num);letter-spacing:-.1px}
.hi-dn{font-weight:800;color:var(--down)}
.hi-up{font-weight:800;color:var(--up)}
.hi-wn{font-weight:800;color:var(--warn)}
.rule .s .hi{font-size:var(--fs-13)}
.rule.ok   .s .hi{color:var(--ok-txt)}
.rule.warn .s .hi{color:var(--wn-txt)}
.rule.bad  .s .hi{color:var(--bd-txt)}
.gitem .f .hi{color:var(--accent)}
.gitem .lead .hi,.gitem .note .hi,.gitem .ex .hi{color:var(--txt)}
/* 指标说明：颜色图例 */
.glegend{display:flex;gap:16px;flex-wrap:wrap;margin:0 0 var(--sp-block);font-size:var(--fs-11);color:var(--mut)}
.glegend span{display:inline-flex;align-items:center;gap:6px}
.glegend i{width:24px;height:8px;border-radius:var(--r-xs);display:inline-block}
.glegend .sw-hl{background:linear-gradient(transparent 46%,color-mix(in srgb,var(--accent) 40%,transparent) 0);
  height:14px}
.glegend .sw-num{background:var(--panel2);border:1px solid var(--line2);height:14px}
.gitem b,.gitem .ex b,.rule b,.summary b{font-weight:700;color:var(--txt)}
.gitem .ex b{color:var(--txt)}

/* ---------- 数据源体检（v3.9）：每个数字来自哪里、新到什么程度 ---------- */
.srcbox{background:var(--panel);border:1px solid var(--line);border-radius:var(--r-lg);
  padding:4px 15px 12px;box-shadow:var(--card-shadow)}
.srcrow{display:flex;align-items:center;gap:10px;flex-wrap:wrap;
  padding:9px 2px;border-bottom:1px solid var(--line);font-size:var(--fs-12)}
.srcrow:last-of-type{border-bottom:0}
.srcrow .s-dot{width:9px;height:9px;border-radius:50%;flex:0 0 auto;box-shadow:0 0 9px currentColor;
  background:currentColor;animation:dotBreath 2.8s ease-in-out infinite}
.srcrow .s-dot.ok{color:var(--up)}
.srcrow .s-dot.wn{color:var(--warn)}
.srcrow .s-dot.bd{color:var(--down)}
.srcrow .s-name{font-weight:700;color:var(--txt)}
.srcrow .s-from{font-size:var(--fs-11);color:var(--mut2)}
.srcrow .s-badge{font-size:var(--fs-11);font-weight:700;padding:1px 8px;border-radius:var(--r-pill);
  color:var(--ok-txt);background:var(--ok-bg);border:1px solid var(--ok-line)}
.srcrow .s-badge.wn{color:var(--wn-txt);background:var(--wn-bg);border-color:var(--wn-line)}
.srcrow .s-last{margin-left:auto;font-family:var(--font-num);color:var(--mut);white-space:nowrap}
.srcrow .s-note{flex:1 1 100%;font-size:var(--fs-11);color:var(--mut);line-height:1.7;margin-top:-2px}
.srcsum{margin-top:10px;padding-top:10px;border-top:1px dashed var(--line2);
  font-size:var(--fs-11);color:var(--mut);line-height:1.8}
.srcsum b{color:var(--txt)}
@media (prefers-reduced-motion:reduce){.srcrow .s-dot{animation:none}}

/* ---------- 一句话结论卡（放在信号区最上面） ---------- */
.summary{background:var(--panel);border:1px solid var(--line2);border-left:3px solid var(--accent);
  border-radius:var(--r-lg);padding:14px 16px;margin-bottom:var(--sp-card);
  box-shadow:var(--card-shadow),0 18px 40px -34px rgba(0,0,0,.9)}
.summary .sum-head{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:var(--sp-tight)}
.summary .sum-badge{font-size:var(--fs-11);font-weight:700;letter-spacing:.5px;
  color:var(--cta-fg);background:var(--cta-bg);padding:3px 10px;border-radius:var(--r-sm)}
.summary .sum-line{font-size:var(--fs-20);font-weight:700;letter-spacing:-.3px;line-height:1.4}
.summary .sum-line .pnm{font-size:var(--fs-13);color:var(--mut);font-weight:700}
.summary .sum-line b{font-weight:800}
.summary .sum-line b.ok{color:var(--ok-txt)}
.summary .sum-line b.warn{color:var(--wn-txt)}
.summary .sum-line b.bad{color:var(--bd-txt)}
.sum-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-block)}
.sum-proj{background:var(--panel2);border:1px solid var(--line);border-radius:var(--r-md);padding:11px 13px}
.sum-proj.ok{border-color:var(--ok-line);background:color-mix(in srgb,var(--ok-bg) 70%,var(--panel))}
.sum-proj.warn{border-color:var(--wn-line);background:color-mix(in srgb,var(--wn-bg) 70%,var(--panel))}
.sum-proj.bad{border-color:var(--bd-line);background:color-mix(in srgb,var(--bd-bg) 70%,var(--panel));
  box-shadow:0 0 0 3px color-mix(in srgb,var(--down) 12%,transparent)}
.sum-proj .sp-top{display:flex;align-items:center;gap:8px;font-weight:700;font-size:var(--fs-13);margin-bottom:6px}
.sum-proj .sp-act{font-size:var(--fs-12);line-height:1.7}
.sum-chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:var(--sp-in)}
.chip{font-size:var(--fs-11);padding:2px 8px;border-radius:var(--r-sm);background:var(--panel);
  border:1px solid var(--line2);color:var(--mut);white-space:nowrap}
.chip b{color:var(--txt);font-family:var(--font-num);font-weight:700}
.chip b.hi{color:var(--txt)}
.chip b.hi-dn{color:var(--down)}
.chip b.hi-up{color:var(--up)}
.chip b.hi-wn{color:var(--warn)}
.sum-foot{margin-top:10px;font-size:var(--fs-12);color:var(--mut);
  border-top:1px dashed var(--line2);padding-top:9px;line-height:1.7}
.sum-foot b{color:var(--txt)}

/* ---------- v3.19 结论深读：把「一句话结论」背后的推理链摊开 ---------- */
.sum-deep{margin-top:var(--sp-block);border-top:1px dashed var(--line2);padding-top:10px}
.sum-deep .sd-head{display:flex;align-items:center;gap:8px;flex-wrap:wrap;
  font-size:var(--fs-12);font-weight:700;color:var(--txt);margin-bottom:9px}
.sum-deep .sd-head .sd-ic{color:var(--accent);display:inline-flex}
.sum-deep .sd-head .sd-ic .ic{width:14px;height:14px}
.sum-deep .sd-hint{font-weight:400;font-size:var(--fs-11);color:var(--mut2)}
.sd-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-block)}
.sd-col{background:color-mix(in srgb,var(--panel2) 55%,transparent);border:1px solid var(--line);
  border-radius:var(--r-md);padding:9px 12px}
.sd-proj{display:flex;align-items:center;gap:7px;font-weight:700;font-size:var(--fs-12);margin-bottom:4px}
.sd-row{display:flex;gap:8px;font-size:var(--fs-11);line-height:1.75;color:var(--mut);padding:6px 0 0;margin-top:6px;
  border-top:1px dashed color-mix(in srgb,var(--line2) 65%,transparent)}
.sd-k{flex:0 0 auto;font-weight:700;color:var(--accent);min-width:2.6em}
.sd-t b{color:var(--txt)}
.sd-t .hl-up,.sd-t .hl-dn{font-weight:700}
@media(max-width:820px){.sd-grid{grid-template-columns:1fr}}

/* ---------- 深层分析（每条信号下面的一块数据推理） ---------- */
.rule .deep{margin-top:9px;padding:9px 11px;border-radius:var(--r-md);
  background:color-mix(in srgb,var(--accent) 8%,transparent);border:1px solid var(--line);
  font-size:var(--fs-11);line-height:1.8;color:var(--mut)}
.rule .deep .dh{display:block;font-size:var(--fs-10);font-weight:700;letter-spacing:.7px;
  color:var(--accent);margin-bottom:3px}
.rule .deep .dl{display:block;margin-top:4px}
.rule .deep b{color:var(--txt)}

/* ---------- 打赏（钱包地址） ---------- */
.author-acts{display:flex;align-items:center;gap:9px;margin-left:auto;flex-wrap:wrap}
.author-tip{display:inline-flex;align-items:center;gap:7px;font-size:var(--fs-12);
  font-weight:700;padding:10px 16px;border-radius:var(--r-pill);white-space:nowrap;transition:.16s;
  border:1px solid color-mix(in srgb,var(--warn) 45%,var(--line2));
  background:color-mix(in srgb,var(--wn-bg) 58%,var(--panel));color:var(--wn-txt)}
.author-tip:hover{transform:translateY(-1px);
  border-color:color-mix(in srgb,var(--warn) 78%,var(--line2))}
/* 下滑后停在左上角的打赏按钮（跟着小头像一起出现，方便随时打赏） */
.tip-mini{position:fixed;top:12.5px;left:64px;z-index:119;display:inline-flex;align-items:center;gap:6px;
  padding:8px 13px;border-radius:var(--r-pill);cursor:pointer;font-size:var(--fs-12);font-weight:700;
  font-family:inherit;color:var(--wn-txt);white-space:nowrap;
  border:1px solid color-mix(in srgb,var(--warn) 45%,var(--line2));
  background:color-mix(in srgb,var(--wn-bg) 62%,var(--panel));
  -webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
  box-shadow:0 12px 32px -16px rgba(0,0,0,.6);
  opacity:0;pointer-events:none;transform:translateX(-8px) scale(.94);transform-origin:left center;
  transition:opacity .28s ease,transform .34s cubic-bezier(.22,1,.36,1)}
.tip-mini.settled{opacity:1;pointer-events:auto;transform:none}
.tip-mini:hover{transform:translateY(-1px)}
.tip-mini .tm-ic{font-size:var(--fs-13);line-height:1}
@media(hover:none){.tip-mini:hover{transform:none}}
.tip-btn{display:inline-flex;align-items:center;gap:6px;font-weight:700;
  border-color:color-mix(in srgb,var(--warn) 55%,var(--line2));
  background:color-mix(in srgb,var(--wn-bg) 70%,var(--panel));color:var(--wn-txt)}
.tip-modal{position:fixed;inset:0;z-index:400;display:none;align-items:center;justify-content:center;
  padding:18px;background:rgba(6,8,12,.6);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px)}
.tip-modal.on{display:flex}
.tip-card{width:min(560px,100%);max-height:88vh;overflow:auto;background:var(--panel);
  border:1px solid var(--line2);border-radius:var(--r-lg);padding:20px;
  box-shadow:0 30px 80px -30px rgba(0,0,0,.75)}
.tip-card h3{margin:0 0 6px;font-size:var(--fs-16)}
.tip-card .tsub{margin:0 0 14px;font-size:var(--fs-12);color:var(--mut);line-height:1.75}
.tip-card .tnote{font-size:var(--fs-11);color:var(--mut2);line-height:1.75;margin-top:10px}
.addr{display:flex;align-items:center;gap:9px;background:var(--panel2);border:1px solid var(--line);
  border-radius:var(--r-md);padding:10px 12px;margin-top:8px}
.addr .chain{font-size:var(--fs-11);font-weight:700;color:var(--mut);flex:0 0 auto;min-width:58px}
.addr code{flex:1;font-family:var(--font-mono);font-size:var(--fs-11);word-break:break-all;color:var(--txt)}
.addr button{flex:0 0 auto;font-size:var(--fs-11);padding:6px 12px;font-weight:700}
.tip-close{position:absolute;top:12px;right:14px}
.tip-thanks{margin-top:14px;padding:10px 12px;border-radius:var(--r-md);font-size:var(--fs-12);line-height:1.75;
  background:var(--ok-bg);border:1px solid var(--ok-line);color:var(--ok-txt)}
.toast{position:fixed;left:50%;bottom:34px;z-index:500;transform:translateX(-50%) translateY(14px);
  opacity:0;transition:opacity .26s ease,transform .26s ease;pointer-events:none;
  background:var(--cta-bg);color:var(--cta-fg);font-size:var(--fs-12);font-weight:700;
  padding:10px 18px;border-radius:var(--r-pill);box-shadow:0 18px 40px -18px rgba(0,0,0,.75);max-width:88vw;text-align:center}
.toast.on{opacity:1;transform:translateX(-50%) translateY(0)}
.foot .foot-tip{display:inline-flex;align-items:center;gap:7px;margin:0;vertical-align:middle;
  padding:9px 14px;border:1px solid var(--line2);border-radius:var(--r-pill);background:var(--panel);
  color:var(--mut);font-size:var(--fs-11);cursor:pointer}
.foot .foot-tip:hover{color:var(--txt);border-color:var(--line2)}
@media(max-width:900px){.sum-grid{grid-template-columns:1fr}}
@media(max-width:680px){
  body{font-size:var(--fs-13)}
  .kv .v{font-size:var(--fs-14)}
  .price .p{font-size:var(--fs-16)}
  .summary .sum-line{font-size:var(--fs-14)}
  .author-tip{margin-left:0;width:100%;justify-content:center;padding:10px 14px}
  .tip-mini{top:11px;left:58px;padding:7px 11px}
  .topbar .tb-t{padding-left:140px}
  .foot .foot-author{flex:1 1 100%}
  .foot .foot-tip{flex:1 1 100%;justify-content:center}
  .foot .fa-follow{padding:9px 18px}
}

/* ============================================================
   收入排行 —— 「我们现在坐在第几排」
   一张卡 = 一个项目：名次 + 对数刻度轴 + 三个口径 + 环比 + 还差多远
   ============================================================ */
.rank-sub{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:var(--fs-11);
  color:var(--mut);line-height:1.7;margin:0 0 var(--sp-tight)}
.rank-sub .rank-force{font-size:var(--fs-11);font-weight:700;padding:4px 11px;color:var(--accent);
  border-color:color-mix(in srgb,var(--accent) 40%,var(--line2));
  background:color-mix(in srgb,var(--accent) 10%,var(--panel))}
.rank-sub .rank-force:hover{border-color:var(--accent)}
.rank-updated{font-size:var(--fs-11);color:var(--mut2);margin-left:auto}
.rank-warn{color:var(--wn-txt);font-weight:600}

/* ---- 一句话总结：近一个月名次怎么动 ---- */
.rank-insight{display:flex;align-items:center;gap:10px 16px;flex-wrap:wrap;margin:0 0 var(--sp-block);padding:9px 13px;
  border-radius:var(--r-md);font-size:var(--fs-12);line-height:1.7;color:var(--txt);border:1px solid var(--line);
  background:linear-gradient(90deg,color-mix(in srgb,var(--accent) 13%,transparent),transparent 58%),var(--panel)}
.rank-insight .ri-t{font-size:var(--fs-11);font-weight:700;letter-spacing:.4px;color:var(--mut)}
.rank-insight .ri-p{display:inline-flex;align-items:center;gap:7px;white-space:nowrap}
.rank-insight .ri-p b{font-weight:800;letter-spacing:.2px}
.rank-insight .ri-p i{font-style:normal;font-family:var(--font-num);color:var(--mut)}
.rank-insight .ri-p em{font-style:normal;font-weight:700;font-size:var(--fs-11);padding:1px 7px;
  border-radius:var(--r-xs);background:var(--panel2);border:1px solid var(--line2)}
.rank-insight .rd-up{color:var(--up)} .rank-insight .rd-down{color:var(--down)}
.rank-insight .rd-flat{color:var(--mut)}

/* ---- 名次卡 ---- */
.rank-card{position:relative;background:var(--panel);border:1px solid var(--line);border-radius:var(--r-lg);
  padding:14px 16px 14px 19px;box-shadow:var(--card-shadow);overflow:hidden}
.rank-card::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;
  background:var(--rank-c,var(--accent))}
.rc-pons{--rank-c:var(--pons)} .rc-stonk{--rank-c:var(--stonk)}
.rank-card-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:8px}
.rank-pct{font-size:var(--fs-11);font-weight:700;color:var(--mut);background:var(--panel2);
  border:1px solid var(--line2);border-radius:var(--r-pill);padding:2px 10px;white-space:nowrap}
.rank-big{font-family:var(--font-num);font-variant-numeric:tabular-nums;font-size:36px;font-weight:800;letter-spacing:-.85px;line-height:1.02;
  color:color-mix(in srgb,var(--rank-c,var(--accent)) 72%,var(--txt))}
.rank-big small{display:block;font-family:var(--font-ui);font-size:var(--fs-11);font-weight:500;
  letter-spacing:0;color:var(--mut);margin-top:4px}

/* ---- 对数刻度轴：#1 在最左，#总数 在最右 ---- */
.rank-scale{padding:0 9px;margin:var(--sp-block) 0}
.rs-track{position:relative;height:5px;border-radius:var(--r-pill);background:var(--panel3);
  border:1px solid var(--line);box-shadow:inset 0 1px 2px rgba(0,0,0,.16)}
.rs-track i{position:absolute;top:-4.5px;bottom:-4.5px;width:3px;margin-left:-1.5px;border-radius:var(--r-xs);
  background:var(--rank-c,var(--accent));
  box-shadow:0 0 0 3px color-mix(in srgb,var(--rank-c,var(--accent)) 20%,transparent)}
.rs-ticks{position:relative;height:15px;margin-top:5px}
.rs-ticks span{position:absolute;top:0;transform:translateX(-50%);font-size:var(--fs-10);color:var(--mut2);
  font-family:var(--font-num);letter-spacing:-.2px}
.rs-ticks span:first-child{transform:none}
.rs-ticks span.rt-end{transform:translateX(-100%)}

/* ---- 三个口径一栏 ---- */
.rank-kv{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}
.rank-kv span{display:inline-flex;align-items:center;gap:5px;white-space:nowrap;
  font-size:var(--fs-11);color:var(--mut);background:var(--panel2);border:1px solid var(--line);
  border-radius:var(--r-sm);padding:4px 9px;font-variant-numeric:tabular-nums}
.rank-kv span b{color:var(--mut2);font-weight:600}
.rank-kv span i{font-style:normal;font-family:var(--font-num);font-weight:700;color:var(--txt)}
.rank-kv span em{font-style:normal;font-family:var(--font-num);color:var(--mut)}

/* ---- 环比 + 还差多远 ---- */
.rank-delta{display:flex;align-items:center;gap:7px;flex-wrap:wrap;font-size:var(--fs-12);font-weight:700;
  padding-top:10px;border-top:1px dashed var(--line)}
.rank-delta .rd-up{color:var(--up)} .rank-delta .rd-down{color:var(--down)}
.rank-delta .rd-flat{color:var(--mut)}
.rank-delta .rd-why{font-size:var(--fs-11);font-weight:500;color:var(--mut2)}
.rank-gap{margin-top:9px;font-size:var(--fs-12);line-height:1.7;color:var(--txt);border-radius:var(--r-md);
  padding:8px 11px;background:color-mix(in srgb,var(--accent) 9%,transparent);
  border:1px solid color-mix(in srgb,var(--accent) 26%,var(--line))}
.rank-gap .rd-why{color:var(--mut2);font-size:var(--fs-11)}
.rank-gap b{color:color-mix(in srgb,var(--accent) 66%,var(--txt))}

/* ---- 榜首 10 名 + 上下邻居 ---- */
.rank-block{margin-top:var(--sp-card)}
.rank-h{display:flex;align-items:center;gap:10px;margin:0 0 var(--sp-tight)}
.rank-h .rh-t{font-size:var(--fs-12);font-weight:700;letter-spacing:.3px;color:var(--mut)}
.rank-h::after{content:"";flex:1;height:1px;background:var(--line)}
.rank-list{background:var(--panel);border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden;
  box-shadow:var(--card-shadow)}
.rank-row{display:grid;grid-template-columns:46px minmax(0,1fr) minmax(0,168px) 96px;align-items:center;
  gap:10px;padding:9px 14px;border-bottom:1px solid var(--line);font-size:var(--fs-12);
  transition:background .15s ease}
.rank-row:last-child{border-bottom:0}
.rank-row:hover{background:var(--panel2)}
.rank-row .rr-rank{font-family:var(--font-num);font-size:var(--fs-11);font-weight:700;color:var(--mut2)}
.rank-row .rr-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:600}
.rank-row .rr-cat{font-size:var(--fs-11);color:var(--mut2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rank-row .rr-val{font-family:var(--font-num);font-weight:700;text-align:right;font-variant-numeric:tabular-nums}
.rank-row.me{background:color-mix(in srgb,var(--accent) 12%,transparent);box-shadow:inset 3px 0 0 var(--accent)}
.rank-row.me .rr-name{font-weight:800;color:var(--txt)}
.rank-row.me .rr-rank,.rank-row.me .rr-val{color:var(--accent)}
.bb-row .rr-me,.rank-row .rr-me{font-style:normal;font-size:var(--fs-10);font-weight:800;letter-spacing:.4px;color:var(--accent);
  background:color-mix(in srgb,var(--accent) 16%,transparent);
  border:1px solid color-mix(in srgb,var(--accent) 40%,var(--line));border-radius:var(--r-xs);
  padding:1px 6px;margin-left:7px;vertical-align:1px;white-space:nowrap}
.rank-near{margin-top:var(--sp-card);align-items:start}
@media(max-width:680px){
  .rank-card{padding:13px 13px 13px 16px}
  .rank-big{font-size:30px}
  .rank-row{grid-template-columns:38px minmax(0,1fr) 84px;gap:8px;padding:8px 11px}
  .rank-row .rr-cat{display:none}
  .rs-ticks .rt-1000{display:none}
  .rank-updated{margin-left:0;flex-basis:100%}
}

/* ---------- 回购与销毁：链上真实烧毁量 + 全行业回购强度 ---------- */
.burn-card{position:relative;background:var(--panel);border:1px solid var(--line);border-radius:var(--r-lg);
  padding:14px 16px 13px 19px;box-shadow:var(--card-shadow);overflow:hidden}
.burn-card::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--bc,var(--accent))}
.burn-head{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
.burn-head .proj-name{font-size:var(--fs-13);font-weight:800}
.burn-head .bn-chain{font-size:var(--fs-11);font-weight:600;color:var(--mut2);background:var(--panel2);
  border:1px solid var(--line);border-radius:var(--r-sm);padding:1px 7px;white-space:nowrap}
.burn-head .bn-link{margin-left:auto;font-size:var(--fs-11);font-weight:700;color:var(--accent);
  text-decoration:none;border:1px solid color-mix(in srgb,var(--accent) 34%,var(--line));
  border-radius:var(--r-sm);padding:3px 9px;white-space:nowrap;transition:background .15s ease}
.burn-head .bn-link:hover{background:color-mix(in srgb,var(--accent) 12%,transparent)}
.burn-big{font-family:var(--font-num);font-variant-numeric:tabular-nums;font-size:30px;font-weight:800;letter-spacing:-.7px;line-height:1.14;
  margin:var(--sp-block) 0 0;font-variant-numeric:tabular-nums}
.burn-big small{font-family:var(--font-ui);font-size:var(--fs-12);font-weight:600;letter-spacing:0;
  color:var(--mut);margin-left:7px}
.burn-bar{height:9px;border-radius:var(--r-pill);background:var(--panel2);border:1px solid var(--line);
  overflow:hidden;margin:12px 0 7px}
.burn-bar i{display:block;height:100%;border-radius:var(--r-pill);background:var(--bc,var(--accent));
  box-shadow:0 0 12px -3px var(--bc,var(--accent))}
.burn-barcap{display:flex;justify-content:space-between;gap:10px;font-size:var(--fs-11);color:var(--mut2)}
.burn-barcap b{color:var(--txt);font-family:var(--font-num);font-weight:800}
.burn-kv{display:flex;gap:6px;flex-wrap:wrap;margin-top:var(--sp-block)}
.burn-kv span{display:inline-flex;align-items:center;gap:5px;white-space:nowrap;font-size:var(--fs-11);
  background:var(--panel2);border:1px solid var(--line);border-radius:var(--r-sm);padding:3px 9px}
.burn-kv span b{color:var(--mut2);font-weight:600}
.burn-kv span i{font-style:normal;font-family:var(--font-num);font-weight:700;color:var(--txt)}
.burn-src{margin-top:10px;font-size:var(--fs-11);color:var(--mut2);line-height:1.6}
.burn-src code{font-family:var(--font-mono);font-size:var(--fs-10);color:var(--mut)}
/* v3.17：进度条改环形（大号百分比在圈里）＋ 销毁速度/下一关一行小字 */
.burn-hero{display:flex;align-items:center;gap:16px;margin-top:var(--sp-block)}
.burn-ring{position:relative;width:122px;height:122px;flex:0 0 auto}
.burn-ring svg{display:block;width:100%;height:100%;transform:rotate(-90deg)}
.burn-ring .brk-trk{fill:none;stroke:var(--panel3);stroke-width:10}
.burn-ring .brk-arc{fill:none;stroke-width:10;stroke-linecap:round;
  filter:drop-shadow(0 2px 9px color-mix(in srgb,var(--bc,var(--accent)) 46%,transparent))}
.brk-c{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px}
.brk-c b{font-family:var(--font-num);font-variant-numeric:tabular-nums;font-size:28px;font-weight:800;letter-spacing:-1.1px;line-height:1}
.brk-c b em{font-style:normal;font-size:14px;font-weight:700;margin-left:1px;color:var(--mut)}
.brk-c span{font-size:var(--fs-10);color:var(--mut2);font-weight:600;letter-spacing:.2px}
.burn-hero-txt{flex:1;min-width:0}
.burn-hero-txt .burn-big{margin:0}
.burn-husd{margin-top:6px;font-size:var(--fs-12);color:var(--mut2)}
.burn-husd b{color:var(--txt);font-family:var(--font-num);font-variant-numeric:tabular-nums;font-weight:800}
@media(max-width:680px){.burn-hero{gap:12px}.burn-ring{width:102px;height:102px}.brk-c b{font-size:23px}}
.burn-mile{margin-top:9px;font-size:var(--fs-11);color:var(--mut2);line-height:1.65}
.burn-mile b{color:var(--txt);font-family:var(--font-num);font-variant-numeric:tabular-nums;font-weight:800}
.burn-mile em{font-style:normal;font-family:var(--font-num);font-size:var(--fs-10);color:var(--mut2);margin-left:6px}
.bb-head{display:grid;grid-template-columns:40px minmax(0,1fr) 116px 116px;align-items:end;gap:10px;
  padding:0 14px 7px;font-size:var(--fs-11);font-weight:700;color:var(--mut2)}
.bb-head span:nth-child(3),.bb-head span:nth-child(4){text-align:right}
.bb-head .on{color:color-mix(in srgb,var(--accent) 76%,var(--txt))}
.bb-head .on::before{content:"● ";font-size:var(--fs-10);vertical-align:1px}
.bb-row{display:grid;grid-template-columns:40px minmax(0,1fr) 116px 116px;align-items:center;gap:10px;
  padding:9px 14px;border-bottom:1px solid var(--line);font-size:var(--fs-12);transition:background .15s ease}
.bb-row:last-child{border-bottom:0}
.bb-row:hover{background:var(--panel2)}
.bb-row .bb-rank{font-family:var(--font-num);font-size:var(--fs-11);font-weight:700;color:var(--mut2)}
.bb-row .bb-name{display:flex;flex-direction:column;align-items:flex-start;min-width:0;font-weight:600;line-height:1.35}
.bb-row .bb-name b{font-weight:inherit;max-width:100%}
.bb-row .bb-name i{font-style:normal;font-size:var(--fs-10);font-weight:500;color:var(--mut2);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bb-row .bb-v{font-family:var(--font-num);font-weight:700;text-align:right;font-variant-numeric:tabular-nums;
  color:var(--mut2);white-space:nowrap}
.bb-row .bb-v.on{color:var(--txt);font-weight:800}
.bb-row.me .bb-v.on{color:var(--accent)}
.bb-row.me{background:color-mix(in srgb,var(--accent) 12%,transparent);box-shadow:inset 3px 0 0 var(--accent)}
.bb-row.me .bb-name{font-weight:800;color:var(--txt)}
.bb-row.me .bb-rank{color:var(--accent)}
.bb-row .bb-v .bb-live{font-style:normal;font-size:var(--fs-10);font-weight:800;color:var(--accent);margin-left:5px}
.bb-note{margin-top:var(--sp-card);background:var(--panel);border:1px solid var(--line);border-radius:var(--r-lg);
  padding:14px 16px;box-shadow:var(--card-shadow);font-size:var(--fs-12);line-height:1.9}
.bb-note .bb-h{font-size:var(--fs-13);font-weight:800;margin-bottom:var(--sp-in)}
.bb-tbl{width:100%;border-collapse:collapse;margin:0 0 10px;font-size:var(--fs-11);
  font-variant-numeric:tabular-nums}
.bb-tbl th{font-weight:600;color:var(--mut2);text-align:right;padding:5px 8px;border-bottom:1px solid var(--line2);
  white-space:nowrap}
.bb-tbl th:first-child{text-align:left}
.bb-tbl td{padding:6px 8px;border-bottom:1px solid var(--line);text-align:right;font-family:var(--font-num);
  font-weight:700;white-space:nowrap}
.bb-tbl td:first-child{text-align:left;font-family:var(--font-ui);font-weight:700}
.bb-tbl tr.me td{background:color-mix(in srgb,var(--accent) 10%,transparent);color:var(--txt)}
.bb-tbl tr.me td:first-child{color:var(--accent)}
.bb-tbl tr:last-child td{border-bottom:0}
.bb-note ul{margin:0;padding-left:17px}
.bb-note li{margin:5px 0}
.bb-note .hl{background:color-mix(in srgb,var(--accent) 20%,transparent);border-radius:var(--r-xs);
  padding:0 4px;font-weight:800;font-variant-numeric:tabular-nums}
.bb-note .bb-foot{margin-top:9px;padding-top:8px;border-top:1px solid var(--line);
  font-size:var(--fs-11);color:var(--mut2);line-height:1.7}
/* ---- v3.0：24h 口径主位（用户最关心「今天烧了多少」）---- */
.burn-tabs{margin:0 0 var(--sp-tight)}
.burn-tabs .tab{padding:5px 13px}
.bb-lag{margin:8px 2px 0;font-size:var(--fs-11);color:var(--mut2);line-height:1.75}
.bb-lag b{color:var(--txt);font-weight:700}
.bb-lag .lk{color:var(--accent);font-weight:700}
.burn-kv span.live{background:color-mix(in srgb,var(--accent) 13%,var(--panel2));
  border-color:color-mix(in srgb,var(--accent) 34%,var(--line))}
.burn-kv span.live b{color:color-mix(in srgb,var(--accent) 62%,var(--mut2))}
.burn-kv span.live i{color:color-mix(in srgb,var(--accent) 74%,var(--txt));font-weight:800}
.burn-kv span.live em{font-style:normal;font-size:var(--fs-10);font-weight:800;letter-spacing:.3px;
  color:var(--accent);background:color-mix(in srgb,var(--accent) 17%,transparent);border-radius:var(--r-xs);padding:1px 5px}
.burn-kv span.wait i{color:var(--mut2);font-weight:700}
.bb-row .bb-val.hl{color:color-mix(in srgb,var(--accent) 66%,var(--txt))}
.bb-row.me .bb-val.hl{color:var(--accent)}
.bb-tbl th.c24{color:color-mix(in srgb,var(--accent) 78%,var(--txt))}
.bb-tbl td.c24{color:color-mix(in srgb,var(--accent) 66%,var(--txt))}
.bb-tbl tr.me td.c24{color:var(--accent)}
.bb-row .bb-live{font-style:normal;font-size:var(--fs-10);font-weight:800;color:var(--accent);
  background:color-mix(in srgb,var(--accent) 16%,transparent);border-radius:var(--r-xs);padding:1px 5px;
  margin-left:6px;vertical-align:1px;white-space:nowrap}
.bb-tbl .bb-tag{font-style:normal;font-size:var(--fs-10);font-weight:700;color:var(--mut2);margin-left:4px}
.rank-sub .lk{color:var(--accent);font-weight:700}
.rank-sub .lk.mut{color:var(--mut2);font-weight:600}
.burn-kv .h24tx{font-style:normal;font-family:var(--font-num);font-size:var(--fs-10);color:var(--mut2)}
@media(max-width:680px){
  .burn-big{font-size:26px}
  .bb-row,.bb-head{grid-template-columns:42px minmax(0,1fr) 74px 80px;gap:6px;padding:8px 11px}
  .bb-chainrk{padding:1px 6px}
  .bb-tbl td:first-child,.bb-tbl th:first-child{padding-left:12px}
  .bb-head{padding:0 11px 6px;font-size:var(--fs-10)}
  .bb-row .bb-name i{font-size:var(--fs-10)}
  .bb-tbl{font-size:var(--fs-10)}
  .bb-tbl th,.bb-tbl td{padding:5px 5px}
  .bb-note{padding:12px 13px}
  .burn-tabs .tab{padding:5px 11px;font-size:var(--fs-10)}
  .burn-tabs{margin-bottom:8px}
  .bb-lag{font-size:var(--fs-10)}
  /* 24h 小卡里塞了「金额 + 笔数 + 来源」，手机上允许它在胶囊内部换行，避免把卡片撑破 */
  .burn-kv span.live{white-space:normal;flex-wrap:wrap;max-width:100%;row-gap:2px}
  .burn-kv{flex-wrap:wrap}
  .burn-kv span{max-width:100%}
  .bb-tbl{display:block;overflow-x:auto;-webkit-overflow-scrolling:touch}
  /* 手机上让表头折两行，5 列就不用横向滚了 */
  .bb-tbl th{white-space:normal;line-height:1.25;font-size:var(--fs-10);padding:5px 4px}
  .bb-tbl td{padding:5px 4px}
  .bb-tbl td:first-child{padding-left:2px}
}

/* ---------- 行情 BGM：涨听《逍遥仙》· 跌听《兄弟抱一下》 ---------- */
.bgm{position:fixed;right:16px;bottom:16px;z-index:130;display:flex;flex-direction:column;align-items:flex-end;
  gap:8px;width:min(356px,calc(100vw - 32px));pointer-events:none}
.bgm>*{pointer-events:auto}
.bgm-card{display:flex;align-items:center;gap:9px;padding:8px 14px 8px 11px;border-radius:var(--r-pill);
  background:color-mix(in srgb,var(--panel) 86%,transparent);
  -webkit-backdrop-filter:blur(16px) saturate(150%);backdrop-filter:blur(16px) saturate(150%);
  border:1px solid var(--line2);color:var(--txt);cursor:pointer;font-family:inherit;text-align:left;
  box-shadow:0 14px 34px -20px rgba(0,0,0,.9);
  transition:border-color .28s ease,box-shadow .28s ease,transform .12s ease}
.bgm-card:hover{transform:translateY(-1px)}
.bgm.up .bgm-card{border-color:color-mix(in srgb,var(--up) 52%,var(--line2));
  box-shadow:0 14px 36px -20px color-mix(in srgb,var(--up) 65%,transparent)}
.bgm.down .bgm-card{border-color:color-mix(in srgb,var(--down) 52%,var(--line2));
  box-shadow:0 14px 36px -20px color-mix(in srgb,var(--down) 65%,transparent)}
.bgm-eq{display:inline-flex;align-items:flex-end;gap:2.5px;height:14px;width:15px;flex:0 0 15px}
.bgm-eq i{width:3px;height:4px;border-radius:var(--r-xs);background:var(--mut2);transform-origin:bottom;
  transition:background .28s ease}
.bgm.up .bgm-eq i{background:var(--up)} .bgm.down .bgm-eq i{background:var(--down)}
.bgm.live .bgm-eq i{animation:bgmEq 1.05s ease-in-out infinite}
.bgm-eq i:nth-child(2){animation-delay:.16s} .bgm-eq i:nth-child(3){animation-delay:.32s}
@keyframes bgmEq{0%,100%{height:4px}50%{height:14px}}
@media (prefers-reduced-motion:reduce){.bgm.live .bgm-eq i{animation:none;height:8px}}
.bgm-txt{display:flex;flex-direction:column;line-height:1.3}
.bgm-t{font-size:var(--fs-12);font-weight:700;letter-spacing:-.1px;white-space:nowrap}
.bgm-cv{display:none;align-items:center;justify-content:center;width:19px;height:19px;flex:0 0 19px;
  border-radius:50%;color:var(--mut);font-size:var(--fs-10);line-height:1;background:var(--panel2);
  border:1px solid var(--line);transition:transform .28s ease,color .2s ease,background .2s ease}
.bgm.on .bgm-cv{display:inline-flex}
.bgm.det .bgm-cv{transform:rotate(180deg)}
.bgm-cv:hover{color:var(--txt);background:var(--panel3)}
.bgm-s{font-size:var(--fs-10);color:var(--mut);font-variant-numeric:tabular-nums;white-space:nowrap}
.bgm-det{display:none;width:100%;background:color-mix(in srgb,var(--panel) 92%,transparent);
  -webkit-backdrop-filter:blur(18px) saturate(150%);backdrop-filter:blur(18px) saturate(150%);
  border:1px solid var(--line);border-radius:var(--r-lg);padding:12px 14px;
  box-shadow:0 20px 44px -26px rgba(0,0,0,.95)}
.bgm.det .bgm-det{display:block;animation:bgmIn .34s cubic-bezier(.32,.72,0,1)}
@keyframes bgmIn{from{opacity:0;transform:translateY(9px) scale(.985)}to{opacity:1;transform:none}}
.bgm-head{display:flex;align-items:center;justify-content:space-between;gap:8px}
.bgm-head b{font-size:var(--fs-16);font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:-.4px}
.bgm-head b.u{color:var(--up)} .bgm-head b.d{color:var(--down)}
.bgm-labw{display:inline-flex;align-items:baseline;gap:7px;min-width:0}
.bgm-hl{font-size:var(--fs-11);color:var(--mut2);letter-spacing:.2px;white-space:nowrap}
.bgm-tag{font-size:var(--fs-10);font-weight:700;letter-spacing:.6px;padding:2px 9px;border-radius:var(--r-pill);
  border:1px solid var(--line2);color:var(--mut);white-space:nowrap}
.bgm-tag.up{color:var(--up);border-color:color-mix(in srgb,var(--up) 48%,var(--line2));
  background:color-mix(in srgb,var(--up) 12%,transparent)}
.bgm-tag.down{color:var(--down);border-color:color-mix(in srgb,var(--down) 48%,var(--line2));
  background:color-mix(in srgb,var(--down) 12%,transparent)}
.bgm-legend{font-size:var(--fs-10);color:var(--mut2);line-height:1.62;margin:5px 0 8px;white-space:pre-line}
.bgm-prow{display:flex;align-items:center;gap:9px;font-size:var(--fs-11);padding:5px 0;
  border-top:1px dashed var(--line);flex-wrap:wrap}
.bgm-pn{display:inline-flex;align-items:center;gap:6px;font-weight:700;min-width:70px}
.bgm-pn i{width:6px;height:6px;border-radius:50%;display:inline-block}
.bgm-pv{font-weight:700;font-variant-numeric:tabular-nums;min-width:56px}
.bgm-pv.u{color:var(--up)} .bgm-pv.d{color:var(--down)}
.bgm-pd{color:var(--mut2);font-size:var(--fs-10);margin-left:auto;flex:0 0 auto;font-variant-numeric:tabular-nums}
.bgm-src{font-size:var(--fs-10);color:var(--mut2);line-height:1.62;margin-top:9px;
  border-top:1px dashed var(--line);padding-top:8px}
@media(max-width:640px){.bgm{right:12px;bottom:12px;width:min(330px,calc(100vw - 24px))}}

/* ---------- 共勉：名片中间那一句（BGM 一开口，这里就让位给歌词） ---------- */
.qbox{flex:1 1 180px;min-width:0;display:flex;align-items:center;gap:12px;
  opacity:0;transition:opacity .5s ease}
.qbox.hidden{display:none}         /* 有歌词时整块收掉，不留半透明残影 */
.qbox.on{opacity:1}
.qtext{position:relative;flex:1 1 auto;min-width:0;padding-left:13px;
  font-size:var(--fs-13);font-weight:500;line-height:1.6;color:var(--txt);letter-spacing:.15px;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.qtext::before{content:"";position:absolute;left:0;top:3px;bottom:3px;width:2px;border-radius:var(--r-xs);
  background:linear-gradient(180deg,var(--pons),var(--stonk));opacity:.8}
@media(max-width:900px){.qbox{flex:1 1 100%}}

/* 点赞：只加不减、可连点；心形和数字都在一个胶囊里 */
:root{--like:#ff6b8a}
:root[data-theme="light"]{--like:#e0325a}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]):not([data-theme="light"]){--like:#e0325a}}
.q-like{position:relative;flex:0 0 auto;margin-left:auto;display:inline-flex;align-items:center;gap:7px;
  padding:7px 14px;border-radius:var(--r-pill);cursor:pointer;
  border:1px solid color-mix(in srgb,var(--like) 22%,var(--line2));
  background:color-mix(in srgb,var(--like) 7%,var(--panel2));
  color:var(--txt);font-size:var(--fs-12);font-weight:800;letter-spacing:-.2px;
  font-family:inherit;font-variant-numeric:tabular-nums;
  transition:border-color .22s ease,color .22s ease,background .22s ease,transform .12s ease}
.q-like:hover{border-color:var(--like);color:var(--like)}
.q-like:active{transform:scale(.97)}
.q-like svg{width:14px;height:14px;display:block;overflow:visible;color:var(--like)}
.q-like svg path{fill:none;stroke:currentColor;stroke-width:1.7;stroke-linejoin:round;transition:fill .22s ease}
.q-like b{display:inline-block;min-width:13px;text-align:center}
.q-like.hit{border-color:color-mix(in srgb,var(--like) 55%,var(--line2));color:var(--like);
  background:color-mix(in srgb,var(--like) 13%,transparent)}
.q-like.hit svg path{fill:var(--like)}
/* 撒花：点一次赞在按钮上方炸开一小把彩纸（canvas 贴在按钮上，纯装饰） */
.q-confetti{position:fixed;pointer-events:none;z-index:150;display:none}
/* 点下去时飘一个 +1 上去 */
.q-plus{position:absolute;left:50%;top:-3px;transform:translateX(-50%);font-size:var(--fs-11);font-weight:800;
  color:var(--like);opacity:0;pointer-events:none;letter-spacing:-.2px}
.q-like.plus .q-plus{animation:qPlus .95s cubic-bezier(.32,.72,0,1)}
@keyframes qPlus{0%{opacity:0;transform:translateX(-50%) translateY(3px) scale(.85)}
  22%{opacity:1;transform:translateX(-50%) translateY(-5px) scale(1.08)}
  100%{opacity:0;transform:translateX(-50%) translateY(-26px) scale(1)}}
@keyframes qPop{0%{transform:scale(1)}32%{transform:scale(1.42)}62%{transform:scale(.9)}100%{transform:scale(1)}}
.q-like.pop svg,.q-like.pop b{animation:qPop .46s cubic-bezier(.32,.72,0,1)}
@media (prefers-reduced-motion:reduce){
  .q-like.pop svg,.q-like.pop b{animation:none}
  .q-like.plus .q-plus{animation:none}
}

/* ---------- 小时监控（最近 72 小时） ---------- */
.hourly-box{background:var(--panel);border:1px solid var(--line);border-radius:var(--r-lg);
  padding:14px 16px 10px;box-shadow:var(--card-shadow);position:relative}
/* 当前小时：默认就摆着，不用悬停也能看到；查看某根柱子时先让位（和提示框数据重复） */
.hourly-now{position:absolute;right:14px;top:12px;z-index:3;pointer-events:none;
  background:color-mix(in srgb,var(--panel2) 86%,transparent);border:1px solid var(--line2);
  border-radius:var(--r-md);padding:8px 11px;min-width:172px;box-shadow:var(--card-shadow);
  backdrop-filter:blur(6px);transition:opacity .18s ease,transform .18s ease}
.hourly-now.hide{opacity:0;transform:translateY(-4px)}
.hourly-now .h{font-size:var(--fs-10);color:var(--mut2);margin-bottom:5px;letter-spacing:.3px}
.hourly-now .r{display:flex;justify-content:space-between;gap:10px;font-size:var(--fs-11);color:var(--mut)}
.hourly-now .r b{font-family:var(--font-num);font-size:var(--fs-12);color:var(--txt)}
.hourly-now .r.p b{color:var(--pons)}
.hourly-now .r.s b{color:var(--stonk)}
.hourly-now .r em{font-style:normal;font-size:var(--fs-10);color:var(--mut2);font-family:inherit}
/* 鼠标划过任意一根柱子：自绘提示框（原生 title 太慢/在手机上不出现） */
.hourly-tipbox{position:absolute;z-index:6;display:none;pointer-events:none;
  background:var(--panel);border:1px solid var(--line2);border-radius:var(--r-md);padding:8px 10px;
  box-shadow:0 12px 28px rgba(0,0,0,.24);white-space:nowrap;transform:translate(-50%,-112%)}
.hourly-tipbox .t{font-size:var(--fs-10);color:var(--mut2);margin-bottom:5px}
.hourly-tipbox .r{font-size:var(--fs-11);color:var(--mut);display:flex;justify-content:space-between;gap:12px}
.hourly-tipbox .r b{font-family:var(--font-num);font-size:var(--fs-12);color:var(--txt);margin-left:6px}
.hourly-tipbox .r.p b{color:var(--pons)}
.hourly-tipbox .r.s b{color:var(--stonk)}
.hourly-tipbox .r em{font-style:normal;font-size:var(--fs-10);color:var(--mut2);font-family:inherit}
.hourly-hl{fill:var(--accent);opacity:0;transition:opacity .12s ease}
.hourly-hl.on{opacity:.09}
.hourly-legend{display:flex;flex-wrap:wrap;gap:14px;align-items:center;
  font-size:var(--fs-11);color:var(--mut);margin-bottom:10px}
.hourly-legend .lg{display:inline-flex;align-items:center;gap:6px}
.hourly-legend .lg i{width:9px;height:9px;border-radius:var(--r-xs);display:inline-block;font-style:normal}
.hourly-legend b{color:var(--txt);font-family:var(--font-num)}
.hourly-legend .lg em{font-style:normal;color:var(--mut2);font-size:var(--fs-10)}
:root{--chart-h:270px}
#hourlyChart{width:100%;height:var(--chart-h);display:block}
/* 坐标轴文字：从 SVG 里搬出来用原生 HTML 渲染 —— SVG 被 preserveAspectRatio="none"
   横向压扁后，里面 10px 的字在手机上只剩 6~7px 且被拉变形（2026-10-07 用户反馈「模糊」）。
   这一层正好盖住图表区域（负 margin 等高铁），百分比定位跟着图表一起缩放，缩放窗口也不用重算。 */
.hourly-marks{position:relative;height:var(--chart-h);margin-top:calc(-1 * var(--chart-h));
  pointer-events:none;z-index:2}
.hourly-marks i{position:absolute;font-style:normal;font-size:var(--fs-10);font-family:var(--font-mono);
  color:var(--mut2);white-space:nowrap;line-height:1;font-variant-numeric:tabular-nums;letter-spacing:.2px}
.hourly-marks i.x{bottom:7px;transform:translateX(-50%)}
.hourly-marks i.x.l{transform:none}
.hourly-marks i.x.r{transform:translateX(-100%)}
.hourly-marks i.y{left:4px}
@media(max-width:680px){.hourly-marks i.x[data-alt]{display:none}}
.hourly-grid{stroke:var(--line);stroke-width:1;stroke-dasharray:3 5;opacity:.8}
.hourly-bar{cursor:default;transition:opacity .15s ease}
.hourly-bar:hover{opacity:.66}
.hourly-sum{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:var(--sp-block)}
.hourly-sum>div{background:var(--panel);border:1px solid var(--line);border-radius:var(--r-md);padding:9px 11px}
.hourly-sum .k{font-size:var(--fs-10);color:var(--mut);margin-bottom:5px;letter-spacing:.2px}
/* 汇总卡：两家上下两行（一行时两组数字挨太近、不好区分）；不要椭圆框；数字与代币名字号一致，仅靠颜色区分 */
.hourly-sum .v{display:flex;flex-direction:column;align-items:flex-start;row-gap:1px;
  font-size:var(--fs-13);font-weight:700;font-family:var(--font-num);letter-spacing:-.2px;line-height:1.5}
.hourly-sum .v .pair{display:inline-flex;align-items:baseline;gap:5px;white-space:nowrap}
.hourly-sum .v .pair i{font-style:normal;font-family:inherit;font-size:var(--fs-13);font-weight:600;color:var(--mut2)}
.hourly-sum .v .pair.p b{color:var(--pons)}
.hourly-sum .v .pair.s b{color:var(--stonk)}
.hourly-note{font-size:var(--fs-11);color:var(--mut);line-height:1.8;margin-top:var(--sp-block);
  background:var(--panel2);border:1px solid var(--line);border-radius:var(--r-md);padding:9px 12px}
.hourly-note b{color:var(--txt)}
.sec-live{font-size:var(--fs-10);font-weight:600;color:var(--ok-txt);margin-left:8px;letter-spacing:0}
.sec-live.off{color:var(--mut2)}
.sec-live.est{color:var(--warn)}
/* ---------- 市场占有率 · 24 小时成交量份额（v3.14） ---------- */
.share-card{position:relative;background:var(--panel);border:1px solid var(--line);border-radius:var(--r-lg);
  padding:14px 16px 13px 19px;box-shadow:var(--card-shadow);overflow:hidden}
.share-card::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--sc,var(--accent))}
.share-head{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
.share-head .sh-name{font-size:var(--fs-13);font-weight:800}
.share-head .sh-name i{font-style:normal;font-size:var(--fs-10);font-weight:700;color:var(--mut2);margin-left:5px;letter-spacing:.4px}
.share-head .sh-chain{margin-left:auto;font-size:var(--fs-11);font-weight:600;color:var(--mut2);background:var(--panel2);
  border:1px solid var(--line);border-radius:var(--r-sm);padding:1px 7px;white-space:nowrap}
.share-big{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap;margin:var(--sp-block) 0 0}
.share-big b{font-family:var(--font-num);font-variant-numeric:tabular-nums;font-size:31px;font-weight:800;
  letter-spacing:-.8px;line-height:1.08;color:var(--sc,var(--accent))}
.share-big span{font-size:var(--fs-12);font-weight:600;color:var(--mut)}
.share-bar{position:relative;height:9px;border-radius:var(--r-pill);background:var(--panel2);border:1px solid var(--line);
  overflow:hidden;margin:12px 0 7px}
.share-bar i{position:absolute;left:0;top:0;bottom:0;min-width:3px;border-radius:var(--r-pill);background:var(--sc,var(--accent));
  box-shadow:0 0 12px -3px var(--sc,var(--accent))}
.share-bar u{position:absolute;top:0;bottom:0;width:2px;background:color-mix(in srgb,var(--warn) 82%,transparent)}
.share-caps{display:flex;justify-content:space-between;gap:10px;font-size:var(--fs-11);color:var(--mut2)}
.share-caps b{color:var(--txt);font-family:var(--font-num);font-weight:800}
.share-kv{display:flex;gap:6px;flex-wrap:wrap;margin-top:var(--sp-block)}
.share-kv span{display:inline-flex;align-items:center;gap:5px;white-space:nowrap;font-size:var(--fs-11);
  background:var(--panel2);border:1px solid var(--line);border-radius:var(--r-sm);padding:3px 9px}
.share-kv span b{color:var(--mut2);font-weight:600}
.share-kv span i{font-style:normal;font-family:var(--font-num);font-weight:700;color:var(--txt)}
.share-kv span i.up{color:var(--up)}
.share-kv span i.down{color:var(--down)}
.share-spark{display:flex;align-items:center;gap:10px;margin-top:11px}
.share-spark svg{flex:1;height:30px;min-width:0;color:var(--sc,var(--accent))}
.share-spark .sh-spk{font-size:var(--fs-10);color:var(--mut2);white-space:nowrap}
.share-vs{margin-top:var(--sp-block);border-top:1px dashed var(--line2);padding-top:11px}
.share-vs .sh-vs-h{font-size:var(--fs-11);font-weight:800;color:var(--mut);margin-bottom:7px}
.share-vs .sh-vs-h em{font-style:normal;font-weight:600;color:var(--mut2);font-size:var(--fs-10)}
.share-vsbar{display:flex;height:9px;border-radius:var(--r-pill);overflow:hidden;background:var(--panel2);border:1px solid var(--line)}
.share-vsbar i{display:block;height:100%}
.share-vsbar i.a{min-width:3px;background:var(--stonk)}
.share-vsbar i.b{background:color-mix(in srgb,var(--warn) 70%,transparent)}
.share-vscap{display:flex;justify-content:space-between;gap:10px;font-size:var(--fs-10);color:var(--mut2);margin-top:5px}
.share-vscap b{font-family:var(--font-num);font-weight:800;color:var(--txt)}
.share-vsline{margin-top:7px;font-size:var(--fs-11);color:var(--mut);line-height:1.75}
.share-vsline b{color:var(--txt);font-family:var(--font-num);font-weight:800}
.share-note{margin-top:var(--sp-card);background:var(--panel);border:1px solid var(--line);border-radius:var(--r-lg);
  padding:14px 16px;box-shadow:var(--card-shadow);font-size:var(--fs-12);line-height:1.9}
.share-note .bb-h{font-size:var(--fs-13);font-weight:800;margin-bottom:var(--sp-in)}
.share-note .bb-h em{font-style:normal;font-size:var(--fs-10);font-weight:600;color:var(--mut2);margin-left:7px}
.rank-sub a.qi{display:inline-block;width:15px;height:15px;line-height:14px;text-align:center;border-radius:50%;
  font-size:var(--fs-10);font-weight:800;color:var(--mut2);background:var(--panel2);border:1px solid var(--line);
  text-decoration:none;vertical-align:-3px;transition:transform .15s ease,color .15s ease,border-color .15s ease}
.rank-sub a.qi:hover,.rank-sub a.qi:focus-visible{color:var(--accent);
  border-color:color-mix(in srgb,var(--accent) 40%,var(--line));transform:scale(1.12)}
@media(max-width:680px){.share-big b{font-size:27px}}
@media(max-width:680px){
  :root{--chart-h:200px}
  .hourly-sum{grid-template-columns:repeat(2,1fr)}
  .hourly-box{padding:12px 12px 8px}
  /* 手机端：当前小时卡片改成图下通栏，两个代币左右分列（2026-10-06 重排） */
  .hourly-now{position:static;margin:8px 0 2px;min-width:0;display:block;padding:9px 12px}
  .hourly-now .h{margin:0 0 6px}
  .hourly-now .hv{display:grid;grid-template-columns:1fr 1fr;gap:2px 14px}
  .hourly-now .hv .r{align-items:baseline;gap:8px}
  .hourly-now .hv .r.s{padding-left:14px;border-left:1px dashed var(--line2)}
  .hourly-now .r b{font-size:var(--fs-14)}
  .hourly-tipbox{max-width:200px}
}

/* ============================================================
   v3.11 视觉精修 · 顶级画风
   同一个圆（四档圆角）· 同一个刻度（七档字号）· 同一套景深（三级阴影）
   ------------------------------------------------------------
   纯样式层：不动数据、不动接口、不动文案键
   ============================================================ */

/* --- 背景氛围：顶部主光晕 + 右上副光晕 + 极淡点阵（只在上半屏显影） --- */
body::before{height:520px;
  background:radial-gradient(820px 380px at 50% -120px,var(--glow),transparent 72%),
             radial-gradient(560px 300px at 86% 2%,var(--glow2),transparent 68%)}
body::after{content:"";position:fixed;inset:0;pointer-events:none;z-index:0;opacity:.55;
  background-image:radial-gradient(circle at center,color-mix(in srgb,var(--txt) 8%,transparent) 1px,transparent 1.1px);
  background-size:28px 28px;background-position:center top;
  -webkit-mask-image:radial-gradient(820px 460px at 50% 0,#000 6%,transparent 72%);
          mask-image:radial-gradient(820px 460px at 50% 0,#000 6%,transparent 72%)}
::selection{background:color-mix(in srgb,var(--accent) 32%,transparent)}

/* --- 顶栏：品牌标 + 标题主次 --- */
h1{display:flex;align-items:center;flex-wrap:wrap;row-gap:3px;font-weight:800}
h1 .brand{display:inline-flex;flex:0 0 auto;align-items:center;margin-right:11px;
  filter:drop-shadow(0 4px 12px color-mix(in srgb,var(--pons) 32%,transparent))}
h1 .brand svg{display:block}
h1 #h1t{font-size:var(--fs-16);font-weight:800;color:var(--txt);letter-spacing:-.25px;margin-left:0}
h1 #gen{font-size:var(--fs-11);font-weight:500;color:var(--mut);margin-left:10px;letter-spacing:.1px}

/* --- 卡片：一线顶部提亮，让面板「浮」起来 --- */
.card,.chartbox,.srcbox,.summary,.rank-list,.burn-card{
  background-image:var(--card-sheen);background-repeat:no-repeat;background-position:top}

/* --- 区块标题：左侧一段渐变小竖条，扫读更有节奏 --- */
.sec-title{gap:10px;letter-spacing:.72px;font-weight:700}
.sec-title::before{content:"";flex:0 0 auto;width:3px;height:12px;border-radius:var(--r-pill);
  background:linear-gradient(180deg,var(--pons),var(--stonk));opacity:.8}

/* --- 价格：等宽数字 + 收紧字距，两个币上下对齐一眼比大小 --- */
.price .p{font-family:var(--font-num);font-variant-numeric:tabular-nums;font-weight:700;letter-spacing:-.45px}
.price .p small{letter-spacing:-.2px}

/* --- 控件手感：按钮 / 标签页 / 问号 --- */
button{padding:6px 13px;transition:background .16s ease,border-color .16s ease,transform .08s ease,box-shadow .16s ease}
button:hover{background:var(--panel3);border-color:var(--line2);box-shadow:var(--sh-1)}
button:active{box-shadow:none}
.tab{transition:color .16s ease,background .16s ease,border-color .16s ease,box-shadow .2s ease}
.tab.on{box-shadow:0 10px 24px -14px var(--accent),0 0 0 3px color-mix(in srgb,var(--accent) 18%,transparent)}
.kv>div{padding:10px 12px}
.kv .qi{width:14px;height:14px;line-height:12px;font-size:var(--fs-10);vertical-align:-3px;
  background:var(--panel);transition:color .18s ease,background .18s ease,border-color .18s ease,transform .18s ease}
.kv .qi:hover,.kv .qi:focus-visible{transform:scale(1.12)}

/* --- 细滚动条（不抢视线，但比系统默认更利落） --- */
*::-webkit-scrollbar{width:11px;height:11px}
*::-webkit-scrollbar-track{background:transparent}
*::-webkit-scrollbar-thumb{background:var(--line2);border:3.5px solid transparent;
  background-clip:content-box;border-radius:var(--r-pill)}
*::-webkit-scrollbar-thumb:hover{background:var(--mut2);background-clip:content-box}
*::-webkit-scrollbar-corner{background:transparent}
html{scrollbar-color:var(--line2) transparent;scrollbar-width:thin}

/* --- 表头：吸顶时多一道发丝分隔，滚过内容不糊在一起 --- */
#tbl thead tr.grp th{letter-spacing:.7px}
#tbl thead tr.grp th{box-shadow:inset 0 -1px 0 var(--line)}
#tbl thead tr.grp th.g-pons{box-shadow:inset 0 -1px 0 var(--line),inset 0 -2px 0 var(--pons-dim)}
#tbl thead tr.grp th.g-stonk{box-shadow:inset 0 -1px 0 var(--line),inset 0 -2px 0 var(--stonk-dim)}
@media (prefers-reduced-motion:reduce){.kv .qi{transition:none}}


/* ==========================================================================
   v3.13.1 图标系统 · Phosphor Icons「Fill」实心权重 (phosphoricons.com · MIT)
   —— 全部内联 SVG symbol，无外部请求。改了两件事：
      ① 线性描边 → 实心填充，远看是"块"，比细线条更有分量；
      ② 尺寸分成三档，拉开层次：板块标题 18px（品牌渐变）> 按钮/状态 15px
         > 提示 13~14px > 行内标记 11~12px。
   ========================================================================== */
.ic{width:1em;height:1em;flex:0 0 auto;display:inline-block;vertical-align:-.15em;
  fill:currentColor;stroke:none;pointer-events:none}
/* ① 板块标题：最大 + 品牌渐变（PONS 紫 → STONK 绿），一眼分得出「这是新板块」 */
#icGrad313 .gs1{stop-color:var(--pons)}
#icGrad313 .gs2{stop-color:var(--stonk)}
.sec-title > .ic{width:18px;height:18px;vertical-align:-.22em;fill:url(#icGrad313)}
/* ② 主操作与状态：头部按钮、安全条、打赏入口 */
button .ic,.tbtn .ic,.tip-btn .ic{vertical-align:-.2em}
header button .ic,.tbtn .ic{width:15px;height:15px}
.rank-force .ic{width:14px;height:14px;margin-right:5px}
.safe-line .sf-ic .ic{width:15px;height:15px;color:var(--up)}
.author-tip .ic{width:15px;height:15px}
.tip-mini .tm-ic .ic{width:16px;height:16px}
.tip-card h3 .ic{width:17px;height:17px;margin-right:8px;vertical-align:-.2em;color:var(--warn)}
.tip-thanks .ic{width:16px;height:16px;margin-right:7px;vertical-align:-.2em;color:var(--warn)}
/* ③ 提示与行内标记：越靠后越小，主次一眼分明 */
.alertbar b .ic{width:14px;height:14px;margin-right:5px;vertical-align:-.17em}
.badflag .ic{width:13px;height:13px;margin-right:4px;vertical-align:-.15em}
.bgm-cv .ic{width:12px;height:12px}
.pv .pv-ic .ic{width:13px;height:13px;color:var(--mut)}
.bn-link{display:inline-flex;align-items:center;gap:3px}
.bn-link .ic{width:12px;height:12px}
.bb-row .bb-live{display:inline-flex;align-items:center}
.bb-row .bb-live .ic{width:11px;height:11px}
.rank-sub .ic{width:13px;height:13px;margin-right:1px}
.foot-tip .ic{width:13px;height:13px;color:var(--warn)}
/* 排行榜前三：金属圆牌（比奖牌 emoji 克制，深浅色都稳） */
.rank-row .rr-rank.rk{display:inline-flex;align-items:center;justify-content:center;
  width:19px;height:19px;border-radius:50%;font-size:var(--fs-10);letter-spacing:0;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.42),0 1px 3px rgba(0,0,0,.26)}
.rank-row .rr-rank.rk1{background:linear-gradient(150deg,#ffeeb4,#f0b731 58%,#b8790a);color:#241a04}
.rank-row .rr-rank.rk2{background:linear-gradient(150deg,#f5f8fc,#c6d0de 58%,#8794a8);color:#1b2230}
.rank-row .rr-rank.rk3{background:linear-gradient(150deg,#f8d8b3,#cb8b52 58%,#8f5626);color:#241304}

/* ==========================================================================
   v3.13.2 图标动效层 · 目标：「有提示感，但不吵」
   动效分三类，全部有含义，不是为动而动：
     ① 入场提示 —— 板块滚进视野时，图标胶囊弹一下 + 放一圈淡光（一次性）
     ② 状态提示 —— 链上现读的闪电在呼吸（= 实时）；告警三角每轮渲染轻跳一下（= 要处理）
     ③ 手感提示 —— 悬停时的微反应：主题翻转、刷新倒转、咖啡跳一下、眼睛眨一下
   ========================================================================== */

/* --- 板块图标升级成「胶囊」：底色={PONS 紫 → STONK 绿} 的极淡渐变，图标仍是品牌渐变 --- */
.sec-title::before{display:none}   /* 原来的 3px 竖条退役：胶囊本身就是左侧标记 */
.sec-title > .ic{width:20px;height:20px;padding:4px;box-sizing:content-box;border-radius:9px;
  background:linear-gradient(140deg,
    color-mix(in srgb,var(--pons) 16%,transparent),
    color-mix(in srgb,var(--stonk) 16%,transparent));
  box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--pons) 26%,transparent);
  transition:transform .3s cubic-bezier(.2,1.35,.4,1),box-shadow .3s ease,background .3s ease}
.sec-title:hover > .ic{transform:scale(1.09) rotate(-4deg);
  box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--pons) 40%,transparent),
             0 0 0 3px color-mix(in srgb,var(--pons) 13%,transparent)}

/* --- ① 入场提示：滚到该板块时弹一下 + 放一圈光（一次性，看完就静下来） --- */
.ic-motion .sec-title > .ic{opacity:0}
.ic-motion .sec-title.ic-in > .ic{opacity:1;animation:icPop .68s cubic-bezier(.22,1.38,.4,1) backwards}
@keyframes icPop{
  0%  {opacity:0;transform:scale(.68) translateY(4px);
       box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--pons) 24%,transparent),
                  0 0 0 0 color-mix(in srgb,var(--pons) 42%,transparent)}
  58% {opacity:1;transform:scale(1.09)}
  100%{opacity:1;transform:scale(1);
       box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--pons) 26%,transparent),
                  0 0 0 16px transparent}
}

/* --- ② 状态提示 --- */
/* 链上现读：呼吸 = 这是实时的（只在榜单行的小闪电上，正文里的不动，免得吵） */
.bb-row .bb-live .ic{animation:icBreath 2.8s ease-in-out infinite}
@keyframes icBreath{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(.88)}}
/* 告警：出现时轻跳一下，提醒「这条要处理」（每轮数据刷新重放一次，就是要你看它） */
.alertbar b .ic,.badflag .ic{animation:icAlert 1.5s cubic-bezier(.36,.07,.19,.97) .2s 1 both;transform-origin:50% 65%}
@keyframes icAlert{0%,72%,100%{transform:scale(1) rotate(0)}
  78%{transform:scale(1.16) rotate(-6deg)} 85%{transform:scale(1.1) rotate(5deg)} 92%{transform:scale(1.05) rotate(-2deg)}}
/* 实时圆点（v3.7 起就有）保持不动 */

/* --- ③ 手感提示 --- */
#tbtn .ic{transition:transform .45s cubic-bezier(.2,1.4,.4,1)}
#tbtn:hover .ic{transform:rotate(-22deg) scale(1.08)}
#btnRefresh .ic{transition:transform .45s cubic-bezier(.2,1.4,.4,1)}
#btnRefresh:hover .ic{transform:rotate(-52deg)}
.author-tip .ic,.foot-tip .ic,.tip-mini .ic{transition:transform .35s cubic-bezier(.2,1.4,.4,1)}
.author-tip:hover .ic,.foot-tip:hover .ic,.tip-mini:hover .ic{transform:translateY(-2.5px) rotate(-7deg)}
.pv .ic{transition:transform .2s ease;transform-origin:50% 50%}
.pv:hover .ic{animation:icBlink 1.05s ease-in-out}
@keyframes icBlink{0%,100%{transform:scaleY(1)}42%{transform:scaleY(.12)}58%{transform:scaleY(.12)}}
.bgm-cv .ic{transition:transform .35s cubic-bezier(.2,1.4,.4,1)}
.bgm-card:hover .bgm-cv .ic{transform:translateY(-2px)}
.rank-row .rr-rank.rk{transition:transform .3s cubic-bezier(.2,1.4,.4,1)}
.rank-row:hover .rr-rank.rk{transform:scale(1.14)}

/* --- 无障碍：系统开了「减弱动效」就全部停掉（含入场，直接显示） --- */
@media (prefers-reduced-motion:reduce){
  .ic-motion .sec-title > .ic{opacity:1}
  .sec-title > .ic,.ic-motion .sec-title.ic-in > .ic,
  .bb-row .bb-live .ic,.alertbar b .ic,.badflag .ic,.pv:hover .ic{animation:none!important}
  .sec-title:hover > .ic,#tbtn:hover .ic,#btnRefresh:hover .ic,
  .author-tip:hover .ic,.foot-tip:hover .ic,.tip-mini:hover .ic,
  .rank-row:hover .rr-rank.rk{transform:none}
}
/* ==========================================================================
   v3.13.3（2026-10-05）性能 & 手机端专项
   目标：滚动跟手、首屏不跳、手机上点得到。
   ========================================================================== */

/* --- ① 重绘隔离：行内的小动效不带着整页一起重画（这几类行里都有呼吸点） --- */
.srcrow,.kv>div{contain:layout paint}

/* --- ② 首屏防跳（CLS 0.26 -> ~0）：价格卡在数据落地前先用骨架占住高度 --- */
.card.sk{position:relative;overflow:hidden;box-shadow:none;min-height:var(--cards-h,380px)}
.card.sk::before{content:"";position:absolute;inset:14px;border-radius:12px;
  background:linear-gradient(100deg,
    color-mix(in srgb,var(--mut) 7%,transparent) 0 40%,
    color-mix(in srgb,var(--mut) 14%,transparent) 50%,
    color-mix(in srgb,var(--mut) 7%,transparent) 60% 100%)}
@media(max-width:900px){.card.sk{min-height:var(--cards-h,520px)}}
@media(max-width:680px){.card.sk{min-height:var(--cards-h,610px)}}

/* --- ③ 手机端：每个呼吸点原来 3 层动画，手机上只留 1 层（省电、省 GPU） --- */
@media(max-width:640px){
  .dot::before,.dot::after{animation:none;opacity:.2;transform:scale(1.75)}
}

/* --- ④ 手机端点击目标：一律抬到 38px 上下，手指点得准 --- */
@media(max-width:680px){
  .tabs{gap:8px}
  .tab{padding:9px 13px;min-height:38px;display:inline-flex;align-items:center}
  /* 顶部工具条：手机上一行放不下时整组换行、三个按钮平分一行，
     不再把「系统 / 刷新数据」挤成竖排两字（2026-10-06 用户反馈） */
  header{gap:10px}
  .hdr-right{width:100%;flex-wrap:wrap;row-gap:8px}
  /* 状态条单独占一行；三个按钮平分下一行 —— 谁也不会被挤成竖排两字 */
  .hdr-right .badge{flex:1 1 100%;text-align:center;justify-content:center}
  header .tbtn,#btnRefresh{min-height:38px;padding:8px 10px;flex:1 1 0;min-width:0;justify-content:center;
    white-space:nowrap;display:inline-flex;align-items:center;gap:6px}
  .q-like{min-height:38px;padding:6px 14px}
  /* 共勉长句：手机上整句完整显示，不再截成「…」（2026-10-06 用户反馈） */
  .qtext{display:block;overflow:visible;-webkit-line-clamp:unset;-webkit-box-orient:initial}
  .livechip{min-height:26px;padding:4px 9px}
  .bn-link{min-height:34px;display:inline-flex;align-items:center;padding:6px 10px}
  .kv .qi{position:relative;width:16px;height:16px;line-height:14px}
  .kv .qi::after{content:"";position:absolute;inset:-11px;border-radius:50%}   /* 38px 命中区 */
}

/* --- ⑤ 手机端注解文字抬高：10.5px 在手机上太费眼（动的是全局刻度，所有小字一起抬） --- */
@media(max-width:680px){
  /* v3.22：手机端整体抬一档。11.5px 的中文在手机上偏小、发虚（用户反馈「字体太模糊」），
     主字号 11.5→12.5、12→13.5；只动刻度，布局靠卡片自身换行消化。 */
  :root{--fs-10:11.5px; --fs-11:12.5px; --fs-12:13.5px; --fs-13:14.5px; --fs-14:16px; --fs-16:17.5px}
  .sec-live,.lagtag,#gen,.srcrow .s-from,.tnote{font-weight:600}
  /* 「?」帮助入口：手机上加到 38px 命中区，点得准（原来 15px 极易点空） */
  .k .qi,.rank-sub a.qi{position:relative}
  .k .qi::after,.rank-sub a.qi::after{content:"";position:absolute;inset:-12px;border-radius:50%}
  #st-guide{min-height:38px}                       /* 指标说明的标题即折叠开关，点得着 */
  .rank-force{min-height:34px;display:inline-flex;align-items:center}
}

/* --- ⑥ 手机端表格：日期列吸住左边，右边滑动看全部；滑动提示中英各一份 --- */
.tbl-hint{display:none}
@media(max-width:680px){
  #tbl{min-width:660px}
  #tbl th:first-child,#tbl td:first-child{position:sticky;left:0;z-index:3;
    background:var(--panel);box-shadow:1px 0 0 var(--line)}
  .tbl-hint{display:block;margin:-6px 0 10px;font-size:11.5px;font-weight:600;color:var(--mut);letter-spacing:.2px}
  html[lang="en"] .tbl-hint .zh{display:none}
  html[lang^="zh"] .tbl-hint .en{display:none}
}
</style>
<!-- v3.13.2：先给 <html> 打上 ic-motion，图标入场动画的初始态才不会闪一下（没 JS 时图标照常显示） -->
<script>
document.documentElement.classList.add("ic-motion");
/* v3.13.3：首屏骨架按「上次真实卡高」占位 —— 数据落地时页面几乎不再跳动 */
try{
  var _bk=(window.innerWidth<=680?'m':(window.innerWidth<=900?'t':'d'));
  var _h=localStorage.getItem('ponsCardsH-'+_bk);
  if(_h) document.documentElement.style.setProperty('--cards-h', _h+'px');
}catch(e){}
</script>
</head>
