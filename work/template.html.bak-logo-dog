/* ---------- 收入排行：把 DefiLlama 全站榜单裁成"你的位置" ---------- */
const RANK_METRICS=[{k:'total24h',zh:'24 小时',en:'24H'},{k:'total7d',zh:'7 日',en:'7D'},{k:'total30d',zh:'30 日',en:'30D'}];
const RANK_DAYS={total24h:1,total7d:7,total30d:30};
const RANK_TARGET_IDS=['pons','stonkfun'];
const RANK_TOP_N=10, RANK_NEAR=4, RANK_SLUGS={pons:'pons-v2',stonkfun:'stonkfun'};
let RANK_BY='total24h';

function rankBoard(){ return DATA.leaderboard || BUNDLE.leaderboard || null; }
function rankTabLabel(k){ var m=RANK_METRICS.find(function(x){return x.k===k;}); return m? (LANG==='zh'?m.zh:m.en) : k; }
function rankPos(r,total){ return Math.min(100, Math.log10(Math.max(r,1))/Math.log10(Math.max(total,10))*100); }

/* 前端复刻 leaderboard.py 的裁剪逻辑：刷新时用同一套规则重算 */
function buildRankBoard(protocols){
  var total=protocols.length, board={};
  RANK_METRICS.forEach(function(m){
    var arr=protocols.slice().sort(function(a,b){ return ((b[m.k]||0)-(a[m.k]||0)); });
    var index={}; arr.forEach(function(p,i){ index[p.slug]=i+1; });
    var pack=function(p,r,me){ return {r:r,n:(p.name||'').trim(),c:(p.category||'').trim(),
      v:Math.round((p[m.k]||0)*100)/100, me:!!me}; };
    var o={top:[],near:{},rank:{}};
    arr.slice(0,RANK_TOP_N).forEach(function(p,i){
      o.top.push(pack(p,i+1, RANK_TARGET_IDS.some(function(tid){ return RANK_SLUGS[tid]===p.slug; })));
    });
    RANK_TARGET_IDS.forEach(function(tid){
      o.rank[tid]=index[RANK_SLUGS[tid]]||null;
      var r=o.rank[tid]; if(!r){ o.near[tid]=[]; return; }
      var i=r-1, lo, hi;
      if(r<=RANK_TOP_N){ lo=i; hi=Math.min(total,i+RANK_NEAR*2+1); }   /* 已在 Top10 里 → 只看身后追兵 */
      else { lo=Math.max(0,i-RANK_NEAR); hi=Math.min(total,i+RANK_NEAR+1); }
      var rows=[];
      for(var j=lo;j<hi;j++) rows.push(pack(arr[j],j+1,(j+1)===r));
      o.near[tid]=rows;
    });
    board[m.k]=o;
  });
  return {total:total, board:board, updated:new Date().toISOString(), source:'defillama.com/revenue'};
}

/* 实时刷新：整包 4.2MB 太重，浏览器只下压缩后的 ~860KB，并且缓存 6 小时 */
async function loadLeaderboard(force){
  let cache=null;
  try{ cache=JSON.parse(localStorage.getItem('pons-rank')||'null'); }catch(e){}
  if(cache && cache.d && !force && (Date.now()-cache.t)<6*3600*1000){ DATA.leaderboard=cache.d; return 1; }
  const j=await fetchJSON('https://api.llama.fi/overview/fees?dataType=dailyRevenue&excludeTotalDataChart=true&excludeTotalDataChartBreakdown=true');
  const d=buildRankBoard(j.protocols||[]);
  if(j.updated) d.updated=j.updated;
  DATA.leaderboard=d;
  try{ localStorage.setItem('pons-rank', JSON.stringify({t:Date.now(), d:d})); }catch(e){}
  return 1;
}
async function rankForce(){
  const sub=document.getElementById('rankSub');
  if(sub) sub.textContent=t('rankLoading');
  try{ await loadLeaderboard(true); renderRank(); }
  catch(e){ if(sub) sub.textContent=t('rankNoData'); }
}

function renderRank(){
  const b=rankBoard();
  const sub=document.getElementById('rankSub'), tabs=document.getElementById('rankTabs');
  const cards=document.getElementById('rankCards'), topEl=document.getElementById('rankTop');
  const nearEl=document.getElementById('rankNear'), topH=document.getElementById('rankTopH');
  if(!b){
    if(tabs) tabs.innerHTML=''; if(cards) cards.innerHTML=''; if(topEl) topEl.innerHTML='';
    if(nearEl) nearEl.innerHTML=''; if(topH) topH.textContent='';
    if(sub) sub.innerHTML='<span class="rank-warn">'+t('rankNoData')+'</span>';
    return;
  }
  const data=b.board[RANK_BY]||{};
  const total=b.total, mine=(data.near||{}), rk=(data.rank||{});

  if(sub){
    const up=b.updated? new Date(b.updated).toLocaleString(LANG==='zh'?'zh-CN':'en-GB'):'—';
    sub.innerHTML = t('rankSub')(fmtN(total,0))
      + ' <button class="rank-force" onclick="rankForce()">'+IC.refresh+t('rankRefresh')+'</button>'
      + '<div class="rank-updated">'+t('rankUpdated')(up)+'</div>';
  }
  if(tabs){
    tabs.innerHTML = RANK_METRICS.map(function(m){
      return '<button class="tab'+(m.k===RANK_BY?' on':'')+'" onclick="RANK_BY=\''+m.k+'\';renderRank();">'+rankTabLabel(m.k)+'</button>';
    }).join('');
  }
  const ins=document.getElementById('rankInsight');
  if(ins){
    const r30all=b.board.total30d&&b.board.total30d.rank||{};
    ins.innerHTML = '<span class="ri-t">'+t('rankMonth')+'</span>'+RANK_TARGET_IDS.map(function(tid){
      const p=PROJECTS.find(function(x){return x.id===tid;})||{ticker:tid,color:'var(--mut)'};
      const r=rk[tid], r30=r30all[tid];
      if(!r||!r30) return '';
      const d=r30-r;
      const tail = d>0? '<em class="rd-up">'+t('rankInsightUp')(d)+'</em>'
                 : d<0? '<em class="rd-down">'+t('rankInsightDown')(-d)+'</em>'
                 : '<em class="rd-flat">'+t('rankInsightFlat')+'</em>';
      return '<span class="ri-p"><b style="color:'+p.color+'">'+p.ticker+'</b>'
           + '<i>#'+r30+' → #'+r+'</i>'+tail+'</span>';
    }).join('');
  }

  if(cards){
    cards.innerHTML = RANK_TARGET_IDS.map(function(tid){
      const p=PROJECTS.find(function(x){return x.id===tid;})||{ticker:tid,color:'var(--mut)'};
      const r=rk[tid]; if(!r) return '';
      const rows=mine[tid]||[];
      const meRow=rows.find(function(x){return x.me;})||{v:0};
      const above=(data.top||[]).concat(rows).filter(function(x){return x.r<r;})
                    .sort(function(a,b){return b.r-a.r;})[0];
      const pct=(r/total*100).toFixed(r<=20?1:0);
      const r30=(b.board.total30d.rank||{})[tid];
      let deltaHTML='';
      if(RANK_BY==='total30d' || !r30){ deltaHTML='<span class="rd-flat">'+t('rankDeltaNone')+'</span>'; }
      else{
        const d=r30-r;
        const why=t('rankDeltaWhy')(r30,r);
        if(d>0) deltaHTML='<span class="rd-up">'+t('rankDeltaUp')(Math.abs(d))+'</span> <span class="rd-why">'+why+'</span>';
        else if(d<0) deltaHTML='<span class="rd-down">'+t('rankDeltaDown')(Math.abs(d))+'</span> <span class="rd-why">'+why+'</span>';
        else deltaHTML='<span class="rd-flat">'+t('rankDeltaFlat')+'</span>';
      }
      let gapHTML;
      if(r<=1){ gapHTML='<span class="rd-why">'+t('rankGapTop')+'</span>'; }
      else if(above){
        const need=(above.v-meRow.v)/RANK_DAYS[RANK_BY];
        gapHTML = need>0
          ? t('rankGap')(fmtU(need), above.r, esc(above.n)) + ' <span class="rd-why">'+(LANG==='zh'?'（'+fmtU(above.v)+' vs '+fmtU(meRow.v)+'，同口径）':'('+fmtU(above.v)+' vs '+fmtU(meRow.v)+')')+'</span>'
          : t('rankGapTop');
      } else gapHTML='';
      const ticks=[1,10,100,1000].filter(function(x){return x<total;}).map(function(x){
        return '<span class="rt-'+x+'" style="left:'+rankPos(x,total).toFixed(2)+'%">#'+x+'</span>';
      }).join('')+'<span class="rt-end" style="left:100%">#'+fmtN(total,0)+'</span>';
      return '<div class="rank-card rc-'+tid+'">'
        + '<div class="rank-card-head">'
        +   '<span class="proj-name"><span class="dot" style="background:'+p.color+';color:'+p.color+'"></span>'+p.ticker+'</span>'
        +   '<span class="rank-pct">'+t('rankPct')(pct)+'</span>'
        + '</div>'
        + '<div class="rank-big">#'+r+'<small>'+t('rankOf')+fmtN(total,0)+'</small></div>'
        + '<div class="rank-scale"><div class="rs-track"><i style="left:'+rankPos(r,total).toFixed(2)+'%"></i></div><div class="rs-ticks">'+ticks+'</div></div>'
        + '<div class="rank-kv">'+RANK_METRICS.map(function(m){
            const rr=b.board[m.k]&&b.board[m.k].rank? b.board[m.k].rank[tid]:null;
            const vv=b.board[m.k]&&b.board[m.k].near&&b.board[m.k].near[tid]? (b.board[m.k].near[tid].find(function(x){return x.me;})||{}).v : null;
            return '<span><b>'+rankTabLabel(m.k)+'</b><i>'+(rr?'#'+rr:'—')+'</i><em>'+fmtU(vv)+'</em></span>';
          }).join('')+'</div>'
        + '<div class="rank-delta">'+deltaHTML+'</div>'
        + (gapHTML? '<div class="rank-gap">'+gapHTML+'</div>' : '')
        + '</div>';
    }).join('');
  }

  if(topH) topH.innerHTML = '<span class="rh-t">'+t('rankTopH')+'</span>';
  if(topEl){
    topEl.innerHTML=(data.top||[]).map(function(x,i){
      return '<div class="rank-row'+(x.me?' me':'')+'">'
        + '<span class="rr-rank'+(i<3?' rk rk'+(i+1):'')+'">'+(i<3?(i+1):('#'+x.r))+'</span>'
        + '<span class="rr-name">'+esc(x.n)+'</span>'
        + '<span class="rr-cat">'+esc(x.c)+'</span>'
        + '<span class="rr-val mono">'+fmtU(x.v)+'</span></div>';
    }).join('');
  }
  if(nearEl){
    nearEl.innerHTML = RANK_TARGET_IDS.map(function(tid){
      const p=PROJECTS.find(function(x){return x.id===tid;})||{ticker:tid,color:'var(--mut)'};
      const rows=mine[tid]||[];
      return '<div class="rank-block">'
        + '<div class="rank-h"><span class="rh-t">'+t((rk[tid]&&rk[tid]<=RANK_TOP_N)?'rankBelowH':'rankNearH')(p.ticker)+'</span></div>'
        + '<div class="rank-list">'+rows.map(function(x){
            return '<div class="rank-row'+(x.me?' me':'')+'">'
              + '<span class="rr-rank">#'+x.r+'</span>'
              + '<span class="rr-name">'+esc(x.n)+(x.me?' <em class="rr-me">'+t('rankMe')+'</em>':'')+'</span>'
              + '<span class="rr-cat">'+esc(x.c)+'</span>'
              + '<span class="rr-val mono">'+fmtU(x.v)+'</span></div>';
          }).join('')+'</div></div>';
    }).join('');
  }
}

/* ---------- 回购与销毁：链上真实烧毁量 + 24h 链上现读 + 全行业回购强度（work/buyback.py） ---------- */
let BURN_BY='h24';                    /* 榜单口径：默认 24 小时（「今天烧了多少」），可切 30 天 */
let CHAIN_STATE='', CHAIN_TRIED=false; /* 链上实时读数的状态（成功时刻 / 是否试过） */

function burnBundle(){ return DATA.burn || BUNDLE.burn || null; }
/* 全站唯一的「当前价」出口：主源 coins.llama.fi → 兜底 CoinGecko → 最后收盘价。
   禁止其它地方直接读 DATA.market[..].price —— 两个源会打架，同一个币价显示两个数（2026-10-05 修）。 */
function pxOf(id){
  const a=(DATA.price||{})[id];
  if(typeof a==='number' && a>0) return a;
  const m=((DATA.market||{})[id]||{}).price;
  if(typeof m==='number' && m>0) return m;
  const arr=(DATA.priceSeries||{})[id]||[];
  for(let i=arr.length-1;i>=0;i--){ if(arr[i] && arr[i][1]>0) return arr[i][1]; }
  return 0;
}
/* 链上/快照读回来的 24h 回购是「代币数量」，这里统一折成美元（拿不到币价就返回 null，宁可显示 — 也不要报个数骗人） */
function b24usd(pid, tok){
  const px=pxOf(pid);
  return (px>0 && tok!=null && isFinite(tok))? tok*px : null;
}
function burnOf(p){
  const c=(burnBundle()&&burnBundle().chain)||{};
  const d=c[p.id]||{};
  const burned=(d.burned!=null)? d.burned : p.burned;
  const supply=(d.supply!=null)? d.supply : p.maxSupply;
  return {burned:burned, supply:supply, pct:(supply>0)? burned/supply*100 : 0,
          addr:d.addr||null, explorer:d.explorer||null,
          b24:(d.burn24h!=null)? b24usd(p.id, d.burn24h) : null, b24src:d.burn24hSrc||null,
          b24live:!!d.burn24hLive, b24txs:(d.burn24hTxs!=null)? d.burn24hTxs : null};
}
/* 24 小时回购的取数优先级：链上现读 / 链上快照  >  数据源里最近的一天（会滞后） */
function b24Of(pid, st){
  const d=((burnBundle()||{}).chain||{})[pid]||{}, x=(st||{})[pid]||{};
  if(d.burn24h!=null){
    const usd=b24usd(pid, d.burn24h);
    if(usd!=null) return {v:usd, wait:false, live:!!d.burn24hLive, txs:(d.burn24hTxs||null),
            tag:(d.burn24hLive? t('burn24Chain') : (d.burn24hSrc==='official'? t('burn24Official') : t('burn24Snap')))};
  }
  if(x.d1!=null){
    return {v:x.d1, wait:false, live:false, txs:null, tag:((x.d1date||'').slice(5)), tip:t('burn24DayTip')};
  }
  return {v:null, wait:true, live:false, txs:null, tag:''};
}
function burnStats(){
  const out={}, rows=build();
  PROJECTS.forEach(function(p){
    const hold=rows.map(function(r){ return r[p.id+'_hold']; });
    let last=-1;
    for(let i=0;i<rows.length;i++){ if(hold[i]!==null && hold[i]!==undefined) last=i; }
    if(last<0) last=rows.length-1;
    let s7=0; for(let i=Math.max(0,last-6);i<=last;i++) s7+=hold[i]||0;
    let s30=0,n30=0;
    for(let i=Math.max(0,last-29);i<=last;i++){ if(hold[i]!==null && hold[i]!==undefined){ s30+=hold[i]||0; n30++; } }
    const mk=(DATA.market||{})[p.id]||{};
    const b=burnOf(p);
    const mcap=mk.mcap || (DATA.meta[p.id]||{}).mcap || p.mcapFallback || 0;
    const price=pxOf(p.id)||(b.supply? mcap/b.supply : 0);
    out[p.id]={s7:s7, s30:s30, mcap:mcap, price:price, vol:mk.vol24h||0,
      d1:(hold[last]!=null? hold[last] : null), d1date:(rows[last]? rows[last].date : null),
      volShare:(mk.vol24h>0)? s7/(mk.vol24h*7) : null,
      yield30:(mcap>0&&n30)? (s30/n30*365)/mcap : null};
  });
  return out;
}
function pctS(v){ return (v===null||v===undefined||isNaN(v))?'—':(v*100).toFixed(2)+'%'; }

/* 榜单里自家两家用链上口径覆盖（DefiLlama 会晚 1~2 天出数），其余协议走 DefiLlama */
function burnPeerVal(x, by){
  if(by!=='h24') return {v:x.d30, live:false};
  let b=null;
  if(x.slug==='pons-v1')  b=burnOf(PROJECTS[0]);
  if(x.slug==='stonkfun') b=burnOf(PROJECTS[1]);
  if(b && b.b24!=null) return {v:b.b24, live:b.b24live};
  return {v:x.h24, live:false};
}

function renderBurn(){
  const sec=document.getElementById('st-burn'); if(!sec) return;
  const bd=burnBundle(), sub=document.getElementById('burnSub'), cards=document.getElementById('burnCards');
  const ph=document.getElementById('burnPeersH'), pl=document.getElementById('burnPeers'), note=document.getElementById('burnNote');
  const bt=document.getElementById('burnTabs'), bn=document.getElementById('burnPeersNote');
  const bh=document.getElementById('burnHead');
  const ALL=[sec,sub,cards,ph,pl,note,bt,bn,bh];
  if(!bd || !bd.chain){ ALL.forEach(function(el){ if(el) el.style.display='none'; }); return; }
  ALL.forEach(function(el){ if(el) el.style.display=''; });
  const st=burnStats(), peers=(bd.peers&&bd.peers.rows)||[], total=(bd.peers&&bd.peers.total)||0;
  const bmk=bd.market||{};

  if(sub){
    const stamp=esc(new Date(DATA.generated||BUNDLE.generated).toLocaleString(LANG==='zh'?'zh-CN':'en-GB'));
    const msv=(msBundle()||{}).versus||{};
    sub.innerHTML = IC.zap + esc(t('burnSub')(stamp))
      + (CHAIN_STATE? ' <b class="lk">'+IC.zap+esc(t('burnLiveOk')(CHAIN_STATE))+'</b>'
                    : (CHAIN_TRIED? ' <b class="lk mut">'+IC.zap+esc(t('burnLiveFail'))+'</b>' : ''))
      + (msv.ratio? ' · '+esc(t('msSub')(msv.faster, msv.ratio.toFixed(1))) : '')
      + ' <a class="qi" href="#gloss-milestone" title="'+esc(t('gMmT'))+'">?</a>';
  }

  if(cards) cards.innerHTML=PROJECTS.map(function(p){
    const b=burnOf(p), s=st[p.id]||{}, d=(bd.chain||{})[p.id]||{};
    const usd=b.burned*(s.price||0);
    const link=d.explorer? '<a class="bn-link" href="'+d.explorer+'" target="_blank" rel="noopener">'+t('burnLink')+'</a>' : '';
    const addr=b.addr? (b.addr.length>20? b.addr.slice(0,10)+'…'+b.addr.slice(-6) : b.addr) : '';
    const h24=b24Of(p.id, st);
    const ms=(msBundle()||{})[p.id==='stonkfun'?'stonk':p.id]||null;
    const ARC=2*Math.PI*52, arcFill=(ARC*Math.max(0,Math.min(100,b.pct))/100).toFixed(2);
    const mile=(ms && ms.perDay!=null)
      ? '<div class="burn-mile" title="'+esc(t('bmTip'))+(ms.generated? ' · '+esc(t('msStamp'))+esc(new Date(ms.generated*1000).toLocaleString(LANG==='zh'?'zh-CN':'en-GB')) : '')+'">'
        + '<span>'+esc(t('bmSpeedL'))+' <b>'+fmtT(ms.perDay)+t('msPerDay')+'</b>'
        + (ms.speedPct!=null? '<em>'+esc(t('msPerDayPct')(ms.speedPct.toFixed(3)))+'</em>':'')+'</span>'
        + (ms.daysTo!=null? ' · <span>'+esc(t('bmNext')(
            (ms.nextPct!=null? ms.nextPct+'%':'—'),
            (ms.toNext!=null? fmtT(ms.toNext):'—'),
            t('msDays')(msDayTxt(ms.daysTo)) ))+'</span>' : '')
        + '</div>'
      : '';
    const chip = h24.wait
      ? '<span class="wait"><b>'+t('burn24')+'</b><i>'+t('burn24Wait')+'</i></span>'
      : '<span class="live"'+(h24.tip?' title="'+esc(h24.tip)+'"':'')+'>'
        + '<b>'+t('burn24')+'</b><i>'+fmtU(h24.v)+'</i>'
        + (h24.txs? '<em class="h24tx">'+h24.txs+' tx</em>':'')
        + (h24.live? IC.zap:'')+'<em>'+esc(h24.tag)+'</em></span>';
    return '<div class="burn-card" style="--bc:'+p.color+'">'
      + '<div class="burn-head">'
      +   '<span class="proj-name"><span class="dot" style="background:'+p.color+';color:'+p.color+'"></span>'+p.ticker+'</span>'
      +   '<span class="bn-chain">'+esc(p.chain)+'</span>'+link
      + '</div>'
      + '<div class="burn-hero">'
      +   '<div class="burn-ring" title="'+esc(t('burnPctOf'))+' '+(b.pct!=null? b.pct.toFixed(2)+'%':'—')+'">'
      +     '<svg viewBox="0 0 120 120" aria-hidden="true">'
      +       '<circle class="brk-trk" cx="60" cy="60" r="52"/>'
      +       '<circle class="brk-arc" cx="60" cy="60" r="52" style="stroke:'+p.color+';stroke-dasharray:'+arcFill+' '+ARC.toFixed(2)+'"/>'
      +     '</svg>'
      +     '<div class="brk-c"><b>'+(b.pct!=null? b.pct.toFixed(2):'—')+'<em>%</em></b><span>'+esc(t('burnPctOf'))+'</span></div>'
      +   '</div>'
      +   '<div class="burn-hero-txt">'
      +     '<div class="burn-big">'+fmtN(b.burned/1e6,2)+'M<small>'+p.ticker+' '+t('burnBurned')+'</small></div>'
      +     '<div class="burn-husd">'+t('burnValue')+' <b>'+fmtU(usd)+'</b></div>'
      +   '</div>'
      + '</div>'
      + mile
      + '<div class="burn-kv">'+ chip
      +   '<span><b>'+t('burn30d')+'</b><i>'+fmtU(s.s30)+'</i></span>'
      +   '<span><b>'+t('burnYield')+'</b><i>'+pctS(s.yield30)+'</i></span>'
      +   '<span><b>'+t('burnVolShare')+'</b><i>'+pctS(s.volShare)+'</i></span>'
      + '</div>'
      + '<div class="burn-src">'+t(p.id==='pons'?'burnSrcPons':'burnSrcStonk')+(addr?' · <code>'+addr+'</code>':'')+'</div>'
      + '</div>';
  }).join('');

  const byK=(BURN_BY==='h24')?'r24':'r30';
  if(bt) bt.innerHTML=['h24','d30'].map(function(k){
    return '<button class="tab'+(k===BURN_BY?' on':'')+'" onclick="BURN_BY=\''+k+'\';renderBurn();">'
      + t(k==='h24'?'burnTab24':'burnTab30')+'</button>';
  }).join('');
  if(ph) ph.innerHTML='<span class="rh-t">'+esc(t(BURN_BY==='h24'?'burnPeersH24':'burnPeersH30')(fmtN(total,0)))
    + '　·　'+esc(t('burnRankBy')(t(BURN_BY==='h24'?'burnTab24':'burnTab30')))+'</span>';
  if(bn) bn.innerHTML=(BURN_BY==='h24'? IC.zap : '')+esc(t(BURN_BY==='h24'?'burnPeersNote24':'burnPeersNote30'));
  /* 表格化：两个周期各占一列，各自带表头 —— 不再用「小字写另一个周期」，
     那种写法会让人以为 tab 串了（用户就是这么误会的） */
  if(bh) bh.innerHTML='<span></span><span>'+t('bbColName')+'</span>'
    + '<span class="'+(BURN_BY==='h24'?'on':'')+'">'+t('burnTab24')+'</span>'
    + '<span class="'+(BURN_BY==='d30'?'on':'')+'">'+t('burnTab30')+'</span>';
  if(pl) pl.innerHTML=peers.slice().sort(function(a,b){
      /* 按「这一列实际显示的金额」排。以前按 DefiLlama 的名次排，而自家两行显示的是链上现读数，
         于是出现「钱少的在上面、钱多的在下面」（2026-10-05 用户发现）。 */
      const va=(BURN_BY==='h24')? (burnPeerVal(a,'h24').v||0) : (a.d30||0);
      const vb=(BURN_BY==='h24')? (burnPeerVal(b,'h24').v||0) : (b.d30||0);
      return vb-va;
    }).map(function(x){
      const v24=burnPeerVal(x,'h24');       /* 自家两家这里会用链上现读数覆盖 */
      const override=(BURN_BY==='h24') && (x.slug==='pons-v1'||x.slug==='stonkfun') && v24.v!=null;
      return '<div class="bb-row'+(x.me?' me':'')+'">'
        + '<span class="bb-rank">'+(override? '<em class="bb-chainrk" title="'+esc(t('bbChainRkTip'))+'">'+esc(t('bbChainRk'))+'</em>' : '#'+x[byK])+'</span>'
        + '<span class="bb-name"><b>'+esc(x.n)+(x.me?' <em class="rr-me">'+t('rankMe')+'</em>':'')+'</b>'
        +   '<i>'+esc(x.c)+'</i></span>'
        + '<span class="bb-v'+(BURN_BY==='h24'?' on':'')+'">'+fmtU(v24.v)
        +   (v24.live? '<em class="bb-live">'+IC.zap+'</em>':'')+'</span>'
        + '<span class="bb-v'+(BURN_BY==='d30'?' on':'')+'">'+fmtU(x.d30)+'</span></div>';
    }).join('');

  if(note){
    const bySlug={}; peers.forEach(function(x){ bySlug[x.slug]=x; });
    const pf=bySlug['pump.fun']||{d30:0,h24:null};
    const pfk=bmk.pumpfun||{};
    const po=st.pons||{}, sk=st.stonkfun||{};
    const po24=b24Of('pons', st), sk24=b24Of('stonkfun', st);
    const pf24=(pf.h24!=null && pf.h24>0)? {v:pf.h24, wait:false, tag:t('burn24Snap')}
              : ((pfk.s7)? {v:pfk.s7/7, wait:false, tag:'≈'} : {v:null, wait:true, tag:''});
    const pfVs=(pfk.vol24h>0 && pfk.s7)? pfk.s7/(pfk.vol24h*7) : null;
    const pfYd=(pfk.mcap>0 && pfk.s30)? (pfk.s30/30*365)/pfk.mcap : null;
    const times=(pfVs>0 && sk.volShare)? (sk.volShare/pfVs).toFixed(0)+'×' : '—';
    const cell=function(h){
      if(h.wait) return '<b style="opacity:.55">'+t('burn24Wait')+'</b>';
      return '<b>'+fmtU(h.v)+'</b>'+(h.tag? '<em class="bb-tag">'+esc(h.tag)+'</em>' : '');
    };
    const rowsCmp=[
      {n:'StonkFun', c:'var(--stonk)', h:sk24, s30:sk.s30, vs:sk.volShare, yd:sk.yield30, me:1},
      {n:'Pons',     c:'var(--pons)',  h:po24, s30:po.s30, vs:po.volShare, yd:po.yield30, me:1},
      {n:'pump.fun', c:'var(--mut)',   h:pf24, s30:pf.d30, vs:pfVs,         yd:pfYd,       me:0}
    ];
    const tbl='<table class="bb-tbl"><thead><tr><th></th><th class="c24">'+t('burnCmpCol1')+'</th><th>'+t('burnCmpCol2')
      +'</th><th>'+t('burnCmpCol3')+'</th><th>'+t('burnCmpCol4')+'</th></tr></thead><tbody>'
      + rowsCmp.map(function(r){
          return '<tr'+(r.me?' class="me"':'')+'><td><span class="dot" style="background:'+r.c+';color:'+r.c
            +';display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:9px"></span>'+r.n+'</td>'
            +'<td class="c24">'+cell(r.h)+'</td><td>'+fmtU(r.s30)+'</td><td>'+pctS(r.vs)+'</td><td>'+pctS(r.yd)+'</td></tr>';
        }).join('')
      +'</tbody></table>';
    const o={stonkVs:pctS(sk.volShare), ponsVs:pctS(po.volShare), pfVs:pctS(pfVs), timesVs:times,
      stonkYd:pctS(sk.yield30), ponsYd:pctS(po.yield30), pfYd:pctS(pfYd),
      pfVol:fmtU(pfk.vol24h), pfVolX:(pfk.vol24h&&po.vol)? (pfk.vol24h/po.vol).toFixed(0)+'×' : '—',
      stonk7:fmtU(sk.s7), ponsPct:burnOf(PROJECTS[0]).pct.toFixed(2)+'%', stonkPct:burnOf(PROJECTS[1]).pct.toFixed(2)+'%',
      pons24:(po24.wait? '—' : fmtU(po24.v)), pons24tx:(po24.txs||null), stonk24:(sk24.wait? t('burn24Wait') : fmtU(sk24.v)),
      foot:t('burnFoot')};
    note.innerHTML='<div class="bb-h">'+t('burnNoteH')+'</div>'+tbl+t('burnBody')(o);
  }
}

/* ---------- PONS 近 24h：浏览器直连 Robinhood Chain RPC 现读（CORS 已验证开放） ----------
   之所以在前端再读一遍：DefiLlama 的收入/回购数据会晚 1~2 天，而链上一直算到最新区块，
   所以「回购与销毁」这一块每次打开页面 / 点刷新，都是当下的数字。 */
const RH_RPC='https://rpc.mainnet.chain.robinhood.com';
const PONS_TOKEN='0x39dBED3a2bd333467115dE45665cC57F813C4571';
const PONS_DEAD='0x000000000000000000000000000000000000dEaD';
const XFER='0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef';
const pad32=a=>'0x'+'0'.repeat(24)+a.slice(2);
async function rhRpc(method, params){
  const r=await fetch(RH_RPC,{method:'POST',headers:{'Content-Type':'application/json'},cache:'no-store',
    body:JSON.stringify({jsonrpc:'2.0',id:1,method:method,params:params})});
  if(!r.ok) throw new Error('rpc '+r.status);
  const j=await r.json(); if(j.error) throw new Error(j.error.message||'rpc');
  return j.result;
}
async function loadChainBurn(){
  try{
    const hexBn=await rhRpc('eth_blockNumber',[]);
    const bn=parseInt(hexBn,16);
    const blks=await Promise.all([rhRpc('eth_getBlockByNumber',[hexBn,false]),
                                  rhRpc('eth_getBlockByNumber',['0x'+(bn-60000).toString(16),false])]);
    const tsNow=parseInt(blks[0].timestamp,16);
    const bps=60000/Math.max(1, tsNow-parseInt(blks[1].timestamp,16));
    const target=tsNow-24*3600;
    let est=Math.round(bn-(tsNow-target)*bps);
    for(let i=0;i<3;i++){
      est=Math.max(0,Math.min(bn-1,est));
      const b=await rhRpc('eth_getBlockByNumber',['0x'+est.toString(16),false]);
      const d=parseInt(b.timestamp,16)-target;
      if(Math.abs(d)<=45) break;
      est=Math.round(est-d*bps);
    }
    const fromBlock=Math.max(0,Math.min(bn-1,est));
    const logs=await rhRpc('eth_getLogs',[{fromBlock:'0x'+fromBlock.toString(16), toBlock:hexBn,
      address:PONS_TOKEN, topics:[XFER,null,pad32(PONS_DEAD)]}]);
    let amt=0; (logs||[]).forEach(function(l){ amt+=Number(BigInt(l.data||'0x0'))/1e18; });
    const node=(((DATA.burn||{}).chain||{}).pons)||null;
    if(node){
      node.burn24h=Math.round(amt*100)/100; node.burn24hSrc='chain';
      node.burn24hTxs=(logs||[]).length; node.burn24hHours=24;
      node.burn24hTs=tsNow; node.burn24hBlock=bn; node.burn24hLive=true;
    }
    try{
      const res=await Promise.all([
        rhRpc('eth_call',[{to:PONS_TOKEN,data:'0x70a08231'+pad32(PONS_DEAD).slice(2)},'latest']),
        rhRpc('eth_call',[{to:PONS_TOKEN,data:'0x18160ddd'},'latest'])]);
      const dead=parseInt(res[0],16)/1e18, sup=parseInt(res[1],16)/1e18;
      if(node && sup>0){ node.burned=Math.round(dead*100)/100; node.supply=sup; node.pct=Math.round(dead/sup*10000)/100; }
    }catch(e){}
    CHAIN_STATE=new Date().toLocaleTimeString(LANG==='zh'?'zh-CN':'en-GB',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
    return true;
  }catch(e){ return false; }
}

/* ---------- render cards ---------- */
/* ---------- 小时监控（最近 72 小时）：交易量 / 收入 / 销毁 ---------- */
let HOUR_TAB='vol', HOUR_LIVE=0;
const HOUR_POOLS={pons:['robinhood','0xed50bdeea8adc232f159486192a4157281d722ff'],
                  stonk:['solana','zxTpi4BtaWX3mgdAPoezkMD1hxx8CdeCfrqXMWvSCLX']};
function hourlyBundle(){ return ((typeof DATA!=='undefined' && DATA.hourly) || (typeof BUNDLE!=='undefined' && BUNDLE.hourly) || null); }
function hourSeries(){
  const h=hourlyBundle(); if(!h||!h.hours) return null;
  const out={hours:h.hours.slice(), pons:[], stonk:[], rawPons:[], rawStonk:[], px:{}, by:0.8};
  out.by=(h.buybackShare||0.8);
  ['pons','stonk'].forEach(function(k){
    const n=h[k]||{};
    const src = (HOUR_TAB==='vol')? (n.vol||[]) : (HOUR_TAB==='rev')? (n.rev||[]) : (n.burn||[]);
    out.px[k]=n.close||[];
    if(k==='pons') out.rawPons=src.slice(); else out.rawStonk=src.slice();
    out[k]=(HOUR_TAB==='burn')? src.map(function(v,i){ const c=(n.close||[])[i]; return (v==null||!c)? null : v*c; }) : src.slice();
  });
  out.burnSrc={pons:((h.pons||{}).burnSrc||''), stonk:((h.stonk||{}).burnSrc||'')};
  /* v3.22：断档回填的小时（官方累计值断了一晚 → 按小时平均摊回，画斜纹柱 + 标「估算」） */
  const st=(h.stonk||{});
  out.spanStonk=(HOUR_TAB==='rev')? (st.spanR||st.span||[]) : (HOUR_TAB==='burn')? (st.spanB||st.span||[]) : [];
  out.spanSet={}; out.spanStonk.forEach(function(b){ out.spanSet[b]=1; });
  out.gen=h.generated;
  return out;
}
function hourSum(a,n){ let s=0, any=false; (a||[]).slice(-n).forEach(function(x){ if(x!=null&&isFinite(x)){ s+=x; any=true; } }); return any? s : null; }
function hourTip(s,i){
  const d=new Date(s.hours[i]*1000), hm=fmtDay(d);
  const pv=s.pons[i], sv=s.stonk[i], pu=s.rawPons[i], su=s.rawStonk[i];
  let out=hm;
  out+='\nPons  '+(pv==null?'—':fmtU(pv))+(HOUR_TAB==='burn'&&pu!=null? '（'+fmtN(pu,0)+' PONS）':'');
  out+='\nStonkFun  '+(sv==null?'— 还没攒到':fmtU(sv))+(HOUR_TAB==='burn'&&su!=null? '（'+fmtN(su,0)+' STONK）':'');
  return out;
}
function fmtDay(d){
  const p=function(n){ return (n<10?'0':'')+n; };
  return (d.getMonth()+1)+'/'+d.getDate()+' '+p(d.getHours())+':'+p(d.getMinutes());
}
function renderHourly(){
  const sec=document.getElementById('st-hourly'); if(!sec) return;
  const hb=document.getElementById('hourlySub'), ht=document.getElementById('hourlyTabs'),
        hl=document.getElementById('hourlyLegend'), svg=document.getElementById('hourlyChart'),
        sm=document.getElementById('hourlySum'), nt=document.getElementById('hourlyNote'),
        lv=document.getElementById('hourlyLive');
  const s=hourSeries();
  const ALL=[sec,hb,ht,hl,svg,sm,nt];
  if(!s||!s.hours.length){ ALL.forEach(function(e){ if(e) e.style.display='none'; }); return; }
  ALL.forEach(function(e){ if(e) e.style.display=''; });
  if(lv){ lv.textContent=(HOUR_LIVE? t('hourLive') : t('hourLiveOff'));
          lv.className='sec-live'+(HOUR_LIVE?'':' off'); }
  if(hb) hb.textContent=t('hourSub');
  if(ht) ht.innerHTML=[['vol','hourTabVol'],['rev','hourTabRev'],['burn','hourTabBurn']].map(function(p){
      return '<button class="tab'+(HOUR_TAB===p[0]?' on':'')+'" onclick="HOUR_TAB=\''+p[0]+'\';renderHourly();">'+t(p[1])+'</button>';
    }).join('');

  const W=1200,CH=300,padT=18,padB=30,padL=2,padR=2;
  const n=s.hours.length;
  const vals=[];
  s.pons.forEach(function(v){ if(v!=null&&isFinite(v)) vals.push(v); });
  s.stonk.forEach(function(v){ if(v!=null&&isFinite(v)) vals.push(v); });
  const max=Math.max.apply(null, vals.concat([1]));
  const yv=function(v){ return padT+(1-v/max)*(CH-padT-padB); };
  const step=(W-padL-padR)/n, bw=Math.max(2.2, step*0.42);
  let body='<defs><pattern id="hpHatch" width="7" height="7" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">'
      +'<rect width="7" height="7" fill="var(--stonk)" opacity=".2"/>'
      +'<line x1="0" y1="0" x2="0" y2="7" stroke="var(--stonk)" stroke-width="2.6" opacity=".85"/></pattern></defs>', marks='';
  [1,0.5].forEach(function(f){
    const yy=yv(max*f).toFixed(1);
    body+='<line class="hourly-grid" x1="0" y1="'+yy+'" x2="'+W+'" y2="'+yy+'"/>';
    marks+='<i class="y" style="top:'+(((Number(yy)-14)/CH)*100).toFixed(2)+'%">'+fmtU(max*f)+'</i>';
  });
  s.hours.forEach(function(ts,i){
    const x=padL+i*step;
    const pv=s.pons[i], sv=s.stonk[i];
    const h1=(pv!=null)? (CH-padB-yv(pv)) : 0, h2=(sv!=null)? (CH-padB-yv(sv)) : 0;
    let g='<g class="hourly-bar">';
    g+='<rect x="'+x.toFixed(1)+'" y="'+padT+'" width="'+step.toFixed(2)+'" height="'+(CH-padT-padB)+'" fill="transparent"/>';
    if(pv!=null) g+='<rect x="'+x.toFixed(1)+'" y="'+(CH-padB-h1).toFixed(1)+'" width="'+bw.toFixed(1)+'" height="'+Math.max(1,h1).toFixed(1)+'" rx="1.5" fill="var(--pons)" opacity=".92"/>';
    const svFill=(s.spanSet && s.spanSet[ts])? 'url(#hpHatch)' : 'var(--stonk)';
    if(sv!=null) g+='<rect x="'+(x+step-bw).toFixed(1)+'" y="'+(CH-padB-h2).toFixed(1)+'" width="'+bw.toFixed(1)+'" height="'+Math.max(1,h2).toFixed(1)+'" rx="1.5" fill="'+svFill+'" opacity=".92"/>';
    body+=g+'</g>';
  });
  body+='<rect id="hourHl" class="hourly-hl" x="0" y="'+padT+'" width="0" height="'+(CH-padT-padB)+'" rx="3" pointer-events="none"/>';
  /* 时间轴：每 12 小时一个（桌面全显；手机只留 0h / 36h / 最新，间距疏、不打架） */
  let labI=0;
  s.hours.forEach(function(ts,i){
    if(i%12===0 || i===n-1){
      const x=padL+i*step;
      const cls=(x<70? ' l' : (x>W-70? ' r' : ''));
      const alt=(i!==n-1 && (labI%3!==0))? ' data-alt="1"' : '';
      marks+='<i class="x'+cls+'"'+alt+' style="left:'+((x/W)*100).toFixed(2)+'%">'+fmtDay(new Date(ts*1000))+'</i>';
      labI++;
    }
  });
  if(svg) svg.innerHTML=body;
  const mk=document.getElementById('hourlyMarks'); if(mk) mk.innerHTML=marks;

  /* 当前小时读数卡：不点也能看到；手机点柱子 → 直接切成那一小时的数据
     （v3.21.1 起不再把卡收起 —— 收起后它在手机上是「隐形但占位」，会留一大块空白） */
  const nowBox=document.getElementById('hourlyNow');
  const hideNow=function(){ if(nowBox) nowBox.classList.add('hide'); };
  const buildNow=function(i){
    if(!nowBox) return;
    const last=s.hours.length-1;
    const pick=(i!=null && i>=0 && i<last)? i : null;      /* null＝最新一小时（进行中） */
    const idx=(pick==null)? last : pick;
    const dl=new Date(s.hours[idx]*1000);
    const ongoing=(pick==null) && ((Date.now()/1000) < (s.hours[idx]+3600));
    const head=(pick==null)
      ? esc(t('hourNow'))+' · '+fmtDay(dl)+(ongoing? ' · '+esc(t('hourOngoing')) : '')
      : esc(t('hourPick'))+' · '+fmtDay(dl);
    nowBox.innerHTML='<div class="h">'+head+'</div>'
      +'<div class="hv">'
      +'<div class="r p"><span>PONS</span><b>'+hourTxt(s.pons[idx])+'</b></div>'
      +'<div class="r s"><span>STONK</span><b>'+hourTxt(s.stonk[idx])+'</b></div>'
      +'</div>';
    nowBox.classList.remove('hide');
  };
  buildNow(null);
  /* 鼠标划过任意一根柱子：自绘提示框 + 高亮整列（桌面；手机点选走下面的 selectAt） */
  const tipBox=document.getElementById('hourlyTipBox');
  const hlEl=svg? svg.querySelector('#hourHl') : null;
  if(svg && tipBox){
    const box=svg.parentElement;
    const fine=function(){ try{ return !window.matchMedia('(max-width:680px)').matches; }catch(e){ return true; } };
    const label=function(raw){ return (HOUR_TAB==='burn'&&raw!=null)? ' <em>'+fmtN(raw,0)+'</em>' : ''; };
    const mark=function(i){ if(hlEl){ hlEl.setAttribute('x',(padL+i*step).toFixed(1));
      hlEl.setAttribute('width',step.toFixed(2)); hlEl.classList.add('on'); } };
    const hoverAt=function(ev){
      if(fine()) hideNow();          /* 桌面悬停时提示框已显示同款数据，右上卡先让位 */
      const r=svg.getBoundingClientRect();
      let i=Math.floor((ev.clientX-r.left)/r.width*s.hours.length);
      i=Math.max(0, Math.min(s.hours.length-1, i));
      mark(i);
      const pv=s.pons[i], sv2=s.stonk[i];
      tipBox.innerHTML='<div class="t">'+fmtDay(new Date(s.hours[i]*1000))+(i===s.hours.length-1?' · '+esc(t('hourOngoing')):'')+'</div>'
        +'<div class="r p"><span>PONS</span><b>'+hourTxt(pv)+label(s.rawPons[i])+'</b></div>'
        +'<div class="r s"><span>STONK</span><b>'+(sv2==null? esc(t('hourNoData')) : hourTxt(sv2)+label(s.rawStonk[i]))+'</b>'
        +((s.spanSet && s.spanSet[s.hours[i]])? '<em class="bf">'+esc(t('hourSpan'))+'</em>':'')+'</div>';
      tipBox.style.display='block';
      const br=box.getBoundingClientRect();
      tipBox.style.left=Math.max(86, Math.min(br.width-86, ev.clientX-br.left))+'px';
      tipBox.style.top=Math.max(52, ev.clientY-br.top)+'px';
    };
    const selectAt=function(ev){
      const r=svg.getBoundingClientRect();
      let i=Math.floor((ev.clientX-r.left)/r.width*s.hours.length);
      i=Math.max(0, Math.min(s.hours.length-1, i));
      mark(i);
      tipBox.style.display='none';   /* 手机上把数据写进图下那张卡，不再飘一个框 */
      buildNow(i===s.hours.length-1? null : i);
    };
    const hideTip=function(){ tipBox.style.display='none'; if(hlEl) hlEl.classList.remove('on'); };
    window.__hourReset=function(){ hideTip(); buildNow(null); };
    svg.onmousemove=function(ev){ if(Date.now()-(window.__hourTouch||0)<800) return; hoverAt(ev); };
    svg.onclick=function(ev){ if(Date.now()-(window.__hourTouch||0)<800) return; hoverAt(ev); };
    /* 手机：触屏没有 hover —— 点一下柱子＝把那一小时的数据写进图下的读数卡 */
    svg.ontouchstart=function(ev){
      if(ev.touches && ev.touches[0]){ window.__hourTouch=Date.now(); selectAt({clientX:ev.touches[0].clientX}); }
    };
    svg.onmouseleave=function(){ hideTip(); buildNow(null); };
    /* 点图表以外的地方 / 页面划走 → 收起提示框，读数卡回到「当前小时」 */
    if(!window.__hourlyNowOut){
      window.__hourlyNowOut=1;
      document.addEventListener('click', function(ev){
        const sv=document.getElementById('hourlyChart');
        if(!sv || sv.contains(ev.target)) return;
        if(window.__hourReset) window.__hourReset();
      }, true);
      window.addEventListener('scroll', function(){
        const nb=document.getElementById('hourlyNow');
        if(!nb || !nb.classList.contains('hide')) return;
        if(window.__hourReset) window.__hourReset();
      }, {passive:true});
    }
  }

  if(hl){
    const srcP=(HOUR_TAB==='vol')? '' : (HOUR_TAB==='rev'? t('hourEst') : t('hourChain'));
    const srcS=(HOUR_TAB==='vol')? '' : t('hourOfficial');
    hl.innerHTML='<span class="lg"><i style="background:var(--pons)"></i>Pons <b>'+hourTxt(hourSum(s.pons,72))+'</b><em>72h'+(srcP?' · '+esc(srcP):'')+'</em></span>'
      +'<span class="lg"><i style="background:var(--stonk)"></i>StonkFun <b>'+hourTxt(hourSum(s.stonk,72))+'</b><em>72h'+(srcS?' · '+esc(srcS):'')+'</em></span>'
      + '<span class="lg"><em>'+esc(t('hourEach'))+'</em></span>';
  }
  if(sm){
    sm.innerHTML=[[1,'hourH1'],[6,'hourH6'],[24,'hourH24'],[72,'hourH72']].map(function(w){
      const a=hourSum(s.pons,w[0]), b=hourSum(s.stonk,w[0]);
      return '<div><div class="k">'+t(w[1])+'</div><div class="v">'
        +'<span class="pair p"><b>'+hourTxt(a)+'</b><i>PONS</i></span>'
        +'<span class="pair s"><b>'+hourTxt(b)+'</b><i>STONK</i></span></div></div>';
    }).join('');
  }
  if(nt){
    let note=t(HOUR_TAB==='vol'? 'hourNoteVol' : HOUR_TAB==='rev'? 'hourNoteRev' : 'hourNoteBurn');
    if(s.spanStonk && s.spanStonk.length)
      note+=' '+esc(t('hourSpanNote').replace('{n}', s.spanStonk.length));
    nt.innerHTML=note;
  }
}
function hourTxt(v){ return (v==null)? '—' : fmtU(v); }

/* 打开页面 / 点刷新时：把最近 24h 交易量 + 最近 3h 链上销毁拉成新的（实时） */
async function refreshHourlyLive(){
  const h=hourlyBundle(); if(!h||!h.hours) return;
  let ok=false;
  for(const k in HOUR_POOLS){
    try{
      const net=HOUR_POOLS[k][0], pool=HOUR_POOLS[k][1];
      const j=await fetchJSON('https://api.geckoterminal.com/api/v2/networks/'+net+'/pools/'+pool+'/ohlcv/hour?limit=26&aggregate=1');
      const rows=(((j||{}).data||{}).attributes||{}).ohlcv_list||[];
      const node=h[k]||(h[k]={});
      rows.forEach(function(r){
        const b=Math.floor(r[0]/3600)*3600, i=h.hours.indexOf(b);
        if(i<0) return;
        node.vol[i]=parseFloat(r[5]); node.close[i]=parseFloat(r[4]);
        if(k==='pons' && (h.pons.burn||[])[i]!=null)
          h.pons.rev[i]=Math.round(h.pons.burn[i]*parseFloat(r[4])/(h.buybackShare||0.8)*100)/100;
      });
      ok=true;
    }catch(e){}
  }
  try{
    const hexBn=await rhRpc('eth_blockNumber',[]); const bn=parseInt(hexBn,16);
    const b1=await rhRpc('eth_getBlockByNumber',[hexBn,false]);
    const b2=await rhRpc('eth_getBlockByNumber',['0x'+(bn-100000).toString(16),false]);
    const tsNow=parseInt(b1.timestamp,16);
    const bps=100000/Math.max(1, tsNow-parseInt(b2.timestamp,16));
    const hNow=Math.floor(tsNow/3600)*3600;
    for(let k=2;k>=0;k--){
      const t0=hNow-k*3600;
      let f=Math.round(bn-(tsNow-t0)*bps);
      for(let it=0;it<2;it++){
        const bb=await rhRpc('eth_getBlockByNumber',['0x'+Math.max(0,f).toString(16),false]);
        const d=parseInt(bb.timestamp,16)-t0;
        if(Math.abs(d)<=60) break;
        f=Math.round(f-d*bps);
      }
      const to=Math.min(bn, Math.round(f+3600*bps));
      const logs=await rhRpc('eth_getLogs',[{fromBlock:'0x'+Math.max(0,f).toString(16), toBlock:'0x'+to.toString(16),
        address:PONS_TOKEN, topics:[XFER,null,pad32(PONS_DEAD)]}]);
      let amt=0, cnt=0;
      (logs||[]).forEach(function(l){ amt+=Number(BigInt(l.data||'0x0'))/1e18; cnt++; });
      const i=h.hours.indexOf(t0);
      if(i>=0){
        h.pons.burn[i]=Math.round(amt*100)/100; h.pons.burnTx[i]=cnt;
        const c=(h.pons.close||[])[i];
        if(c) h.pons.rev[i]=Math.round(amt*c/(h.buybackShare||0.8)*100)/100;
      }
    }
    ok=true;
  }catch(e){}
  HOUR_LIVE=ok?1:0;
  renderHourly();
}

/* 卡片上的「实时 24 小时」：从小时监控的同一份数据里取最近 24 根柱子求和。
   PONS 是链上回购折算、STONK 是官方接口真值 —— 都远比 DefiLlama 日度新。 */
function live24(id){
  const h=hourlyBundle(); if(!h || !h.hours) return null;
  const key=(id==='pons')? 'pons' : 'stonk';     /* 卡片 id 是 stonkfun，小时数据里叫 stonk */
  const n0=h[key]; if(!n0) return null;
  const arr=(n0.rev||[]).slice(-24);
  let sum=0, n=0;
  for(let i=0;i<arr.length;i++){ const v=arr[i]; if(typeof v==='number' && isFinite(v)){ sum+=v; n++; } }
  if(n<12) return null;               /* 不到半天数据就不显示，宁缺毋滥 */
  return {rev:sum, n:n};
}
function jumpHourly(){
  try{ HOUR_TAB='rev'; renderHourly(); }catch(e){}
  const el=document.getElementById('st-hourly');
  if(el){ try{ el.scrollIntoView({behavior:'smooth',block:'start'}); }catch(e){ el.scrollIntoView(); } }
}
/* ---------- 市场占有率（v3.14）：DefiLlama DEX 同源口径（协议 ÷ 所在链全部） ---------- */
function shareBundle(){ var h=((typeof DATA!=='undefined' && DATA.hourly) || (typeof BUNDLE!=='undefined' && BUNDLE.hourly) || null); return (h && h.share) || null; }
function shPct(v){ return (v===null||v===undefined||isNaN(v))?'—':(v*100).toFixed(2)+'%'; }
function shSpark(hist){
  var pts=(hist||[]).filter(function(r){ return r && r[1]!=null; }).slice(-14);
  if(pts.length<3) return '';
  var W=220,H=30,P=3;
  var mn=Math.min.apply(null,pts.map(function(r){return r[1];})), mx=Math.max.apply(null,pts.map(function(r){return r[1];}));
  var sp=(mx-mn)||1, st=(W-2*P)/(pts.length-1), xy=[];
  pts.forEach(function(r,i){ xy.push([P+i*st, H-P-((r[1]-mn)/sp)*(H-2*P)]); });
  var line=xy.map(function(p,i){ return (i?'L':'M')+p[0].toFixed(1)+','+p[1].toFixed(1); }).join(' ');
  var area=line+' L'+xy[xy.length-1][0].toFixed(1)+','+(H-P)+' L'+xy[0][0].toFixed(1)+','+(H-P)+' Z';
  return '<svg viewBox="0 0 '+W+' '+H+'" preserveAspectRatio="none" aria-hidden="true">'
    + '<path d="'+area+'" fill="currentColor" opacity=".13"/>'
    + '<path d="'+line+'" fill="none" stroke="currentColor" stroke-width="1.6" vector-effect="non-scaling-stroke" stroke-linejoin="round"/></svg>';
}
function renderShare(){
  var sec=document.getElementById('st-share'); if(!sec) return;
  var s=shareBundle();
  var sub=document.getElementById('shareSub'), cards=document.getElementById('shareCards'),
      note=document.getElementById('shareNote'), lv=document.getElementById('shareLive');
  var ALL=[sec,sub,cards,note];
  if(!s || !s.pons || !s.stonk){ ALL.forEach(function(e){ if(e) e.style.display='none'; }); return; }
  ALL.forEach(function(e){ if(e) e.style.display=''; });
  if(lv){ lv.textContent=t('shareLive'); lv.className='sec-live'; }
  if(sub){
    var stamp=s.generated? new Date(s.generated*1000).toLocaleString(LANG==='zh'?'zh-CN':'en-GB') : '';
    sub.innerHTML=esc(t('shareSub')(stamp))+' <a class="qi" href="#gloss-share" title="'+esc(t('gMsT'))+'">?</a>';
  }
  if(cards){
    cards.innerHTML=[['pons',s.pons],['stonk',s.stonk]].map(function(pair){
      var key=pair[0], o=pair[1];
      var color=(key==='pons')? 'var(--pons)' : 'var(--stonk)';
      var name=(key==='pons')? 'Pons' : 'StonkFun', ticker=(key==='pons')? 'PONS' : 'STONK';
      var vals=(o.hist||[]).filter(function(r){ return r && r[1]!=null; });
      var last=vals.length? vals[vals.length-1][1] : null;
      var week=vals.length>7? vals[vals.length-8][1] : (vals.length? vals[0][1] : null);
      var delta=(last!=null&&week!=null)? (last-week) : null;
      var deltaChip = delta==null? '' :
        '<span>'+t('sh7d')+' <i class="'+(delta>=0?'up':'down')+'">'+((delta>=0)?'↑ ':'↓ ')+Math.abs(delta*100).toFixed(2)+'pp</i></span>';
      var marker = (key==='stonk' && o.pumpShare!=null)?
        '<u style="left:'+(Math.min(99.6,o.pumpShare*100)).toFixed(2)+'%" title="'+esc(t('shPumpMark'))+'"></u>' : '';
      var vs = (key!=='stonk')? '' :
        '<div class="share-vs"><div class="sh-vs-h">'+t('shVsT')+' <em>'+t('shVsSub')+'</em></div>'
        + '<div class="share-vsbar"><i class="a" style="width:'+Math.max(0.6,(o.vsPump||0)*100).toFixed(2)+'%"></i><i class="b" style="width:'+Math.max(0,(100-(o.vsPump||0)*100)).toFixed(2)+'%"></i></div>'
        + '<div class="share-vscap"><span>StonkFun <b>'+fmtU(o.vol24h)+'</b></span><span>pump.fun <b>'+fmtU(o.pumpVol24h)+'</b></span></div>'
        + '<div class="share-vsline">'+t('shVsLine')(shPct(o.vsPump), shPct(o.pumpShare), (o.vsPump? (1/o.vsPump).toFixed(1)+'×' : '—'))+'</div></div>';
      return '<div class="share-card" style="--sc:'+color+'">'
        + '<div class="share-head"><span class="sh-name">'+name+'<i>'+ticker+'</i></span><span class="sh-chain">'+esc(o.chain||'')+'</span></div>'
        + '<div class="share-big"><b>'+shPct(o.share)+'</b><span>'+t('shOfChain')+'</span></div>'
        + '<div class="share-bar"><i style="width:'+Math.min(100,(o.share||0)*100).toFixed(3)+'%"></i>'+marker+'</div>'
        + '<div class="share-caps"><span>'+name+' <b>'+fmtU(o.vol24h)+'</b></span><span>'+t('shChainVol')+' <b>'+fmtU(o.chainVol24h)+'</b></span></div>'
        + '<div class="share-kv"><span>'+t('shRank')+' <i>'+((o.rank!=null)? '#'+o.rank+' / '+o.total : '—')+'</i></span>'+deltaChip+'</div>'
        + '<div class="share-spark">'+shSpark(o.hist)+'<span class="sh-spk">'+t('sh14d')+'</span></div>'
        + vs
        + '</div>';
    }).join('');
  }
  if(note) note.innerHTML='<div class="bb-h">'+t('shareNoteH')+'</div>'+t('shareNote');
}
/* ---------- 销毁里程碑数据（v3.15 新增；v3.16 并进「回购与销毁」卡片，不再单独成块） ---------- */
function msBundle(){
  var h=((typeof DATA!=='undefined' && DATA.hourly) || (typeof BUNDLE!=='undefined' && BUNDLE.hourly) || null);
  return (h && h.milestone) || null;
}
/* 官方日线（v3.18）：STONK 日度对账数据，来自 stonkfun 官方 /api/v2/revenue/daily */
function sfDailyBundle(){
  var h=((typeof DATA!=='undefined' && DATA.hourly) || (typeof BUNDLE!=='undefined' && BUNDLE.hourly) || null);
  return (h && h.sfDaily) || null;
}
function sfDailyLast(){
  var b=sfDailyBundle(); if(!b || !b.days) return null;
  var ks=Object.keys(b.days).sort(); return ks.length? ks[ks.length-1] : null;
}
function fmtT(v){
  if(v===null||v===undefined||isNaN(v)) return '—';
  var a=Math.abs(v);
  if(LANG==='zh'){
    if(a>=1e8) return (v/1e8).toFixed(2)+' 亿';
    if(a>=1e4) return (v/1e4).toFixed(1)+' 万';
  }
  if(a>=1e9) return (v/1e9).toFixed(2)+'B';
  if(a>=1e6) return (v/1e6).toFixed(2)+'M';
  if(a>=1e3) return (v/1e3).toFixed(1)+'K';
  return String(Math.round(v));
}
function msDayTxt(d){ return (d===null||d===undefined||isNaN(d))?'—':(d<10? d.toFixed(1):String(Math.round(d))); }
function msPriceTxt(p){ return '$'+(p>=1? p.toFixed(3) : p.toFixed(4)); }
/* v3.16：原「销毁里程碑」独立板块已并入「回购与销毁」卡片（速度 + 下一关），渲染函数删除 */
function renderCards(){
  const rows = build();
  const el = document.getElementById('cards');
  el.innerHTML = PROJECTS.map(p=>{
    const s = stats(rows,p);
    const d = (s.avg7-s.avg7p)/(s.avg7p||1);
    const status = s.avg7 < p.danger ? ['bad',t('stBad')]
                 : s.avg7 < p.warn   ? ['warn',t('stWarn')]
                 : (d<-0.25)         ? ['warn',t('stMom')]
                 : (d>0.05)          ? ['good',t('stUp')]
                 : ['good',t('stFlat')];
    const pct = v => v===null||isNaN(v)? '—' : (v>=0?'+':'')+(v*100).toFixed(1)+'%';
    const dd = s.ath? (s.psv-s.ath)/s.ath : null;
    const stTxt = status[0]==='bad'? ('● '+t('lvBad')) : status[0]==='warn'? ('● '+t('lvWarn')) : ('● '+t('lvOk'));
    return `<div class="card">
      <div class="proj-head">
        <div>
          <div class="proj-name"><span class="dot" style="background:${p.color};color:${p.color}"></span>${p.name}<span class="tick">${p.ticker}</span>${s.lag>0? `<span class="lagtag" title="${t('lagTip')}">${t('lagBadge')(s.lag)}</span>`:''}${(()=>{ if(!(s.lag>0)) return ''; const lv=live24(p.id); if(!lv) return ''; return `<span class="livechip" title="${t('liveChipTip')}" onclick="jumpHourly()"><i></i>${t('liveChip')(fmtU(lv.rev))}</span>`; })()}</div>
          <div class="pmeta"><span class="pch">${p.chain}</span><span class="pbn">${t('burned')}${(s.burnPct*100).toFixed(1)}% (${fmtN(s.burnAmt/1e6,1)}M ${p.ticker})</span></div>
        </div>
        <div class="price">
          <div class="p mono" id="px-${p.id}">$${fmtN(s.psv,4)}</div>
          <div class="m">${t('mcap')}${fmtU(s.mcap)}</div>
          <div class="pill ${dd>=0?'up':'down'}">${t('fromAth')}${pct(dd)}</div>
        </div>
      </div>
      <div class="kv">
        <div><div class="k">${t('kAvg7')}</div><div class="v">${fmtU(s.avg7)}<small>${t('perDay')}</small></div></div>
        <div><div class="k">${t('kMom')}</div><div class="v" style="color:${d>=0?'var(--up)':'var(--down)'}">${pct(d)}</div></div>
        <div><div class="k">${t('kLast')}${s.lag>0 && s.lastDate? ' <span style="opacity:.62">· '+s.lastDate.slice(5)+'</span>':''}</div><div class="v">${fmtU(s.lastRev)}</div></div>
        <div><div class="k">${t('kPeak')}</div><div class="v">${fmtU(s.peak)}</div></div>
        <div title="${t('tipPs')}"><div class="k">${t('kPs7')} <a class="qi" href="#gloss-ps">?</a></div><div class="v">${s.ps7?fmtN(s.ps7,2)+'x':'—'}</div></div>
        <div title="${t('tipPs30')}"><div class="k">${t('kPs30')} <a class="qi" href="#gloss-ps">?</a></div><div class="v">${s.ps30?fmtN(s.ps30,2)+'x':'—'}</div></div>
        <div><div class="k">${t('kFromPeak')}</div><div class="v" style="color:var(--down)">${s.peak?((s.lastRev-s.peak)/s.peak*100).toFixed(0)+'%':'—'}</div></div>
        <div title="${t('tipBurnYield')}"><div class="k">${t('kBurnYield')} <a class="qi" href="#gloss-to">?</a></div><div class="v">${s.burnYield!==null?fmtN(s.burnYield*100,0)+'%':'—'}</div></div>
        <div><div class="k">${t('kBurn7')}</div><div class="v">${fmtU(s.holdSum7)}</div></div>
        <div title="${t('tipBurnForce')}"><div class="k">${t('kBurnForce')} <a class="qi" href="#gloss-bp">?</a></div><div class="v" style="color:${s.burnForce===null?'inherit':s.burnForce>=0.05?'var(--up)':s.burnForce>=0.02?'var(--warn)':'var(--down)'}">${s.burnForce===null?'—':(s.burnForce*100).toFixed(2)+'%'}</div></div>
        <div title="${t('tipVol')}"><div class="k">${t('kVol24')}</div><div class="v">${fmtU(s.vol24)}</div></div>
        <div title="${t('tipVol')}"><div class="k">${t('kTurnover')} <a class="qi" href="#gloss-to">?</a></div><div class="v">${s.turnover!==null?(s.turnover*100).toFixed(1)+'%':'—'}</div></div>
      </div>
      <div class="status ${status[0]}"><span class="lbl">${stTxt}</span><span>${status[1]}</span></div>
    </div>`;
  }).join('');
  /* v3.13.3：记住这次真实卡高，下次打开时骨架直接按它占位（分断点存，手机/电脑互不干扰） */
  try{
    var kids = el.children, mx = 0;
    for(var i=0;i<kids.length;i++) mx = Math.max(mx, kids[i].offsetHeight);
    if(mx > 60){
      var bk = (window.innerWidth<=680?'m':(window.innerWidth<=900?'t':'d'));
      localStorage.setItem('ponsCardsH-'+bk, String(Math.round(mx)));
    }
  }catch(e){}
}

/* ---------- rules ---------- */
function dims(){ return [
  {key:'floor',     short:t('dimFloorS'), label:t('dimFloorL'), hint:t('dimFloorH')},
  {key:'mom',       short:t('dimMomS'),   label:t('dimMomL'),   hint:t('dimMomH')},
  {key:'burn',      short:t('dimBurnS'),  label:t('dimBurnL'),  hint:t('dimBurnH')},
  {key:'burnpower', short:t('dimBpS'),    label:t('dimBpL'),    hint:t('dimBpH')},
  {key:'ps',        short:t('dimPsS'),    label:t('dimPsL'),    hint:t('dimPsH')}
];}

function ruleItems(rows, p){
  const s = stats(rows,p);
  const d = (s.avg7-s.avg7p)/(s.avg7p||1);
  const ps = s.ps7;
  const it = {};
  let lvl, act;

  if(s.avg7 < p.danger){ lvl='bad'; act=t('actFloorBad'); }
  else if(s.avg7 < p.warn){ lvl='warn'; act=t('actFloorWarn'); }
  else { lvl='ok'; act=t('actFloorOk')(fmtN((s.avg7-p.warn)/p.warn*100,0)); }
  it.floor = {level:lvl, act, score:(s.avg7-p.danger)/p.danger,
    s:t('sFloor')(fmtU(s.avg7), fmtU(p.danger), fmtU(p.warn))};

  if(d < -0.25){ lvl='bad'; act=t('actMomBad'); }
  else if(d < -0.15){ lvl='warn'; act=t('actMomWarn'); }
  else if(d > 0.05){ lvl='ok'; act=t('actMomUp'); }
  else { lvl='ok'; act=t('actMomFlat'); }
  it.mom = {level:lvl, act, score:d, s:t('sMom')((d*100).toFixed(1))};

  const burnRatio = s.avg7>0? s.holdSum7/(s.avg7*7) : 0;
  if(s.holdSum7 <= 0){ lvl='bad'; act=t('actBurnOff'); }
  else { lvl='ok'; act=t('actBurnOn')((burnRatio*100).toFixed(0)); }
  it.burn = {level:lvl, act, score:burnRatio,
    s:t('sBurn')(fmtU(s.holdSum7), tx(p.burnEvent))};

  const bf = s.burnForce;
  if(bf===null||!isFinite(bf)){ lvl='warn'; act=t('actBpNone'); }
  else if(bf >= 0.05){ lvl='ok';   act=t('actBpOk')((bf*100).toFixed(1)); }
  else if(bf >= 0.02){ lvl='warn'; act=t('actBpWarn')((bf*100).toFixed(1)); }
  else {               lvl='bad';  act=t('actBpBad')((bf*100).toFixed(2)); }
  it.burnpower = {level:lvl, act, score:(bf===null||!isFinite(bf))? null : bf,
    s:t('sBp')(fmtU(s.holdSum7), fmtU(s.vol24? s.vol24*7 : null))};

  if(ps===null||!isFinite(ps)){ lvl='warn'; act=t('actPsNone'); }
  else if(ps < 1.5){ lvl='ok'; act=t('actPsCheap')(fmtN(ps,2)); }
  else if(ps <= 4){ lvl='ok'; act=t('actPsFair')(fmtN(ps,2)); }
  else { lvl='warn'; act=t('actPsDear')(fmtN(ps,2)); }
  it.ps = {level:lvl, act, score:(ps===null||!isFinite(ps))? null : -ps,
    s:t('sPs')((ps===null||!isFinite(ps))?'—':fmtN(ps,2)+'x')};

  return {s, d, it, ok:Object.values(it).filter(x=>x.level==='ok').length};
}

/* ---------- 深层分析：把数字算给读者看 ---------- */
function divTrendOf(st){
  if(!st || !st.ps7 || !st.ps30) return '';
  const div = st.ps7/st.ps30;
  const pick = o => (o && typeof o==='object')? o.t : o;
  if(div>1.5) return pick(t('divFast')(fmtN(100/div,0)));
  if(div>1.15) return pick(t('divSoft')());
  if(div<0.85) return pick(t('divUp')((1/div).toFixed(1)));
  return pick(t('divFlat')());
}

function deepFor(p, s){
  const buy7=s.holdSum7, buyDay=s.holdSum7/7, vol7=s.vol24? s.vol24*7 : null;
  const revDay=s.avg7, f=s.burnForce;
  const needDay = s.vol24? s.vol24*0.05 : null;
  const gap = (f && isFinite(f) && f>0)? (0.05/f) : null;
  const needShare = (needDay && revDay>0)? needDay/revDay : null;
  const buyShare = revDay>0? buy7/(revDay*7) : null;
  const money = v => (v===null||v===undefined||!isFinite(v))? '—' : fmtU(v);
  const d = {
    buy7:money(buy7), vol7:money(vol7), buyDay:money(buyDay), revDay:money(revDay),
    needDay:money(needDay), gap: gap? fmtN(gap,0)+'×' : '—',
    needShare: needShare? (needShare*100).toFixed(0)+'%' : '—',
    share: ((p.buyShare||0)*100).toFixed(0)+'%',
    yield: (s.burnYield!==null&&isFinite(s.burnYield))? fmtN(s.burnYield*100,0)+'%' : '—',
    burnDays: s.burnDays,
    f: (f!==null&&isFinite(f))? (f*100).toFixed(2)+'%' : '—',
    buyShare: buyShare? (buyShare*100).toFixed(0)+'%' : '—',
    priceChg: (s.priceChg7!==null)? (s.priceChg7>=0?'+':'')+(s.priceChg7*100).toFixed(1)+'%' : '—',
    priceFrom: s.price7? '$'+fmtN(s.price7,4) : '—',
    priceNow: s.psv? '$'+fmtN(s.psv,4) : '—',
    a:money(s.avg7), b:money(s.avg7p), diff:money(s.avg7-s.avg7p),
    streak: (s.streakUp>=s.streakDown? s.streakUp : s.streakDown), up: (s.streakUp>s.streakDown),
    streakTxt: t('streakTxt')((s.streakUp>s.streakDown? s.streakUp : s.streakDown), (s.streakUp>s.streakDown)),
    avg7:money(s.avg7), warn:money(p.warn), danger:money(p.danger),
    toWarn: fmtN((s.avg7-p.warn)/p.warn*100,0)+'%',
    days: (s.daysToWarn && isFinite(s.daysToWarn) && s.daysToWarn>0 && s.daysToWarn<400)? Math.round(s.daysToWarn) : null,
    mcap:money(s.mcap), yearRev:money(s.avg7*365),
    ps7: s.ps7? fmtN(s.ps7,2)+'x':'—', ps30: s.ps30? fmtN(s.ps30,2)+'x':'—',
    div: (s.ps7&&s.ps30)? fmtN(s.ps7/s.ps30,2):'—', trend: divTrendOf(s)
  };
  return {
    floor: t('anFloor')(d),
    mom: t('anMom')(d),
    burn: t('anBurn')(d),
    burnpower: t('anBp')(d) + '<span class="dl">'+t('anBpEvidence')(d)+'</span><span class="dl">'+t('anBpLong')(d)+'</span>',
    ps: t('anPs')(d)
  };
}

/* ---------- v3.19 结论深读：给「一句话结论」配上完整的推理链 ---------- */
/* 7 日窗口对半分：最近 3 天 vs 前 4 天 —— 判断下滑是在继续还是已踩住 */
function last7Split(rows, p){
  const idx = rows.map((r,i)=>r[p.id+'_rev']!==null?i:-1).filter(i=>i>=0);
  if(idx.length < 7) return null;
  const win = idx.slice(-7);
  const avg = a => { let s=0,n=0; a.forEach(i=>{ const v=rows[i][p.id+'_rev']; if(v!=null&&isFinite(v)){ s+=v; n++; } }); return n? s/n : null; };
  const a3 = avg(win.slice(-3)), a4 = avg(win.slice(0,4));
  return {a3, a4, chg: (a3!=null&&a4)? a3/a4-1 : null};
}
/* 小时级拐点：最近 24 个有数小时 vs 再往前 24 个 —— 比日线早 1~2 天看到转向 */
function hourlyInflection(key){
  const b = hourlyBundle(); if(!b || !b[key]) return null;
  const rev = b[key].rev || [];
  const vals = [];
  for(let i=rev.length-1;i>=0 && vals.length<48;i--){ const v=rev[i]; if(v!=null&&isFinite(v)) vals.push(v); }
  if(vals.length < 12) return null;
  const n = Math.min(24, vals.length-6);
  const last = vals.slice(0, n), prev = vals.slice(n, n+24);
  const sum = a => a.reduce((x,y)=>x+y,0);
  const sl = sum(last), sp = prev.length? sum(prev) : null;
  return {last:sl, prev:sp, chg:(sp&&sp>0)? sl/sp-1 : null, n:last.length,
          perDay: last.length? sl/last.length*24 : null};
}
function deepReview(p, s, rows){
  const w = last7Split(rows, p);
  const h2 = hourlyInflection(p.id==='pons'? 'pons' : 'stonk');
  const money = v => (v===null||v===undefined||!isFinite(v))? '—' : fmtU(v);
  const pct1 = v => (v===null||v===undefined||!isFinite(v))? '—' : (v>=0?'+':'')+(v*100).toFixed(1)+'%';
  const vol7 = s.vol24? s.vol24*7 : null;
  const f = s.burnForce;
  const revChg = s.avg7p? (s.avg7-s.avg7p)/s.avg7p : null;
  const priceChg = (s.priceChg7!==null&&isFinite(s.priceChg7))? s.priceChg7 : null;
  const psPrev = (s.ps7 && priceChg!==null && s.avg7p>0 && (1+priceChg)>0)
    ? (s.mcap/(1+priceChg))/(s.avg7p*365) : null;
  const y = (s.burnYield!==null&&isFinite(s.burnYield))? s.burnYield : null;
  const streakN = (s.streakUp>=s.streakDown? s.streakUp : s.streakDown);
  const d = {
    a3: money(w&&w.a3), a4: money(w&&w.a4), d3: pct1(w? w.chg : null),
    d3abs: (w&&w.chg!==null&&w.chg!==undefined)? (Math.abs(w.chg)*100).toFixed(1)+'%' : '—',
    worse: !!(w && w.chg!==null && w.chg < -0.08),
    up:    !!(w && w.chg!==null && w.chg > 0.03),
    streakTxt: t('streakTxt')(streakN, s.streakUp>s.streakDown),
    buy7: money(s.holdSum7), vol7: money(vol7),
    f: (f!==null&&isFinite(f))? (f*100).toFixed(2)+'%' : '—',
    weak: (f!==null&&isFinite(f))? f<0.02 : false,
    strong: (f!==null&&isFinite(f))? f>=0.05 : false,
    gap: (f&&f>0)? fmtN(0.05/f,1)+'×' : '—',
    yTxt: y===null? '—' : (y>=1? t('drYFull') : t('drYPart')(fmtN(y*100,0)+'%')),
    ps7: s.ps7? fmtN(s.ps7,2)+'x':'—',
    psPrev: psPrev? fmtN(psPrev,2)+'x':'',
    rev7: pct1(revChg), p7: pct1(priceChg),
    compressed: (psPrev&&s.ps7)? s.ps7 < psPrev*0.97 : false,
    expanded:   (psPrev&&s.ps7)? s.ps7 > psPrev*1.03 : false,
    h24: h2? money(h2.last) : null, h24per: h2? money(h2.perDay) : null,
    h24chg: (h2&&h2.chg!==null)? pct1(h2.chg) : '—',
    hot:  (h2&&s.avg7>0)? h2.perDay > s.avg7*1.05 : false,
    cold: (h2&&s.avg7>0)? h2.perDay < s.avg7*0.95 : false,
    avg7: money(s.avg7), avg7N: s.avg7, warn: money(p.warn), warnN: p.warn, danger: money(p.danger),
    needUp: (s.avg7>0 && s.avg7<p.warn)? '+'+fmtN((p.warn/s.avg7-1)*100,0)+'%' : '—',
    days: (s.daysToWarn && isFinite(s.daysToWarn) && s.daysToWarn>0 && s.daysToWarn<400)? Math.round(s.daysToWarn) : null
  };
  const row = (k, body) => '<div class="sd-row"><span class="sd-k">'+t(k)+'</span><span class="sd-t">'+body+'</span></div>';
  return row('drDrop', t('drDropT')(d)) + row('drBuy', t('drBuyT')(d)) + row('drVal', t('drValT')(d))
       + row('drTurn', t('drTurnT')(d)) + row('drCond', t('drCondT')(d));
}

function sumActionOf(it){
  if(it.floor.level==='bad') return ['bad', t('sumActBad')];
  if(it.burn.level==='bad')  return ['bad', t('sumActBurnBad')];
  if(it.mom.level==='bad')   return ['warn', t('sumActMomBad')];
  if(it.burnpower.level==='bad') return ['warn', t('sumActBpBad')];
  if(it.floor.level==='warn'||it.burnpower.level==='warn'||it.ps.level==='warn') return ['warn', t('sumActWarn')];
  return ['ok', t('sumActOk')];
}

function renderRules(){
  const rows = build();
  const A = PROJECTS[0], B = PROJECTS[1];
  const ra = ruleItems(rows, A), rb = ruleItems(rows, B);
  const da = deepFor(A, ra.s), db = deepFor(B, rb.s);
  const DIMS = dims();
  const VKEY={floor:'vFloor',mom:'vMom',burn:'vBurn',burnpower:'vBurnpower',ps:'vPs'};

  const verdict = {};
  DIMS.forEach(dim=>{
    const x = ra.it[dim.key].score, y = rb.it[dim.key].score;
    if(x===null||y===null||!isFinite(x)||!isFinite(y)){ verdict[dim.key]={text:t('verdictNoData'), tie:true}; return; }
    const rel = Math.abs(x-y)/(Math.abs(x)+Math.abs(y)||1);
    if(rel < 0.10){ verdict[dim.key]={text:t('verdictTie'), tie:true}; return; }
    const w = x>y ? A : B;
    verdict[dim.key] = {text:t('verdictWin')(w.ticker+' '+t(VKEY[dim.key])), tie:false};
  });

  const lvName = lvl => t(lvl==='ok'?'lvOk':lvl==='warn'?'lvWarn':'lvBad');
  const card = (p, item, deep) =>
    `<div class="rule ${item.level}">
       ${item.level==='bad'?`<span class="badflag">${IC.alert}${t('badFlag')}</span>`:''}
       <div class="rtop"><span class="tag ${item.level}">${lvName(item.level)}</span><span class="pname" style="color:${p.color}">● ${p.name}</span></div>
       <div class="s">${item.s}</div>
       <div class="act ${item.level}">${t('advice')}${item.act}</div>
       ${deep?`<div class="deep"><span class="dh">${t('deepTag')}</span>${deep}</div>`:''}
     </div>`;

  const head = `<div class="cmp-head">
      <div class="col"><span class="dot" style="background:${A.color};color:${A.color}"></span>${A.name}<span class="tick">${A.ticker}</span><span class="cnt">${t('cmpHead')(ra.ok, Object.keys(ra.it).length)}</span></div>
      <div class="col"><span class="dot" style="background:${B.color};color:${B.color}"></span>${B.name}<span class="tick">${B.ticker}</span><span class="cnt">${t('cmpHead')(rb.ok, Object.keys(rb.it).length)}</span></div>
    </div>`;

  const body = DIMS.map((dim,i)=>{
    const v = verdict[dim.key];
    return `<div class="cmp-row">
      <div class="cmp-label"><b>${i+1}. ${dim.label}</b><span class="hint">${dim.hint}</span>
        <span class="verdict${v.tie?'':' win'}">${t('verdict')}${v.text}</span></div>
      <div class="cmp-pair">${card(A, ra.it[dim.key], da[dim.key])}${card(B, rb.it[dim.key], db[dim.key])}</div>
    </div>`;
  }).join('');

  const money = v => (v===null||v===undefined||!isFinite(v))? '—' : fmtU(v);
  const chip = (label,val,cls) => `<span class="chip">${label} <b${cls?` class="${cls}"`:''}>${val}</b></span>`;
  /* 关键数字按健康度上色：危险红 / 警戒黄 / 健康绿 —— 一眼看出哪个数是坏的 */
  const cMom = x => x.d < -0.25 ? 'hi-dn' : (x.d > 0.05 ? 'hi-up' : '');
  const cBp  = x => (x.s.burnForce===null||!isFinite(x.s.burnForce)) ? '' :
                    (x.s.burnForce < 0.02 ? 'hi-dn' : (x.s.burnForce >= 0.05 ? 'hi-up' : 'hi-wn'));
  const cPs  = x => (x.s.ps7===null||!isFinite(x.s.ps7)) ? '' :
                    (x.s.ps7 < 1.5 ? 'hi-up' : (x.s.ps7 > 4 ? 'hi-wn' : ''));
  const projBlock = (p, s2, act) => `<div class="sum-proj ${act[0]}">
      <div class="sp-top"><span class="dot" style="background:${p.color};color:${p.color}"></span>${p.name}<span class="tick">${p.ticker}</span>
        <span class="tag ${act[0]}">${lvName(act[0])}</span></div>
      <div class="sp-act">${act[1]}</div>
      <div class="sum-chips">
        ${chip(t('chipRev'), money(s2.s.avg7), s2.it.floor.level==='ok'?'':'hi-wn')}
        ${chip(t('chipMom'), ((s2.d*100).toFixed(1)+'%'), cMom(s2))}
        ${chip(t('chipBp'), (s2.s.burnForce!==null&&isFinite(s2.s.burnForce)? (s2.s.burnForce*100).toFixed(2)+'%':'—'), cBp(s2))}
        ${chip(t('chipPs'), (s2.s.ps7? fmtN(s2.s.ps7,2)+'x':'—'), cPs(s2))}
      </div>
    </div>`;

  const sa = sumActionOf(ra.it), sb = sumActionOf(rb.it);
  const cheaper = (ra.s.ps7 && rb.s.ps7) ? (ra.s.ps7 < rb.s.ps7 ? A : B) : null;
  const action = cheaper ? t('priority')(cheaper.ticker) : t('priorityNone');

  /* v3.19：把推理链摊在结论下面 —— 跌势结构 / 回购托底 / 估值安全垫 / 实时拐点 / 反转条件 */
  const deepCol = (p, r2) => `<div class="sd-col">
      <div class="sd-proj"><span class="dot" style="background:${p.color};color:${p.color}"></span>${p.name}<span class="tick">${p.ticker}</span></div>
      ${deepReview(p, r2.s, rows)}
    </div>`;
  const deepBlock = `<div class="sum-deep">
      <div class="sd-head"><span class="sd-ic">${IC.book}</span>${t('drHead')}<span class="sd-hint">${t('drHint')}</span></div>
      <div class="sd-grid">${deepCol(A, ra)}${deepCol(B, rb)}</div>
    </div>`;

  const summary = `<div class="summary">
      <div class="sum-head"><span class="sum-badge">${t('conclusion')}</span>
        <span class="sum-line"><span class="pnm">${A.name}</span> <b class="${sa[0]}">${sa[1]}</b>　·　<span class="pnm">${B.name}</span> <b class="${sb[0]}">${sb[1]}</b></span></div>
      <div class="sum-grid">${projBlock(A, ra, sa)}${projBlock(B, rb, sb)}</div>
      ${deepBlock}
      <div class="sum-foot">${action}<br><span style="color:var(--mut2)">${t('sumHint')}</span></div>
    </div>`;

  const badList = [];
  DIMS.forEach(dim=>{
    if(ra.it[dim.key].level==='bad') badList.push(A.ticker+' · '+dim.short);
    if(rb.it[dim.key].level==='bad') badList.push(B.ticker+' · '+dim.short);
  });
  const alert = badList.length
    ? `<div class="alertbar"><b>${IC.alert}${t('alertTitle')}</b><span>${badList.join('　·　')}</span><span class="ah">${t('alertHint')}</span></div>`
    : '';

  document.getElementById('rules').innerHTML = alert + summary + head + body;
}

/* ---------- chart ---------- */
function tabs(){ return [
  {id:'rev',  label:t('tabRev')},
  {id:'rev7', label:t('tabRev7')},
  {id:'cum',  label:t('tabCum')},
  {id:'price',label:t('tabPrice')}
];}
function renderTabs(){
  document.getElementById('tabs').innerHTML = tabs().map(x=>
    `<div class="tab ${x.id===MODE?'on':''}" onclick="MODE='${x.id}';renderTabs();renderChart()">${x.label}</div>`).join('');
}
function renderChart(){
  const rows = build();
  const N = MODE==='price'? 90 : 60;
  const sub = rows.slice(-N);
  const svg = document.getElementById('chart');
  const W=1200,H=340, P={l:64,r:104,t:14,b:30};
  const iw = W-P.l-P.r, ih = H-P.t-P.b;
  /* 覆盖层的字是固定 CSS 字号（手机 11.5px），SVG 里的字会跟着缩放 ——
     所以末端胶囊的贴合/防溢出必须按「真实 CSS 像素」算，不能沿用 SVG 单位。
     cw = 容器真实宽度；svgScale = 1 个 SVG 单位对应几个 CSS 像素。 */
  const cw = (function(){ const el=document.getElementById('chartMarks'); if(!el) return 0;
                          const w=el.getBoundingClientRect().width; return w>0? w : 0; })();
  const shellW = cw>0? cw : W, svgScale = cw>0? cw/W : 0;
  let series=[], thresholds=[], yfmt = fmtU;

  if(MODE==='price'){
    let base = {};
    PROJECTS.forEach(p=>{
      const first = sub.find(r=>r[p.id+'_price']!==null);
      base[p.id] = first? first[p.id+'_price'] : null;
    });
    series = PROJECTS.map(p=>({name:p.name,color:p.color,
      pts: sub.map((r,i)=>({i, v: r[p.id+'_price']!==null&&base[p.id]? r[p.id+'_price']/base[p.id]*100 : null}))}));
    yfmt = v => fmtN(v,0);
    thresholds=[{v:100,label:'基准 100',color:'var(--mut2)'}];
  } else if(MODE==='cum'){
    let cum = {}; PROJECTS.forEach(p=>cum[p.id]=0);
    const allRows = rows;
    const start = allRows.length - sub.length;
    series = PROJECTS.map(p=>{
      let c=0; const pts=[];
      allRows.forEach((r,gi)=>{ if(gi>=start) pts.push({i:gi-start, v:(c+= (r[p.id+'_hold']||0))}); });
      const first = pts.length? pts[0].v : 0;
      return {name:t('cumName')(p.name), color:p.color, pts: pts.map(x=>({i:x.i, v:x.v-first}))};
    });
  } else {
    series = PROJECTS.map(p=>{
      const vals = sub.map(r=>r[p.id+'_rev']);
      const filled = vals.map((v,i)=> v===null? null : (MODE==='rev7'? smaAt(vals.map(x=>x??0), i, 7) : v));
      return {name:p.name, color:p.color, pts: filled.map((v,i)=>({i, v}))};
    });
    PROJECTS.forEach(p=>thresholds.push({v:p.danger,label:t('stopLoss')(p.ticker),color:p.colorDim}));
  }

  const allV = series.flatMap(s=>s.pts.map(p=>p.v)).filter(v=>v!==null&&isFinite(v));
  let max = Math.max(...allV), min = MODE==='price'? Math.min(...allV) : 0;
  if(MODE!=='price'){ max = Math.max(max, ...thresholds.map(t=>t.v||0)); }
  const pad = (max-min)*0.08 || 1;
  max += pad; min = MODE==='price'? min-pad*1.5 : 0;
  const X = i => P.l + (sub.length<=1?0:(i/(sub.length-1))*iw);
  const Y = v => P.t + ih - ((v-min)/(max-min))*ih;

  /* 坐标文字走 HTML 覆盖层（#chartMarks）：SVG 被 preserveAspectRatio="none" 拉伸后
     里面的字在手机上只剩 3~4px，2026-10-07 起统一搬进原生 HTML，字号真实、永久清晰。 */
  let g='', marks='';
  const TICKS=5;
  for(let k=0;k<=TICKS;k++){
    const v = min + (max-min)*k/TICKS, y = Y(v);
    g += `<line x1="${P.l}" x2="${W-P.r}" y1="${y}" y2="${y}" style="stroke:var(--grid)"/>`;
    marks += `<i class="y"${k%2===1?' data-alt="1"':''} style="top:${(y/H*100).toFixed(2)}%">${yfmt(v)}</i>`;
  }
  const step = Math.max(1, Math.round(sub.length/7));
  const xl=[];
  sub.forEach((r,i)=>{ if(i%step===0||i===sub.length-1) xl.push({i, x:X(i), txt:r.date.slice(5)}); });
  xl.forEach((it,n)=>{ it.alt = (n<xl.length-1 && n%2===1); });
  if(xl.length>1 && (xl[xl.length-1].i - xl[xl.length-2].i) < step*0.9) xl[xl.length-2].close=true;
  marks += xl.map((it,n)=>`<i class="xl${n===0?' l':(n===xl.length-1?' r':'')}"${it.alt&&!it.close?' data-alt="1"':''}${it.close?' data-close="1"':''} style="left:${(it.x/W*100).toFixed(2)}%">${it.txt}</i>`).join('');
  thresholds.forEach(th=>{
    if(th.v===undefined||th.v===null) return;
    const y=Y(th.v);
    g += `<line x1="${P.l}" x2="${W-P.r}" y1="${y}" y2="${y}" style="stroke:${th.color}" class="warnline"/>`;
    marks += `<i class="th" style="top:${(y/H*100).toFixed(2)}%;color:${th.color}">${th.label}</i>`;
  });
  const endLabels = [];
  series.forEach(s=>{
    const segs=[]; let cur=[];
    s.pts.forEach(pt=>{
      if(pt.v===null||!isFinite(pt.v)){ if(cur.length) segs.push(cur); cur=[]; return; }
      cur.push({x:X(pt.i), y:Y(pt.v), v:pt.v});
    });
    if(cur.length) segs.push(cur);
    const clamp = y => Math.max(P.t-6, Math.min(P.t+ih+6, y));
    let d='';
    segs.forEach(seg=>{
      if(seg.length===1){ d += 'M'+seg[0].x.toFixed(1)+' '+seg[0].y.toFixed(1)+' L'+(seg[0].x+0.01).toFixed(2)+' '+seg[0].y.toFixed(1); return; }
      d += 'M'+seg[0].x.toFixed(1)+' '+seg[0].y.toFixed(1);
      for(let i=0;i<seg.length-1;i++){
        const p0=seg[i-1]||seg[i], p1=seg[i], p2=seg[i+1], p3=seg[i+2]||p2;
        const c1x=p1.x+(p2.x-p0.x)/6, c1y=p1.y+(p2.y-p0.y)/6;
        const c2x=p2.x-(p3.x-p1.x)/6, c2y=p2.y-(p3.y-p1.y)/6;
        d += ' C'+c1x.toFixed(1)+' '+clamp(c1y).toFixed(1)+','+c2x.toFixed(1)+' '+clamp(c2y).toFixed(1)+','+p2.x.toFixed(1)+' '+p2.y.toFixed(1);
      }
    });
    g += `<path d="${d}" fill="none" style="stroke:${s.color}" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>`;
    const lastSeg = segs[segs.length-1];
    const lastPt = lastSeg? lastSeg[lastSeg.length-1] : null;
    if(lastPt){
      g += `<circle cx="${lastPt.x.toFixed(1)}" cy="${lastPt.y.toFixed(1)}" r="8" fill="none" style="stroke:${s.color}" stroke-opacity=".3" stroke-width="1.5"/>`;
      g += `<circle cx="${lastPt.x.toFixed(1)}" cy="${lastPt.y.toFixed(1)}" r="4.2" style="fill:${s.color}"/>`;
      endLabels.push({x:lastPt.x, y:lastPt.y, color:s.color,
        text:(MODE==='price'? fmtN(lastPt.v,1) : fmtU(lastPt.v))});
    }
  });
  /* 曲线末端固定标签：不用 hover 也能一眼看到当前值。
     位置全部按「真实 CSS 像素」排：先避开阈值标签，再按最小间距错开，
     最后夹回图表范围内 —— 顺序不能反，否则后面的步骤会把前面的间距吃掉。 */
  const isNarrow = (window.innerWidth||1440) <= 680;
  const txtW = (str,fs)=>{ let w=0; for(const ch of String(str)) w += (ch.charCodeAt(0)>255? fs : fs*0.62); return w; };
  const pillW = t => svgScale>0? (22 + 7.2*t.length) : (18 + t.length*7.7);
  const pillX = l => Math.max(2, Math.min((svgScale>0? l.x*svgScale : l.x) + 13, shellW - 4 - pillW(l.text)));
  const thBoxes = thresholds.filter(th=>th.v!==undefined&&th.v!==null&&isFinite(th.v)).map(th=>{
    const tw = txtW(th.label, isNarrow? 11.5 : 10.5);
    const rgt = cw>0? cw*0.91 : W*0.91;
    return { x1: (isNarrow? 44 : rgt-tw)-4, x2: (isNarrow? 44+tw : rgt)+4,
             y1: Y(th.v)*svgScale - 18, y2: Y(th.v)*svgScale - 1 };
  });
  const minY = P.t - 6, maxY = H - P.b - 11;
  endLabels.sort((a,b)=>a.y-b.y);
  /* ① 让开阈值标签（桌面两端标签都在右侧，会叠在一起） */
  if(cw>0 && thBoxes.length) endLabels.forEach(l=>{
    const px = pillX(l) - 13, x2 = px + pillW(l.text), py = l.y*svgScale;
    thBoxes.forEach(bx=>{
      if(x2 > bx.x1 && px < bx.x2 && py+10 > bx.y1 && py-10 < bx.y2){
        const pick = (bx.y1 - 12 >= minY*svgScale) ? (bx.y1 - 12) : (bx.y2 + 12);
        l.y = pick/svgScale;
      }
    });
  });
  /* ② 夹回图表范围 */
  endLabels.forEach(l=>{ l.y = Math.max(minY, Math.min(maxY, l.y)); });
  /* ③ 两个系列末值挨太近就错开：间距按真实像素（手机图表只有 ~94px 高，
     沿用 SVG 单位的 18 会挤成 5px，两枚胶囊叠在一起）。 */
  const minGap = svgScale>0? 26/svgScale : 18;
  for(let i=1;i<endLabels.length;i++){
    if(endLabels[i].y - endLabels[i-1].y < minGap){
      const down = endLabels[i-1].y + minGap;
      if(down <= maxY){ endLabels[i].y = down; }
      else { endLabels[i].y = maxY; endLabels[i-1].y = Math.max(minY, maxY - minGap); }
    }
  }
  endLabels.forEach(l=>{
    const x = pillX(l), y = l.y;
    marks += `<i class="pill" style="left:${(x/shellW*100).toFixed(2)}%;top:${(y/H*100).toFixed(2)}%;color:${l.color}">${l.text}</i>`;
  });
  svg.innerHTML = g;
  const cm=document.getElementById('chartMarks'); if(cm) cm.innerHTML=marks;
  document.getElementById('legend').innerHTML = series.map(s=>
    `<span><i style="background:${s.color}"></i>${s.name}</span>`).join('') +
    (MODE==='price'?'<span style="color:var(--mut2)">'+t('start100')+'</span>':'');

  const tip = document.getElementById('tip');
  svg.onmousemove = e => {
    const r = svg.getBoundingClientRect();
    const relX = (e.clientX - r.left)/r.width*W;
    const i = Math.round((relX-P.l)/iw*(sub.length-1));
    if(i<0||i>=sub.length){ tip.style.display='none'; return; }
    const row = sub[i];
    let html = `<div class="d">${row.date}</div>`;
    series.forEach(s=>{
      const pt = s.pts.find(p=>p.i===i);
      if(pt && pt.v!==null && isFinite(pt.v))
        html += `<div class="r"><span style="color:${s.color}">${s.name.split(' cumulative')[0]}</span><b>${MODE==='price'?fmtN(pt.v,1):fmtU(pt.v)}</b></div>`;
    });
    tip.innerHTML = html;
    tip.style.display='block';
    const px = X(i)/W*r.width;
    tip.style.left = Math.min(px+14, r.width-190)+'px';
    tip.style.top = (e.clientY - r.top - 20)+'px';
  };
  svg.onmouseleave = ()=> tip.style.display='none';
}
/* 横竖屏切换 / 窗口缩放后，胶囊的像素级防重叠要重算一次 */
let chartRzT=null;
window.addEventListener('resize',function(){
  if(chartRzT) clearTimeout(chartRzT);
  chartRzT=setTimeout(function(){ try{ renderChart(); }catch(e){} }, 200);
});

/* ---------- table ---------- */
/* ---------- 数据源体检（v3.9）：每个数字来自哪里、最新到什么时候 ----------
   用户反馈「数据源不统一，有的晚 2 天但小时级又能拿到」—— 这一块就是这个问题的正面回答：
   把每一项数据的上游、最后一天（或最后一小时）、是否滞后全部摊开，滞后的标黄并解释原因。
   原则：只陈述事实，不美化；拿不到就说拿不到（v3.2 定下的口径，继续守）。 */
function lastDayOf(key){
  const arr = (DATA.series && DATA.series[key]) || [];
  for(let i=arr.length-1;i>=0;i--){ if(arr[i] && arr[i][1]!=null && isFinite(arr[i][0])) return dayKey(arr[i][0]); }
  return null;
}
function renderSrc(){
  const el = document.getElementById('srcBox'); if(!el) return;
  const todayK = dayKey(Math.floor(Date.now()/1000));
  const todayTs = Date.parse(todayK+'T00:00:00Z');
  const lagDays = d => { if(!d) return null; const t0 = Date.parse(d+'T00:00:00Z');
                         return isFinite(t0) ? Math.max(0, Math.round((todayTs-t0)/86400000)) : null; };
  const rows = [];
  const push = o => rows.push(o);

  /* 币价 */
  const pxp = (DATA.price||{}).pons, pxs = (DATA.price||{}).stonkfun;
  push({ st:'ok', name:t('srcPrice'), from:t('srcPriceFrom'), last:t('srcJustNow'),
         note:(pxp?'PONS $'+fmtN(pxp,4):'')+(pxp&&pxs?'　·　':'')+(pxs?'STONK $'+fmtN(pxs,4):'') });

  /* 两家日度（收入与销毁取更早的那条，别报喜不报忧） */
  [['srcDailyP','pons.dailyRevenue','pons.dailyHoldersRevenue',''],
   ['srcDailyS','stonkfun.dailyRevenue','stonkfun.dailyHoldersRevenue','stonkfun']].forEach(function(x){
    const d1 = lastDayOf(x[1]), d2 = lastDayOf(x[2]);
    let last = (d1 && d2) ? (d1 < d2 ? d1 : d2) : (d1 || d2);
    let from = t('srcDailyFrom');
    if(x[3]){                        /* STONK：官方日线优先（v3.18） */
      const sfL = sfDailyLast();
      if(sfL && (!last || sfL > last)) last = sfL;
      if(sfL) from = t('srcDailyFromS');
    }
    const lg = lagDays(last);
    push({ st: (lg!=null && lg>=2) ? 'wn' : 'ok', name:t(x[0]), from: from,
           last: last ? last.slice(5) : '—',
           badge: (lg!=null && lg>=1) ? t('srcLag')(lg) : null,
           note: x[3] ? t('srcStonkNote') : null });
  });

  /* 小时级 */
  const hb = hourlyBundle();
  const hrs = (hb && hb.hours) || [];
  const lastH = hrs.length ? hrs[hrs.length-1] : null;
  push({ st:'ok', name:t('srcHourly'), from:t('srcHourlyFrom'),
         last: lastH ? new Date(lastH*1000).toISOString().slice(5,16).replace('T',' ') : '—',
         note:t('srcHourNote') });

  /* 全站收入排行榜 */
  const lb = rankBoard();
  const lbT = lb && (lb.fetchedAt || lb.updated);
  const lbLast = lbT ? new Date(lbT).toLocaleString(LANG==='zh'?'zh-CN':'en-GB',
                    {month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'}) : '—';
  push({ st: (lb && lb.stale) ? 'wn' : 'ok', name:t('srcLb'), from:t('srcLbFrom'),
         last: lbLast, note: (lb && lb.stale) ? t('srcLbStale') : null });

  const lag = rows.filter(r=>r.st!=='ok').length;
  el.innerHTML = rows.map(function(r){
    return '<div class="srcrow">'
      + '<span class="s-dot '+r.st+'"></span>'
      + '<span class="s-name">'+r.name+'</span>'
      + '<span class="s-from">'+r.from+'</span>'
      + (r.badge ? '<span class="s-badge'+(r.st==='ok'?'':' wn')+'">'+r.badge+'</span>' : '')
      + '<span class="s-last">'+r.last+'</span>'
      + (r.note ? '<span class="s-note">'+r.note+'</span>' : '')
      + '</div>';
  }).join('') + '<div class="srcsum">'+t('srcSum')(rows.length, rows.length-lag, lag)+'</div>';
}
function renderTable(){
  const all  = build();
  const rows = all.slice(-20).reverse();
  const mx = {};
  ['pons_rev','pons_hold','stonkfun_rev','stonkfun_hold'].forEach(k=>{
    mx[k] = Math.max(1, ...rows.map(r=>+r[k]||0));
  });
  const w = (k,v)=> (!v||!isFinite(v)) ? 0 : Math.max(2, Math.round(v/mx[k]*100));
  const gc = p => p.id==='pons' ? 'pons' : 'stonk';
  const st = {}; PROJECTS.forEach(p=>{ st[p.id]=stats(all,p); });
  const priceTd = v => `<td class="mono v-px">${v?'$'+fmtN(v,4):'—'}</td>`;
  const dlt = (cur,prev)=>{
    if(!cur||!prev) return '';
    const d=(cur-prev)/prev;
    if(!isFinite(d)||Math.abs(d)<0.005) return '<span class="dlt flat">–</span>';
    return '<span class="dlt '+(d>0?'up':'dn')+'">'+(d>0?'▲':'▼')+Math.abs(d*100).toFixed(0)+'%</span>';
  };
  /* 补充值：DefiLlama 还没出的日子，用更快的源补上（链上 / 官方），并标明覆盖了多久 */
  const suppData=(hourlyBundle()&&hourlyBundle().dailySupp)||{};
  const suppOf=(id,day,key)=>{
    const d=(suppData[id==='pons'?'pons':'stonk']||{})[day];
    if(!d || d[key]==null) return null;
    return { v:d[key],
      tag:(d.partial? t('suppNewPart')(d.hours) : t('suppNew')),
      tip:t('suppTip')(d.hours, !!d.partial, id==='pons'? t('suppWhoPons') : t('suppWhoStonk'), id!=='pons') };
  };
  const cell = (cl,k,v,extra,pending,supp)=>{
    if(pending){
      if(supp) return `<td class="mono ${cl} sup" title="${esc(supp.tip)}"><span class="v">${fmtU(supp.v)}</span><em class="sup-tag">${esc(supp.tag)}</em></td>`;
      return `<td class="mono ${cl} pend" title="${t('pendingTip')}"><span class="v pend-v">${t('pendingCell')}</span></td>`;
    }
    return `<td class="mono ${cl}"><span class="bar" style="--w:${w(k,v)}%"></span><span class="v">${fmtU(v)}</span>${extra||''}</td>`;
  };
  const lagTag = id => { const s = st[id]; return s.lag>0
    ? `<span class="lagtag" title="${t('lagTip')}">${t('srcLatest')(s.lastDate.slice(5))}</span>` : ''; };

  document.getElementById('tbl').querySelector('thead').innerHTML =
    `<tr class="grp"><th class="c-date" rowspan="2">${t('thDate')}</th>`+
    `<th class="g-pons" colspan="3">PONS <span style="opacity:.45;font-weight:500;letter-spacing:0">· Robinhood</span>${lagTag('pons')}</th>`+
    `<th class="g-stonk" colspan="3">STONK <span style="opacity:.45;font-weight:500;letter-spacing:0">· Solana</span>${lagTag('stonkfun')}</th></tr>`+
    `<tr class="sub"><th class="g-pons">${t('thRev')}</th><th class="g-pons">${t('thBurn')}</th><th class="g-pons">${t('thPrice')}</th>`+
    `<th class="g-stonk">${t('thRev')}</th><th class="g-stonk">${t('thBurn')}</th><th class="g-stonk">${t('thPrice')}</th></tr>`;

  const sum = `<tr class="sum"><td class="mono c-date">${t('thAvg7')}</td>`+
    PROJECTS.map(p=>{
      const s=st[p.id], g='g-'+gc(p);
      const win = s.lag>0? `<small class="win">${s.winFrom.slice(5)} ~ ${s.winTo? s.winTo.slice(5):s.lastDate.slice(5)}</small>` : '';
      return cell(g+' v-rev', p.id+'_rev',  s.avg7, win) +
             cell(g+' v-bb',  p.id+'_hold', s.holdSum7/7) +
             priceTd(s.psv);
    }).join('') + `</tr>`;

  const pLast = st.pons.lastDate, bLast = st.stonkfun.lastDate;
  const pHoldLast = st.pons.holdLastDate, bHoldLast = st.stonkfun.holdLastDate;
  const body = rows.map((r,i)=>{
    const prev = rows[i+1] || {};
    /* 源站还没出这天 → 标"待更新"而不是一个光秃秃的破折号；收入与回购两条线各自判断 */
    const pPend = r.date > pLast,   pHoldPend = r.date > pHoldLast;
    const bPend = r.date > bLast,   bHoldPend = r.date > bHoldLast;
    return `<tr><td class="mono c-date">${r.date}</td>`+
      cell('g-pons v-rev','pons_rev',r.pons_rev, dlt(r.pons_rev, prev.pons_rev), pPend, pPend? suppOf('pons',r.date,'rev'):null)+
      cell('g-pons v-bb','pons_hold',r.pons_hold, '', pHoldPend, pHoldPend? suppOf('pons',r.date,'hold'):null)+
      priceTd(r.pons_price)+
      cell('g-stonk v-rev','stonkfun_rev',r.stonkfun_rev, dlt(r.stonkfun_rev, prev.stonkfun_rev), bPend, bPend? suppOf('stonkfun',r.date,'rev'):null)+
      cell('g-stonk v-bb','stonkfun_hold',r.stonkfun_hold, '', bHoldPend, bHoldPend? suppOf('stonkfun',r.date,'hold'):null)+
      priceTd(r.stonkfun_price)+`</tr>`;
  }).join('');

  document.getElementById('tbl').querySelector('tbody').innerHTML = sum + body;
}

/* ---------- guide ---------- */
function renderGuide(){
  const rows = build();
  const A = PROJECTS[0], B = PROJECTS[1];
  const sa = stats(rows,A), sb = stats(rows,B);
  const psx = v => (v===null||v===undefined||!isFinite(v))?'—':fmtN(v,2)+'x';
  const pcy = v => (v===null||!isFinite(v))?'—':(v*100).toFixed(2)+'%';
  const wk  = s => s.vol24? s.vol24*7 : null;

  const cheaper = (sa.ps7 && sb.ps7) ? (sa.ps7<sb.ps7 ? A : B) : null;
  const dearer  = cheaper ? (cheaper.id===A.id ? B : A) : null;
  const sc = cheaper? stats(rows,cheaper) : null, sd = dearer? stats(rows,dearer) : null;
  const gap = (sc&&sd&&sc.ps7&&sd.ps7)? sd.ps7/sc.ps7 : null;

  const divLine = (p, stT) => {
    if(!stT.ps7 || !stT.ps30) return '';
    const div = stT.ps7/stT.ps30;
    let tx2;
    if(div > 1.5) tx2 = t('divFast')(fmtN(100/div,0));
    else if(div > 1.15) tx2 = t('divSoft')();
    else if(div < 0.85) tx2 = t('divUp')((1/div).toFixed(1));
    else tx2 = t('divFlat')();
    return t('psLine')(p.name, psx(stT.ps7), psx(stT.ps30), div.toFixed(2), tx2.t).replace('%C%', tx2.c);
  };

  const item = (title, formula, lead, ex, bands, note, anchor) =>
    `<div class="gitem"${anchor?' id="'+anchor+'"':''}>
       <h3>${title}</h3>
       <div class="f">${formula}</div>
       <div class="lead">${lead}</div>
       ${ex?`<div class="ex">${ex}</div>`:''}
       ${bands?`<ul>${bands.map(b=>`<li><span class="band ${b[1]}">${b[0]}</span><span>${b[2]}</span></li>`).join('')}</ul>`:''}
       ${note?`<div class="note">${note}</div>`:''}
     </div>`;

  const ex1 = `<div class="cap">${t('gPsCap')(A.name)}</div>` +
    t('gPsLine')(fmtU(sa.mcap), fmtU(sa.avg7), fmtU(sa.avg7*365), psx(sa.ps7), fmtN(sa.ps7,1)) +
    (sb.ps7!==null ? `<div style="margin-top:7px;padding-top:7px;border-top:1px dashed var(--line2)">`+
      t('gPsCompare')(B.name, fmtU(sb.mcap), fmtU(sb.avg7*365), psx(sb.ps7), cheaper?cheaper.ticker:'', gap?gap.toFixed(1):'') + `</div>` : '');

  const ex3 = t('gBpLine')(A.name, fmtU(sa.holdSum7), pcy(sa.burnForce), fmtU(wk(sa))) +
    '<br>' + t('gBpLine')(B.name, fmtU(sb.holdSum7), pcy(sb.burnForce), fmtU(wk(sb))) +
    '<br><span style="color:var(--mut2)">' + t('gBpFoot') + '</span>';

  const ex4 = t('gToLine')(A.name,
      (sa.turnover!==null?(sa.turnover*100).toFixed(1)+'%':'—'),
      (sa.burnYield!==null?fmtN(sa.burnYield*100,0)+'%':'—'),
      B.name,
      (sb.turnover!==null?(sb.turnover*100).toFixed(1)+'%':'—'),
      (sb.burnYield!==null?fmtN(sb.burnYield*100,0)+'%':'—')) +
    '<br><span style="color:var(--mut2)">' + t('gToFoot') + '</span>';

  const momA = (sa.avg7-sa.avg7p)/(sa.avg7p||1), momB = (sb.avg7-sb.avg7p)/(sb.avg7p||1);
  const ex5 = A.name+' <b>'+(momA*100).toFixed(1)+'%</b>　·　'+B.name+' <b>'+(momB*100).toFixed(1)+'%</b>'+
    '<br><span style="color:var(--mut2)">'+t('gMomFoot')+'</span>';
  const sk = shareBundle() || {};
  const exShare = (sk.pons && sk.stonk)? t('gMsEx')(
      shPct(sk.pons.share), (sk.pons.rank!=null? '#'+sk.pons.rank+' / '+sk.pons.total : '—'),
      shPct(sk.stonk.share), (sk.stonk.rank!=null? '#'+sk.stonk.rank+' / '+sk.stonk.total : '—'),
      shPct(sk.stonk.pumpShare), shPct(sk.stonk.vsPump)) : '';
  const msk = msBundle() || {};
  const exMs = (msk.pons && msk.stonk)? t('gMmEx')(
      fmtT(msk.pons.burned), (msk.pons.pct!=null? msk.pons.pct.toFixed(2)+'%':'—'),
      (msk.pons.nextPct!=null? msk.pons.nextPct+'%':'—'), msDayTxt(msk.pons.daysTo),
      fmtT(msk.stonk.burned), (msk.stonk.pct!=null? msk.stonk.pct.toFixed(2)+'%':'—'),
      (msk.stonk.nextPct!=null? msk.stonk.nextPct+'%':'—'), msDayTxt(msk.stonk.daysTo)) : '';

  document.getElementById('guide').innerHTML =
    item(t('gPsT'), t('gPsF'), t('gPsL'), ex1, t('gPsBands'), t('gPsNote'), 'gloss-ps')
  + item(t('g730T'), t('g730F'), t('g730L'),
         divLine(A,sa) + '<div style="margin-top:7px;padding-top:7px;border-top:1px dashed var(--line2)">' + divLine(B,sb) + '</div>',
         null, t('g730Note'), 'gloss-730')
  + item(t('gBpT'), t('gBpF'), t('gBpL'), ex3, t('gBpBands'), t('gBpNote'), 'gloss-bp')
  + item(t('gToT'), t('gToF'), t('gToL'), ex4, t('gToBands'), t('gToNote'), 'gloss-to')
  + item(t('gMomT'), t('gMomF'), t('gMomL'), ex5, t('gMomBands'), null, 'gloss-mom')
  + item(t('gMsT'), t('gMsF'), t('gMsL'), exShare, t('gMsBands'), t('gMsNote'), 'gloss-share')
  + item(t('gMmT'), t('gMmF'), t('gMmL'), exMs, t('gMmBands'), t('gMmNote'), 'gloss-milestone');
}

/* ---------- 指标说明：默认折叠 + 「?」直达（v3.7） ----------
   · 默认收起；点标题行（或回车 / 空格）展开、收起
   · 点指标旁的「?」→ 自动展开 + 平滑滚动到对应说明 + 闪一下高亮
   · 带 #gloss-xx 锚点打开页面时，同样自动展开并定位 */
function guideSetOpen(open){
  var w = document.getElementById('guideWrap'), h = document.getElementById('st-guide');
  if(!w || !h) return;
  h.classList.toggle('open', !!open);
  h.setAttribute('aria-expanded', open ? 'true' : 'false');
  var hint = document.getElementById('guideHint');
  if(hint) hint.textContent = open ? t('guideCollapse') : t('guideExpand');
  /* 容器始终 overflow:hidden —— 折叠动画期间内容必须被裁掉；
     若放开成 visible，盒子收到 0 高度后内容仍会画在外面、和下方区块重叠（v3.7.1 修复） */
  w.style.overflow = 'hidden';
  if(open){
    w.classList.add('open');
    w.style.maxHeight = w.scrollHeight + 'px';       /* 量出实际高度，动画才顺 */
  }else{
    if(!w.classList.contains('open')){ w.style.maxHeight = '0px'; return; }
    w.style.maxHeight = w.scrollHeight + 'px';       /* 从当前高度往 0 收 */
    requestAnimationFrame(function(){ w.classList.remove('open'); w.style.maxHeight = '0px'; });
  }
}
function guideToggle(force){
  var w = document.getElementById('guideWrap');
  if(!w) return;
  guideSetOpen(force === undefined ? !w.classList.contains('open') : !!force);
}
(function(){
  var w = document.getElementById('guideWrap');
  if(!w) return;
  w.addEventListener('transitionend', function(ev){
    if(ev.propertyName !== 'max-height') return;
    if(w.classList.contains('open')) w.style.maxHeight = 'none';
    /* 展开后只解除高度上限（overflow 保持 hidden），语言切换 / 数据刷新导致内容变高也不会被裁 */
  });
  document.addEventListener('click', function(ev){
    var a = ev.target && ev.target.closest ? ev.target.closest('a.qi') : null;
    if(!a) return;
    var id = (a.getAttribute('href') || '').slice(1);
    if(!id) return;
    ev.preventDefault();
    var wasOpen = w.classList.contains('open');
    guideSetOpen(true);
    /* 折叠时页面比展开后矮一截，立即滚会被文档底截断 → 等展开动画把页面撑高再滚 */
    guideScrollTo(id, wasOpen ? 0 : 580);
  });
})();

/* v3.19：数据源体检也支持折叠（默认收起，风格与指标说明一致） */
function srcSetOpen(open){
  var w = document.getElementById('srcWrap'), h = document.getElementById('st-src');
  if(!w || !h) return;
  h.classList.toggle('open', !!open);
  h.setAttribute('aria-expanded', open ? 'true' : 'false');
  var hint = document.getElementById('srcHint');
  if(hint) hint.textContent = open ? t('guideCollapse') : t('guideExpand');
  w.style.overflow = 'hidden';
  if(open){
    w.classList.add('open');
    w.style.maxHeight = w.scrollHeight + 'px';
  }else{
    if(!w.classList.contains('open')){ w.style.maxHeight = '0px'; return; }
    w.style.maxHeight = w.scrollHeight + 'px';
    requestAnimationFrame(function(){ w.classList.remove('open'); w.style.maxHeight = '0px'; });
  }
}
function srcToggle(force){
  var w = document.getElementById('srcWrap');
  if(!w) return;
  srcSetOpen(force === undefined ? !w.classList.contains('open') : !!force);
}
(function(){
  var w = document.getElementById('srcWrap');
  if(!w) return;
  w.addEventListener('transitionend', function(ev){
    if(ev.propertyName !== 'max-height') return;
    if(w.classList.contains('open')) w.style.maxHeight = 'none';
  });
})();
function guideScrollTo(id, delay){
  var el = document.getElementById(id);
  if(!el) return;
  var go = function(){
    try{ el.scrollIntoView({behavior:'smooth', block:'start'}); }catch(e){ el.scrollIntoView(); }
    gflashAfterScroll(el);
  };
  if(delay) setTimeout(go, delay); else go();
}
/* v3.8：高亮等「滚动停稳」再亮。
   跨半个页面滚动要约 2 秒，若点击瞬间就点亮，用户滚到时闪光只剩一半 —— 白烧。
   目标本来就在视口内（不产生滚动）时 0.45 秒后直接亮；兜底最长 7 秒。 */
function gflashAfterScroll(el){
  var fired = false, idle = null, t0 = Date.now(), moved = false;
  function fire(){
    if(fired) return; fired = true;
    window.removeEventListener('scroll', onScroll);
    clearTimeout(idle);
    el.classList.remove('gflash'); void el.offsetWidth; el.classList.add('gflash');
    setTimeout(function(){ el.classList.remove('gflash'); }, 4300);
  }
  function onScroll(){
    moved = true;
    if(Date.now() - t0 > 7000){ fire(); return; }
    clearTimeout(idle); idle = setTimeout(fire, 180);
  }
  window.addEventListener('scroll', onScroll, {passive:true});
  idle = setTimeout(function(){ if(!moved) fire(); }, 450);
}
function guideHashInit(){
  if(!/^#gloss-/.test(location.hash || '')) return;
  guideSetOpen(true);
  guideScrollTo(location.hash.slice(1), 580);
}


/* ==========================================================================
   v3.21 页面导航（#secNav）：长页面「我在哪、去哪」的答案
   —— 桌面：左侧竖排导航列，图标 + 文字常显（v3.20 只有图标，用户反馈看不懂）；
      滚到哪一节，对应项自动亮；点击平滑滚过去。
   —— 手机：顶部横滑胶囊条（吸顶在固定头部下面），当前项自动滚到中间；
      滑动时出现、停手约 1.5 秒自动淡出（只在吸顶后收起，页面顶部不留空档）。
   —— 目标如果是折叠区（数据体检 / 指标说明），先展开、等页面撑高再滚，
      否则会滚到一半被文档底截断（复用 guideScrollTo 的成熟时序）。
   ========================================================================== */
const NAV_ITEMS=[
  {id:'top',       ic:'zap',      k:'navTop'},
  {id:'st-hourly', ic:'activity', k:'navHourly'},
  {id:'st-rules',  ic:'bell',     k:'navRules'},
  {id:'st-burn',   ic:'flame',    k:'navBurn'},
  {id:'st-share',  ic:'pie',      k:'navShare'},
  {id:'st-rank',   ic:'trophy',   k:'navRank'},
  {id:'st-chart',  ic:'trend',    k:'navChart'},
  {id:'st-table',  ic:'table',    k:'navTable'},
  {id:'st-src',    ic:'db',       k:'navSrc'},
  {id:'st-guide',  ic:'book',     k:'navGuide'}
];
let NAV_NOW=null, NAV_TICK=false, NAV_ELS=null, NAV_CARD=null, NAV_TBON=false, NAV_HIDE_T=null, NAV_STICK=false;
function navReduce(){ try{ return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches); }catch(e){ return false; } }
function navBuild(){
  const nav=document.getElementById('secNav'); if(!nav) return;
  nav.setAttribute('aria-label', t('navAria'));
  nav.innerHTML='<div class="nav-h" aria-hidden="true">'+esc(t('navTitle'))+'</div>'
    +NAV_ITEMS.map(function(it){
    const lab=t(it.k);
    return '<button class="nav-i" type="button" data-nav="'+it.id+'" title="'+esc(lab)+'" aria-label="'+esc(lab)+'">'
      + '<span class="nav-dot">'+IC[it.ic]+'</span><span class="nav-t">'+esc(lab)+'</span></button>';
  }).join('');
  NAV_NOW=null; navSpy();
}
function navSet(id){
  const nav=document.getElementById('secNav'); if(!nav || id===NAV_NOW) return;
  NAV_NOW=id;
  const bs=nav.querySelectorAll('[data-nav]');
  let act=null;
  for(let i=0;i<bs.length;i++){
    const on=bs[i].getAttribute('data-nav')===id;
    bs[i].classList.toggle('on',on);
    if(on){ bs[i].setAttribute('aria-current','true'); act=bs[i]; }
    else bs[i].removeAttribute('aria-current');
  }
  /* 手机横条：把当前项滚到可视区中间（只动横条自己，不带动整页） */
  if(act && nav.scrollWidth>nav.clientWidth+8){
    const x=act.offsetLeft-(nav.clientWidth-act.offsetWidth)/2;
    try{ nav.scrollTo({left:Math.max(0,x),behavior:navReduce()?'auto':'smooth'}); }catch(e){ nav.scrollLeft=Math.max(0,x); }
  }
}
function navSpy(){
  NAV_TICK=false;
  const nav=document.getElementById('secNav'); if(!nav) return;
  /* 性能：板块元素、作者卡只查一次（它们是静态节点，语言切换/数据刷新都不会被替换），
     滚动时每帧只做 getBoundingClientRect 这一种「读」，不查 DOM、不写样式（除高亮变化）。 */
  if(!NAV_ELS) NAV_ELS=NAV_ITEMS.map(function(it){ return it.id==='top'? null : document.getElementById(it.id); });
  if(NAV_CARD===null) NAV_CARD=document.querySelector('.author')||false;
  const y=window.pageYOffset||document.documentElement.scrollTop||0;
  const vh=window.innerHeight, atBottom=(y+vh>=(document.documentElement.scrollHeight-6));
  let cur='top';
  if(atBottom){
    /* 已在页底：页尾几节都贴着屏幕，取「最上面那个可见的」当当前 —— 否则点「数据体检」
       这种倒数第二节会因为滚不到顶而错亮最后一节 */
    for(let i=1;i<NAV_ELS.length;i++){
      const el=NAV_ELS[i]; if(!el) continue;
      const t=el.getBoundingClientRect().top;
      if(t>=0 && t<=vh*0.6){ cur=NAV_ITEMS[i].id; break; }
    }
    if(cur==='top') cur=NAV_ITEMS[NAV_ITEMS.length-1].id;
  }else{
    for(let i=1;i<NAV_ELS.length;i++){
      const el=NAV_ELS[i]; if(!el) continue;
      /* 判定线（视口坐标）：标题滚进上缘 132px 内就算「当前」（比锚点落位 80/114 略大，点完不会差一格） */
      if(el.getBoundingClientRect().top<=132) cur=NAV_ITEMS[i].id;
    }
  }
  navSet(cur);
  /* 手机：横条跟着顶部固定栏下移，别叠在一起（判定与左上角小头像同源） */
  const tbOn=NAV_CARD ? NAV_CARD.getBoundingClientRect().bottom<=8 : y>160;
  if(tbOn!==NAV_TBON){ NAV_TBON=tbOn; document.body.classList.toggle('tb-on',tbOn); }
  /* 手机：横条吸顶后补一层柔和底（body.nav-stick），缝隙不再透出正文 */
  const stick=(y>40) && nav.getBoundingClientRect().top<=68;
  if(stick!==NAV_STICK){ NAV_STICK=stick; document.body.classList.toggle('nav-stick', stick && navCoarse()); }
}
function navReq(){ if(NAV_TICK) return; NAV_TICK=true; requestAnimationFrame(navSpy); }
function navGo(id){
  if(id==='top'){
    try{ window.scrollTo({top:0,behavior:navReduce()?'auto':'smooth'}); }catch(e){ window.scrollTo(0,0); }
    navSet('top'); return;
  }
  const el=document.getElementById(id); if(!el) return;
  const go=function(){
    try{ el.scrollIntoView({behavior:navReduce()?'auto':'smooth',block:'start'}); }catch(e){ el.scrollIntoView(); }
    el.classList.remove('nflash'); void el.offsetWidth; el.classList.add('nflash');
    setTimeout(function(){ el.classList.remove('nflash'); },1600);
  };
  /* 目标是折叠区：先展开，等展开动画真正结束再滚 —— 固定延时会在页面还没长高时就把
     滚动截断在旧的底部，落点差出一两百像素（实测点「数据体检」）。优先听 transitionend，
     没有动画（reduced-motion）时用 1s 兜底。 */
  const w=(id==='st-src')? document.getElementById('srcWrap') : (id==='st-guide')? document.getElementById('guideWrap') : null;
  if(w && !w.classList.contains('open')){
    if(id==='st-src') srcSetOpen(true); else guideSetOpen(true);
    let fired=false;
    const onEnd=function(ev){ if(ev.propertyName==='max-height') fire(); };
    const fire=function(){ if(fired) return; fired=true; w.removeEventListener('transitionend',onEnd); go(); };
    w.addEventListener('transitionend',onEnd);
    setTimeout(fire,1000);
    navSet(id); return;
  }
  go(); navSet(id);
}
/* v3.21 手机横条「滑动出现、停手收起」：只在吸顶之后才收 —— 还挂在文档流里时收起，
   顶部会留出一条空档；停手 1.5 秒后淡出，滑动 / 点击导航 / 重新吸顶都会让它回来。
   桌面端（≥1024px）不走这套逻辑，完全不受影响。 */
function navCoarse(){ try{ return window.matchMedia('(max-width:1023px)').matches; }catch(e){ return window.innerWidth<1024; } }
function navShow(){
  const nav=document.getElementById('secNav'); if(!nav) return;
  if(NAV_HIDE_T){ clearTimeout(NAV_HIDE_T); NAV_HIDE_T=null; }
  nav.classList.remove('nav-hide');
  if(!navCoarse()) return;
  NAV_HIDE_T=setTimeout(function(){
    NAV_HIDE_T=null;
    if(!navCoarse()) return;
    let focus=false; try{ focus=nav.matches(':focus-within'); }catch(e){}
    if(focus) return;                                    /* 焦点还在导航上：不收 */
    const y=window.pageYOffset||document.documentElement.scrollTop||0;
    if(y<40) return;                                     /* 页面顶部：横条本来就该在 */
    const stuck=(document.body.classList.contains('tb-on')?66:6)+2;
    if(nav.getBoundingClientRect().top>stuck) return;    /* 还没吸顶：收起会留空档 */
    nav.classList.add('nav-hide');
  },1500);
}
(function(){
  const nav=document.getElementById('secNav'); if(!nav) return;
  nav.addEventListener('click',function(ev){
    const b=ev.target && ev.target.closest? ev.target.closest('[data-nav]') : null;
    if(b){ navGo(b.getAttribute('data-nav')); navShow(); }
  });
  window.addEventListener('scroll',function(){ navReq(); navShow(); },{passive:true});
  window.addEventListener('resize',function(){ navReq(); navShow(); });
  window.addEventListener('load',navReq);
  window.__navSpy=navReq;               /* 数据落地后布局变了，renderAll 会再叫一次 */
})();
 
/* ---------- live ---------- */
async function fetchJSON(u, ms){
  /* 统一超时：第三方接口偶尔挂起，没有超时会把「刷新中」状态卡死 */
  const ac = (typeof AbortController !== 'undefined') ? new AbortController() : null;
  const tm = ac ? setTimeout(function(){ try{ ac.abort(); }catch(e){} }, ms || 15000) : null;
  try{
    const r = await fetch(u, {cache:'no-store', signal: ac ? ac.signal : undefined});
    if(!r.ok) throw new Error(r.status);
    return await r.json();
  } finally { if(tm) clearTimeout(tm); }
}

async function loadFees(){
  const reqs=[];
  ['pons','stonkfun'].forEach(s=>['dailyRevenue','dailyHoldersRevenue','dailyFees'].forEach(dt=>
    reqs.push(fetchJSON(`https://api.llama.fi/summary/fees/${s}?dataType=${dt}`).then(j=>({k:`${s}.${dt}`, j})))));
  reqs.push(fetchJSON('https://api.llama.fi/protocol/pons').then(j=>({k:'meta.pons',j})));
  reqs.push(fetchJSON('https://api.llama.fi/protocol/stonkfun').then(j=>({k:'meta.stonkfun',j})));
  const res = await Promise.all(reqs);
  res.forEach(({k,j})=>{
    if(k.startsWith('meta.')){ const id=k.slice(5);
      DATA.meta[id] = Object.assign({}, DATA.meta[id], {name:j.name, symbol:j.symbol, mcap:j.mcap || DATA.meta[id]?.mcap}); }
    else {
      const arr = (j.totalDataChart||[]).map(([ts,v])=>[ts, v]);
      /* 接口偶尔返回空数组：不要用它覆盖内嵌快照，否则图表会整段空掉 */
      if(arr.length) DATA.series[k] = arr;
    }
  });
}

/* 价格：DefiLlama 币价接口（Pons 在 Robinhood Chain、STONK 在 Solana，均按合约地址取） */
async function loadPrices(){
  const ids = Object.values(LLAMA_IDS).join(',');
  const j = await fetchJSON('https://coins.llama.fi/prices/current/'+ids);
  const coins = j.coins || {};
  const today = Math.floor(Date.now()/1000);
  let got = 0;
  Object.entries(LLAMA_IDS).forEach(([id,key])=>{
    const c = coins[key];
    if(!c || !c.price) return;
    got++;
    DATA.price = DATA.price || {};
    DATA.price[id] = c.price;
    DATA.priceSeries[id] = DATA.priceSeries[id] || [];
    const arr = DATA.priceSeries[id];
    const lastTs = arr.length? arr[arr.length-1][0] : 0;
    if(dayKey(lastTs) === dayKey(today)) arr[arr.length-1] = [lastTs, c.price];
    else arr.push([today, c.price]);
    DATA.priceAt = Date.now();
    const p = PROJECTS.find(x=>x.id===id);
    const mk = (DATA.market||{})[id];
    const mc = (mk && mk.mcap) ? mk.mcap : (p ? c.price * p.supply : null);
    if(mc) DATA.meta[id] = Object.assign({}, DATA.meta[id], {mcap: mc});
  });
  return got;
}

/* 成交额 / 市值：CoinGecko（失败不影响其他数据） */
async function loadMarket(){
  const j = await fetchJSON('https://api.coingecko.com/api/v3/simple/price?ids=' + Object.values(CG_IDS).join(',')
    + '&vs_currencies=usd&include_24hr_vol=true&include_market_cap=true&include_24hr_change=true');
  const mk = DATA.market || (DATA.market = {});
  Object.entries(CG_IDS).forEach(([name,cid])=>{
    const x = j[cid] || {};
    if(x.usd_24h_vol) mk[name] = {vol24h:x.usd_24h_vol, mcap:x.usd_market_cap||0, price:x.usd, change24h:x.usd_24h_change||0};
    /* 价格只认一个主源（coins.llama.fi）。这里以前会无条件覆盖 DATA.price，
       两个接口完成顺序不同 → 同一个币价一会是这个、一会是那个（2026-10-05 修）：
       只有当主源没给到价时，才用 CoinGecko 兜底。 */
    DATA.price = DATA.price || {};
    if(x.usd && !(DATA.price[name] > 0)) DATA.price[name] = x.usd;
  });
  PROJECTS.forEach(p=>{
    const m = mk[p.id];
    if(m && m.mcap) DATA.meta[p.id] = Object.assign({}, DATA.meta[p.id], {mcap: m.mcap});
  });
}

let BUSY = false;
async function loadLive(){
  if(BUSY) return;
  BUSY = true;
  const b = document.getElementById('src');
  b.textContent = t('fetching'); b.className = 'badge';
  const btn = document.getElementById('btnRefresh');
  if(btn){ btn.disabled = true; btn.classList.add('busy'); }
  /* v3.9 首屏价格优先（用户反馈：打开后 1~3 秒价格才变，第一印象像数据不对）
     价格只走 coins.llama.fi 一个最小接口；以前它排在 6 个日度口径请求「后面」串行等待，
     所以最快也要等 loadFees 全部跑完才轮到它。现在先发出去、回来立刻单独上屏，
     不等其它任何数据。 */
  const priceP = loadPrices().then(function(n){
    if(n){
      renderAll();          /* 先用最新价重画一遍（其余字段仍是内嵌快照值） */
      flashPrices();
      setSrc(true, n);
    }
    return n;
  }).catch(function(){ return 0; });

  /* v3.9 主数据与重数据拆成两条流水线。
     以前是「日度口径 → 成交额 → 4.2MB 排行榜」一路 await 串下来，
     时序实测：日度数据 600ms 就回来了，但 renderAll 要等到排行榜 1682ms 跑完才执行
     —— 用户多等 1 秒多才看到新数字。现在各走各的，谁回来谁上屏。 */
  const coreP = Promise.allSettled([loadFees(), loadMarket()]);
  /* 排行榜 4.2MB：单独发，回来只重画「收入排行」那一段，绝不拖住主数据上屏 */
  const lbP = loadLeaderboard().then(function(){
    try{ renderRank(); }catch(e){}
  }).catch(function(){});
  /* 链上 24h 回购（20+ 次 RPC，最慢）：同样不阻塞首屏 */
  const chainP = loadChainBurn().then(function(r){
    CHAIN_TRIED = true;
    if(r) renderAll(); else renderBurn();
    return r;
  }).catch(function(){ CHAIN_TRIED = true; return false; });
  /* 小时监控：交易量 / 链上销毁 的小时级实时刷新（不阻塞首屏） */
  try{ refreshHourlyLive(); }catch(e){}

  const core = await coreP;
  const ok = core[0].status === 'fulfilled';
  const priceOk = await priceP;
  DATA.generated = new Date().toISOString();
  try{
    setSrc(ok, priceOk);
    renderAll();
    if(priceOk) flashPrices();
  } finally {
    /* 任何一步出错也要放掉「刷新中」，否则按钮会一直禁用 */
    BUSY = false;
    if(btn){ btn.disabled = false; btn.classList.remove('busy'); }
  }
}
function setSrc(ok, priceOk){
  const b=document.getElementById('src');
  const time = new Date().toLocaleTimeString(LANG==='zh'?'zh-CN':'en-GB',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
  if(ok || priceOk){ b.textContent = t('liveAt') + time; b.className='badge live'; }
  else  { b.textContent = t('offline');        b.className='badge off'; }
}
function flashPrices(){
  PROJECTS.forEach(p=>{
    const el=document.getElementById('px-'+p.id);
    if(!el) return;
    el.classList.remove('flash');
    void el.offsetWidth;
    el.classList.add('flash');
    setTimeout(()=>el.classList.remove('flash'), 1600);
  });
}
/* ---------- 浏览量：本站自建计数（/api/hits），第三方看不到数据 ---------- */
let PV_DATA = null;
function paintViews(){
  const el = document.getElementById('pvStat');
  if(!el) return;
  if(!PV_DATA){ el.style.display='none'; return; }
  el.style.display = '';
  el.innerHTML = '<span class="pv-ic">'+IC.eye+'</span>'
    + '<span class="pv-k">'+t('pvTotal')+'</span> <b>'+fmtN(PV_DATA.total,0)+'</b>'
    + '<i>·</i><span class="pv-k">'+t('pvToday')+'</span> <b>'+fmtN(PV_DATA.today,0)+'</b>'
    + '<i>·</i><span class="pv-k">'+t('pvUv')+'</span> <b>'+fmtN(PV_DATA.uvToday||0,0)+'</b>';
}
function loadViews(){
  /* 只有真正挂在 http(s) 上才计数：本地双击打开的 file:// 页面不算流量 */
  if(location.protocol!=='http:' && location.protocol!=='https:') return;
  fetch('/api/hits?t='+Date.now(), {cache:'no-store'})
    .then(function(r){ return r.ok ? r.json() : null; })
    .then(function(d){ if(d && typeof d.total==='number'){ PV_DATA = d; paintViews(); } })
    .catch(function(){ /* 计数服务不在也不影响页面 */ });
}

function renderAll(){
  [renderCards, renderHourly, renderShare, renderRules, renderBurn, renderRank, renderTabs, renderChart, renderTable, renderSrc, renderGuide].forEach(function(fn){
    try{ fn(); }catch(e){ console.error('render failed:', fn.name, e); }
  });
  const g = DATA.generated || BUNDLE.generated;
  if(icRevealMeasure){ try{ icRevealMeasure(); }catch(e){} }
  if(window.__miniMeasure){ try{ window.__miniMeasure(); }catch(e){} }
  if(window.__navSpy){ try{ window.__navSpy(); }catch(e){} }   /* v3.20：数据落地后刷新导航高亮 */
  document.getElementById('gen').textContent = t('updatedAt') + new Date(g).toLocaleString(LANG==='zh'?'zh-CN':'en-GB')
    + (DATA.priceAt? t('priceLive')(new Date(DATA.priceAt).toLocaleTimeString(LANG==='zh'?'zh-CN':'en-GB',{hour:'2-digit',minute:'2-digit'})) : '');
  document.getElementById('foot').innerHTML = t('foot1') + '<br>' + t('foot2') + FOOT_AUTHOR[LANG]
      + '<div class="foot-meta"><span class="dash-ver" title="'+t('verTip')+'">'+DASH_VER+'</span>'
      + '<span class="pv" id="pvStat" title="'+t('pvTip')+'"></span></div>';
  paintViews();
}

/* ---------- 手机端：确保头像 / 关注按钮一定能跳转 X ---------- */
(function(){
  var XURL = 'https://x.com/arych_kun';
  var touch = ('ontouchstart' in window) || (navigator.maxTouchPoints>0);
  document.addEventListener('click', function(ev){
    var a = ev.target && ev.target.closest ? ev.target.closest('a[data-xlink]') : null;
    if(!a) return;
    if(ev.metaKey||ev.ctrlKey||ev.shiftKey||ev.button>0) return;
    if(!touch) return;                     /* 桌面端保持原生行为 */
    ev.preventDefault();
    var w = null;
    try{ w = window.open(a.href, '_blank'); }catch(e){}
    if(!w || w.closed || typeof w.closed==='undefined'){ window.location.href = a.href; }
  }, true);
  void XURL;
})();

/* ---------- 启动 ---------- */
document.documentElement.lang = (LANG==='zh'?'zh-CN':'en');
document.title = t('docTitle');

/* ---------- 主题切换 ---------- */
const THEMES=[{k:'auto',ic:IC.monitor,zh:'系统',en:'Auto'},{k:'light',ic:IC.sun,zh:'浅色',en:'Light'},{k:'dark',ic:IC.moon,zh:'深色',en:'Dark'}];
function curTheme(){try{return localStorage.getItem('pons-theme')||'auto'}catch(e){return 'auto'}}
function applyTheme(t){
  const th=THEMES.find(x=>x.k===t)||THEMES[0];
  if(th.k==='auto') document.documentElement.removeAttribute('data-theme');
  else document.documentElement.setAttribute('data-theme',th.k);
  try{localStorage.setItem('pons-theme',th.k);}catch(e){}
  const b=document.getElementById('tbtn');
  if(b){ b.innerHTML=th.ic+' '+(LANG==='zh'?th.zh:th.en);
         b.title=(LANG==='zh'?'切换主题：跟随系统 / 浅色 / 深色':'Theme: system / light / dark'); }
}
function cycleTheme(){
  const i=THEMES.findIndex(x=>x.k===curTheme());
  applyTheme(THEMES[(i+1)%THEMES.length].k);
}
applyTheme(curTheme());

/* ---------- 顶部作者名片 → 左上角小头像：共享元素式过渡 ----------
   大头像不动，下滑时小头像从大头像的「原位」出发，边缩小边飞向左上角，
   回到顶部再原路飞回。全程跟随滚动位置，不用定时器，所以没有一跳一跳的感觉。 */
(function(){
  var mini=document.querySelector('.author-mini');
  var tmini=document.getElementById('tipMini');
  var big=document.querySelector('.author-av');
  var card=document.querySelector('.author');
  var bar=document.getElementById('topbar');
  if(!mini||!big||!card) return;
  var IMG=40, PAD=4, CX=12, CY=10;      /* 终点：左上角，尺寸与内边距跟 CSS 保持一致 */
  var reduce=false;
  try{ reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches; }catch(e){}
  var ticking=false, sx=null, sy=0, s0=1;
  /* v3.13.3 性能：名片与头像的位置只在开场/改窗口大小时量一次，
     滚动时只算数字（原来每帧两次 getBoundingClientRect，是第二处强制同步布局）。 */
  var cTop=0, cH=1, bLeft=0, bTop=0, bW=IMG;
  function measure(){
    var y=window.pageYOffset||document.documentElement.scrollTop||0;
    var rc=card.getBoundingClientRect(), rb=big.getBoundingClientRect();
    cTop=rc.top+y; cH=rc.height||1;
    bLeft=rb.left; bTop=rb.top+y; bW=rb.width||IMG;
    sx=null;                                    /* 起点重新采样 */
  }
  function frame(){
    ticking=false;
    var y=window.pageYOffset||document.documentElement.scrollTop||0;
    var p=(8-(cTop-y))/(cH-8);                 /* 0＝停在顶部　1＝名片已完全离开视口 */
    p=p<0?0:(p>1?1:p);
    if(p<=0.001||sx===null){ sx=bLeft; sy=bTop-y; s0=bW/IMG; }  /* 起点＝顶部时的原位 */
    var e=reduce?(p>0.5?1:0):p*p*(3-2*p);      /* smoothstep：起步轻、中段快、落位稳 */
    var s=s0+(1-s0)*e;
    var tx=sx+(CX-sx)*e-PAD*s;
    var ty=sy+(CY-sy)*e-PAD*s;
    mini.style.transform='translate3d('+tx.toFixed(2)+'px,'+ty.toFixed(2)+'px,0) scale('+s.toFixed(4)+')';
    mini.style.opacity=Math.min(1,p/0.10).toFixed(3);
    big.style.opacity=(1-Math.min(1,p/0.28)).toFixed(3);
    var st=e>0.995;
    if(bar){ bar.style.opacity=Math.max(0,Math.min(1,(p-0.18)/0.30)).toFixed(3);
             bar.classList.toggle('on',st); }
    mini.classList.toggle('settled',st);
    if(tmini) tmini.classList.toggle('settled',st);
  }
  function req(){ if(!ticking){ ticking=true; requestAnimationFrame(frame); } }
  function remeasure(){ measure(); req(); }
  measure();
  window.__miniMeasure=measure;               /* 数据落地后高度可能变，由 renderAll 再量一次 */
  window.addEventListener('scroll',req,{passive:true});
  window.addEventListener('resize',remeasure);
  window.addEventListener('load',remeasure);
  req();
})();

/* ---------- 打赏弹窗 + 复制地址 + 感谢提示 ---------- */
function openTip(){
  var m=document.getElementById('tipModal'); if(!m) return;
  m.classList.add('on'); document.body.style.overflow='hidden';
}
function closeTip(){
  var m=document.getElementById('tipModal'); if(!m) return;
  m.classList.remove('on'); document.body.style.overflow='';
}
document.addEventListener('keydown',function(e){ if(e.key==='Escape') closeTip(); });
function toast(msg){
  var el=document.getElementById('toast'); if(!el) return;
  el.textContent=msg; el.classList.add('on');
  clearTimeout(el._tm);
  el._tm=setTimeout(function(){ el.classList.remove('on'); },2600);
}
function copyAddr(id,label){
  var node=document.getElementById(id); if(!node) return;
  var text=(node.textContent||'').trim();
  var done=function(){
    toast((LANG==='zh'?('已复制 '+label+' 地址 · 谢谢你的咖啡'):(label+' address copied · thank you')));
  };
  var fallback=function(){
    try{
      var ta=document.createElement('textarea');
      ta.value=text; ta.setAttribute('readonly',''); ta.style.position='fixed'; ta.style.top='-1000px';
      document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
      done();
    }catch(e){ toast(LANG==='zh'?'复制失败，请长按地址手动复制':'Copy failed — long-press to copy'); }
  };
  if(navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(text).then(done).catch(fallback);
  } else { fallback(); }
}
function renderTip(){
  var zh = (LANG==='zh');
  var map={btn:zh?'打赏':'Tip',
    title:zh?'请我喝杯咖啡':'Buy me a coffee',
    sub:zh?'这个面板是我自己一行行写、每天手动核对数据做出来的。如果它帮你少亏了一笔、或者多赚了一笔，欢迎请我喝杯咖啡——不影响任何功能，纯属心意。'
           :'I built this dashboard myself and check the data by hand every day. If it saved you a bad trade, a coffee is welcome — purely optional, nothing is gated.',
    copy:zh?'复制':'Copy',
    thanks:zh?'谢谢你的咖啡，每一笔打赏我都会记着——它会变成下一次更深的拆解和更快的更新。'
             :'Thank you — every tip goes straight back into deeper research and faster updates.',
    note:zh?'温馨提示：只认这两个地址，任何让你点链接、输助记词、转「授权」的都是骗子。打赏纯自愿，不构成任何投资建议或收益承诺。'
           :'Note: these are the only two addresses. Anyone asking you to click a link, enter a seed phrase or sign an approval is a scammer. Tips are voluntary and never buy returns.'};
  document.querySelectorAll('[data-tip]').forEach(function(el){
    var k=el.getAttribute('data-tip'); if(map[k]) el.textContent=map[k];
  });
}

/* ==================== 行情 BGM ====================
   涨 →《逍遥仙》《不凡》轮着放　跌 →《梦的翅膀受了伤》《兄弟抱一下》《无人之岛》轮着放
   （以币价为主：涨了开心，跌了难受；跌幅这一档两首换着听，不腻）
   面板上的「两家平均涨跌」：单个币 = 近 7 天涨跌 × 0.65 + 近 24 小时涨跌 × 0.35
        两家再按市值加权（谁盘子大谁影响大，避免小盘插针带节奏）
   分档：≥ +3% 涨档 · ≤ −3% 跌档；回到 ±1.5% 以内才退出该档（滞回，防抖）
   横盘不上不下时：不切歌，继续放当前这首
   同一首至少播 90 秒才允许切；切换用 1.2 秒交叉淡入淡出
   浏览器禁止自动播放 → 默认关闭，点一下按钮＝用户授权，之后才会出声
   音源：优先 audio/up.mp3、audio/down.mp3（你自己上传的真歌）；
        文件不存在时自动回落到内置占位旋律（Web Audio 合成的原创乐句，不含任何版权素材）
   ================================================== */
/* 每个档位一组曲目：涨档两首轮换（逍遥仙 → 不凡），跌档三首轮换（梦的翅膀受了伤 → 兄弟抱一下 → 无人之岛） */
const BGM_TRACKS = {
  up:   [{ src:'audio/up.mp3',        lrc:'audio/up.lrc',        name:'bgmUpName'   },
         /* 不凡（王铮亮）：时间轴用的是网易云官方 lrc 的毫秒级时间，和本地这份 mp3（同一版，211.8s）逐句核对过
            —— 官方歌词里 1:31~2:19 / 2:32~3:05 两段本来就没有词（纯音乐），不是漏抓 */
         { src:'audio/up-bufan.mp3',  lrc:'audio/up-bufan.lrc',  name:'bgmUpName2'  }],
  down: [{ src:'audio/down-meng.mp3', lrc:'audio/down-meng.lrc', name:'bgmDownName2' },
         /* down-v2 = 跟《美好》专辑版 mp3 对齐的时间轴（旧的 down.lrc 是网易云「2021 版」，两版编曲不同、对不上） */
         { src:'audio/down.mp3',      lrc:'audio/down-v2.lrc',   name:'bgmDownName', lrcOffset:0 },
         /* 无人之岛：m4a（AAC）+ 官方时间轴 lrc；时间轴已用音频能量包络核对过
            （副歌「如果云层是天空的一封信」正好落在 01:12 的能量大跳点上），不需要 lrcOffset */
         { src:'audio/down-wuren.m4a', lrc:'audio/down-wuren.lrc', name:'bgmDownName3' }]
};
/* 歌词与音频同目录同名（.lrc）。新增歌曲：mp3 + lrc 一起放进 audio/，这里补一条。 */
const BGM_TH = 3.0, BGM_EXIT = 1.5, BGM_MIN_MS = 90000, BGM_FADE_MS = 1200;

let bgmOn=true, bgmBand=null, bgmCur=null, bgmCurIdx=0, bgmSince=0, bgmMoodCache=null;
const bgmEls={}, bgmMissing={};
const bgmRot={ up:0, down:0 };      /* 每档下一首该放第几首（轮换游标） */
/* 默认自动开；用户手动关过（静音）就再也不自动响 */
try{ if(localStorage.getItem('pons-bgm-muted')==='1') bgmOn=false; }catch(e){}
var bgmStartedOnce=false, bgmListenersOn=false, bgmSkipToggle=false;

function bgmBandTxt(b){ return b==='up'? t('bgmBandUp') : b==='down'? t('bgmBandDown') : t('bgmBandFlat'); }
function bgmTrack(band, idx){ var l=BGM_TRACKS[band]||[]; return l[idx]||l[0]||null; }
function bgmName(band, idx){
  if(band===null||band===undefined) return t('bgmName');
  var tr=bgmTrack(band, idx||0);
  return tr? t(tr.name) : (band==='up'? t('bgmUpName') : t('bgmDownName'));
}
function bgmTrackNo(band, idx){
  var n=(BGM_TRACKS[band]||[]).length;
  return n>1? t('bgmTrackNo')((idx||0)+1, n) : '';
}
function bgmPct(v){ return (v===null||v===undefined||!isFinite(v))? '—' : (v>=0?'+':'')+v.toFixed(1)+'%'; }

/* ---- 自动播放闸门 ----
   浏览器禁止「零交互出声」。策略：
     ① 加载时直接 play()：老访客 / 已互动过的域会被放行 → 完全自动，用户什么都看不到
     ② 被拦下（NotAllowedError）→ 挂一组一次性监听，用户第一次点/划/滚就把音乐淡入
     ③ 用户手动静音过 → 之后永不再自动响 */
const BGM_GESTURES = ['pointerdown','touchstart','touchend','mousedown','keydown','click','wheel','scroll'];
function bgmArmGesture(){
  if(bgmListenersOn) return;
  bgmListenersOn = true;
  BGM_GESTURES.forEach(function(ev){
    window.addEventListener(ev, bgmFirstGesture, {capture:true, passive:true});
  });
}
function bgmDisarmGesture(){
  if(!bgmListenersOn) return;
  bgmListenersOn = false;
  BGM_GESTURES.forEach(function(ev){
    window.removeEventListener(ev, bgmFirstGesture, {capture:true});
  });
}
function bgmFirstGesture(){
  if(bgmOffState()){ bgmDisarmGesture(); return; }
  if(bgmCur){ bgmDisarmGesture(); return; }
  bgmSkipToggle = true;
  setTimeout(function(){ bgmSkipToggle = false; }, 0);
  bgmKickstart();                      /* 必须同步调用，iOS 只认手势里的 play() */
}
function bgmOffState(){ return !bgmOn; }
function bgmKickstart(){
  if(!bgmOn || bgmCur) return;
  try{ if(bgmActx && bgmActx.state==='suspended') bgmActx.resume(); }catch(e){}
  Object.keys(BGM_TRACKS).forEach(function(b){
    BGM_TRACKS[b].forEach(function(_tr,i){ try{ bgmEl(b,i).load(); }catch(e){} });
  });
  bgmBand = null; bgmSince = 0;
  bgmSync();
  if(bgmOn && !bgmCur && bgmMoodCache) bgmSwitch(bgmMoodCache.score>=0? 'up' : 'down');
  bgmPaint();
}
function bgmOnPlayed(){
  bgmDisarmGesture();
  bgmKeepFresh();
  if(!bgmStartedOnce){ bgmStartedOnce = true; if(typeof toast==='function') toast(t('bgmTip')); }
}

function bgmEl(band, idx){
  var key = band + idx;
  if(bgmEls[key]) return bgmEls[key];
  var tr = bgmTrack(band, idx);
  var a = new Audio();
  a.loop = ((BGM_TRACKS[band]||[]).length < 2);   /* 只有一首就单曲循环；两首就放完换下一首 */
  a.preload = 'none'; a.volume = 0;
  a.src = tr.src;
  a.addEventListener('error', function(){
    bgmMissing[key] = true;
    if(bgmOn && bgmCur===band && bgmCurIdx===idx && bgmSynthOn!==band) bgmSynthStart(band);
    bgmPaint();
  });
  a.addEventListener('ended', function(){
    if(bgmOn && bgmCur===band && bgmCurIdx===idx) bgmNext();   /* 这首放完 → 同档下一首 */
  });
  a.addEventListener('timeupdate', function(){                 /* 歌词跟播放进度走 */
    if(bgmCur===band && bgmCurIdx===idx) lyricSeek(a.currentTime, a.duration);
  });
  bgmEls[key] = a; return a;
}

function bgmFade(a, to, ms, cb){
  if(!a) return;
  var token = (a.__fade = (a.__fade||0) + 1);
  var from = a.volume, t0 = Date.now();
  (function step(){
    if(a.__fade !== token) return;
    var k = Math.min(1, (Date.now()-t0)/ms);
    a.volume = Math.max(0, Math.min(1, from + (to-from)*k));
    if(k<1) requestAnimationFrame(step);
    else { if(to<=0.001){ try{ a.pause(); }catch(e){} } if(cb) cb(); }
  })();
}

/* ---- 内置占位旋律（原创，Web Audio 合成；不是任何现有歌曲）---- */
var bgmActx=null, bgmMaster=null, bgmLoopTimer=null, bgmSynthOn=null;
const BGM_SYNTH = {
  up:   { base:261.63, step:0.22, wave:'triangle', gain:0.085,
          seq:[0,4,7,12,7,16,12,7, 5,9,12,19,12,9,5,9, 0,4,7,12,16,19,16,12, 9,5,9,12,7,4,0,4] },
  down: { base:220.00, step:0.44, wave:'sine', gain:0.095,
          seq:[0,-2,-5,-2,-9,-5,-2,-5, 0,-2,-5,-2,-7,-5,-3,-5] }
};
function bgmSynthStart(key){
  if(bgmSynthOn===key) return;
  try{
    if(!bgmActx) bgmActx = new (window.AudioContext||window.webkitAudioContext)();
    if(bgmActx.state==='suspended') bgmActx.resume();
  }catch(e){ return; }
  bgmSynthStop(0);
  var m = bgmActx.createGain(); m.gain.value = 0; m.connect(bgmActx.destination);
  bgmMaster = m; bgmSynthOn = key;
  try{ m.gain.linearRampToValueAtTime(1, bgmActx.currentTime + 1.2); }catch(e){}
  bgmSynthLoop();
}
function bgmSynthLoop(){
  if(!bgmSynthOn || !bgmActx || !bgmMaster) return;
  var key = bgmSynthOn, c = BGM_SYNTH[key], ctx = bgmActx, tm = ctx.currentTime + 0.06;
  c.seq.forEach(function(n){
    var o = ctx.createOscillator(), g = ctx.createGain();
    o.type = c.wave;
    o.frequency.value = c.base * Math.pow(2, n/12);
    g.gain.setValueAtTime(0.0001, tm);
    g.gain.linearRampToValueAtTime(c.gain, tm + 0.03);
    g.gain.exponentialRampToValueAtTime(0.0006, tm + c.step*1.55);
    o.connect(g); g.connect(bgmMaster);
    o.start(tm); o.stop(tm + c.step*1.7);
    tm += c.step;
  });
  bgmLoopTimer = setTimeout(bgmSynthLoop, Math.max(400, c.seq.length*c.step*1000 - 260));
}
function bgmSynthStop(ms){
  if(bgmLoopTimer){ clearTimeout(bgmLoopTimer); bgmLoopTimer = null; }
  var m = bgmMaster; bgmMaster = null; bgmSynthOn = null;
  if(m && bgmActx){
    var fade = (ms===undefined)? 1200 : ms;
    try{
      var now = bgmActx.currentTime;
      m.gain.cancelScheduledValues(now);
      m.gain.setValueAtTime(m.gain.value, now);
      if(fade>0) m.gain.linearRampToValueAtTime(0, now + fade/1000);
      else m.gain.value = 0;
    }catch(e){}
    setTimeout(function(){ try{ m.disconnect(); }catch(e){} }, fade + 160);
  }
}

function bgmStopAll(){
  Object.keys(bgmEls).forEach(function(k){ bgmFade(bgmEls[k], 0, BGM_FADE_MS); });
  bgmSynthStop();
  bgmCur = null;
  lyricPaintIdle();
}

function bgmPlay(band, idx){
  var tr = bgmTrack(band, idx);
  if(!tr) return;
  var key = band + idx;
  Object.keys(bgmEls).forEach(function(k){ if(k!==key) bgmFade(bgmEls[k], 0, BGM_FADE_MS); });
  bgmSynthStop();
  bgmCur = band; bgmCurIdx = idx; bgmSince = Date.now();
  if(bgmMissing[key]){ lyricClear(); bgmSynthStart(band); bgmPaint(); return; }
  var a = bgmEl(band, idx);
  a.volume = 0;
  var pr = null;
  try{ pr = a.play(); }catch(e){}
  function go(){ a.volume = 0; bgmFade(a, 1, BGM_FADE_MS); bgmOnPlayed(); lyricOnTrack(band, idx); bgmPaint(); }
  function fail(err){
    var n = err && err.name;
    if(n === 'NotAllowedError' || n === 'AbortError'){    /* 被自动播放策略拦下：等第一次交互 */
      bgmCur = null; lyricPaintIdle(); bgmArmGesture(); bgmPaint(); return;
    }
    bgmMissing[key] = true; bgmSynthStart(band); bgmArmGesture(); bgmPaint();
  }
  if(pr && pr.then) pr.then(go).catch(fail); else go();
  bgmPaint();
}

/* 切到某一档：同一档正在放就不打断；进档时取轮换游标那首，取完游标后移 */
function bgmSwitch(band){
  if(bgmCur === band) return;
  var list = BGM_TRACKS[band] || [];
  if(!list.length) return;
  var idx = (bgmRot[band]||0) % list.length;
  bgmRot[band] = (idx + 1) % list.length;
  bgmPlay(band, idx);
}

/* 一首放完 → 同档下一首（跌幅档两首来回轮） */
function bgmNext(){
  if(!bgmCur) return;
  var list = BGM_TRACKS[bgmCur] || [];
  if(list.length < 2) return;
  var idx = (bgmRot[bgmCur]||0) % list.length;
  bgmRot[bgmCur] = (idx + 1) % list.length;
  bgmPlay(bgmCur, idx);
}

function bgmMood(){
  var rows = build(), sw = 0, sm = 0, parts = [];
  PROJECTS.forEach(function(p){
    var s = stats(rows, p);
    var m7  = (s.priceChg7!==null && isFinite(s.priceChg7))? s.priceChg7*100 : null;
    var m24 = (typeof s.volChange === 'number' && isFinite(s.volChange))? s.volChange : null;
    if(m7===null && m24===null) return;
    var mood = (m7!==null && m24!==null)? (m7*0.65 + m24*0.35) : (m7!==null? m7 : m24);
    var mc = (s.mcap && isFinite(s.mcap) && s.mcap>0)? s.mcap : 1;
    sw += mc; sm += mc*mood;
    parts.push({ p:p, m7:m7, m24:m24, mood:mood });
  });
  if(!sw || !parts.length) return null;
  return { score: sm/sw, parts: parts };
}

function bgmBandOf(score, prev){
  if(score >=  BGM_TH) return 'up';
  if(score <= -BGM_TH) return 'down';
  if(prev==='up'   && score >  BGM_EXIT) return 'up';
  if(prev==='down' && score < -BGM_EXIT) return 'down';
  return 'flat';
}

function bgmSync(){
  var m = bgmMood();
  bgmMoodCache = m;
  bgmBand = m? bgmBandOf(m.score, bgmBand) : null;
  if(bgmOn && m){
    var want = (bgmBand==='up')? 'up' : (bgmBand==='down'? 'down' : null);
    if(!want && !bgmCur) want = (m.score>=0? 'up' : 'down');
    var ready = (Date.now() - bgmSince) >= BGM_MIN_MS;
    if(want && want!==bgmCur && (ready || !bgmCur)) bgmSwitch(want);
  }
  bgmPaint();
}

function bgmPaint(){
  var root = document.getElementById('bgm'); if(!root) return;
  var m = bgmMoodCache, playing = bgmOn && bgmCur;
  root.classList.toggle('on', bgmOn);
  root.classList.toggle('live', !!playing);
  if(!bgmOn) root.classList.remove('det');
  root.classList.toggle('up', !!playing && bgmCur==='up');
  root.classList.toggle('down', !!playing && bgmCur==='down');
  var tEl = document.getElementById('bgmT'), sEl = document.getElementById('bgmS');
  if(tEl) tEl.textContent = bgmCur? bgmName(bgmCur, bgmCurIdx) : t('bgmName');
  if(sEl){
    if(!bgmOn) sEl.textContent = t('bgmOff');
    else if(!m) sEl.textContent = t('bgmNoData');
    else if(!bgmCur) sEl.textContent = t('bgmWait');
    else sEl.textContent = (m.score>=0?'+':'') + m.score.toFixed(1) + '% · ' + bgmBandTxt(bgmBand);
  }
  var card = document.getElementById('bgmCard');
  if(card) card.title = t('bgmName') + '　' + t('bgmRule');
  var leg = document.getElementById('bgmLegend'); if(leg) leg.textContent = t('bgmLegend');
  var sc = document.getElementById('bgmScore');
  if(sc){
    sc.innerHTML = m
      ? '<span class="bgm-labw"><span class="bgm-hl">'+t('bgmLab')+'</span>'
          + '<b class="'+(m.score>=0?'u':'d')+'">'+(m.score>=0?'+':'')+m.score.toFixed(2)+'%</b></span>'
        + '<span class="bgm-tag '+(bgmBand||'flat')+'">'+bgmBandTxt(bgmBand)+'</span>'
      : '<b>—</b><span class="bgm-tag">'+t('bgmNoData')+'</span>';
  }
  var pp = document.getElementById('bgmParts');
  if(pp){
    pp.innerHTML = !m? '' : m.parts.map(function(x){
      return '<div class="bgm-prow">'
        + '<span class="bgm-pn"><i style="background:'+x.p.color+'"></i>'+x.p.ticker+'</span>'
        + '<span class="bgm-pv '+(x.mood>=0?'u':'d')+'">'+bgmPct(x.mood)+'</span>'
        + '<span class="bgm-pd">'+t('bgmSev7')+' '+bgmPct(x.m7)+'　·　'+t('bgmSev24')+' '+bgmPct(x.m24)+'</span>'
        + '</div>';
    }).join('');
  }
  var src = document.getElementById('bgmSrc');
  if(src){
    var no = bgmCur? bgmTrackNo(bgmCur, bgmCurIdx) : '';
    if(bgmOn && bgmCur && bgmMissing[bgmCur+bgmCurIdx]) src.textContent = t('bgmPlaceholder');
    else if(bgmOn && bgmCur) src.textContent = (no? no+' · ' : '') + t('bgmReal') + ' · ' + t('bgmMin');
    else src.textContent = t('bgmRule');
  }
}

/* 详情面板：开启/换歌时自动展开，15 秒后收起；鼠标移上去或点小箭头再看 */
var bgmDetTimer = null;
function bgmDetShow(){
  var r = document.getElementById('bgm'); if(!r || !bgmOn) return;
  r.classList.add('det');
  if(bgmDetTimer) clearTimeout(bgmDetTimer);
  bgmDetTimer = setTimeout(function(){ bgmDetHide(); }, 15000);
}
function bgmDetHide(){
  if(bgmDetTimer){ clearTimeout(bgmDetTimer); bgmDetTimer = null; }
  var r = document.getElementById('bgm'); if(r) r.classList.remove('det');
}
function bgmDetToggle(){
  var r = document.getElementById('bgm'); if(!r || !bgmOn) return;
  if(r.classList.contains('det')) bgmDetHide(); else bgmDetShow();
}

function bgmToggle(){
  if(bgmSkipToggle){ bgmSkipToggle = false; bgmDetShow(); return; }   /* 刚被第一次交互自动点亮，这次点击不算静音 */
  bgmOn = !bgmOn;
  try{ localStorage.setItem('pons-bgm-muted', bgmOn?'0':'1'); }catch(e){}
  if(bgmOn){
    bgmCur = null;
    bgmKickstart();
    bgmKeepFresh();
  }else{
    bgmStopAll();
  }
  bgmPaint();
  if(bgmOn) bgmDetShow(); else bgmDetHide();
}

/* 每 5 分钟刷一次数据（与 BGM 开关无关：静音的用户同样要看到新数据）；
   页面切到后台时跳过，切回来立刻补一次，既省流量又不影响新鲜度 */
var bgmRefreshTimer = null;
function bgmKeepFresh(){
  if(bgmRefreshTimer) return;
  bgmRefreshTimer = setInterval(function(){ if(!document.hidden) loadLive(); }, 300000);
  document.addEventListener('visibilitychange', function(){ if(!document.hidden) loadLive(); });
}

/* ==================== 横幅歌词（跟着 BGM 走） ====================
   歌词文件与音频同目录（LRC）：audio/up.lrc · audio/down-meng.lrc · audio/down-v2.lrc
   当前行居中高亮、上下行渐隐，下面一条细进度条；窄屏铺满一整行
   · 只有「真的有歌词」时才显示；待命 / 加载中 / 纯音乐 / 试听片段 → 整块收起，不留空话
   · 音源明显短于歌词时间轴（试听片段）→ 自动收起，不硬套
   · 每条曲目可加 lrcOffset（秒）：正数＝歌词提前，负数＝歌词延后；用来微调个别版本
   ================================================================ */
const LY_LH = 18, LY_CACHE = {};
let lyLines = [], lyNodes = null, lyIdx = -1, lyTok = 0, lyReady = false, lyFit = false, lyHideTimer = null;

function lyTrackEl(){ return document.getElementById('lyTrack'); }
function lyRootEl(){ return document.getElementById('lyric'); }
function lyBarEl(){ return document.getElementById('lyBarI'); }

/* 当前曲目的时间轴微调（秒） */
function lyricOff(){
  var tr = (bgmCur!==null && bgmCur!==undefined)? bgmTrack(bgmCur, bgmCurIdx) : null;
  return (tr && isFinite(tr.lrcOffset))? Number(tr.lrcOffset) : 0;
}

/* LRC → [{t:秒, s:文本}]，过滤元数据行与空行 */
function lyricParse(raw){
  var out = [], re = /\[(\d{1,3}):(\d{1,2}(?:[.:]\d{1,3})?)\]/g;
  raw.split(/\r?\n/).forEach(function(line){
    var m, stamps = [], end = 0;
    re.lastIndex = 0;
    while((m = re.exec(line))){
      stamps.push(parseInt(m[1],10)*60 + parseFloat(String(m[2]).replace(':', '.')));
      end = re.lastIndex;
    }
    if(!stamps.length) return;
    var txt = line.slice(end).trim();
    if(!txt) return;
    if(/^(作词|作曲|编曲|制作人|制作助理|配唱|出品人|出品公司|出品|发行|混音室|混音师|混音|录音棚|录音室|录音师|录音|和声编写|和声|缩混|母带师|母带|监制|统筹|企划|宣发|封面|视觉|吉他|贝斯|鼓|键盘|弦乐|词|曲|OP|SP)\s*[:：]/.test(txt)) return;
    stamps.forEach(function(sec){ out.push({ t:sec, s:txt }); });
  });
  out.sort(function(a,b){ return a.t - b.t; });
  return out;
}

function lyricShow(){
  if(typeof qBoxHideNow === 'function') qBoxHideNow();   /* 歌词来了，共勉让位 */
  var r = lyRootEl(); if(!r) return;
  if(lyHideTimer){ clearTimeout(lyHideTimer); lyHideTimer = null; }
  r.classList.remove('hidden');
  requestAnimationFrame(function(){ r.classList.add('on'); });
}
function lyricHide(){
  if(typeof qBoxShowSoon === 'function') qBoxShowSoon(); /* 歌词走了，共勉延迟接回来 */
  var r = lyRootEl(); if(!r) return;
  r.classList.remove('on');
  if(lyHideTimer) clearTimeout(lyHideTimer);
  lyHideTimer = setTimeout(function(){                 /* 先淡出，再从排版里收掉 */
    lyHideTimer = null;
    if(!r.classList.contains('on')) r.classList.add('hidden');
  }, 620);
}
/* 没有歌词可显示时的唯一出口：清空 + 整块收起 */
function lyricClear(){
  lyReady = false; lyIdx = -1; lyLines = []; lyNodes = null; lyFit = false;
  var tr = lyTrackEl();
  if(tr){ tr.innerHTML = ''; tr.style.transform = 'translateY(0px)'; }
  var bi = lyBarEl(); if(bi) bi.style.width = '0%';
  lyricHide();
}
function lyricPaintIdle(){ lyricClear(); }

function lyricIdxAt(time){
  var i = -1;
  for(var k = 0; k < lyLines.length; k++){ if(time + 0.15 >= lyLines[k].t) i = k; else break; }
  return i;
}
function lyricShift(){
  var tr = lyTrackEl(); if(!tr) return;
  var di = lyIdx < 0 ? 0 : lyIdx;
  var c = ((tr.parentNode.clientHeight || 54) - LY_LH)/2;
  tr.style.transform = 'translateY(' + (c - di*LY_LH) + 'px)';
}
function lyricSetIdx(i){
  lyIdx = i;
  if(!lyNodes) return;
  for(var k = 0; k < lyNodes.length; k++){
    lyNodes[k].className = 'ly-line' + (k === i ? ' on' : (k < i ? ' past' : ''));
  }
  lyricShift();
}
function lyricMount(lines){
  var tr = lyTrackEl(); if(!tr) return;
  lyLines = lines; lyIdx = -1; lyReady = true; lyFit = false;
  tr.innerHTML = lines.map(function(l){ return '<div class="ly-line">' + esc(l.s) + '</div>'; }).join('');
  lyNodes = tr.children;
  /* 歌词是异步来的：到位时可能已经唱到中段了，第一下直接归位、不要从第一行滚过去 */
  var el = (bgmCur!==null && bgmCur!==undefined)? bgmEls[bgmCur + bgmCurIdx] : null;
  var now = ((el && isFinite(el.currentTime))? el.currentTime : 0) + lyricOff();
  tr.style.transition = 'none';
  lyricSetIdx(lyricIdxAt(now));
  requestAnimationFrame(function(){ requestAnimationFrame(function(){ tr.style.transition = ''; }); });
  lyricShow();
}
function lyricOnTrack(band, idx){
  var tr = bgmTrack(band, idx), url = tr && tr.lrc;
  if(!url){ lyricClear(); return; }
  var key = band + idx, tok = ++lyTok, hit = LY_CACHE[key];
  if(hit){ if(hit.length) lyricMount(hit); else lyricClear(); return; }
  lyricClear();                                        /* 取词之前先收起，等真有词再出现 */
  fetch(url, {cache:'force-cache'}).then(function(r){
    return r.ok ? r.text() : Promise.reject(new Error('lrc ' + r.status));
  }).then(function(txt){
    var lines = lyricParse(txt);
    LY_CACHE[key] = lines;
    if(tok !== lyTok || bgmCur !== band) return;       /* 已经切歌 / 已经停播 → 丢弃这次结果 */
    if(lines.length) lyricMount(lines); else lyricClear();
  }).catch(function(){
    if(tok !== lyTok || bgmCur !== band) return;
    LY_CACHE[key] = [];
    lyricClear();
  });
}
function lyricSeek(time, dur){
  if(!lyReady || !lyLines.length) return;
  var off = lyricOff(), lt = time + off;
  if(dur && isFinite(dur) && dur > 0 && !lyFit){
    lyFit = true;
    if(dur + 3 < lyLines[lyLines.length-1].t - off){   /* 试听片段：时间轴对不上，别硬套 */
      lyricClear(); return;
    }
  }
  var i = lyricIdxAt(lt);
  if(i !== lyIdx) lyricSetIdx(i);
  var bi = lyBarEl();
  if(bi) bi.style.width = (dur && isFinite(dur) && dur > 0 ? Math.min(100, Math.max(0, lt)/dur*100) : 0) + '%';
}
try{ lyricPaintIdle(); }catch(e){}

/* 展开的详情面板：点到别处 / 滑动页面 → 立刻收起（PC 与手机同一套行为）
   手机上面板里的按钮小，用户大概率会直接点屏幕其它地方来关，这里兜住这个直觉 */
(function(){
  function bgmAway(ev){
    var r = document.getElementById('bgm');
    if(!r || !r.classList.contains('det')) return;
    /* 注意：scroll/wheel 的事件目标是 window（不是 Node），直接 contains 会抛异常 */
    if(ev && ev.target && ev.target.nodeType && r.contains(ev.target)) return;   /* 点播放器自己不算 */
    bgmDetHide();
  }
  ['pointerdown','mousedown','touchstart','touchmove','wheel'].forEach(function(ev){
    window.addEventListener(ev, bgmAway, {capture:true, passive:true});
  });
  window.addEventListener('scroll', bgmAway, {passive:true});
})();

/* 每次渲染完（手动刷新 / 自动刷新 / 切语言）重算情绪并决定要不要换歌 */
(function(){
  var _renderAll = renderAll;
  renderAll = function(){
    _renderAll.apply(null, arguments);
    try{ bgmSync(); }catch(e){ console.error('bgm:', e); }
  };
})();

/* ==================== 共勉 + 点赞（就在作者名片中间） ====================
   规则（和歌词互斥，开关都挂在 lyricShow / lyricHide 上）：
     · 没在放歌 / 放不出歌词（占位旋律、纯音乐、试听片段）→ 显示一句共勉 + 点赞按钮
     · 歌词一出现 → 立刻收起共勉，让位给歌词；暂停时歌词停在那不动，共勉也不抢回来
     · 用户关掉音乐（lyricClear）→ 歌词收起，共勉回来
     · 切歌瞬间会先清歌词再挂新词，所以「显示共勉」延迟 350ms，避免中间闪一下
   每次只显示一句，不轮播；刷新页面随机换一句（不和上次重复，记在 localStorage）。
   点赞只加不减、可以连点：连点先在本地累加，攒成一批发给服务器，点完还有一把撒花。
   文案在 template.base.html 的 i18n（quotes / qLike / qLikeTip），中英各一份。
   ================================================== */
/* 注意：这几个必须是 var —— 函数声明会提升，let 不会。
   BGM_JS 里的初始化（lyricPaintIdle）比这段代码先执行，会回调 qBoxShowSoon，
   用 let 的话那时还在暂时性死区（TDZ），整个初始化会被 try/catch 静默吞掉，
   症状就是：歌词块永远不收起、共勉被挤成半宽。 */
var QN = null;                       /* 服务器上的赞数 */
var QPend = 0, QFlush = false, QHitT = null, QBoxT = null, QRetryT = false;
var QI = 0;

function qList(){ var a = t('quotes'); return (a && a.length) ? a : []; }
function qBoxEl(){ return document.getElementById('qbox'); }

/* 每次刷新随机挑一句：尽量不和上次那句重复 */
function qPick(){
  var list = qList(); if(!list.length) return 0;
  var last = -1;
  try{ last = parseInt(localStorage.getItem('pons-q-last'), 10); }catch(e){}
  var pool = [];
  for(var i = 0; i < list.length; i++){ if(i !== last) pool.push(i); }
  if(!pool.length) pool = [0];
  var pick = pool[(Math.random()*pool.length)|0];
  try{ localStorage.setItem('pons-q-last', String(pick)); }catch(e){}
  return pick;
}

function qRedraw(){ qPaint(); }          /* 切语言：同一句换成另一种语言，赞数不动 */
function qPaint(){
  var list = qList();
  var el = document.getElementById('qText');
  if(el) el.textContent = list[QI] || '';
  var n = document.getElementById('qN');
  if(n) n.textContent = fmtN((QN===null? 0 : QN) + QPend, 0);
  var btn = document.getElementById('qLike');
  if(btn){ btn.title = t('qLikeTip'); btn.setAttribute('aria-label', t('qLikeTip')); }
}

/* ---- 与歌词互斥：名片中间那块地方，同一时间只站一个人 ---- */
function qBoxHideNow(){
  if(QBoxT){ clearTimeout(QBoxT); QBoxT = null; }
  var r = qBoxEl(); if(!r) return;
  r.classList.remove('on');
  setTimeout(function(){ if(!r.classList.contains('on')) r.classList.add('hidden'); }, 420);
}
function qBoxShowNow(){
  var r = qBoxEl(); if(!r) return;
  r.classList.remove('hidden');
  requestAnimationFrame(function(){ r.classList.add('on'); });
  qPaint();
}
function qBoxShowSoon(){            /* 切歌瞬间会先清歌词 → 稍等一下再接回来 */
  if(QBoxT) clearTimeout(QBoxT);
  QBoxT = setTimeout(function(){ QBoxT = null; qBoxShowNow(); }, 350);
}

/* ---- 点赞：只加不减，连点攒批发 ---- */
function qLikeApply(n){ if(typeof n === 'number'){ QN = n; qPaint(); } }

var qCv = null, qCtx = null, qParts = [], qRAF = 0;
function qConfetti(btn){
  try{
    if(window.matchMedia && window.matchMedia('(prefers-reduced-motion:reduce)').matches) return;
    if(!btn) return;
    var r = btn.getBoundingClientRect();
    var W = 320, H = 260, dpr = Math.min(2, window.devicePixelRatio || 1);
    if(!qCv){
      qCv = document.createElement('canvas');
      qCv.className = 'q-confetti';
      document.body.appendChild(qCv);
    }
    qCv.width = Math.round(W*dpr); qCv.height = Math.round(H*dpr);
    qCv.style.width = W + 'px'; qCv.style.height = H + 'px';
    qCv.style.left = Math.round(r.left + r.width/2 - W/2) + 'px';
    qCv.style.top  = Math.round(r.top + r.height/2 - H/2 - 14) + 'px';
    qCv.style.display = 'block';
    qCtx = qCv.getContext('2d');
    qCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
    qCtx.clearRect(0, 0, W, H);
    var COLORS = ['#ff6b8a','#8b7cff','#2ee6a8','#ffb020','#ff9aa8','#7ff0c6','#ffffff'];
    var cx = W/2, cy = H*0.66;
    for(var i = 0; i < 34; i++){
      var ang = (-90 + (Math.random()*160 - 80)) * Math.PI/180;   /* 往上开的扇形 */
      var sp  = 2.3 + Math.random()*4.4;
      qParts.push({
        x: cx + (Math.random()*22 - 11), y: cy + (Math.random()*12 - 6),
        vx: Math.cos(ang)*sp - 0.35, vy: Math.sin(ang)*sp - 1.6,   /* 略微往左偏：按钮偏右，别被屏幕边裁掉 */
        g: 0.12 + Math.random()*0.055,
        w: 3.2 + Math.random()*3.8, h: 5 + Math.random()*5.4,
        rot: Math.random()*Math.PI, vr: (Math.random() - 0.5)*0.36,
        c: COLORS[(Math.random()*COLORS.length)|0],
        life: 1, dec: 0.011 + Math.random()*0.009,
        round: Math.random() < 0.3
      });
    }
    if(!qRAF) qRAF = requestAnimationFrame(qTick);
  }catch(e){}
}
function qTick(){
  qRAF = 0;
  if(!qCtx || !qCv) return;
  qCtx.clearRect(0, 0, qCv.width, qCv.height);
  var alive = 0;
  for(var i = 0; i < qParts.length; i++){
    var p = qParts[i];
    p.vy += p.g; p.vx *= 0.994; p.x += p.vx; p.y += p.vy;
    p.rot += p.vr; p.life -= p.dec;
    if(p.life <= 0) continue;
    alive++;
    qCtx.save();
    qCtx.globalAlpha = Math.min(1, p.life*1.25);
    qCtx.translate(p.x, p.y);
    qCtx.rotate(p.rot);
    qCtx.fillStyle = p.c;
    if(p.round){ qCtx.beginPath(); qCtx.arc(0, 0, p.w/2, 0, Math.PI*2); qCtx.fill(); }
    else qCtx.fillRect(-p.w/2, -p.h/2, p.w, p.h);
    qCtx.restore();
  }
  qParts = qParts.filter(function(p){ return p.life > 0; });
  if(alive > 0) qRAF = requestAnimationFrame(qTick);
  else { qParts = []; qCtx.clearRect(0, 0, qCv.width, qCv.height); qCv.style.display = 'none'; }
}

function qFlush(){
  if(QFlush || QPend <= 0) return;
  var n = Math.min(QPend, 20);
  QFlush = true;
  fetch('/api/likes?d=' + n + '&t=' + Date.now(), {cache:'no-store'})
    .then(function(r){ return r.ok ? r.json() : null; })
    .then(function(d){
      QPend = Math.max(0, QPend - n);                 /* 这一批已经落到服务器上 */
      if(d && typeof d.likes === 'number') QN = d.likes;
      qPaint();
    })
    .catch(function(){
      /* 服务器没接住（离线 / 接口挂了）：数字先不掉，过 6 秒再试一次，
         免得用户看到自己点的赞又缩回去 */
      QRetryT = true;
    })
    .then(function(){
      QFlush = false;
      if(QPend > 0){
        if(QRetryT){ QRetryT = false; setTimeout(qFlush, 6000); }
        else qFlush();
      }
    });
}

function qLike(){
  QPend++;                                            /* 乐观 +1：立刻上屏，连点也不卡 */
  var btn = document.getElementById('qLike');
  if(btn){
    btn.classList.remove('pop','plus','hit');
    void btn.offsetWidth;
    btn.classList.add('pop','plus','hit');
    qConfetti(btn);
    if(QHitT) clearTimeout(QHitT);
    QHitT = setTimeout(function(){ QHitT = null; btn.classList.remove('hit'); }, 900);
  }
  qPaint();
  qFlush();
}

function qLoadLikes(){
  if(location.protocol !== 'http:' && location.protocol !== 'https:') return;
  fetch('/api/likes?t=' + Date.now(), {cache:'no-store'})
    .then(function(r){ return r.ok ? r.json() : null; })
    .then(function(d){ if(d && typeof d.likes === 'number') qLikeApply(d.likes); })
    .catch(function(){});
}

function qInit(){
  QI = qPick();
  qBoxShowNow();
  qLoadLikes();
}

/* ---------- v3.13.2 板块图标：滚进视野时弹一下（一次性的「这里有板块」提示） ----------
   v3.13.3 性能：位置只在开场量一次并缓存，之后滚动只比较数字、不再读布局。
   原来每帧对 8 个板块调 getBoundingClientRect（会强制同步布局），实测一次滚动
   就吃掉 300ms+ 的主线程 —— 这就是「上线后有点卡」的主因。
   判定用「进入视野，或已经被滚到上方去」（快速滑动 / 点锚点跳转时是后者）。
   用扫描而不是 IntersectionObserver —— 观察器在「一步跳到页底」时，
   中间从没进入过视野的板块不会产生任何回调，图标会永远停在 opacity:0。 */
var icRevealMeasure = null;
function icRevealInit(){
  var list = [].slice.call(document.querySelectorAll('.sec-title'));
  if(!list.length) return;
  var tops = new Array(list.length), remain = list.length;
  var ticking = false, done = false;
  function measure(){
    var y = window.pageYOffset || document.documentElement.scrollTop || 0;
    for(var i = 0; i < list.length; i++){
      var b = list[i].getBoundingClientRect();
      tops[i] = b.top + y + b.height;      /* 缓存「底边」的文档绝对位置 */
    }
  }
  function sweep(){
    if(done) return;
    var y = window.pageYOffset || document.documentElement.scrollTop || 0;
    var vh = window.innerHeight || document.documentElement.clientHeight || 900;
    var line = y + vh * 0.94;
    /* 板块按文档顺序排：碰到第一个还没到的，后面的也都没到，可以直接收工 */
    for(var i = 0; i < list.length; i++){
      if(list[i].classList.contains('ic-in')) continue;
      if(tops[i] < line || tops[i] < y){ list[i].classList.add('ic-in'); remain--; }
      else break;
    }
    if(remain <= 0){
      done = true;
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onResize);
    }
  }
  function onScroll(){
    if(ticking || done) return;
    ticking = true;
    var raf = window.requestAnimationFrame || function(f){ return setTimeout(f, 16); };
    raf(function(){ ticking = false; sweep(); });
  }
  function onResize(){ measure(); sweep(); }
  measure();
  sweep();
  icRevealMeasure = measure;               /* 数据落地后布局会变，由 renderAll 再量一次 */
  window.addEventListener('scroll', onScroll, {passive:true});
  window.addEventListener('resize', onResize);
  window.addEventListener('load', measure);
}

renderTip();
renderStatic();
renderAll();
guideHashInit();
loadViews();
bgmKeepFresh();          /* 数据每 5 分钟自动刷新，不受音乐开关影响 */
loadLive();
qInit();
icRevealInit();
</script>
</body>
</html>
