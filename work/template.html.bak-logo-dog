  streakTxt:(n,up)=> up? (n>=2? '最近 '+n+' 天连续回升': '最近 1 天转为回升') : (n>=2? '最近 '+n+' 天连续下滑': '最近 1 天小幅回落'),
  anMom:d=>'最近 7 日均 <b>'+d.a+'</b> vs 前 7 日均 '+d.b+'（差 <b>'+d.diff+'/天</b>）；'+(d.up? '<span class="hl-up">'+d.streakTxt+'</span>' : '<span class="hl-dn">'+d.streakTxt+'</span>')+'。',
  anBurn:d=>'7 日回购合计 <b>'+d.buy7+'</b>（日均 '+d.buyDay+'）＝ 同期收入的 <b>'+d.buyShare+'</b>；7 天里有 '+d.burnDays+' 天在回购；按这个速度一年能买回流通市值的 <b>'+d.yield+'</b>。',
  anBp:d=>'回购 <b>'+d.buy7+'</b> ÷ 同期成交额 <b>'+d.vol7+'</b> ＝ 力度 <b>'+d.f+'</b>。要够到「有效买盘」5% 的门槛，每天得回购 <b>'+d.needDay+'</b>，是现在的 <b>'+d.gap+'</b>；按当前收入 '+d.revDay+'/天，这笔钱相当于收入的 <b>'+d.needShare+'</b>，而项目公开口径只拿 <b>'+d.share+'</b> 的收入做回购 → 短期结构上做不到。',
  anBpEvidence:d=>'实证：这 7 天回购一直在继续，价格同期 <b>'+d.priceChg+'</b>（'+d.priceFrom+' → '+d.priceNow+'）。',
  anBpLong:d=>'回购真正的价值在长期：按现在速度，一年大约买回流通市值的 '+d.yield+'，流通的币持续变少——但这是慢变量，决定不了短期方向。',
  anPs:d=>'市值 '+d.mcap+' ÷（7 日均收入 '+d.avg7+' × 365 ＝ '+d.yearRev+'）＝ <b>'+d.ps7+'</b>；用 30 天算 '+d.ps30+'（相差 '+d.div+'×）→ '+d.trend+'。对照 pump.fun 约 4.45x。',
  priority:t=>'优先买哪家：'+t+'（估值更低、安全垫更厚）；另一家先等收入不再下滑、估值回落再考虑加仓。',
  priorityNone:'数据不足，暂不给资金优先级建议。',
  drHead:'深度解读 · 这个结论怎么推出来的',
  drHint:'把全站数据逐步拆开算给你看，不是一句判断',
  drDrop:'跌势', drBuy:'托底', drVal:'估值', drTurn:'拐点', drCond:'条件',
  drDropT:d=>'本周后 3 天日均 <b>'+d.a3+'</b>，前 4 天 <b>'+d.a4+'</b>：'+(d.worse? '<b class="hl-dn">又低 '+d.d3abs+'</b>，下滑还在继续，不是单日抖动' : d.up? '<b class="hl-up">回升 '+d.d3+'</b>，刚出现企稳迹象，还要再连 2 天才算确认' : '变化 '+d.d3+'，跌势暂时踩住，但还没掉头')+'；日线'+d.streakTxt+'。',
  drBuyT:d=> d.vol7? '7 天回购 <b>'+d.buy7+'</b>，占同期成交额（'+d.vol7+'）的 <b>'+d.f+'</b>：'+(d.strong? '已站上 5% 的「有效买盘」门槛，回购对短期价格有真实支撑。' : d.weak? '离 5% 的「有效买盘」门槛还差 <b>'+d.gap+'</b>，短期改变不了供需，价格仍由收入预期主导。' : '接近但未到 5% 的「有效买盘」门槛（差 '+d.gap+'），有存在感、还不算强支撑。')+' 另一面看长期：'+d.yTxt+'——供应真实变少，这是慢变量，也是长期底。' : '成交额数据缺失，暂时无法测算回购托底力度。',
  drYFull:'按当前速度不足一年就能买回全部流通盘',
  drYPart:v=>'按当前速度一年约买回流通市值的 '+v,
  drValT:d=>'按 7 日均收入年化，市值/年收入 = <b>'+d.ps7+'</b>（便宜线 1.5x ｜ 偏贵线 4x）。这一周收入 '+d.rev7+'、价格 '+d.p7+'，'+(d.compressed? '价格跌得比收入快 → 估值被压得更低，安全垫在变厚' : d.expanded? '价格比收入抗跌 → 估值反而抬高了，安全垫在变薄' : '两者步调接近，估值基本没动')+(d.psPrev? '（上周同口径约 '+d.psPrev+'）':'')+'。',
  drTurnT:d=> (d.h24!=null)? '最近 24 小时收入 <b>'+d.h24+'</b>（折合日均 '+d.h24per+'），比前 24 小时 '+d.h24chg+'；相对 7 日均 '+(d.hot? '<b class="hl-up">偏高，当下节奏在回暖</b>' : d.cold? '<b class="hl-dn">偏低，当下仍在走弱</b>' : '基本持平，还没给出方向')+'。' : '小时数据不足，暂不判断实时拐点。',
  drCondT:d=> (d.avg7N>=d.warnN)? '收入还在警戒线 <b>'+d.warn+'/天</b>上方（离场线 '+d.danger+' 更远），现在拖住结论的是周环比 '+d.rev7+'。按规则：周环比回到 -15% 以内或连续 3 天回升，就解除「暂停加仓」；若收入跌破警戒线先收紧，跌破离场线按纪律撤。' : '要让结论从「暂停加仓」回到「可以加仓」，收入得回到 <b>'+d.warn+'/天</b>上方并站稳（现在 '+d.avg7+'，还差 '+d.needUp+'）'+(d.days? '；按最近两周的斜率外推，约 <b>'+d.days+' 天</b>后会跌破警戒线' : '')+'。若直接跌破 <b>'+d.danger+'/天</b>（离场线），按纪律先撤。',
  actFloorBad:'已跌破离场线：建议分批减仓或清仓，不要补仓',
  actFloorWarn:'低于警戒线：暂停加仓，每天盯住这条线',
  actFloorOk:v=>'高出警戒线 '+v+'%，可继续持有',
  sFloor:(a,b,c)=>'7 日均 <b class="hi">'+a+'/天</b>　·　离场线 '+b+'　·　警戒线 '+c,
  actMomBad:'比上周降超 25%：先别加仓，等连续 3 天回升再考虑',
  actMomWarn:'比上周走弱：只观察、不加仓',
  actMomUp:'比上周回升：可考虑分批加仓',
  actMomFlat:'和上周差不多：维持现有仓位',
  sMom:(d)=>'本周 vs 上周 <b class="hi">'+d+'%</b>　·　触发线 −25%',
  actBurnOff:'回购已停止：先减仓，等回购恢复再谈加仓',
  actBurnOn:v=>'回购在持续，7 日回购≈同期收入的 '+v+'%',
  sBurn:(a,b)=>'最近 7 日回购 <b class="hi">'+a+'</b>　·　'+b,
  actBpNone:'缺少成交额数据，无法判断回购的影响力',
  actBpOk:v=>'回购占成交额 '+v+'%：买盘足够重，能真正托住价格',
  actBpWarn:v=>'回购占成交额 '+v+'%：能减缓下跌，但改变不了方向',
  actBpBad:v=>'回购只占成交额 '+v+'%：短期买盘扛不住卖压（算式见下）',
  sBp:(a,b)=>'最近 7 日回购 <b class="hi">'+a+'</b> ÷ 7 日成交额 <b class="hi">'+b+'</b>　·　≥5% 才算有效买盘',
  actPsNone:'没有收入数据，暂时无法估值',
  actPsCheap:v=>v+'x 便宜：安全垫厚，可分批加仓',
  actPsFair:v=>v+'x 合理：持有观察，不追高',
  actPsDear:v=>v+'x 偏贵：不追高，等回调或收入涨上来',
  sPs:v=>'市值÷年收入(7日) <b class="hi">'+v+'</b>　·　低于 1.5x 算便宜 · 高于 4x 算贵　·　（pump.fun 是 4.45x）',
  tabRev:'日收入', tabRev7:'7 日均线收入', tabCum:'累计回购销毁', tabPrice:'价格对比（归一）',
  base100:'基准 100', start100:'起点=100', stopLoss:t=>t+' 止损线',
  cumName:n=>n+' 累计回购（窗口内）',
  thDate:'日期', thRev:'日收入', thBurn:'回购销毁', thPrice:'币价', thAvg7:'近 7 日均',
  pendingCell:'待更新',
  pendingTip:'DefiLlama 还没出这天的数字（不是看板坏了）。出数后刷新一下就自动补上。',
  suppNew:'最新',
  suppNewPart:h=>'最新·'+h+'h',
  suppWhoPons:'PONS 来自链上回购（收入＝回购支出÷80%）',
  suppWhoStonk:'STONK 来自官方接口（累计值做差，与官网一致）',
  suppTip:(h,p,who,off)=>'DefiLlama 还没出这天的数，这里显示的是'+(p? ('部分时段（'+h+' 小时）') : '整天（24 小时）')+'的真值 —— '+who+(off? '；这就是全表用的官方口径，今天结束后自动补全。' : '。口径和 DefiLlama 不完全一样，别直接相减。'),
  srcLatest:d=>'数据源最新 '+d,
  lagBadge:d=>'数据晚了 '+d+' 天',
  lagTip:'DefiLlama 还没更新最近这几天的收入，所以这条线用的是它最后一次更新前的 7 天 —— 对比两家的 7 日均时注意这点差别。',
  liveChip:v=>'最近 24 小时 '+v,
  liveChipTip:'DefiLlama 的日度还没更新到最近这几天，所以这里直接用更快的源把「最近 24 小时」补上：PONS＝链上回购支出折算的收入，STONK＝官方接口真值。点一下跳到下面「小时监控」看逐小时明细。注意：这是滚动 24 小时，和上面 7 日均的日度口径不同，别直接相减。',
  gPsT:'市值÷年收入 —— 你花多少钱，买它一年的收入',
  gPsF:'市值÷年收入 ＝ <b class="hi">市值</b> ÷ (<b class="hi">每天收入 × 365 天</b>)',
  gPsL:'<b class="hl">数字越小越便宜</b>，可以理解成「按现在的赚钱速度要几年回本」。它把「公司贵不贵」和「币价高低」分开看——<b class="hl">币价低不代表便宜</b>，要看它每年能赚多少。',
  gPsCap:t=>'算给你看（'+t+'）',
  gPsLine:(mc,avg,year,ps,yrs)=>'市值 '+mc+'　÷　(7 日均收入 '+avg+'/天 × 365 天 ＝ '+year+')'+
      '<br>＝ <b>'+ps+'</b><br>→ 假设收入不变，你花 '+ps+' 买它 1 年的收入，要 <b>'+yrs+' 年</b>才回本',
  gPsCompare:(name,mc,year,ps,cheaper,gap)=>'对照 '+name+'：'+mc+' ÷ '+year+' ＝ <b>'+ps+'</b>'+(gap?('　→　'+cheaper+' 便宜 <b>'+gap+' 倍</b>'):''),
  gPsBands:[['&lt; 1.5x','g-ok','便宜 —— 安全垫厚，可分批加仓'],['1.5x – 4x','','合理 —— 持有观察，不追高'],['&gt; 4x','g-warn','偏贵 —— 需要收入增长来消化估值']],
  gPsNote:'注意：这个倍数只反映"现在"，不反映"未来"。收入正在下滑时，<b class="hl">看起来很便宜可能只是假象</b>（分母迟早会变小）。',
  g730T:'为什么估值要同时看 7 日和 30 日',
  g730F:'<b class="hi">7 日</b> ＝ 最新速度　·　<b class="hi">30 日</b> ＝ 近一个月平均',
  g730L:'<b class="hl">7 日灵敏、能最早发现拐点</b>；<b>30 日平滑、不会被单日噪声骗</b>。两个数字差得越大，说明收入变化越剧烈 —— <b class="hl">这正是判断"拐点"的关键</b>。',
  g730Note:'记法：<b class="hl">7 日的倍数明显高于 30 日的倍数 ＝ 收入在掉</b>；反过来 ＝ 收入在涨。',
  psLine:(p,ps7,ps30,div,txt)=>p+'：7日 <b>'+ps7+'</b> vs 30日 <b>'+ps30+'</b>　→　相差 '+div+' 倍<br><span class="%C%">↳ '+txt+'</span>',
  divFast:(pct)=>({c:'g-bad', t:'收入正在快速下滑 —— 最近 7 天的收入只有过去一个月平均的 '+pct+'%'}),
  divSoft:()=>({c:'g-warn', t:'收入比月均低，正在走弱'}),
  divUp:(n)=>({c:'', t:'收入比月均高 '+n+' 倍，正在加速'}),
  divFlat:()=>({c:'', t:'收入和月均基本持平，节奏稳定'}),
  gBpT:'回购力度 —— 回购到底有没有用',
  gBpF:'回购力度 ＝ <b class="hi">最近 7 日回购 ÷ 最近 7 日成交额</b>',
  gBpL:'<b class="hl">不要看「回购了多少钱」，要看它占市场成交量的比例</b>。买盘再大，如果同期有几十倍的钱在换手，也改变不了价格方向。这是判断回购能不能托底的唯一有效算法。',
  gBpBands:[['≥ 5%','g-ok','买盘足够重，能真正托住价格'],['2% – 5%','g-warn','能减缓下跌，但改变不了方向'],['&lt; 2%','g-bad','影响不了短期价格，只能靠长期一点点变少']],
  gBpNote:'这就是「回购了但涨不动」的原因：<b class="hl">回购占成交额低于 2%</b> 时，买盘只是给卖盘提供流动性，价格方向由买卖双方决定；回购真正的作用是把币慢慢收走（慢变量）。',
  gBpLine:(a,x,b,y)=>a+'：最近 7 日回购 '+x+' ÷ 7 日成交额 '+y+' ＝ <b>'+b+'</b>',
  gBpFoot:'↑ 两家的回购力度都在 <b class="hi">2%</b> 以下 —— 用上面的算式就能说明：<b class="hl">为什么天天在回购，价格却还是跟着大盘走</b>',
  gToT:'换手率 & 回购折合一年',
  gToF:'<b class="hi">换手率</b> ＝ 24 小时成交额 ÷ 市值　·　<b class="hi">回购折合一年</b> ＝ 最近 7 天回购 × 52 ÷ 市值',
  gToL:'换手率告诉你这些币换手有多频繁：<b class="hl">换得越快，说明短线资金越多、波动越大，回购的影响也越小</b>。回购折合一年告诉你：如果回购速度不变，一年能买回市值的百分之几。',
  gToBands:[['换手 &lt; 3%','g-ok','币很稳，回购效果好'],['换手 3% – 8%','g-warn','换手偏活跃，回购效果一般'],['换手 &gt; 8%','g-bad','换手太快，回购效果被摊薄']],
  gToNote:'<b class="hl-warn">重要：回购折合一年买得多 ≠ 币价一定涨</b>。它建立在「收入不跌」的前提上；收入一旦下滑，这个数字会跟着一起缩水。',
  gToLine:(a,ta,ya,b,tb,yb)=>'当前：'+a+' 换手 <b>'+ta+'/天</b> · 回购折合一年 <b>'+ya+'</b><br>　　　'+b+' 换手 <b>'+tb+'/天</b> · 回购折合一年 <b>'+yb+'</b>',
  gToFoot:'每天有 <b class="hi">1 成</b>以上的币在换手 → <b class="hl">短线资金主导，回购对价格的影响被稀释</b>',
  gMomT:'收入对比上周 —— 最早报警的那个',
  gMomF:'收入对比上周 ＝ <b class="hi">最近 7 天的平均收入</b> vs <b class="hi">再往前 7 天的平均收入</b>',
  gMomL:'这是所有数字里<b class="hl">最早报警</b>的一个。因为回购的钱来自收入：<b>收入 ↓ → 回购的钱 ↓ → 买盘 ↓ → 价格失去支撑</b>。盯收入，比盯回购更早。',
  gMomBands:[['&gt; −15%','g-ok','收入平稳，维持仓位'],['−15% ~ −25%','g-warn','走弱，只观察不加仓'],['&lt; −25%','g-bad','骤降，暂停一切加仓']],
  gMomFoot:'两家都在 <b class="hi">−35%</b> 附近 → 已越过 −25% 触发线，按规则＝<b class="hl">暂停加仓</b>',
  gMsT:'市场占有率（24h 成交量份额）',
  gMsF:'占比 = <b class="hi">本品 24 小时成交量</b> ÷ <b class="hi">所在链全部 DEX 成交量</b>（DefiLlama 口径）',
  gMsL:'它回答的是「在整条链里，你占多大位置」。链越大分母越大，占比天然越小 —— 别看绝对值大小，看三件事：<b class="hl">跟自己比</b>（占比在升还是降）、<b class="hl">跟同链龙头比</b>（还差多少倍）、<b class="hl">全链在放量还是缩量</b>（决定占比变化是不是假象）。',
  gMsBands:[['占比连续走高','g-ok','资金在往这边搬，赛道热度上升'],['占比横盘 · 全链缩量','g-warn','池子在变小，不是你变强'],['占比连续下滑','g-bad','跑输所在的链：钱去了别处']],
  gMsEx:(p,pr,s,sr,pu,vs)=>'<b>现在</b>：PONS 占 Robinhood Chain <b>'+p+'</b>（链上第 '+pr+'）；STONK 占 Solana <b>'+s+'</b>（第 '+sr+'）。pump.fun 一家就占 Solana 的 <b>'+pu+'</b>，STONK 是它的 <b>'+vs+'</b>。',
  gMsNote:'口径提醒：本模块用「协议」口径（平台全部交易对加总），与小时监控的「单一池子」口径不同，两个数字不要互相加减；DefiLlama 大约每小时刷新一次。',
  bgmName:'行情BGM',
  bgmOff:'点一下开始听',
  bgmUpName:'逍遥仙',
  bgmUpName2:'不凡',
  bgmDownName:'兄弟抱一下',
  bgmDownName2:'梦的翅膀受了伤',
  bgmDownName3:'无人之岛',
  bgmTrackNo:(i,n)=>'第 '+i+' 首（共 '+n+' 首）',
  bgmBandUp:'涨了',
  bgmBandDown:'跌了',
  bgmBandFlat:'不涨不跌',
  bgmLab:'两家平均涨跌',
  bgmRule:'涨 3% 以上放《逍遥仙》《不凡》轮着来；跌 3% 以上三首疗伤歌轮着放；中间不换歌',
  bgmLegend:'上面那个百分比 ＝ 两家的平均涨跌，谁的盘子大谁说了算：近 7 天算 6.5 成、近 24 小时算 3.5 成\n涨了放《逍遥仙》《不凡》，跌了放《梦的翅膀受了伤》《兄弟抱一下》《无人之岛》\n涨跌 3% 以上才换歌；回到 1.5% 以内就先不换（免得来回跳）',
  bgmNoData:'价格还没到，先不播',
  bgmHold:'不涨不跌，继续放这首',
  bgmPlaceholder:'占位旋律（没读到歌曲文件，先用原创旋律垫着）',
  bgmReal:'正在放真歌',
  bgmMin:'每首至少放满 90 秒才换、换歌带 1.2 秒淡入淡出',
  bgmSev7:'近 7 天',
  /* —— 共勉：每次刷新随机一句（不轮播）+ 点赞（文案改这里，中英各一份）—— */
  secQuote:'共勉',
  quotes:[
    '遗憾与失败始终贯彻人生，真正改变命运的是极少数几次下注，难得的是在一次次失败后仍有勇气追逐梦想',
    '时常站在风口，从未把握住，本以为是时运不济，细细想来其实是实力的不足，命运的必然',
    '强大的投资者本就是享受孤独的，分享只是兴趣爱好',
    'If you don\u2019t believe me or don\u2019t get it, I don\u2019t have time to try to convince you, sorry',
    '你总以为机会无限，所以从不珍惜，可花有重开日，人无再少年',
    '所以我们一直在讲的确定性其实就是：1、你比其他人知道的多。2、你比其他人知道的早。3、你比其他人认知高'
  ],
  qLike:'点赞',
  qLikeTip:'每点一次 +1，可以连点；六句话共用一个数，只加不减',
  verTip:'当前线上版本 · 有更新时这个号会变',
  pvTotal:'总浏览', pvToday:'今日', pvUv:'今日访客',
  pvTip:'每次打开页面计 1 次浏览；同一天同一设备只计 1 个访客。数据来自本站自建计数，不接任何第三方统计',
  secRank:'收入排行 · 在整个行业里排第几',
  rankSub:n=>'数据来自 DefiLlama · 共 '+n+' 个项目 · 按收入总额排（含没上链的中心化平台）',
  rankPct:p=>'前 '+p+'%',
  rankOf:'共 ',
  rankDeltaUp:n=>'比一个月前 ↑ 上升 '+n+' 位',
  rankDeltaDown:n=>'比一个月前 ↓ 下滑 '+n+' 位',
  rankDeltaFlat:'排名与一个月前持平',
  rankDeltaNone:'以一个月前为基准',
  rankDeltaWhy:(a,b)=>'（按 30 天排是 #'+a+'，现在是 #'+b+'）',
  rankGap:(v,r,n)=>'再涨 <b class="hi">'+v+'</b>/天，就能超过 <b>#'+r+'</b> '+n,
  rankGapTop:'已经在前十之内，再往上每一名都很难',
  rankTopH:'榜首 10 名 · 天花板在哪',
  rankNearH:t=>t+' 的上下邻居',
  rankBelowH:t=>t+' 身后 8 名 · 谁在追',
  rankMonth:'近一个月名次变化',
  rankInsightUp:n=>'上升 '+n+' 位', rankInsightDown:n=>'下滑 '+n+' 位', rankInsightFlat:'持平',
  rankMe:'你关注的',
  rankNeed:'再涨',
  rankUpdated:u=>'排行数据时间：'+u,
  rankRefresh:'更新排行',
  rankLoading:'正在拉取全站榜单（约 1MB）…',
  rankNoData:'排行数据暂缺，点「刷新数据」或「更新排行」拉一次',
  rankTab24:'24 小时', rankTab7:'7 日', rankTab30:'30 日',
  bgmTip:'行情BGM 已开启 · 点右下角可静音',
  bgmWait:'还没开始 · 碰一下页面就响',
  bgmSev24:'近 24 小时',
  secBurn:'回购与销毁 · 真金白银烧掉多少',
  burnSub:u=>'链上现读（PONS 一直算到最新区块）· 数据源：Robinhood Chain / Solana 链上接口 + DefiLlama 全站回购榜'+(u?' · 快照 '+u:''),
  burnLink:'链上记录',
  burnBurned:'已销毁',
  burnPctOf:'占总量',
  burnValue:'按现价折算',
  burn30d:'近 30 天回购',
  burnYield:'折合一年能买回',
  burnVolShare:'回购占成交额 (7天)',
  burnSrcPons:'链上现读：Robinhood Chain · 死地址余额',
  burnSrcStonk:'链上现读：Solana · 初始 10 亿 − 当前总量',
  burnTab24:'近 24 小时', burnTab30:'近 30 天', bbColName:'项目',
  burnRankBy:t=>'名次按「'+t+'」这一列排（链上现读的两行口径不同，不占 DefiLlama 名次）',
  bbChainRk:'链上',
  bbChainRkTip:'这行金额是链上最近 24 小时现读（比 DefiLlama 新）；口径与 DefiLlama 不同，所以不占用它的名次。',
  burnPeersH24:n=>'回购力度榜 · 全行业近 24 小时回购金额（共 '+n+' 个项目，已去掉「烧 gas」的公链）',
  burnPeersH30:n=>'回购力度榜 · 全行业近 30 天回购金额（共 '+n+' 个项目，已去掉「烧 gas」的公链）',
  burnPeersNote24:'只有 Pons / StonkFun 这两行是链上现读的：PONS 一直算到最新区块（真 24 小时），STONK 用总量差值。其它项目来自 DefiLlama，它有时晚 1~2 天出数。',
  burnPeersNote30:'说明：数字来自 DefiLlama 的 holders-revenue，近 30 天累计；已经把「烧 gas」的公链去掉（那不叫回购）。',
  burn24:'近 24 小时回购', burn24Wait:'积累中', burn24Chain:'链上现读', burn24Snap:'链上快照', burn24Official:'官方接口',
  burnCmpCol1:'近 24 小时', burnCmpCol2:'近 30 天', burnCmpCol3:'回购占成交额', burnCmpCol4:'折合一年能买回',
  burnLiveOk:s=>'链上实时已同步（'+s+'）· 收入与全站榜单来自 DefiLlama，可能晚 1~2 天',
  burnLiveFail:'链上接口这次没读通 · 显示的是最近一次快照值',
  burn24DayTip:'这是数据源里最近的一天（可能滞后 1~2 天）；链上实时值要等快照攒满 24 小时。',
  burnNoteH:'回购到底能不能托住价格？三个项目用同一把尺子量',
  burnFoot:'说明：销毁量和链上余额是现读的；回购金额来自 DefiLlama；「折合一年」是拿最近 30 天的速度直接乘出来的，不是承诺。一周的数据说明不了趋势，请连着看。',
  burnBody:o=>'<ul>'
   +'<li><b>先看「今天」的钱：</b>过去 24 小时，Pons 打进死地址 <b class="hl">'+o.pons24+'</b>'+(o.pons24tx?'（'+o.pons24tx+' 笔）':'')+'，StonkFun 销毁 <b class="hl">'+o.stonk24+'</b>。这一栏不用等公告，链上每天都能对账 —— 回购一停，数字立刻变 0。</li>'
   +'<li><b>谁的回购更有分量（回购占成交额，近 7 天）：</b>StonkFun <b class="hl">'+o.stonkVs+'</b> &gt; Pons <b class="hl">'+o.ponsVs+'</b> &gt; pump.fun <b class="hl">'+o.pfVs+'</b>。StonkFun 的回购力度是 pump.fun 的 <b>'+o.timesVs+'</b>，可它这一周在跌；pump.fun 的比值最低，价格反而在高位。<b>回购不是价格的开关。</b></li>'
   +'<li><b>谁能真正把币买走（回购 ÷ 市值，折合一年）：</b>StonkFun <b class="hl">'+o.stonkYd+'</b>、Pons <b class="hl">'+o.ponsYd+'</b>、pump.fun <b class="hl">'+o.pfYd+'</b>。按最近 30 天的速度算，这两家一年买回的币相当于市值的很大一块 —— 这才是回购真正的价值：<b>慢，但会累积</b>。</li>'
   +'<li><b>那 pump.fun 凭什么涨？</b>它一天成交 <b>'+o.pfVol+'</b>，是 Pons 的 <b>'+o.pfVolX+'</b>，涨在<b>需求、注意力和流动性</b>，不在回购。同一个道理反过来看：StonkFun 跌，不是回购停了（近 7 日回购 <b>'+o.stonk7+'</b>，一天没落），而是<b>卖盘比买盘急</b>。</li>'
   +'<li><b>真正不可逆的是销毁（币是真的没了）：</b>Pons 已把 <b class="hl">'+o.ponsPct+'</b> 的总量送进死地址，StonkFun 已销毁 <b class="hl">'+o.stonkPct+'</b>。这部分永远回不来。一句话：<b>回购是买盘，会被卖盘吃掉；销毁是抽走供给，永久生效。</b></li>'
   +'</ul><div class="bb-foot">'+o.foot+'</div>',
  secSrc:'数据源体检 · 每个数字有多新',
  srcPrice:'币价', srcPriceFrom:'coins.llama.fi', srcJustNow:'打开即刷新',
  srcDailyP:'PONS 日度（收入 / 销毁）', srcDailyS:'STONK 日度（收入 / 销毁）', srcDailyFrom:'DefiLlama', srcDailyFromS:'StonkFun 官方 API',
  srcHourly:'小时级（交易量 / 收入 / 销毁）', srcHourlyFrom:'官方接口 + 链上',
  srcLb:'收入排行榜', srcLbFrom:'DefiLlama 全站榜',
  srcLag:n=>'滞后 '+n+' 天',
  srcStonkNote:'STONK 的日度与小时级都读官方 API，数字与 stonkfun.xyz 官网一致：日度＝官方日线，小时级＝官方累计值的每小时差值；官方接口断流时才退回 DefiLlama 兜底（会标注）。',
  srcLbStale:'上次抓取失败（4.2MB 榜单接口被中途掐断），现在显示的是上一份；已补上重试，下次抓取会自动追上。',
  srcHourNote:'PONS 收入＝链上回购支出 ÷ 80%（推算，已标注），销毁＝链上真值；STONK 收入与销毁＝官方接口真值。',
  srcSum:(n,ok,lag)=>'共 <b>'+n+'</b> 项数据源：<b>'+ok+'</b> 项是最新的'+(lag?('，<b>'+lag+'</b> 项滞后（上方已标黄 —— 那是上游出数的节奏，不是本站故障，小时级那套照旧是最新的）'):'')+'。',
  safeLine:'<b>只读数据面板</b> · 不连接钱包 · 不请求签名 · 不发起任何交易<span class="sf-sep">　|　</span>数据全部来自公开接口',
  foot1:'数据来源：Pons 的收入和回购＝DefiLlama + 链上；STONK 的收入和回购＝StonkFun 官方 API（与官网一致）；成交额和市值＝CoinGecko。Pons 算的是它自己留下的那部分收入（创作者和 Uniswap 的分成已经扣掉）；StonkFun 算的就是它留下的交易费。贵不贵＝市值 ÷（每天收入 × 365 天），数字越小越便宜。参照：pump.fun 30 天收入 $4,528 万、市值 $24.6 亿 → 4.45x。',
  foot2:'红线怎么定的：Pons 7 日均收入 &lt; $10 万＝该走，&lt; $15 万＝别加仓；StonkFun &lt; $20 万＝该走，&lt; $28 万＝别加仓。这个看板只是研究工具，不是投资建议。'
},
en:{
  docTitle:'Pons · StonkFun Revenue & Buyback Monitor',
  h1:'Pons · StonkFun Revenue & Buyback Monitor',
  navAria:'Section navigation', navTitle:'Sections',
  navTop:'Overview', navHourly:'Hourly', navRules:'Action', navBurn:'Buybacks', navShare:'Share',
  navRank:'Ranking', navChart:'Trends', navTable:'Daily', navSrc:'Data health', navGuide:'Glossary',
  secRules:'What to do now · the five numbers that matter',
  secHourly:'Hourly monitor · last 72 hours',
  hourSub:'One bar per hour — volume / revenue / burns. Is it heating up or cooling down?',
  hourTabVol:'Volume', hourTabRev:'Revenue', hourTabBurn:'Burns',
  hourH1:'Last 1 hour', hourH6:'Last 6 hours', hourH24:'Last 24 hours', hourH72:'Last 72 hours',
  hourLive:'● live', hourLiveOff:'● page snapshot (live refresh failed)',
  hourNow:'Current hour', hourPick:'Selected', hourOngoing:'in progress',
  hourNoData:'no data yet',
  hourSpan:'gap backfill · est.',
  hourSpanNote:'{n} h in this window are averaged backfill across a gap in the official counter (hatched bars, estimated); the rest are measured hour by hour.',
  hourEst:'estimate', hourChain:'on-chain', hourOfficial:'official', hourEach:'One bar per hour: PONS left · StonkFun right',
  hourNoteVol:'<b>Volume</b>: hourly traded volume of the two main pools (PONS/WETH, STONK/SOL) from GeckoTerminal hourly candles. Rising volume means short-term money is coming in; fading volume means interest is cooling off — the fastest read on whether anyone is trading.',
  hourNoteRev:'<b>Revenue</b>: the Pons column is an <b>on-chain estimate</b> — hourly buyback spend ÷ 80% (Pons’ published buyback share). StonkFun is <b>official truth</b>: we read stonkfun.xyz’s official cumulative revenue and difference it hour by hour. <b>Note</b>: the official counter settles in batches, so single hours can jump around — use the 6h / 24h totals for a steadier read.',
  hourNoteBurn:'<b>Burns</b>: Pons is counted hour by hour on Robinhood Chain from transfers into the dead address — <b>verifiable on-chain</b> (roughly one buy every 15 min). StonkFun uses the <b>official cumulative burn figure</b>, differenced per hour — the same source as the platform’s own page.',
  /* —— Market share (v3.14): DefiLlama DEX scope —— */
  secShare:'Market share · 24h trading volume',
  shareLive:'● hourly',
  shareSub:u=>'Source: DefiLlama · DEX volume (numerator = protocol, denominator = every DEX on its chain)'+(u?' · fetched '+u:''),
  shOfChain:'of chain DEX volume',
  shChainVol:'Whole chain',
  shRank:'Chain rank',
  sh7d:'Last 7 days',
  sh14d:'14-day share',
  shPumpMark:'pump.fun share',
  shVsT:'Versus Solana leader pump.fun',
  shVsSub:'same ruler: DefiLlama 24h volume',
  shVsLine:(r,ps,mult)=>'StonkFun volume = <b>'+r+'</b> of pump.fun; pump.fun alone holds <b>'+ps+'</b> of the chain — <b>'+mult+'</b> our share.',
  shareNoteH:'How to read this block',
  shareNote:'<b>Share</b> = protocol 24h volume ÷ all DEX volume on its chain (DefiLlama, refreshed hourly). The bigger the chain, the smaller the share by construction — <b>watch the 14-day trend and the gap to the leader rather than the absolute number</b>. Note: this is the protocol scope (all markets of the platform), unlike the single-pool scope in the hourly monitor above — do not add or subtract the two numbers.',
  /* —— Burn milestones (v3.15) —— */
  secMilestone:'Burn milestones · how far to the next round number',
  msLive:'● hourly',
  msSub:(f,r)=> f? f+' burns ~'+r+'× faster than the other (as % of supply per day)' : 'Both burn counters are still accumulating',
  msStamp:'snapshot ',
  msBurned:'Burned',
  msBurnQty:'Burned so far',
  msSupplyTxt:'1B total',
  msUsd:'Value at spot',
  msAtPrice:'at ',
  msSpeed:'Burn speed',
  msPerDay:'/day',
  msPerDayPct:v=>v+'% / day',
  msNext:'Next 1%',
  msDays:v=>'≈ '+v+' days',
  msToGo:'to go',
  msChip:n=>'next '+n,
  msScale:'ticks every 5%',
  msNoteH:'How to read this',
  msNote:'<b>Burned</b> = tokens sent to the dead address (verifiable on-chain, gone forever). <b>Burn speed</b> uses the last ~24h of real burns converted to "what % of supply is burned per day" — one ruler for both. <b>Next 1%</b> = how many tokens remain to the next whole-percent milestone and the estimated days at the current pace. Note: burned tokens come from the buyback — same money, two views; snapshots up to a day old are normal.',
  bmSpeedL:'Burn speed', bmAfter:' to the next mark at this pace', bmTip:'Based on the last ~24h of on-chain burns; refreshes hourly',
  bmNext:(g,t,d)=>t+' to the '+g+' mark · '+d+' at this pace',
  msSrcOfficial:'official counter', msSrcSnapshot:'on-chain snapshot', msSrcChain72:'on-chain logs 72h',
  gMmT:'Burn speed & next mark (how to read them in the Buyback & Burn card)',
  gMmF:'Burned share = <b class="hi">cumulative burned</b> ÷ <b class="hi">1B supply</b>; burn speed = last ~24h burned ÷ supply (per-day %); next mark = the next whole percent',
  gMmL:'The buyback turns revenue into bids; the burn removes coins forever — <b>the burn is the harder evidence</b>: gone is gone. Watch three things: <b class="hl">speed (%/day)</b>, <b class="hl">who burns faster</b>, and <b class="hl">days to the next whole percent</b>. Steady or rising speed = buyback on track; a visible drop = the buyback may be struggling — go back to revenue and daily buyback numbers.',
  gMmBands:[['Steady or rising speed','g-ok','Buyback on track — hold as planned'],['Speed clearly lower','g-warn','Buyback weakening — watch revenue and buyback data'],['Almost no burns for days','g-bad','Buyback looks stalled — exit and watch, per the rules']],
  gMmNote:'Two notes: (1) Pons cumulative burned uses dead-address balance snapshots (daily), StonkFun uses its official counter (hourly) — the refresh rhythms differ, so short-window comparisons carry a small error; (2) "Days to next 1%" is a <b>straight-line estimate from the last 24h pace</b>, not a promise.',
  gMmEx:(pb,pp,pn,pd,sb,sp,sn,sd)=>'<b>Now</b>: Pons has burned <b>'+pb+'</b> ('+pp+', next '+pn+' in ~'+pd+' days); StonkFun has burned <b>'+sb+'</b> ('+sp+', next '+sn+' in ~'+sd+' days).',
  secChart:'Trends',
  secTable:'Day-by-day detail (last 20 days)',
  secGuide:'How to read every number',
  guideExpand:'tap to expand', guideCollapse:'collapse',
  gLegend:'Legend: <b class="hl">highlighted</b> = the takeaway　·　<b class="hi">mono numbers</b> = live values',
  refresh:'Refresh',
  loading:'Loading…', fetching:'Fetching…',
  live:'● Live data', offline:'● Snapshot (offline)', liveAt:'● Live · ',
  updatedAt:'Updated ',
  priceLive:t=>' · price live '+t,
  burned:'burned ', mcap:'Mcap ', fromAth:'From ATH ',
  perDay:' /day',
  kAvg7:'7-day avg revenue', kMom:'vs the previous 7 days', kLast:'Latest daily revenue', kPeak:'Peak daily revenue',
  kPs7:'P/S (7d, annualized)', kPs30:'P/S (30d, annualized)', kFromPeak:'Below peak revenue',
  kBurnYield:'Buyback, annualized', kBurn7:'Buyback, last 7 days', kBurnForce:'Buyback vs volume',
  kVol24:'24h volume', kTurnover:'Daily turnover',
  tipPs:'Market cap ÷ one year of revenue — lower is cheaper', tipPs30:'Uses 30-day average revenue (smoother)',
  tipBurnYield:'At the last 7 days\' pace, how much of the market cap gets bought back in a year',
  tipBurnForce:'7-day buyback ÷ 7-day volume. At 5%+ it is a bid that can actually hold price', tipVol:'24-hour trading volume',
  stBad:'Revenue fell below the exit line — step aside', stWarn:'Revenue below the warning line — no new buys',
  stMom:'Revenue fell sharply vs last week — watch only', stUp:'Revenue stabilising — consider scaling in',
  stFlat:'Revenue flat — hold and watch',
  lvOk:'OK', lvWarn:'Watch', lvBad:'Alert',
  legendOk:'Conditions met, hold as planned', legendWarn:'Near a threshold — pause buys, watch closely',
  legendBad:'Rule triggered — read the advice under each row',
  alertTitle:'Triggered:', alertHint:'Red cards = handle these first',
  badFlag:'Triggered · act first',
  cmpHead:(n,m)=>n+'/'+m+' rules OK',
  verdict:'', verdictTie:'even', verdictNoData:'not enough data', verdictWin:t=>t,
  advice:'Action: ',
  vFloor:'thicker buffer', vMom:'more resilient', vBurn:'more active', vBurnpower:'higher buyback share', vPs:'cheaper',
  dimFloorL:'Revenue vs stop-loss line', dimFloorH:'7-day avg below the exit line = get out',
  dimMomL:'Revenue change vs prior week', dimMomH:'A sustained decline is the earliest warning',
  dimBurnL:'Is the buyback still running?', dimBurnH:'Buyback stopping = the most important exit signal',
  dimBpL:'Can the buyback support price?', dimBpH:'Buyback as a share of volume. Under 2% it barely moves price',
  dimPsL:'Is it cheap? (mcap ÷ yearly revenue)', dimPsH:'Lower is cheaper',
  dimFloorS:'Stop', dimMomS:'vs last week', dimBurnS:'Burn', dimBpS:'Force', dimPsS:'Value',
  conclusion:'Bottom line',
  sumHint:'↓ Five signals below — compare both projects line by line',
  deepTag:'How the numbers are derived',
  chipRev:'7d avg revenue', chipMom:'vs last week', chipBp:'Buyback vs volume', chipPs:'Valuation',
  sumActBad:'Exit: revenue below the exit line',
  sumActMomBad:'Pause buying: revenue down more than 25% vs last week',
  sumActBurnBad:'Trim first: the buyback has stopped',
  sumActBpBad:'Watch only: buyback too small to hold the price',
  sumActWarn:'Pause buying: signals weakening',
  sumActOk:'Hold and watch: signals normal',
  sumActNoData:'Not enough data — watch',
  anFloor:d=>'7-day avg '+d.avg7+' · warning '+d.warn+' · exit '+d.danger+'; <b>'+d.toWarn+' above the warning line</b>'+(d.days?(', roughly <b>'+d.days+' days</b> before it breaks if the last two weeks\' pace holds'):'')+'.',
  streakTxt:(n,up)=> up? (n>=2? 'up '+n+' days in a row': 'turned up on the latest day') : (n>=2? 'down '+n+' days in a row': 'slipped again on the latest day'),
  anMom:d=>'Last 7 days <b>'+d.a+'</b> vs prior 7 days '+d.b+' (Δ <b>'+d.diff+'/day</b>); '+(d.up?'<span class="hl-up">'+d.streakTxt+'</span>':'<span class="hl-dn">'+d.streakTxt+'</span>')+'.',
  anBurn:d=>'7-day buyback <b>'+d.buy7+'</b> (avg '+d.buyDay+') = <b>'+d.buyShare+'</b> of revenue over the same window; buybacks on '+d.burnDays+' of the last 7 days; at this pace it retires <b>'+d.yield+'</b> of the market cap a year.',
  anBp:d=>'Buyback <b>'+d.buy7+'</b> ÷ volume <b>'+d.vol7+'</b> = <b>'+d.f+'</b>. Reaching the 5% "real bid" bar needs <b>'+d.needDay+'</b> a day — <b>'+d.gap+'</b> today\'s rate; against revenue of '+d.revDay+'/day that equals <b>'+d.needShare+'</b> of revenue, while the published policy only spends <b>'+d.share+'</b> of revenue on buybacks → structurally out of reach near term.',
  anBpEvidence:d=>'Evidence: the buyback ran all week and price still moved <b>'+d.priceChg+'</b> ('+d.priceFrom+' → '+d.priceNow+').',
  anBpLong:d=>'Buybacks do matter in the long run: at this pace they retire '+d.yield+' of the market cap a year, steadily shrinking supply — a slow variable that cannot set the short-term direction.',
  anPs:d=>'Market cap '+d.mcap+' ÷ (7-day avg '+d.avg7+' × 365 = '+d.yearRev+') = <b>'+d.ps7+'</b>; using 30 days '+d.ps30+' ('+d.div+'× apart) → '+d.trend+'. pump.fun reference ≈ 4.45x.',
  priority:t=>'Prefer '+t+' (cheaper, thicker buffer); wait for the other one to stop bleeding before adding.',
  priorityNone:'Not enough data for an allocation call.',
  drHead:'Deep read · how this bottom line is derived',
  drHint:'Every step computed from full-site data — not a one-line opinion',
  drDrop:'Trend', drBuy:'Support', drVal:'Value', drTurn:'Now', drCond:'Trigger',
  drDropT:d=>'Last 3 days average <b>'+d.a3+'</b> vs the first 4 days <b>'+d.a4+'</b>: '+(d.worse? '<b class="hl-dn">another '+d.d3abs+' lower</b> — still deteriorating, not a one-day dip' : d.up? '<b class="hl-up">up '+d.d3+'</b> — first sign of stabilising, needs 2 more days to confirm' : 'change '+d.d3+' — the slide paused but has not turned')+'; daily line '+d.streakTxt+'.',
  drBuyT:d=> d.vol7? '7-day buyback <b>'+d.buy7+'</b> = <b>'+d.f+'</b> of same-period volume ('+d.vol7+'): '+(d.strong? 'above the 5% "real bid" bar — buybacks genuinely support the price short term.' : d.weak? '<b>'+d.gap+'</b> short of the 5% "real bid" bar — it cannot move supply/demand yet, price is still driven by revenue expectations.' : 'close to but below the 5% "real bid" bar ('+d.gap+' away) — visible, not yet strong support.')+' The long side: '+d.yTxt+' — supply really shrinks; a slow variable and a long-term floor.' : 'Volume data missing — buyback support cannot be measured right now.',
  drYFull:'at the current pace the entire float is bought back in under a year',
  drYPart:v=>'at the current pace roughly '+v+' of the float is bought back per year',
  drValT:d=>'Annualising 7-day revenue, market cap / annual revenue = <b>'+d.ps7+'</b> (cheap below 1.5x | rich above 4x). Over the week revenue '+d.rev7+', price '+d.p7+': '+(d.compressed? 'price fell faster than revenue → the multiple compressed, buffer getting thicker' : d.expanded? 'price held up better than revenue → the multiple expanded, buffer getting thinner' : 'both moved together, multiple roughly unchanged')+(d.psPrev? ' (last week ≈ '+d.psPrev+')':'')+'.',
  drTurnT:d=> (d.h24!=null)? 'Last 24h revenue <b>'+d.h24+'</b> (≈ '+d.h24per+'/day), '+d.h24chg+' vs the prior 24h; versus the 7-day average it is '+(d.hot? '<b class="hl-up">running hot — near-term pace improving</b>' : d.cold? '<b class="hl-dn">running cold — still weakening</b>' : 'roughly flat — no direction yet')+'.' : 'Not enough hourly data for a real-time call.',
  drCondT:d=> (d.avg7N>=d.warnN)? 'Revenue still sits above the warning line <b>'+d.warn+'/day</b> (exit line '+d.danger+' further down); what holds the current call down is the weekly change '+d.rev7+'. Per the rules: a weekly change within -15%, or 3 consecutive up days, lifts the "pause buying" call; a break of the warning line tightens it, and the exit line means step aside.' : 'For the call to turn from "pause buying" back to "can add", revenue must reclaim <b>'+d.warn+'/day</b> and hold it (now '+d.avg7+', still '+d.needUp+' away)'+(d.days? '; at the last two weeks\' slope the warning line breaks in about <b>'+d.days+' days</b>' : '')+'. If it breaks <b>'+d.danger+'/day</b> (the exit line), the rule says step aside first.',
  actFloorBad:'Below the exit line: trim in tranches or exit, do not average down',
  actFloorWarn:'Below the warning line: no new buys, watch this line daily',
  actFloorOk:v=>'Sits '+v+'% above the warning line — keep holding',
  sFloor:(a,b,c)=>'7-day avg <b class="hi">'+a+'/day</b>　·　exit '+b+'　·　warning '+c,
  actMomBad:'Down more than 25% vs last week: pause all buying until 3 straight up days',
  actMomWarn:'Weaker than last week: watch only, no adds',
  actMomUp:'Up vs last week: consider scaling in',
  actMomFlat:'Flat vs last week: keep current position',
  sMom:(d)=>'This week vs last <b class="hi">'+d+'%</b>　·　trigger −25%',
  actBurnOff:'Buyback has stopped: reduce first, only add after it resumes',
  actBurnOn:v=>'Buyback running: 7d buyback ≈ '+v+'% of revenue',
  sBurn:(a,b)=>'7d buyback <b class="hi">'+a+'</b>　·　'+b,
  actBpNone:'No volume data — cannot judge buyback impact',
  actBpOk:v=>'Buyback is '+v+'% of volume: heavy enough to support price',
  actBpWarn:v=>'Buyback is '+v+'% of volume: cushions drops but cannot reverse them',
  actBpBad:v=>'Buyback is only '+v+'% of volume: too small to support the price',
  sBp:(a,b)=>'7d buyback <b class="hi">'+a+'</b> ÷ 7d volume <b class="hi">'+b+'</b>　·　≥5% is a real bid',
  actPsNone:'No revenue data — cannot value it yet',
  actPsCheap:v=>v+'x is cheap: thick buffer, scale in gradually',
  actPsFair:v=>v+'x is fair: hold and watch, do not chase',
  actPsDear:v=>v+'x is rich: do not chase, wait for a dip or revenue growth',
  sPs:v=>'Mcap ÷ yearly revenue (7d) <b class="hi">'+v+'</b>　·　under 1.5x is cheap · over 4x is rich　·　(pump.fun is 4.45x)',
  tabRev:'Daily revenue', tabRev7:'7-day average', tabCum:'Cumulative buyback', tabPrice:'Price (rebased)',
  base100:'Base 100', start100:'start = 100', stopLoss:t=>t+' stop-loss',
  cumName:n=>n+' cumulative buyback (window)',
  thDate:'Date', thRev:'Revenue', thBurn:'Buyback', thPrice:'Price', thAvg7:'7-day avg',
  pendingCell:'pending',
  pendingTip:'DefiLlama has not published this day yet (the dashboard is fine). It fills in on the next refresh.',
  suppNew:'Latest',
  suppNewPart:h=>'Latest·'+h+'h',
  suppWhoPons:'PONS from on-chain buybacks (revenue = buyback spend ÷ 80%)',
  suppWhoStonk:'STONK from the official API (cumulative diff, matches the official site)',
  suppTip:(h,p,who,off)=>'DefiLlama has not published this day yet; the figure shown is the real value for '+(p? ('a part of the day ('+h+'h)') : 'the full day (24h)')+' — '+who+(off? '; this is the same official basis used across the table and fills in automatically when the day ends.' : '. The basis differs from DefiLlama, so do not subtract them directly.'),
  srcLatest:d=>'latest '+d,
  lagBadge:d=>d+'d late',
  lagTip:'DefiLlama has not updated the last few days for this protocol, so its 7-day average uses the last 7 days that do have data — keep that in mind when comparing the two.',
  liveChip:v=>'Last 24h '+v,
  liveChipTip:'DefiLlama has not published the last few days, so the last-24h figure comes from a faster source: PONS = on-chain buyback spend converted to revenue, STONK = official API. Click to jump to the hourly monitor below. Note: this is a rolling 24h window, not the same basis as the daily 7-day average above.',
  gPsT:'Mcap ÷ yearly revenue — what you pay for one year of revenue',
  gPsF:'Mcap ÷ yearly revenue = <b class="hi">market cap</b> ÷ (<b class="hi">daily revenue × 365</b>)',
  gPsL:'<b class="hl">The lower the number, the cheaper it is</b>: how many years of today\'s earnings you are paying for. It separates "is the business expensive" from "is the token price high".',
  gPsCap:t=>'Worked example ('+t+')',
  gPsLine:(mc,avg,year,ps,yrs)=>'Market cap '+mc+'　÷　(7-day avg '+avg+'/day × 365 = '+year+')'+
      '<br>= <b>'+ps+'</b><br>→ Revenue held flat, you pay 1 year of revenue for <b>'+yrs+' years</b> to break even',
  gPsCompare:(name,mc,year,ps,cheaper,gap)=>'vs '+name+': '+mc+' ÷ '+year+' = <b>'+ps+'</b>'+(gap?('　→　'+cheaper+' is <b>'+gap+'× cheaper</b>'):''),
  gPsBands:[['&lt; 1.5x','g-ok','Cheap — thick buffer, scale in'],['1.5x – 4x','','Fair — hold, do not chase'],['&gt; 4x','g-warn','Rich — needs revenue growth to grow into']],
  gPsNote:'Note: this multiple only describes "now", not the future. When revenue is falling, <b class="hl">cheap-looking can be an illusion</b> — the denominator shrinks next.',
  g730T:'Why read valuation on both 7d and 30d',
  g730F:'<b class="hi">7-day</b> = latest speed　·　<b class="hi">30-day</b> = one-month average',
  g730L:'<b class="hl">The 7-day is sensitive and spots turning points first</b>; <b>the 30-day is smooth and immune to one-off spikes</b>. The wider the gap between them, the more violent the revenue swing — <b class="hl">that gap is exactly what marks a turning point</b>.',
  g730Note:'Rule of thumb: the 7-day multiple well above the 30-day one = revenue falling; the reverse = revenue rising.',
  psLine:(p,ps7,ps30,div,txt)=>p+': 7d <b>'+ps7+'</b> vs 30d <b>'+ps30+'</b>　→　'+div+'× apart<br><span class="%C%">↳ '+txt+'</span>',
  divFast:(pct)=>({c:'g-bad', t:'Revenue is falling fast — the last 7 days are only '+pct+'% of the monthly average'}),
  divSoft:()=>({c:'g-warn', t:'Below the monthly average and softening'}),
  divUp:(n)=>({c:'', t:'Running '+n+'× above the monthly average and accelerating'}),
  divFlat:()=>({c:'', t:'In line with the monthly average, steady'}),
  gBpT:'Buyback force — does the buyback actually matter?',
  gBpF:'Buyback force = <b class="hi">7-day buyback ÷ 7-day volume</b>',
  gBpL:'Do not look at how many dollars were bought back — look at the share of market volume. However big the bid, if tens of times more supply is changing hands, it will not move the price. That is the only reliable test of whether a buyback can hold the price.',
  gBpBands:[['≥ 5%','g-ok','Heavy enough to genuinely support price'],['2% – 5%','g-warn','Slows declines, cannot reverse them'],['&lt; 2%','g-bad','Cannot move short-term price — only a slow supply shrink']],
  gBpNote:'This is why you can see buybacks and still see no bid: when <b class="hl">buyback ÷ volume is under 2%</b>, the bid is mostly providing liquidity to sellers and price is set by the rest of the tape. What a buyback really does is retire supply over time — a slow variable.',
  gBpLine:(a,x,b,y)=>a+': 7d buyback '+x+' ÷ 7d volume '+y+' = <b>'+b+'</b>',
  gBpFoot:'↑ Both sit below <b class="hi">2%</b> — which is exactly why <b class="hl">a daily buyback still leaves the price following the wider market</b>',
  gToT:'Turnover & buyback per year',
  gToF:'<b class="hi">Turnover</b> = 24h volume ÷ mcap　·　<b class="hi">Buyback per year</b> = 7d buyback × 52 ÷ mcap',
  gToL:'Turnover shows how "active" the float is: <b class="hl">the higher it is, the more short-term money is in it, the bigger the swings, and the less a buyback matters</b>. Buyback per year tells you what share of the market cap gets repurchased in a year at the current pace.',
  gToBands:[['Turnover &lt; 3%','g-ok','Stable float, buyback works well'],['Turnover 3% – 8%','g-warn','Fairly active, buyback diluted'],['Turnover &gt; 8%','g-bad','High churn, buyback mostly diluted']],
  gToNote:'Important: buying back a lot per year does not guarantee a higher price. It assumes revenue holds; if revenue falls, the number shrinks with it.',
  gToLine:(a,ta,ya,b,tb,yb)=>'Now: '+a+' turnover <b>'+ta+'/day</b> · buyback per year <b>'+ya+'</b><br>　　　'+b+' turnover <b>'+tb+'/day</b> · buyback per year <b>'+yb+'</b>',
  gToFoot:'<b class="hi">More than 10%</b> of the float trades every day → <b class="hl">short-term money dominates and dilutes the buyback</b>',
  gMomT:'Revenue vs the previous week — the earliest warning',
  gMomF:'Revenue vs previous week = <b class="hi">average of the last 7 days</b> vs <b class="hi">the 7 days before that</b>',
  gMomL:'This is the first number to flash. The buyback is funded by revenue: revenue ↓ → buyback ↓ → bid ↓ → price loses support. Watching revenue gets you ahead of the buyback.',
  gMomBands:[['&gt; −15%','g-ok','Stable — keep position'],['−15% ~ −25%','g-warn','Weakening — watch, do not add'],['&lt; −25%','g-bad','Sharp drop — pause all buying']],
  gMomFoot:'Both are near <b class="hi">−35%</b> → past the −25% trigger, which means: <b class="hl">pause all buying</b>',
  gMsT:'Market share (24h trading volume)',
  gMsF:'Share = <b class="hi">protocol 24h volume</b> ÷ <b class="hi">all DEX volume on its chain</b> (DefiLlama)',
  gMsL:'It answers "how big is this platform inside its whole chain". The bigger the chain, the smaller the share by construction — so read three things, not the absolute number: <b class="hl">vs its own history</b> (rising or falling), <b class="hl">vs the chain leader</b> (how many times behind), and <b class="hl">whether the chain itself is expanding or shrinking</b>.',
  gMsBands:[['Share rising','g-ok','Money is moving in — the niche is heating up'],['Flat share · chain shrinking','g-warn','The pond is getting smaller, not you getting stronger'],['Share falling for days','g-bad','Underperforming its own chain — money went elsewhere']],
  gMsEx:(p,pr,s,sr,pu,vs)=>'<b>Now</b>: PONS is <b>'+p+'</b> of Robinhood Chain (rank '+pr+'); STONK is <b>'+s+'</b> of Solana ('+sr+'). pump.fun alone holds <b>'+pu+'</b> of Solana; STONK is <b>'+vs+'</b> of it.',
  gMsNote:'Note: this module uses the protocol scope (all markets of the platform), which differs from the single-pool scope of the hourly monitor — do not add or subtract the two. DefiLlama refreshes roughly hourly.',
  bgmName:'Market BGM',
  bgmOff:'Tap to play',
  bgmUpName:'Xiao Yao Xian',
  bgmUpName2:'Bu Fan',
  bgmDownName:'Brothers Hug',
  bgmDownName2:'Dream Wings Hurt',
  bgmDownName3:'Nobody\u2019s Island',
  bgmTrackNo:(i,n)=>'track '+i+' of '+n,
  bgmBandUp:'UP',
  bgmBandDown:'DOWN',
  bgmBandFlat:'FLAT',
  bgmLab:'Avg move',
  bgmRule:'Up 3%+ alternates "Xiao Yao Xian" / "Bu Fan"; down 3%+ alternates the three sad songs; in between keeps the current one',
  bgmLegend:'The number above = both coins\u2019 average move, and the bigger coin counts more: 7-day counts 65%, 24-hour counts 35%\nUp → "Xiao Yao Xian" / "Bu Fan". Down → "Dream Wings Hurt" / "Brothers Hug" / "Nobody\u2019s Island"\nIt only switches past 3%; inside 1.5% it keeps playing (no flip-flopping)',
  bgmNoData:'No price data yet — nothing to play',
  bgmHold:'Flat both ways — keeping this track',
  bgmPlaceholder:'Placeholder melody (song files not found)',
  bgmReal:'Real track',
  bgmMin:'each song plays at least 90s · 1.2s crossfade',
  bgmSev7:'7d',
  /* —— A few words: one random quote per page load (no rotation) + one shared like counter —— */
  secQuote:'A few words',
  quotes:[
    'Regret and failure run through every life. What truly changes your fate is a handful of bets \u2014 and what is rare is the courage to keep chasing the dream after failing again and again.',
    'I kept standing in the tailwind, never catching it. I blamed luck; looking closer, it was a lack of skill \u2014 and therefore inevitable.',
    'Strong investors enjoy being alone in the first place. Sharing is just a hobby.',
    'If you don\u2019t believe me or don\u2019t get it, I don\u2019t have time to try to convince you, sorry',
    'We always think opportunities are endless, so we never treasure them. But flowers bloom again \u2014 a person is never young twice.',
    'So the \u201Ccertainty\u201D we keep talking about really means three things: 1) you know more than others; 2) you know it earlier than others; 3) you understand it deeper than others.'
  ],
  qLike:'Like',
  qLikeTip:'Each tap adds +1 \u2014 tap as often as you like. All six quotes share one total, and it only ever goes up.',
  verTip:'Live build tag — this changes whenever the dashboard updates',
  pvTotal:'views', pvToday:'today', pvUv:'visitors',
  pvTip:'One view per page load; one visitor per device per day. Counted by this site\u2019s own server-side counter — no third-party analytics.',
  secRank:'Revenue ranking · where they sit in the whole industry',
  rankSub:n=>'Source: DefiLlama · '+n+' projects · ranked by total revenue for the window you pick',
  rankPct:p=>'top '+p+'%',
  rankOf:'of ',
  rankDeltaUp:n=>'Up '+n+' places vs one month ago',
  rankDeltaDown:n=>'Down '+n+' places vs one month ago',
  rankDeltaFlat:'Rank unchanged vs one month ago',
  rankDeltaNone:'Baseline: one month ago',
  rankDeltaWhy:(a,b)=>'(#'+a+' on the 30-day view, #'+b+' now)',
  rankGap:(v,r,n)=>'Add <b class="hi">'+v+'</b>/day to pass <b>#'+r+'</b> '+n,
  rankGapTop:'Already top-10 — every further place is hard fought',
  rankTopH:'Top 10 · how high the ceiling goes',
  rankNearH:t=>'Neighbours around '+t,
  rankBelowH:t=>'Chasing '+t+' · next 8',
