  rankUpdated:u=>'Leaderboard as of '+u,
  rankRefresh:'Refresh ranking',
  rankLoading:'Fetching the full leaderboard (~1MB)…',
  rankNoData:'No ranking data yet — hit Refresh or "Refresh ranking" to pull it',
  rankTab24:'24h', rankTab7:'7D', rankTab30:'30D',
  bgmTip:'Market BGM is on · tap the corner chip to mute',
  bgmWait:'Not started · tap the page to start',
  bgmSev24:'last 24h',
  secBurn:'Buybacks & burns · how much was really retired',
  burnSub:u=>'Read live from chain (PONS: up to the latest block) · Sources: Robinhood Chain / Solana RPC + DefiLlama industry buyback ranking'+(u?' · snapshot '+u:''),
  burnLink:'On-chain',
  burnBurned:'burned',
  burnPctOf:'of total supply',
  burnValue:'at current price',
  burn30d:'buyback, last 30d',
  burnYield:'bought back per year',
  burnVolShare:'buyback vs volume (7d)',
  burnSrcPons:'Read live: Robinhood Chain · dead-address balance',
  burnSrcStonk:'Read live: Solana · 1B initial − current supply',
  burnTab24:'Last 24h', burnTab30:'Last 30d', bbColName:'Project',
  burnRankBy:t=>'ranked by the "'+t+'" column (on-chain rows use a different basis and take no DefiLlama rank)',
  bbChainRk:'Chain',
  bbChainRkTip:'This amount is read live from chain over the last 24h (fresher than DefiLlama); its basis differs, so it does not take a DefiLlama rank.',
  burnPeersH24:n=>'Buyback leaderboard · last 24 hours ('+n+' projects across the industry; gas-burning chains excluded)',
  burnPeersH30:n=>'Buyback leaderboard · last 30 days ('+n+' projects across the industry; gas-burning chains excluded)',
  burnPeersNote24:'Only Pons / StonkFun are read live from chain (PONS up to the latest block; STONK from supply deltas). Every other project comes from DefiLlama, which can lag 1-2 days.',
  burnPeersNote30:'Method: DefiLlama holders-revenue, 30-day cumulative; gas-burning chains excluded (burning gas is not a buyback).',
  burn24:'buyback, last 24h', burn24Wait:'accumulating', burn24Chain:'on-chain', burn24Snap:'on-chain snapshot', burn24Official:'official API',
  burnCmpCol1:'last 24h', burnCmpCol2:'last 30d', burnCmpCol3:'buyback vs volume', burnCmpCol4:'bought back per year',
  burnLiveOk:s=>'On-chain data synced ('+s+') · revenue & industry ranking come from DefiLlama, which can lag 1-2 days',
  burnLiveFail:'Chain RPC unreachable right now · showing the last snapshot',
  burn24DayTip:'This is the latest full day in the source (may lag 1-2 days); the live on-chain read needs a full 24h of snapshots.',
  burnNoteH:'Can buybacks actually hold the price? All three on the same ruler',
  burnFoot:'Method: burned amounts and on-chain balances are read live; buyback amounts come from DefiLlama. "Per year" is simply the last 30 days multiplied out — not a promise. One week of data is not a trend; watch it over time.',
  burnBody:o=>'<ul>'
   +'<li><b>Start with today\'s money:</b> in the last 24 hours Pons sent <b class="hl">'+o.pons24+'</b> to the dead address'+(o.pons24tx?' ('+o.pons24tx+' transfers)':'')+' and StonkFun burned <b class="hl">'+o.stonk24+'</b>. No announcement needed — the chain reconciles every day, and the moment buybacks stop, this number goes to zero.</li>'
   +'<li><b>Whose buyback carries more weight (buyback as a share of volume, last 7 days):</b> StonkFun <b class="hl">'+o.stonkVs+'</b> &gt; Pons <b class="hl">'+o.ponsVs+'</b> &gt; pump.fun <b class="hl">'+o.pfVs+'</b>. StonkFun is buying back <b>'+o.timesVs+'</b> as hard as pump.fun, yet it fell this week; pump.fun has the weakest ratio and still trades near highs. <b>A buyback is not the price switch.</b></li>'
   +'<li><b>Who actually retires coins (buyback ÷ market cap, annualized):</b> StonkFun <b class="hl">'+o.stonkYd+'</b>, Pons <b class="hl">'+o.ponsYd+'</b>, pump.fun <b class="hl">'+o.pfYd+'</b>. Judging by the last 30 days, these two buy back a large slice of their market cap every year — that is what a buyback is really worth: <b>slow, but it compounds</b>.</li>'
   +'<li><b>So why does pump.fun climb?</b> Its daily volume is <b>'+o.pfVol+'</b>, or <b>'+o.pfVolX+'</b> Pons. It climbs on <b>demand, attention and liquidity</b>, not on buybacks. The same logic runs in reverse: StonkFun falls not because buybacks stopped (7-day buyback <b>'+o.stonk7+'</b>, unbroken) but because <b>sellers are in more of a hurry than buyers</b>.</li>'
   +'<li><b>The only irreversible part is the burn (those coins are gone):</b> Pons has sent <b class="hl">'+o.ponsPct+'</b> of supply to the dead address and StonkFun has burned <b class="hl">'+o.stonkPct+'</b>. They never come back. In one line: <b>a buyback is a bid — sellers can eat it; a burn removes supply — for good.</b></li>'
   +'</ul><div class="bb-foot">'+o.foot+'</div>',
  secSrc:'Data health · how fresh is each number',
  srcPrice:'Price', srcPriceFrom:'coins.llama.fi', srcJustNow:'refreshed on open',
  srcDailyP:'PONS daily (revenue / burn)', srcDailyS:'STONK daily (revenue / burn)', srcDailyFrom:'DefiLlama', srcDailyFromS:'official API',
  srcHourly:'Hourly (volume / revenue / burn)', srcHourlyFrom:'official API + on-chain',
  srcLb:'Revenue leaderboard', srcLbFrom:'DefiLlama all-protocol board',
  srcLag:n=>'lagging '+n+'d',
  srcStonkNote:'Both STONK daily and hourly figures come from the official API, matching stonkfun.xyz: daily from the official daily series, hourly from official cumulative diffs. DefiLlama is only a fallback (labelled) when the official API is unreachable.',
  srcLbStale:'Last fetch failed (the 4.2MB board endpoint was cut off); showing the previous board. Retries are in place, so the next fetch catches up automatically.',
  srcHourNote:'PONS revenue = on-chain buyback spend ÷ 80% (estimated, labelled); burn = on-chain truth. Both STONK figures are official-API truth.',
  srcSum:(n,ok,lag)=>n+' sources: '+ok+' up to date'+(lag?(', '+lag+' lagging (highlighted above — upstream publishing cadence, not an outage here; the hourly series is still current)'):'')+'.',
  safeLine:'<b>Read-only dashboard</b> · no wallet connection · no signatures · no transactions<span class="sf-sep">　|　</span>all data from public APIs',
  foot1:'Sources: Pons revenue and buybacks = DefiLlama + on-chain; StonkFun revenue and buybacks = the official StonkFun API (matches the official site); volume and market cap = CoinGecko. Pons revenue is what the protocol keeps (creator and Uniswap splits already deducted); StonkFun revenue is the trading fees it keeps. Valuation = mcap ÷ (daily revenue × 365) — lower is cheaper. Reference: pump.fun 30-day revenue $45.28M, mcap $2.46B → 4.45x.',
  foot2:'Where the lines come from: Pons 7-day avg revenue &lt; $100K = get out, &lt; $150K = stop adding; StonkFun &lt; $200K = get out, &lt; $280K = stop adding. A research tool, not investment advice.'
}
};
let LANG=(function(){ try{ var s=localStorage.getItem('pons-lang'); if(s==='zh'||s==='en') return s; }catch(e){}
  return ((navigator.language||navigator.userLanguage||'').toLowerCase().indexOf('zh')===0)?'zh':'en'; })();
function t(k){
  var v=I18N[LANG][k];
  if(v===undefined) v=I18N.zh[k];
  return v===undefined? k : v;
}
function tx(v){ return (v && typeof v==='object')? (v[LANG] || v.zh) : v; }
function setLang(l){
  LANG = (l==='en')?'en':'zh';
  try{ localStorage.setItem('pons-lang',LANG); }catch(e){}
  document.documentElement.lang = (LANG==='zh'?'zh-CN':'en');
  document.title = t('docTitle');
  var b=document.getElementById('lbtn');
  if(b) b.textContent = (LANG==='zh'?'EN':'中文');
  if(typeof applyTheme==='function') applyTheme(typeof curTheme==='function'?curTheme():'auto');
  renderStatic(); renderAll(); if(typeof renderTip==='function') renderTip();
  if(typeof qRedraw==='function') qRedraw();   /* 共勉栏跟着切语言 */
}
function cycleLang(){ setLang(LANG==='zh'?'en':'zh'); }

