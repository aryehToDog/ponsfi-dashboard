/* ---------- 指标说明 ---------- */
function renderGuide(){
  const rows = build();
  const A = PROJECTS[0], B = PROJECTS[1];
  const sa = stats(rows,A), sb = stats(rows,B);
  const psx = v => (v===null||v===undefined||!isFinite(v))?'—':fmtN(v,2)+'x';
  const pcy = v => (v===null||!isFinite(v))?'—':(v*100).toFixed(2)+'%';
  const wk  = s => s.vol24? s.vol24*7 : null;

  const cheaper = (sa.ps7 && sb.ps7) ? (sa.ps7<sb.ps7 ? A : B) : null;
  const dearer  = cheaper ? (cheaper.id===A.id ? B : A) : null;
  const sc = cheaper? stats(rows,cheaper) : null, sd = dearer? stats(rows,dearer) : null;
  const gap = (sc&&sd&&sc.ps7&&sd.ps7)? sd.ps7/sc.ps7 : null;

  const divLine = (p, st) => {
    if(!st.ps7 || !st.ps30) return '';
    const div = st.ps7/st.ps30;
    let cls='g-ok', txt;
    if(div > 1.5){ cls='g-bad'; txt='收入正在快速下滑 —— 最近 7 天的收入只有过去一个月平均的 '+fmtN(100/div,0)+'%'; }
    else if(div > 1.15){ cls='g-warn'; txt='收入比月均低，正在走弱'; }
    else if(div < 0.85){ txt='收入比月均高 '+(1/div).toFixed(1)+' 倍，正在加速'; }
    else { txt='收入和月均基本持平，节奏稳定'; }
    return `<div>${p.name}：7日 <b>${psx(st.ps7)}</b> vs 30日 <b>${psx(st.ps30)}</b>　→　相差 ${div.toFixed(2)} 倍<br><span class="${cls}">↳ ${txt}</span></div>`;
  };

  const item = (title, formula, lead, ex, bands, note) =>
    `<div class="gitem">
       <h3>${title}</h3>
       <div class="f">${formula}</div>
       <div class="lead">${lead}</div>
       ${ex?`<div class="ex">${ex}</div>`:''}
       ${bands?`<ul>${bands.map(b=>`<li><span class="band ${b[1]}">${b[0]}</span><span>${b[2]}</span></li>`).join('')}</ul>`:''}
       ${note?`<div class="note">${note}</div>`:''}
     </div>`;

  const ex1 = `<div class="cap">算给你看（${A.name}）</div>
    市值 ${fmtU(sa.mcap)}　÷　(7 日均收入 ${fmtU(sa.avg7)}/天 × 365 天 ＝ ${fmtU(sa.avg7*365)})
    <br>＝ <b>${psx(sa.ps7)}</b>
    <br>→ 假设收入不变，你花 ${fmtN(sa.ps7,2)} 元买它 1 年的收入，要 <b>${fmtN(sa.ps7,1)} 年</b>才回本
    <div style="margin-top:7px;padding-top:7px;border-top:1px dashed var(--line2)">对照 ${B.name}：${fmtU(sb.mcap)} ÷ ${fmtU(sb.avg7*365)} ＝ <b>${psx(sb.ps7)}</b>${gap?`　→　${cheaper.ticker} 便宜 <b>${gap.toFixed(1)} 倍</b>`:''}</div>`;

  const ex3 = `${A.name}：最近 7 日回购 ${fmtU(sa.holdSum7)} ÷ 7 日成交额 ${fmtU(wk(sa))} ＝ <b>${pcy(sa.burnForce)}</b>
    <br>${B.name}：最近 7 日回购 ${fmtU(sb.holdSum7)} ÷ 7 日成交额 ${fmtU(wk(sb))} ＝ <b>${pcy(sb.burnForce)}</b>
    <br><span style="color:var(--mut2)">↑ 两个都在 2% 以下 —— 这就是"回购了但涨不动"的直接原因</span>`;

  const ex4 = `当前：${A.name} 换手 <b>${sa.turnover!==null?(sa.turnover*100).toFixed(1)+'%':'—'}/天</b> · 回购年化 <b>${sa.burnYield!==null?fmtN(sa.burnYield*100,0)+'%':'—'}</b>
    <br>　　　${B.name} 换手 <b>${sb.turnover!==null?(sb.turnover*100).toFixed(1)+'%':'—'}/天</b> · 回购年化 <b>${sb.burnYield!==null?fmtN(sb.burnYield*100,0)+'%':'—'}</b>
    <br><span style="color:var(--mut2)">每天 1 成以上的筹码在换手 → 短线资金主导，回购对价格的影响被稀释</span>`;

  const momA = (sa.avg7-sa.avg7p)/(sa.avg7p||1), momB = (sb.avg7-sb.avg7p)/(sb.avg7p||1);
  const momTxt = (p,v) => `${p.name} <b>${(v*100).toFixed(1)}%</b>`;
  const ex5 = `${momTxt(A,momA)}　·　${momTxt(B,momB)}
    <br><span style="color:var(--mut2)">两家都在 −35% 附近 → 已越过 −25% 触发线，按规则＝暂停加仓</span>`;

  document.getElementById('guide').innerHTML =
    item('P/S 年化 —— 你花多少钱，买它一年的收入',
         'P/S ＝ 市值 ÷ (日均收入 × 365 天)',
         '数字越小越便宜，可以理解成"按现在的赚钱速度要几年回本"。它把"公司贵不贵"和"币价高低"分开看——币价低不代表便宜，要看它每年能赚多少。',
         ex1,
         [['&lt; 1.5x','g-ok','便宜 —— 安全垫厚，可分批加仓'],
          ['1.5x – 4x','','合理 —— 持有观察，不追高'],
          ['&gt; 4x','g-warn','偏贵 —— 需要收入增长来消化估值']],
         '注意：P/S 只反映"现在"，不反映"未来"。收入正在下滑时，看起来很便宜的 P/S 可能只是假象（分母迟早会变小）。')

  + item('为什么 P/S 要同时看 7 日和 30 日',
         '7 日 ＝ 最新速度　·　30 日 ＝ 近一个月平均',
         '7 日灵敏、能最早发现拐点；30 日平滑、不会被单日噪声骗。两个数字差得越大，说明收入变化越剧烈 —— 这正是判断"拐点"的关键。',
         divLine(A,sa) + '<div style="margin-top:7px;padding-top:7px;border-top:1px dashed var(--line2)">' + divLine(B,sb) + '</div>',
         null,
         '记法：7 日 P/S 明显高于 30 日 P/S ＝ 收入在掉；反过来 ＝ 收入在涨。')

  + item('回购力度 —— 回购到底有没有用',
         '回购力度 ＝ 最近 7 日回购 ÷ 最近 7 日成交额',
         '不要看"回购了多少钱"，要看它占市场成交量的比例。买盘再大，如果同期有几十倍的筹码在换手，也改变不了价格方向。这是判断回购能否托底唯一有效的口径。',
         ex3,
         [['≥ 5%','g-ok','回购足够重，能真正托住价格'],
          ['2% – 5%','g-warn','能减缓下跌，但改变不了方向'],
          ['&lt; 2%','g-bad','杯水车薪，别指望回购托底']],
         '典型对照：为什么有的币回购了还在跌？回购占成交量太低，只是给卖盘提供流动性而已。')

  + item('换手率 & 回购年化收益率',
         '换手率 ＝ 24h 成交额 ÷ 市值　·　回购年化 ＝ 7 日回购 × 52 ÷ 市值',
         '换手率告诉你筹码有多"活跃"：越高说明短线资金越多、波动越大，回购的影响也越小。回购年化告诉你：如果回购速度不变，一年能买掉市值的百分之几。',
         ex4,
         [['换手 &lt; 3%','g-ok','筹码稳定，回购效果好'],
          ['换手 3% – 8%','g-warn','偏活跃，回购效果一般'],
          ['换手 &gt; 8%','g-bad','高频换手，回购效果被稀释']],
         '重要：回购年化收益率高 ≠ 一定涨。它建立在"收入不跌"的假设上；收入一旦下滑，这个数字会跟着一起缩水。')

  + item('收入环比 —— 最灵敏的预警',
         '收入环比 ＝ 最近 7 日均收入 vs 前 7 日均收入',
         '这是所有指标里最早报警的一个。因为回购是"收入"的下游：收入 ↓ → 回购金额 ↓ → 买盘 ↓ → 价格失去支撑。盯收入，比盯回购更提前。',
         ex5,
         [['&gt; −15%','g-ok','收入平稳，维持仓位'],
          ['−15% ~ −25%','g-warn','走弱，只观察不加仓'],
          ['&lt; −25%','g-bad','骤降，暂停一切加仓']],
         null);
}

/* ---------- live ---------- */
async function fetchJSON(u){ const r=await fetch(u,{cache:'no-store'}); if(!r.ok) throw new Error(r.status); return r.json(); }
async function loadLive(){
  document.getElementById('src').textContent='拉取中…';
  document.getElementById('src').className='badge';
  let ok = true;
  try{
    const reqs=[];
    ['pons','stonkfun'].forEach(s=>['dailyRevenue','dailyHoldersRevenue','dailyFees'].forEach(dt=>
      reqs.push(fetchJSON(`https://api.llama.fi/summary/fees/${s}?dataType=${dt}`).then(j=>({k:`${s}.${dt}`, j})))));
    reqs.push(fetchJSON('https://api.llama.fi/protocol/pons').then(j=>({k:'meta.pons',j})));
    reqs.push(fetchJSON('https://api.llama.fi/protocol/stonkfun').then(j=>({k:'meta.stonkfun',j})));
    const res = await Promise.all(reqs);
    res.forEach(({k,j})=>{
      if(k.startsWith('meta.')){ DATA.meta[k.slice(5)] = {name:j.name, mcap:j.mcap, symbol:j.symbol}; }
      else { DATA.series[k] = (j.totalDataChart||[]).map(([ts,v])=>[ts, v]); }
    });
    DATA.generated = new Date().toISOString();
  }catch(e){
    ok = false;
  }
  // 成交额（CoinGecko）——单独 try，失败就沿用快照，不影响其他数据
  try{
    const j = await fetchJSON('https://api.coingecko.com/api/v3/simple/price?ids=' + Object.values(CG_IDS).join(',')
      + '&vs_currencies=usd&include_24hr_vol=true&include_market_cap=true&include_24hr_change=true');
    const mk = DATA.market || (DATA.market = {});
    Object.entries(CG_IDS).forEach(([name,cid])=>{
      const x = j[cid] || {};
      if(x.usd_24h_vol) mk[name] = {vol24h:x.usd_24h_vol, mcap:x.usd_market_cap||0, price:x.usd, change24h:x.usd_24h_change||0};
    });
  }catch(e){}
  setSrc(ok);
  renderAll();
}
function setSrc(ok){
  const b=document.getElementById('src');
  b.textContent = ok? '● 实时数据' : '● 内置快照（联网失败）';
  b.className = 'badge ' + (ok?'live':'off');
}
function renderAll(){ renderCards(); renderRules(); renderTabs(); renderChart(); renderTable(); renderGuide();
  const g = DATA.generated || BUNDLE.generated;
  document.getElementById('gen').textContent = '数据时间 ' + new Date(g).toLocaleString('zh-CN');
  document.getElementById('foot').innerHTML =
    `数据源：收入/回购＝DefiLlama（fees/revenue/holders-revenue API）；成交额/市值＝CoinGecko。Pons 收入=协议留存收入（创作者与 Uniswap 分成已扣除）；StonkFun 收入=其自留交易费（费用=收入）。`+
    `P/S 年化 = 市值 ÷ (日均收入 × 365)，越低越便宜。参照系：pump.fun 30 日收入 $4,528 万、市值 $24.6 亿 → 4.45x。<br>`+
    `规则阈值：Pons 日收入 7 日均 &lt; $10 万＝离场，&lt; $15 万＝暂停加仓；StonkFun &lt; $20 万＝离场，&lt; $28 万＝暂停加仓。`+
    `本面板仅为研究工具，不构成投资建议。` +
    `<br><br><span class="foot-author"><img src="data:image/jpeg;base64," alt="阿拉斯加的狗💎">本看板作者 <a href="https://x.com/arych_kun" target="_blank" rel="noopener">阿拉斯加的狗💎 @arych_kun</a> &nbsp;·&nbsp; 想看更多项目拆解与实盘记录，欢迎关注</span>`;
}

/* ---------- 主题切换 ---------- */
const THEMES=[{k:'auto',ic:'◐',lb:'系统'},{k:'light',ic:'☀',lb:'浅色'},{k:'dark',ic:'☾',lb:'深色'}];
function curTheme(){try{return localStorage.getItem('pons-theme')||'auto'}catch(e){return 'auto'}}
function applyTheme(t){
  const th=THEMES.find(x=>x.k===t)||THEMES[0];
  if(th.k==='auto') document.documentElement.removeAttribute('data-theme');
  else document.documentElement.setAttribute('data-theme',th.k);
  try{localStorage.setItem('pons-theme',th.k);}catch(e){}
  const b=document.getElementById('tbtn');
  if(b) b.textContent=th.ic+' '+th.lb;
}
function cycleTheme(){
  const i=THEMES.findIndex(x=>x.k===curTheme());
  applyTheme(THEMES[(i+1)%THEMES.length].k);
}
applyTheme(curTheme());

renderAll();
loadLive();
