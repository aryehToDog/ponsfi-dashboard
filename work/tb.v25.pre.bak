<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pons / StonkFun 收入与回购监控面板</title>
<link rel="icon" href="data:,">
<style>
:root{
  --bg:#0a0c11; --panel:#11141c; --panel2:#161a24; --line:#212736; --line2:#2c3446;
  --txt:#e8ebf2; --mut:#828b9e; --mut2:#5d6679;
  --up:#2ee6a8; --down:#ff5c72; --warn:#ffb020;
  --pons:#8b7cff; --stonk:#2ee6a8;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--txt);
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro SC","PingFang SC","Segoe UI",Roboto,sans-serif;
  font-size:13px;line-height:1.5;-webkit-font-smoothing:antialiased}
.mono{font-family:ui-monospace,SFMono-Regular,"SF Mono",Menlo,monospace;font-variant-numeric:tabular-nums}
.wrap{max-width:1420px;margin:0 auto;padding:18px 20px 60px}
header{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:16px}
h1{font-size:16px;margin:0;font-weight:600;letter-spacing:.2px}
h1 span{color:var(--mut);font-weight:400;font-size:12px;margin-left:8px}
.hdr-right{display:flex;align-items:center;gap:10px}
.badge{font-size:11px;padding:3px 9px;border-radius:20px;border:1px solid var(--line2);color:var(--mut);white-space:nowrap}
.badge.live{color:var(--up);border-color:#1c5443;background:#0d2b22}
.badge.off{color:var(--warn);border-color:#5c451a;background:#2b210d}
button{background:var(--panel2);color:var(--txt);border:1px solid var(--line2);border-radius:7px;
  padding:6px 13px;font-size:12px;cursor:pointer;font-family:inherit;transition:.15s}
button:hover{background:#1e2431;border-color:#3a445c}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:900px){.grid2{grid-template-columns:1fr}}
.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:15px 16px}
.proj-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:12px}
.proj-name{display:flex;align-items:center;gap:9px;font-size:15px;font-weight:600}
.dot{width:9px;height:9px;border-radius:50%;flex:0 0 auto;box-shadow:0 0 10px currentColor}
.tick{font-size:11px;color:var(--mut);background:var(--panel2);border:1px solid var(--line2);padding:2px 7px;border-radius:5px}
.price{text-align:right}
.price .p{font-size:19px;font-weight:600}
.price .m{font-size:11px;color:var(--mut)}
.pill{display:inline-block;font-size:11px;padding:2px 7px;border-radius:5px;margin-top:3px}
.pill.up{background:#0d2b22;color:var(--up)}
.pill.down{background:#2b0d13;color:var(--down)}
.kv{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:9px;overflow:hidden;margin-bottom:12px}
.kv .qi{display:inline-block;width:11px;height:11px;line-height:11px;text-align:center;border-radius:50%;background:var(--line2);color:var(--mut);font-size:8.5px;cursor:help;vertical-align:1px}
.kv>div{background:var(--panel2);padding:9px 10px}
.kv .k{font-size:10.5px;color:var(--mut);margin-bottom:3px;letter-spacing:.2px}
.kv .v{font-size:14px;font-weight:600}
.kv .v small{font-size:10.5px;color:var(--mut);font-weight:400}
.status{border-radius:9px;padding:9px 11px;font-size:12px;display:flex;align-items:center;gap:9px;border:1px solid}
.status.good{background:#0d2b22;border-color:#1c5443;color:#7ff0c6}
.status.warn{background:#2b210d;border-color:#5c451a;color:#ffd68a}
.status.bad{background:#2b0d13;border-color:#5c1a24;color:#ff9aa8}
.status .lbl{font-weight:600}
.sec-title{font-size:12px;color:var(--mut);margin:22px 0 10px;letter-spacing:.4px;text-transform:uppercase;font-weight:600}
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
.tab{padding:5px 12px;border-radius:7px;border:1px solid var(--line2);background:var(--panel);color:var(--mut);cursor:pointer;font-size:12px}
.tab.on{background:#1d2330;color:var(--txt);border-color:#3a445c}
.chartbox{position:relative;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px 14px 8px}
.legend{display:flex;gap:16px;margin-bottom:6px;font-size:11.5px;color:var(--mut);flex-wrap:wrap}
.legend i{display:inline-block;width:11px;height:3px;border-radius:2px;margin-right:6px;vertical-align:middle}
svg{display:block;width:100%;height:auto;overflow:visible}
.tip{position:absolute;pointer-events:none;background:#0d1017ee;border:1px solid var(--line2);border-radius:8px;
  padding:7px 10px;font-size:11.5px;display:none;z-index:9;backdrop-filter:blur(6px);min-width:150px}
.tip .d{color:var(--mut);margin-bottom:4px;font-size:10.5px}
.tip .r{display:flex;justify-content:space-between;gap:14px}
table{width:100%;border-collapse:collapse;font-size:12px}
th,td{text-align:right;padding:7px 9px;border-bottom:1px solid var(--line)}
th{color:var(--mut);font-weight:500;font-size:11px;position:sticky;top:0;background:var(--panel);cursor:pointer;user-select:none}
th:first-child,td:first-child{text-align:left}
tbody tr:hover{background:#161a24}
.rules{display:flex;flex-direction:column;gap:16px}
.rule-legend{display:flex;gap:20px;flex-wrap:wrap;font-size:11.5px;color:var(--mut);margin:0 0 12px;line-height:1.6}
.rule-legend .lg{display:flex;align-items:center;gap:7px}
.tag{font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:5px;white-space:nowrap;flex:0 0 auto;letter-spacing:.5px}
.tag.ok{background:#0d2b22;color:var(--up);border:1px solid #1c5443}
.tag.warn{background:#2b210d;color:var(--warn);border:1px solid #5c451a}
.tag.bad{background:#2b0d13;color:var(--down);border:1px solid #5c1a24}
/* 对比表：同一规则左右并排 */
.cmp-head{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:6px}
.cmp-head .col{display:flex;align-items:center;gap:8px;background:var(--panel2);border:1px solid var(--line);border-radius:9px;padding:8px 13px;font-size:13px;font-weight:600}
.cmp-head .col .cnt{margin-left:auto;font-size:11px;font-weight:400;color:var(--mut)}
.cmp-row{display:flex;flex-direction:column;gap:7px}
.cmp-label{display:flex;align-items:center;gap:9px;flex-wrap:wrap;padding:0 2px}
.cmp-label b{font-size:12px;font-weight:600;color:var(--txt)}
.cmp-label .hint{font-size:11px;color:var(--mut2)}
.cmp-label .verdict{margin-left:auto;font-size:11px;padding:2px 9px;border-radius:5px;background:var(--panel2);border:1px solid var(--line2);color:var(--mut)}
.cmp-label .verdict.win{color:#7ff0c6;border-color:#1c5443}
.cmp-pair{display:grid;grid-template-columns:1fr 1fr;gap:10px;align-items:stretch}
@media(max-width:900px){.cmp-head,.cmp-pair{grid-template-columns:1fr}}
.cmp-pair>.rule{display:flex;flex-direction:column}
.cmp-pair>.rule .act{margin-top:auto}
.rule{background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--line2);border-radius:10px;padding:11px 13px}
.rule.ok{border-left-color:#1c5443}
.rule.warn{border-left-color:var(--warn)}
.rule.bad{border-left-color:var(--down)}
.rule.sum{border-left-color:#3a445c}
.rule .rtop{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:5px}
.rule .pname{font-size:11.5px;font-weight:600;display:none}
@media(max-width:900px){.rule .pname{display:inline}}
.rule .s{color:var(--mut);font-size:11.5px;line-height:1.55}
.rule .act{margin-top:7px;font-size:11.5px;padding:5px 9px;border-radius:6px;background:var(--panel2);border:1px solid var(--line);color:var(--mut)}
.rule .act.ok{color:#7ff0c6;border-color:#1c5443}
.rule .act.warn{color:#ffd68a;border-color:#5c451a}
.rule .act.bad{color:#ff9aa8;border-color:#5c1a24}
.rule.sum .act{color:var(--txt);border-color:#3a445c}
.gitem .g-ok{color:var(--up)}
.gitem .g-warn{color:var(--warn)}
.gitem .g-bad{color:var(--down)}
.guide{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:900px){.guide{grid-template-columns:1fr}}
.gitem{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:15px 17px}
.gitem h3{margin:0 0 5px;font-size:13px;font-weight:600}
.gitem .f{font-size:10.5px;color:var(--mut2);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;margin-bottom:9px;word-break:break-all}
.gitem .lead{font-size:12px;color:var(--mut);line-height:1.75;margin:0 0 10px}
.gitem .ex{background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:10px 12px;font-size:11.5px;line-height:1.95;margin-bottom:10px;word-break:break-word}
.gitem .ex b{color:var(--txt)}
.gitem .ex .cap{color:var(--mut2);font-size:10.5px;letter-spacing:.3px;margin-bottom:4px}
.gitem ul{margin:0;padding-left:0;list-style:none;font-size:11.5px;line-height:1.9;color:var(--mut)}
.gitem ul li{display:flex;gap:9px}
.gitem ul li .band{flex:0 0 auto;min-width:66px;font-family:ui-monospace,monospace;color:var(--txt)}
.gitem .note{margin-top:9px;font-size:11px;color:var(--mut2);line-height:1.75;border-top:1px dashed var(--line2);padding-top:8px}
.foot{color:var(--mut2);font-size:11px;margin-top:26px;line-height:1.7}
.warnline{stroke-dasharray:4 4}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1><span id="h1t">Pons · StonkFun 收入与回购监控面板</span><span id="gen"></span></h1>
    <div class="hdr-right">
      <span class="badge" id="src">加载中…</span>
      <button id="btnRefresh" onclick="loadLive()">刷新数据</button>
    </div>
  </header>

  <div class="grid2" id="cards"></div>

  <div class="sec-title" id="st-rules">规则引擎 · 加仓与止损信号</div>
  <div class="rule-legend" id="rule-legend"></div>
  <div class="rules" id="rules"></div>

  <div class="sec-title" id="st-rank">收入排行 · 在整个行业里的位置</div>
  <div class="rank-sub" id="rankSub"></div>
  <div class="rank-insight" id="rankInsight"></div>
  <div class="tabs" id="rankTabs"></div>
  <div class="grid2" id="rankCards"></div>
  <div class="rank-block">
    <div class="rank-h" id="rankTopH"></div>
    <div class="rank-list" id="rankTop"></div>
  </div>
  <div class="grid2 rank-near" id="rankNear"></div>

  <div class="sec-title" id="st-chart">趋势图</div>
  <div class="tabs" id="tabs"></div>
  <div class="chartbox">
    <div class="legend" id="legend"></div>
    <svg id="chart" viewBox="0 0 1200 340" preserveAspectRatio="none"></svg>
    <div class="tip" id="tip"></div>
  </div>

  <div class="sec-title" id="st-table">日度明细（最近 20 天）</div>
  <div class="card" style="padding:0;overflow:auto;max-height:430px">
    <table id="tbl"><thead></thead><tbody></tbody></table>
  </div>

  <div class="sec-title" id="st-guide">指标说明 · 每个数字怎么读</div>
  <div class="glegend" id="glegend"></div>
  <div class="guide" id="guide"></div>

  <div class="foot" id="foot"></div>
</div>

<script>
const BUNDLE = /*__DATA__*/;
const DASH_VER = /*__VER__*/ 'v1.0';

/* ==================== 多语言 / i18n ==================== */
const I18N = {
zh:{
  docTitle:'Pons · StonkFun 收入与回购监控面板',
  h1:'Pons · StonkFun 收入与回购监控面板',
  secRules:'现在该做什么 · 五条信号对照',
  secChart:'趋势图',
  secTable:'日度明细（最近 20 天）',
  secGuide:'指标说明 · 每个数字怎么读',
  gLegend:'图例：<b class="hl">加底色</b> ＝ 一句话结论　·　<b class="hi">等宽亮色数字</b> ＝ 当前真实数值',
  refresh:'刷新数据',
  loading:'加载中…', fetching:'拉取中…',
  live:'● 实时数据', offline:'● 内置快照（联网失败）', liveAt:'● 实时数据 · ',
  updatedAt:'数据时间 ',
  burned:'已销毁 ', mcap:'市值 ', fromAth:'距 ATH ',
  perDay:' /天',
  kAvg7:'7 日均收入', kMom:'环比上 7 日', kLast:'最新单日收入', kPeak:'单日收入峰值',
  kPs7:'P/S 年化 (7日)', kPs30:'P/S 年化 (30日)', kFromPeak:'距收入峰值',
  kBurnYield:'回购年化收益率', kBurn7:'最近 7 日回购', kBurnForce:'回购力度',
  kVol24:'24h 成交额', kTurnover:'日换手率',
  tipPs:'市值 ÷ 一年收入，越小越便宜', tipPs30:'用 30 日均收入算的 P/S，比 7 日平滑',
  tipBurnYield:'7 日回购 × 52 ÷ 市值：一年能买掉市值的百分之几',
  tipBurnForce:'最近 7 日回购 ÷ 最近 7 日成交额：≥5% 才算有效买盘', tipVol:'24 小时成交额',
  stBad:'收入已跌破止损线，退出观察', stWarn:'收入低于警戒线，暂停加仓',
  stMom:'收入环比骤降，只观察不动手', stUp:'收入企稳回升，可考虑分批加仓',
  stFlat:'收入横盘企稳，持有观察',
  lvOk:'正常', lvWarn:'警戒', lvBad:'危险',
  legendOk:'条件满足，按原计划持有', legendWarn:'接近阈值，暂停加仓、盯紧',
  legendBad:'规则已触发，看每条下面的「建议」',
  alertTitle:'⚠ 已触发信号：', alertHint:'红色卡片＝最该优先处理的那条',
  badFlag:'⚠ 已触发 · 优先看这张',
  cmpHead:(n,m)=>n+'/'+m+' 条正常',
  verdict:'对比：', verdictTie:'两家基本打平', verdictNoData:'数据不足', verdictWin:t=>t+' ',
  advice:'建议：',
  vFloor:'缓冲更厚', vMom:'更抗跌', vBurn:'更积极', vBurnpower:'回购占比更高', vPs:'更便宜',
  dimFloorL:'收入还安全吗（离止损线多远）', dimFloorH:'7 日均跌破离场线＝该走',
  dimMomL:'收入在变好还是变坏', dimMomH:'连续下滑是最早的坏消息',
  dimBurnL:'回购还在继续吗', dimBurnH:'回购停＝最重要的离场信号',
  dimBpL:'回购能不能托住价格', dimBpH:'回购 ÷ 成交额：低于 2% 基本影响不到价格',
  dimPsL:'现在贵不贵（P/S）', dimPsH:'数字越小越便宜',
  dimFloorS:'止损', dimMomS:'环比', dimBurnS:'回购', dimBpS:'力度', dimPsS:'估值',
  conclusion:'一句话结论',
  sumHint:'↓ 下面 5 条信号，逐条对照两家的数据',
  deepTag:'数据怎么算出来的',
  chipRev:'7日均收入', chipMom:'环比', chipBp:'回购力度', chipPs:'P/S',
  sumActBad:'该走：收入已跌破离场线',
  sumActMomBad:'暂停加仓：收入环比跌破 −25%',
  sumActBurnBad:'先减仓：回购已经停了',
  sumActBpBad:'只观察：回购占比太低，托不住价格',
  sumActWarn:'暂停加仓：信号转弱',
  sumActOk:'持有观察：信号正常',
  sumActNoData:'数据不足，先观察',
  anFloor:d=>'7 日均 '+d.avg7+'　·　警戒线 '+d.warn+'　·　离场线 '+d.danger+'；<b>距警戒线 '+d.toWarn+'</b>'+(d.days?('，按最近两周的下滑速度，大约 <b>'+d.days+' 天</b>会跌破警戒线'):'')+'。',
  streakTxt:(n,up)=> up? (n>=2? '最近 '+n+' 天连续回升': '最近 1 天转为回升') : (n>=2? '最近 '+n+' 天连续下滑': '最近 1 天小幅回落'),
  anMom:d=>'最近 7 日均 <b>'+d.a+'</b> vs 前 7 日均 '+d.b+'（差 <b>'+d.diff+'/天</b>）；'+(d.up? '<span class="hl-up">'+d.streakTxt+'</span>' : '<span class="hl-dn">'+d.streakTxt+'</span>')+'。',
  anBurn:d=>'7 日回购合计 <b>'+d.buy7+'</b>（日均 '+d.buyDay+'）＝ 同期收入的 <b>'+d.buyShare+'</b>；7 天里有 '+d.burnDays+' 天在回购；按这个速度一年能买回流通市值的 <b>'+d.yield+'</b>。',
  anBp:d=>'回购 <b>'+d.buy7+'</b> ÷ 同期成交额 <b>'+d.vol7+'</b> ＝ 力度 <b>'+d.f+'</b>。要够到「有效买盘」5% 的门槛，每天得回购 <b>'+d.needDay+'</b>，是现在的 <b>'+d.gap+'</b>；按当前收入 '+d.revDay+'/天，这笔钱相当于收入的 <b>'+d.needShare+'</b>，而项目公开口径只拿 <b>'+d.share+'</b> 的收入做回购 → 短期结构上做不到。',
  anBpEvidence:d=>'实证：这 7 天回购一直在继续，价格同期 <b>'+d.priceChg+'</b>（'+d.priceFrom+' → '+d.priceNow+'）。',
  anBpLong:d=>'回购真正的价值在长期：按现在速度，一年大约买回流通市值的 '+d.yield+'，筹码持续减少——但这是慢变量，决定不了短期方向。',
  anPs:d=>'市值 '+d.mcap+' ÷（7 日均收入 '+d.avg7+' × 365 ＝ '+d.yearRev+'）＝ <b>'+d.ps7+'</b>；30 日口径 '+d.ps30+'（相差 '+d.div+'×）→ '+d.trend+'。对照 pump.fun 约 4.45x。',
  priority:t=>'资金优先级：'+t+'（P/S 更低、安全垫更厚）；另一方等环比止跌、估值回落再考虑加仓。',
  priorityNone:'数据不足，暂不给资金优先级建议。',
  actFloorBad:'已跌破离场线：建议分批减仓或清仓，不要补仓',
  actFloorWarn:'低于警戒线：暂停加仓，每天盯住这条线',
  actFloorOk:v=>'高出警戒线 '+v+'%，可继续持有',
  sFloor:(a,b,c)=>'7 日均 <b class="hi">'+a+'/天</b>　·　离场线 '+b+'　·　警戒线 '+c,
  actMomBad:'环比骤降超 25%：暂停一切加仓，等连续 3 天回升再考虑',
  actMomWarn:'环比走弱：只观察、不加仓',
  actMomUp:'环比回升：可考虑分批加仓',
  actMomFlat:'环比平稳：维持现有仓位',
  sMom:(d)=>'本周 vs 上周 <b class="hi">'+d+'%</b>　·　触发线 −25%',
  actBurnOff:'回购已停止：先减仓，等回购恢复再谈加仓',
  actBurnOn:v=>'回购在持续，7 日回购≈同期收入的 '+v+'%',
  sBurn:(a,b)=>'最近 7 日回购 <b class="hi">'+a+'</b>　·　'+b,
  actBpNone:'缺少成交额数据，无法判断回购的影响力',
  actBpOk:v=>'回购占成交额 '+v+'%：买盘足够重，能真正托住价格',
  actBpWarn:v=>'回购占成交额 '+v+'%：能减缓下跌，但改变不了方向',
  actBpBad:v=>'回购只占成交额 '+v+'%：短期买盘扛不住卖压（算式见下）',
  sBp:(a,b)=>'最近 7 日回购 <b class="hi">'+a+'</b> ÷ 7 日成交额 <b class="hi">'+b+'</b>　·　≥5% 才算有效买盘',
  actPsNone:'没有收入数据，暂时无法估值',
  actPsCheap:v=>v+'x 便宜：安全垫厚，可分批加仓',
  actPsFair:v=>v+'x 合理：持有观察，不追高',
  actPsDear:v=>v+'x 偏贵：不追高，等回调或收入涨上来',
  sPs:v=>'P/S 年化(7日) <b class="hi">'+v+'</b>　·　<1.5x 便宜 · >4x 偏贵　·　参照 pump.fun 4.45x',
  tabRev:'日收入', tabRev7:'7 日均线收入', tabCum:'累计回购销毁', tabPrice:'价格对比（归一）',
